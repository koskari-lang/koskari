{
  "scopeName": "source.koskari",
  "name": "Koskari",
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comment" },
    { "include": "#string-triple-raw" },
    { "include": "#string-triple" },
    { "include": "#string-raw" },
    { "include": "#format-string-triple" },
    { "include": "#format-string" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#collection-tuple" },
    { "include": "#collection-list" },
    { "include": "#collection-dict" },
    { "include": "#paren-list" },
    { "include": "#bracket-list" },
    { "include": "#brace-block" },
    { "include": "#quote-syntax-form" },
    { "include": "#quasiquote-syntax-form" },
    { "include": "#quote-form" },
    { "include": "#quasiquote-form" },
    { "include": "#block-header" },
    { "include": "#bare-line-call-head" },
    { "include": "#keyword" },
    { "include": "#symbol" }
  ],
  "repository": {
    "shebang": {
      "begin": "^(#!)",
      "end": "$",
      "name": "comment.line.shebang.koskari"
    },
    "comment": {
      "begin": ";",
      "end": "$",
      "name": "comment.line.koskari"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.koskari",
      "patterns": [
        { "include": "#escape-sequence" }
      ]
    },
    "string-triple": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.koskari",
      "patterns": [
        { "include": "#escape-sequence" }
      ]
    },
    "string-raw": {
      "begin": "r\"",
      "end": "\"",
      "name": "string.quoted.double.raw.koskari"
    },
    "string-triple-raw": {
      "begin": "r\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.raw.koskari"
    },
    "format-string": {
      "begin": "f\"",
      "end": "\"",
      "name": "string.quoted.double.format.koskari",
      "patterns": [
        { "include": "#escape-sequence" },
        { "include": "#format-literal" },
        { "include": "#format-interpolation" }
      ]
    },
    "format-string-triple": {
      "begin": "f\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.format.koskari",
      "patterns": [
        { "include": "#escape-sequence" },
        { "include": "#format-literal" },
        { "include": "#format-interpolation" }
      ]
    },
    "escape-sequence": {
      "match": "\\\\[\\\\'\"abfnrtv0-7]|\\\\x[0-9a-fA-F]{2}|\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}",
      "name": "constant.character.escape.koskari"
    },
    "format-spec-quote": {
      "match": "'[0-9A-Za-z._+#-]+",
      "name": "constant.other.format-spec.koskari"
    },
    "format-interpolation": {
      "begin": "\\{(?!\\{)",
      "end": "\\}(?!\\})",
      "name": "meta.interpolation.koskari",
      "patterns": [
        { "include": "#format-spec-quote" },
        { "include": "$self" }
      ]
    },
    "format-literal": {
      "match": "\\{\\{|\\}\\}",
      "name": "constant.character.escape.koskari"
    },
    "number": {
      "patterns": [
        {
          "match": "\\b0x[0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.koskari"
        },
        {
          "match": "\\b0o[0-7]+\\b",
          "name": "constant.numeric.octal.koskari"
        },
        {
          "match": "\\b0b[01]+\\b",
          "name": "constant.numeric.binary.koskari"
        },
        {
          "match": "-?\\d+/\\d+\\b",
          "name": "constant.numeric.fraction.koskari"
        },
        {
          "match": "-?(?:\\d+\\.\\d*|\\.\\d+)(?:[eE]-?\\d+)?[fd]?\\b",
          "name": "constant.numeric.float.koskari"
        },
        {
          "match": "-?\\d+[eE]-?\\d+[fd]?\\b",
          "name": "constant.numeric.float.koskari"
        },
        {
          "match": "-?\\d+(?:\\.\\d+)?[+-](?:\\d*\\.?\\d*)[ij]\\b",
          "name": "constant.numeric.complex.koskari"
        },
        {
          "match": "-?\\d+(?:\\.\\d*|\\d*)\\.?d\\b",
          "name": "constant.numeric.decimal.koskari"
        },
        {
          "match": "-?\\d+\\b",
          "name": "constant.numeric.integer.koskari"
        }
      ]
    },
    "collection-tuple": {
      "begin": "#\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.collection.begin.koskari" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.collection.end.koskari" }
      },
      "name": "meta.collection.tuple.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "collection-list": {
      "begin": "#\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.collection.begin.koskari" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.collection.end.koskari" }
      },
      "name": "meta.collection.list.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "collection-dict": {
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.collection.begin.koskari" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.collection.end.koskari" }
      },
      "name": "meta.collection.dict.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "paren-list": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.expression.begin.koskari" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.expression.end.koskari" }
      },
      "name": "meta.expression.paren.koskari",
      "patterns": [
        { "include": "#list-head-special" },
        { "include": "$self" }
      ]
    },
    "bracket-list": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.section.bracket.begin.koskari" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.bracket.end.koskari" }
      },
      "name": "meta.expression.bracket.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "brace-block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.block.begin.koskari" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.koskari" }
      },
      "name": "meta.expression.block.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "quote-form": {
      "begin": "(['])",
      "end": "(?=[\\s;()\\[\\]{\"'`]|$)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.quote.koskari" }
      },
      "name": "meta.quoted.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "quote-syntax-form": {
      "begin": "(#')",
      "end": "(?=[\\s;()\\[\\]{\"'`]|$)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.quote.syntax.koskari" }
      },
      "name": "meta.quoted.syntax.koskari",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "quasiquote-syntax-form": {
      "begin": "(#`)",
      "end": "(?=[\\s;()\\[\\]{\"'`]|$)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.quasiquote.syntax.koskari" }
      },
      "name": "meta.quasiquote.syntax.koskari",
      "patterns": [
        { "include": "#unquote" },
        { "include": "$self" }
      ]
    },
    "quasiquote-form": {
      "begin": "(`)",
      "end": "(?=[\\s;()\\[\\]{\"'`]|$)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.quasiquote.koskari" }
      },
      "name": "meta.quasiquote.koskari",
      "patterns": [
        { "include": "#unquote" },
        { "include": "$self" }
      ]
    },
    "unquote": {
      "patterns": [
        {
          "match": ",@(?=[^\\s;\"'`()\\[\\]{},])",
          "name": "keyword.operator.unquote-splicing.koskari"
        },
        {
          "match": ",(?=[^@\\s;\"'`()\\[\\]{},]|$)",
          "name": "keyword.operator.unquote.koskari"
        }
      ]
    },
    "list-head-special": {
      "match": "\\s*(zip|yield-from|yield|with|while|when-main|when|vars|values\\?|values|unquote-splicing|unquote|unpack|unless|unassigned\\?|type\\?|type|tuple\\?|tuple|try|truth|third|takeq|take-item|take-attr|take!|syntax-rules|syntax-match|symbol\\?|symbol|switch|super|sum|subclass\\?|str\\?|str|staticmethod\\?|staticmethod|special-rules|special-match|sorted|slice\\?|slice|sleep|shift|setq-values|setq|setattr|set\\?|set-item|set-cdr|set-car|set-attr|set!|set|second|reversed|return|reset|repr|refq|ref\\?|ref-item|ref-attr|ref|recursive\\?|range\\?|range|raise|quote|quasiquote|py-repr|py-help|property\\?|property|proper\\?|print|pragma|partial\\?|partial|parse-rule-patternq|parse-rule-pattern|parse-match-patternq|parse-match-pattern|parameterq|parameterize|parameter|pair\\?|pair|ord|or|open|on-demand\\?|object\\?|object|not-in\\?|not-in|not-equal\\?|not|nil\\?|nil|next|min|max|match|map|macroexpandq-1|macroexpandq|macroexpand-1|macroexpand|macro-rules|macro-match|lt\\?|locals|local|load-exception|list\\?|list-each|list|letrec|let/cc|let-values|let-syntax|let\\*|let|len|le\\?|lambda|labels|keyword\\?|keyword-block|keyword|iter|item-slice|item\\*|item|is\\?|is-not\\?|is-not|is|int\\?|int|instance\\?|input|inplace-item|inplace-attr|inplace|inline-macro|inline-block|incr!|in\\?|in|import-from|import-all-from|import|if|id|help-pragma-key|help|hasitem\\*|hash|hasattr\\?|hasattr\\*|has\\?|gt\\?|globals|global|getitem\\*|getattr\\*|getattr|gensym-thunk|gensym|ge\\?|function-compose|function|frozenset\\?|frozenset|fraction\\?|fraction|fourth|format|for-each|float\\?|float|flet|first|filter|fifth|extend-syntax|evaluate|equal\\?|enumerate|each|dyn-with|dyn-wind|divmod|dir|dict\\?|dict-each|dict|deref|demand\\?|demand-call|demand-apply|demand|delq|del-item|del-attr|del!|define-values|define-syntax|define-parameter|define-global|define-demanding|define-dataclass|define-coroutine|define-class|define|defer\\?|defer|default!|decr!|decorate|declare-exports|decimal\\?|decimal|datumq|datum\\?|datum|create-task|create-instance-check|coroutine-fn|continue|cons|cond|complex\\?|complex|compileq|compile|clear-exception|classmethod\\?|classmethod|class|chr|check-exception|cdr|cddr|cdddr|cddddr|car|capture/cc|callable\\?|call/cc|call-attr|call|cadr|caddr|cadddr|caddddr|bytes\\?|bytes|bytecode|build-syntax|build-special|build-slice|build-proper|build-macro|break|bracket-splice|bracket-nil|bracket-cons|bool\\?|bool|block-begin|block|bindq|bind!|begin|await|attr\\*|attr|apply-layouts|apply-layout|apply|any\\?|and|all\\?|aiter|abs)(?=(?:\\s|\\)|\\]|\\}|$))",
      "captures": {
        "1": { "name": "keyword.control.koskari" }
      }
    },
    "bare-line-call-head": {
      "match": "^(\\s*)(zip|yield-from|yield|with|while|when-main|when|vars|values\\?|values|unquote-splicing|unquote|unpack|unless|unassigned\\?|type\\?|type|tuple\\?|tuple|try|truth|third|takeq|take-item|take-attr|take!|syntax-rules|syntax-match|symbol\\?|symbol|switch|super|sum|subclass\\?|str\\?|str|staticmethod\\?|staticmethod|special-rules|special-match|sorted|slice\\?|slice|sleep|shift|setq-values|setq|setattr|set\\?|set-item|set-cdr|set-car|set-attr|set!|set|second|reversed|return|reset|repr|refq|ref\\?|ref-item|ref-attr|ref|recursive\\?|range\\?|range|raise|quote|quasiquote|py-repr|py-help|property\\?|property|proper\\?|print|pragma|partial\\?|partial|parse-rule-patternq|parse-rule-pattern|parse-match-patternq|parse-match-pattern|parameterq|parameterize|parameter|pair\\?|pair|ord|or|open|on-demand\\?|object\\?|object|not-in\\?|not-in|not-equal\\?|not|nil\\?|nil|next|min|max|match|map|macroexpandq-1|macroexpandq|macroexpand-1|macroexpand|macro-rules|macro-match|lt\\?|locals|local|load-exception|list\\?|list-each|list|letrec|let/cc|let-values|let-syntax|let\\*|let|len|le\\?|lambda|labels|keyword\\?|keyword-block|keyword|iter|item-slice|item\\*|item|is\\?|is-not\\?|is-not|is|int\\?|int|instance\\?|input|inplace-item|inplace-attr|inplace|inline-macro|inline-block|incr!|in\\?|in|import-from|import-all-from|import|if|id|help-pragma-key|help|hasitem\\*|hash|hasattr\\?|hasattr\\*|has\\?|gt\\?|globals|global|getitem\\*|getattr\\*|getattr|gensym-thunk|gensym|ge\\?|function-compose|function|frozenset\\?|frozenset|fraction\\?|fraction|fourth|format|for-each|float\\?|float|flet|first|filter|fifth|extend-syntax|evaluate|equal\\?|enumerate|each|dyn-with|dyn-wind|divmod|dir|dict\\?|dict-each|dict|deref|demand\\?|demand-call|demand-apply|demand|delq|del-item|del-attr|del!|define-values|define-syntax|define-parameter|define-global|define-demanding|define-dataclass|define-coroutine|define-class|define|defer\\?|defer|default!|decr!|decorate|declare-exports|decimal\\?|decimal|datumq|datum\\?|datum|create-task|create-instance-check|coroutine-fn|continue|cons|cond|complex\\?|complex|compileq|compile|clear-exception|classmethod\\?|classmethod|class|chr|check-exception|cdr|cddr|cdddr|cddddr|car|capture/cc|callable\\?|call/cc|call-attr|call|cadr|caddr|cadddr|caddddr|bytes\\?|bytes|bytecode|build-syntax|build-special|build-slice|build-proper|build-macro|break|bracket-splice|bracket-nil|bracket-cons|bool\\?|bool|block-begin|block|bindq|bind!|begin|await|attr\\*|attr|apply-layouts|apply-layout|apply|any\\?|and|all\\?|aiter|abs)(?=(?:\\s|\\)|\\]|\\}|$))",
      "captures": {
        "2": { "name": "keyword.control.koskari" }
      }
    },
    "block-header": {
      "patterns": [
        {
          "match": "^(\\s*)(with|while|when-main|when|try|syntax-rules|syntax-match|switch|special-rules|special-match|shift|reset|match|macro-rules|macro-match|import-from|if|for-each|finally|extend-syntax|except|else|elif|dyn-with|dyn-wind|define-syntax|define-dataclass|define-coroutine|define-class|define|class|call|begin)\\b([^\\n]*?)(:)\\s*(;.*)?$",
          "captures": {
            "2": { "name": "keyword.control.koskari" },
            "3": { "name": "meta.block-header-args.koskari" },
            "4": { "name": "punctuation.terminator.block.koskari" }
          }
        },
        {
          "match": "^(\\s*)([a-zA-Z_][a-zA-Z0-9_?!-]*)\\b([^\\n]*?)(:)\\s*(;.*)?$",
          "captures": {
            "2": { "name": "entity.name.function.koskari" },
            "3": { "name": "meta.block-header-args.koskari" },
            "4": { "name": "punctuation.terminator.block.koskari" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": ":(?:[^\\s()\\[\\]{};\"'`]|\\\\[\"'\\\\abfnrtv]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})+(?=[\\s()\\[\\]{};\"'`]|$)",
          "name": "constant.other.keyword.koskari"
        },
        {
          "match": "(?:[^\\s()\\[\\]{};\"'`]|\\\\[\"'\\\\abfnrtv]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})+:(?=[\\s()\\[\\]{};\"'`]|$)",
          "name": "constant.other.keyword.koskari"
        }
      ]
    },
    "symbol": {
      "match": "[a-zA-Z_][a-zA-Z0-9_?!*+<=>-]*|[!$%&*+\\-./:<=>?@^_~]",
      "name": "meta.symbol.koskari"
    }
  }
}