"""
opgrams -- opcode n-gram frequency analysis over compiled Koskari code.

Imports a group of modules (the bootstrap builtins, the CLI, the churn
benchmark kernels, the life example, the developer tools), collects
every reachable Code object, softens each back to its symbolic
instruction stream, and counts 2..4-opcode sequences within
straight-line runs. Sequences never cross a jump target (LABEL) and
never continue past a branching or terminal opcode, so every reported
n-gram is a candidate for opcode fusion. POSITION and NOOP rows are
transparent.

Counts are reported both raw (emission frequency) and weighted by static
loop-nesting depth (weight = BASE ** depth), the latter approximating
execution frequency. A Markov successor table shows, per opcode, where
control usually flows next -- an opcode with one dominant successor is a
fusion candidate even at modest absolute counts.

Run from the repository root:

    tox -qe opgrams
    tox -qe opgrams -- --group churn --top 30
    uv run python -B -m koskari tools/tools.ki -- opgrams --group churn --dis

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import importlib
import json
import sys
import types

import-from argparse ArgumentParser
import-from collections Counter defaultdict
import-from os.path abspath basename dirname join

import-from koskari.lib BoundMethod Code Expression Function OpCode OpStyle
import-from koskari.lib demand
import-from koskari.syntax Syntax


define TOPDIR (dirname (dirname (abspath __file__)))

define MODULE_GROUPS #{
    "bootstrap": #("koskari.builtins")

    "modules": #(
        "koskari.cli.launch"
        "koskari.cli.repl"
        "koskari.dis"
        "koskari.help"
        "koskari.help.layout"
        "koskari.help.syntax"
        "koskari.help.tools"
        "koskari.solve")

    "life": #(
        "koslife.cli"
        "koslife.curse"
        "koslife.life")

    "churn": #(
        "ki.binary_trees"
        "ki.branch"
        "ki.fannkuch"
        "ki.field"
        "ki.field_slots"
        "ki.list_each"
        "ki.loop"
        "ki.match_case"
        "ki.method"
        "ki.nbody"
        "ki.pidigits"
        "ki.starmap"
        "ki.tree"
        "ki.yieldfrom")

    ; The developer tools: string, dict, path, and argparse work, a
    ; different opcode mix from the numeric churn kernels. Importing
    ; tools.corpus.quick pulls in tests.corpus, which is why this group
    ; costs more to load than the others.
    "tools": #(
        "tools.tools"
        "tools.opgrams"
        "tools.matchbench"
        "tools.editor_tokens.regen"
        "tools.corpus.load"
        "tools.corpus.export"
        "tools.corpus.quick"
        "tools.corpus.views"
        "tools.corpus.views._material"
        "tools.corpus.views.docs"
        "tools.corpus.views.full"
        "tools.corpus.views.programs")}

; Terminal opcodes with no label argument: control leaves the straight
; line here, so no sequence may continue past them. Ops that carry a
; label argument (jumps, checks, switches, iteration) are detected from
; opcode metadata instead of being listed.
define TERMINAL_OPS #(
    "RETURN" "RAISE" "BREAK" "CONTINUE"
    "YIELD" "YIELD_FROM" "AWAIT"
    "TAIL_CALL" "TAIL_CALL_NAMES" "TAIL_CALL_STAR"
    "THEEND")

define LOOP_PUSH_OPS (frozenset #("PUSH_LOOP" "PUSH_FOREACH"))

define LOOP_POP_OPS (frozenset #("POP_LOOP" "POP_FOREACH"))

define TRANSPARENT_OPS (frozenset #("POSITION" "NOOP"))

; Groups whose modules live outside the installed package join sys.path
; from these repository-relative directories.
define GROUP_PATHS #{
    "churn": (join TOPDIR "examples" "churn")
    "life": (join TOPDIR "examples" "life")
    "tools": TOPDIR}


define build_block_enders []:
    """
    Compute the set of opcode names that end a straight-line run: any
    opcode with a LABEL field in its argument schema, plus the terminal
    set. Computed from OpCode metadata so new branching opcodes are
    picked up automatically.
    """

    define enders:
        list-each [op OpCode]:
            when (or (== op.style OpStyle.LABEL)
                     (has? op.extra OpStyle.LABEL)):
                op.name

    enders.extend TERMINAL_OPS
    frozenset enders


define unwrap_code [obj]:
    """
    Return the Code behind a collectable object, or None. Accepts Code,
    Expression, Function, demand-wrapped Function, and BoundMethod.
    """

    when (instance? obj demand):
        set! obj (getattr obj "__wrapped__" None)

    when (instance? obj BoundMethod):
        set! obj obj.__func__
        when (instance? obj demand):
            set! obj (getattr obj "__wrapped__" None)

    if (instance? obj Function):
        obj.code
    elif (instance? obj Expression):
        obj.code
    elif (instance? obj Code):
        obj
    else:
        None


define closure_codes [fn]:
    """
    Yield Code objects captured in a Python function's closure cells.
    Macro handlers arrive as Python lambdas closing over the compiled
    Koskari body (MacroTransform.handler cell 'raw').
    """

    for-each [cell (or fn.__closure__ #())]:
        try:
            define val cell.cell_contents

        except [ValueError]:
            (continue)

        define code (unwrap_code val)
        when code:
            yield code


define syntax_codes [label syn]:
    """
    Walk a Syntax object's transformers for code-bearing attributes.
    Macro-based syntax carries its body as a Function behind the
    transform's handler; syntax-rules templates and Python specials
    contribute nothing.
    """

    local members

    for-each [[i transform] (enumerate syn.transforms)]:
        set! members (getattr transform "__dict__" None)
        unless members:
            (continue)

        for-each [[key val] (members.items)]:
            define code (unwrap_code val)
            if code:
                yield #(f"{label}[{i}].{key}" code)

            elif (instance? val types.FunctionType):
                for-each [inner (closure_codes val)]:
                    yield #(f"{label}[{i}].{key}" inner)


define collect_codes [modules]:
    """
    Walk module namespaces for code-bearing objects, then recurse into
    each Code's constant pool for nested Code objects (closures, class
    bodies). Syntax objects are walked through their transformers to
    catch macro bodies. Returns (label, Code) pairs, deduplicated by
    identity.
    """

    define seen (set)
    define found #[]
    define stack #[]

    for-each [mod modules]:
        for-each [[key val] (sorted ((vars mod).items))]:
            when (key.startswith "__"):
                (continue)

            define label f"{mod.__name__}.{key}"
            if (instance? val Syntax):
                (stack.extend (syntax_codes label val))
            else:
                define code (unwrap_code val)
                when (not (None? code)):
                    (stack.append #(label code))

    while stack:
        define-values [label code] (stack.pop 0)
        when (in? (id code) seen):
            (continue)
        (seen.add (id code))
        (found.append #(label code))

        for-each [[i val] (enumerate code.constants_pool)]:
            define nested (unwrap_code val)
            when (and (instance? nested Code) (not-in? (id nested) seen)):
                define nested_name (or nested.name f"c#{i}")
                (stack.append #(f"{label}/{nested_name}" nested))

    return found


define iter_blocks [code enders]:
    """
    Soften code and yield straight-line runs as lists of (op_name,
    loop_depth) pairs. A run starts fresh at every LABEL and stops after
    any block-ending opcode; POSITION and NOOP are transparent. Loop
    depth follows PUSH_LOOP/PUSH_FOREACH nesting in textual order.

    :param enders: the block-ending opcode names, from
        :func:`build_block_enders`
    """

    define depth 0
    define block #[]

    for-each [[op_int _arg] (code.soften)]:
        define op (OpCode op_int)
        define name op.name

        if (== name "LABEL"):
            when block:
                yield block
            set! block #[]
            (continue)

        elif (in? name TRANSPARENT_OPS):
            (continue)

        elif (in? name LOOP_PUSH_OPS):
            incr! depth

        elif (and (in? name LOOP_POP_OPS) (> depth 0)):
            decr! depth

        (block.append #(name depth))

        when (in? name enders):
            yield block
            set! block #[]

    when block:
        yield block


define-class GramTally []:
    """
    Accumulates raw and depth-weighted n-gram counts, exemplar
    locations, and the bigram successor table.
    """

    define __init__ [self sizes weight_base]:
        set! self.sizes sizes
        set! self.weight_base weight_base
        set! self.raw (dict (list-each [n sizes] #(n (Counter))))
        set! self.weighted (dict (list-each [n sizes] #(n (Counter))))
        set! self.exemplar #{}
        set! self.successors (defaultdict Counter)
        set! self.op_counts (Counter)
        set! self.code_count 0
        set! self.block_count 0

    define feed [self label block]:
        incr! self.block_count
        define names (list-each [entry block] entry[0])

        for-each [name names]:
            incr! self.op_counts[name]

        for-each [[prev succ] (zip names (item-slice names 1))]:
            define bucket self.successors[prev]
            incr! bucket[succ]

        for-each [n self.sizes]:
            define raw_counts self.raw[n]
            define weighted_counts self.weighted[n]
            for-each [i (range (+ (- (len block) n) 1))]:

                define gram (tuple (item-slice names i (+ i n)))

                define weight (** self.weight_base block[i][1])

                incr! raw_counts[gram]
                incr! weighted_counts[gram] weight
                unless (in? gram self.exemplar):
                    set! self.exemplar[gram] label


define analyze [codes sizes weight_base enders]:
    """
    Run the n-gram tally over every collected code object
    """

    define tally (GramTally sizes weight_base)

    for-each [[label code] codes]:
        incr! tally.code_count
        for-each [block (iter_blocks code enders)]:
            (tally.feed label block)

    return tally


define print_gram_tables [tally top file]:
    """
    Write the weighted n-gram tables for every configured size
    """

    define pad12 (* " " 12)
    define pad6 (* " " 6)

    for-each [n tally.sizes]:
        define weighted tally.weighted[n]
        (file.write
            f"\n=== top {n}-grams (weighted, base {tally.weight_base}) ===\n")

        for-each [[gram wcount] (weighted.most_common top)]:
            define raw tally.raw[n][gram]
            define seq (" ".join gram)
            define exemplar tally.exemplar[gram]
            file.write f"  {wcount:>12}  {raw:>6}  {seq}\n"
            file.write f"  {pad12}  {pad6}    e.g. {exemplar}\n"


define print_markov [tally threshold file]:
    """
    Write the per-opcode successor distribution table
    """

    (file.write
        f"\n=== successor distribution"-
        f" (ops emitted >= {threshold} times) ===\n")

    for-each [[op count] (tally.op_counts.most_common)]:
        when (< count threshold):
            (break)

        define succs tally.successors[op]
        define total (sum (succs.values))
        unless total:
            (continue)

        define parts:
            list-each [[succ scount] (succs.most_common 4)]:
                define pct (/ (* 100.0 scount) total)
                f"{succ} {pct:.0f}%"

        define joined (", ".join parts)
        file.write f"  {op:<24} x{count:<7} -> {joined}\n"


define print_opcounts [tally file]:
    """
    Write the full per-opcode emission count table: every emitted
    opcode with its count, then the never-emitted remainder of the
    enum in opcodes.incl order
    """

    (file.write "\n=== opcode emission counts (full enum) ===\n")

    for-each [[op count] (tally.op_counts.most_common)]:
        file.write f"  {op:<24} x{count}\n"

    define missing #[]
    for-each [op (list OpCode)]:
        unless (in? op.name tally.op_counts):
            (missing.append op.name)

    file.write f"\n  never emitted ({(len missing)}):\n"
    for-each [name missing]:
        file.write f"    {name}\n"


define tally_to_json [tally top]:
    """
    Render the tally as a JSON-serializable mapping
    """

    define grams #{}
    for-each [n tally.sizes]:
        set! grams[(str n)]:
            list-each [[gram wcount] (tally.weighted[n].most_common top)]:
                #{"seq": (list gram)
                  "weighted": wcount
                  "raw": tally.raw[n][gram]
                  "exemplar": tally.exemplar[gram]}

    define successors #{}
    for-each [[op succs] (tally.successors.items)]:
        set! successors[op] (dict (succs.most_common))

    define op_counts #{}
    for-each [op (list OpCode)]:
        set! op_counts[op.name] (tally.op_counts.get op.name 0)

    #{"codes": tally.code_count
      "blocks": tally.block_count
      "weight_base": tally.weight_base
      "grams": grams
      "successors": successors
      "op_counts": op_counts}


define load_group [group]:
    """
    Import and return the modules for a named group. Groups that live
    outside the installed package get their directory on sys.path first.
    """

    define extra_path (GROUP_PATHS.get group)
    when (and extra_path (not-in? extra_path sys.path)):
        sys.path.insert 0 extra_path

    list-each [name MODULE_GROUPS[group]]:
        (importlib.import_module name)


define build_arguments [parser]:
    """
    Register the opgrams options on a parser or subparser
    """

    (parser.add_argument "--group"
        choices: (+ (list MODULE_GROUPS) #["all"]) default: "all"
        help: "module group to analyze (default: all groups)")
    (parser.add_argument "--top"
        type: int default: 25
        help: "rows per n-gram table (default: 25)")
    (parser.add_argument "--weight-base"
        type: int default: 100
        help: "per-loop-depth weight multiplier (default: 100)")
    (parser.add_argument "--markov-threshold"
        type: int default: 20
        help: "min emission count for the successor table (default: 20)")
    (parser.add_argument "--json"
        action: "store_true"
        help: "emit the report as JSON instead of text")
    (parser.add_argument "--dis"
        action: "store_true"
        help: "print full disassembly of each collected code object")
    return parser


define run [options]:
    """
    Execute the analysis described by parsed options

    :param options: parsed argument namespace
    :return: integer exit code
    """

    define groups (if (== options.group "all")
        (list MODULE_GROUPS)
        #[options.group])

    define modules #[]
    for-each [group groups]:
        modules.extend (load_group group)

    define enders (build_block_enders)
    define codes (collect_codes modules)

    when options.dis:
        import-from koskari.dis dis
        for-each [[label code] codes]:
            print f"--- {label} ---"
            (dis code)
        return 0

    define tally (analyze codes #(2 3 4) options.weight_base enders)

    when options.json:
        (json.dump (tally_to_json tally options.top) sys.stdout indent: 2)
        (print)
        return 0

    define joined (", ".join groups)
    (print
        f"codes: {tally.code_count}"-
        f"   blocks: {tally.block_count}"-
        f"   groups: {joined}")
    (print_gram_tables tally options.top sys.stdout)
    (print_markov tally options.markov_threshold sys.stdout)
    (print_opcounts tally sys.stdout)
    return 0


define main [argv: None]:
    """
    Parse arguments and run the analysis

    :param argv: optional argument vector; defaults to sys.argv
    :return: integer exit code
    """

    when (None? argv):
        set! argv sys.argv

    define-values [name *: args] argv

    define parser (ArgumentParser
        prog: (basename name)
        description: "Opcode n-gram frequency analysis over Koskari code")

    build_arguments parser
    run (parser.parse_args args)


when-main:
    (sys.exit (main))


; The end.
