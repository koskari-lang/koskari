"""
matchbench -- matcher and match/case micro-benchmarks.

Three tiers of timing cells over the one matcher:

  engine-*   matcher functions built ahead of the run, called from
             koskari -- hit and miss paths per node family
  syntax-*   one matcher over a let form, and a three-arm Syntax
             trying each arm's matcher in order
  match-*    compiled koskari match functions -- the arm chain of
             MATCH_* instructions inline, captures into fast slots
  anchor-*   the same 8-way literal dispatch as match, switch, and
             cond -- the ratios that say when matching taxes matter

Methodology follows examples/churn: a uniform harness loop, an
empty-cell baseline subtracted from every measurement, and a warmup
pass so every matcher's function is compiled before timing. Numbers
are machine-relative; compare before/after on one machine, not across.

Run from the repository root:

    tox -qe matchbench
    tox -qe matchbench -- --iterations 50000 --json
    tox -qe matchbench -- engine-seq-hit anchor-match anchor-switch

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import json
import sys

import-from argparse ArgumentParser
import-from dataclasses dataclass
import-from os.path basename
import-from time perf_counter

import-from koskari.matcher:
    APP BODY BINDINGS CAPTURE CLASS FIELD FORM LITERAL MAP MAP_ENTRY
    MATCH ONEOF PREDICATE SYMBOL make_matcher
import-from koskari.syntax SpecialTransform Syntax


;; === fixtures ===


@dataclass
class Point []:
    var x :: int 0
    var y :: int 0


var SUBJ_SEQ3 #(#(1 2 3))
var SUBJ_SEQ2 #(#(1 2))
var SUBJ_PT #((Point 3 4))
var SUBJ_STR #("not-a-point")
var SUBJ_MAP #(#{"kind": "job" "url": "http://x"})
var SUBJ_TUP #(#(1 2))
var SUBJ_SEVEN #(7)

var M_SEQ (make_matcher
    (MATCH (FORM (MATCH (CAPTURE "a") (CAPTURE "b") (CAPTURE "c")))))

var M_CLS (make_matcher
    (MATCH (CLASS "Point"
        (FIELD (CAPTURE "a"))
        (FIELD (CAPTURE "b"))))
    #{"Point": Point})

var M_MAP (make_matcher
    (MATCH (MAP
        (MAP_ENTRY "kind" (LITERAL "job"))
        (MAP_ENTRY "url" (CAPTURE "u")))))

var M_ONEOF (make_matcher
    (MATCH (ONEOF
        (LITERAL 0) (LITERAL 1) (LITERAL 2) (LITERAL 3)
        (LITERAL 4) (LITERAL 5) (LITERAL 6) (LITERAL 7))))

var M_SYNTAX (make_matcher
    (MATCH (SYMBOL "head") (BINDINGS "bindings") (BODY "body")))

var FORM_LET '(mylet [[x 1] [y 2]] (+ x y))

def syntax-arm [compiler source result]:
    None

;; a syntax of three arms, the let shape last: the syntax tries each
;; arm's matcher in order
var S_SYNTAX (Syntax "mylet" #(
    (SpecialTransform (MATCH (SYMBOL "head") (LITERAL 0)) syntax-arm)
    (SpecialTransform (MATCH (SYMBOL "head") (SYMBOL "only")) syntax-arm)
    (SpecialTransform
        (MATCH (SYMBOL "head") (BINDINGS "bindings") (BODY "body"))
        syntax-arm)))

def ki-pred [v]:
    True

def ki-extract [v]:
    v

var M_PRED_PY (make_matcher (MATCH (PREDICATE "p")) #{"p": bool})

var M_PRED_KI (make_matcher (MATCH (PREDICATE "p")) #{"p": ki-pred})

var M_APP_PY (make_matcher (MATCH (APP "f" (CAPTURE "x"))) #{"f": abs})

var M_APP_KI (make_matcher
    (MATCH (APP "f" (CAPTURE "x")))
    #{"f": ki-extract})


;; === statement-tier consumers ===


def m8 [v]:
    match v:
        case 0:
            "a0"
        case 1:
            "a1"
        case 2:
            "a2"
        case 3:
            "a3"
        case 4:
            "a4"
        case 5:
            "a5"
        case 6:
            "a6"
        case 7:
            "a7"
        else:
            "meh"


def m-guarded [v]:
    match v:
        case x :: int when (> x 5):
            "big"
        case x :: int:
            "small"
        else:
            "other"


def m-externs [v]:
    match v:
        case x :: float:
            "float"
        case x :: bytes:
            "bytes"
        case x :: str:
            "str"
        case x :: int:
            "int"
        else:
            "other"


def s8 [v]:
    switch v:
        case [0]:
            "a0"
        case [1]:
            "a1"
        case [2]:
            "a2"
        case [3]:
            "a3"
        case [4]:
            "a4"
        case [5]:
            "a5"
        case [6]:
            "a6"
        case [7]:
            "a7"
        else:
            "meh"


def c8 [v]:
    cond:
        [(== v 0) "a0"]
        [(== v 1) "a1"]
        [(== v 2) "a2"]
        [(== v 3) "a3"]
        [(== v 4) "a4"]
        [(== v 5) "a5"]
        [(== v 6) "a6"]
        [(== v 7) "a7"]
        [else: "meh"]


;; === cells ===


def cell-noop []:
    None


def cell-engine-seq-hit []:
    (M_SEQ SUBJ_SEQ3)

def cell-engine-seq-miss []:
    (M_SEQ SUBJ_SEQ2)

def cell-engine-class-hit []:
    (M_CLS SUBJ_PT)

def cell-engine-class-miss []:
    (M_CLS SUBJ_STR)

def cell-engine-map-hit []:
    (M_MAP SUBJ_MAP)

def cell-engine-map-miss []:
    (M_MAP SUBJ_TUP)

def cell-engine-oneof-backtrack []:
    (M_ONEOF SUBJ_SEVEN)

def cell-engine-pred-py []:
    (M_PRED_PY SUBJ_SEVEN)

def cell-engine-pred-ki []:
    (M_PRED_KI SUBJ_SEVEN)

def cell-engine-app-py []:
    (M_APP_PY SUBJ_SEVEN)

def cell-engine-app-ki []:
    (M_APP_KI SUBJ_SEVEN)

def cell-syntax-dispatch []:
    (M_SYNTAX FORM_LET)

def cell-syntax-select []:
    (S_SYNTAX.match_transformer FORM_LET)

def cell-match-first-arm []:
    (m8 0)

def cell-match-last-arm []:
    (m8 7)

def cell-match-else []:
    (m8 99)

def cell-match-guarded []:
    (m-guarded 9)

def cell-match-externs []:
    (m-externs 7)

;; deliberately the same call as cell-match-last-arm: the anchor tier
;; re-reports it beside switch and cond so the ratio rows read together
def cell-anchor-match []:
    (m8 7)

def cell-anchor-switch []:
    (s8 7)

def cell-anchor-cond []:
    (c8 7)


var CELLS #(
    #("engine-seq-hit" cell-engine-seq-hit)
    #("engine-seq-miss" cell-engine-seq-miss)
    #("engine-class-hit" cell-engine-class-hit)
    #("engine-class-miss" cell-engine-class-miss)
    #("engine-map-hit" cell-engine-map-hit)
    #("engine-map-miss" cell-engine-map-miss)
    #("engine-oneof-backtrack" cell-engine-oneof-backtrack)
    #("engine-pred-py" cell-engine-pred-py)
    #("engine-pred-ki" cell-engine-pred-ki)
    #("engine-app-py" cell-engine-app-py)
    #("engine-app-ki" cell-engine-app-ki)
    #("syntax-dispatch" cell-syntax-dispatch)
    #("syntax-select" cell-syntax-select)
    #("match-first-arm" cell-match-first-arm)
    #("match-last-arm" cell-match-last-arm)
    #("match-else" cell-match-else)
    #("match-guarded" cell-match-guarded)
    #("match-externs" cell-match-externs)
    #("anchor-match" cell-anchor-match)
    #("anchor-switch" cell-anchor-switch)
    #("anchor-cond" cell-anchor-cond))


;; === harness ===


def time-loop [fn n]:
    """
    Time n calls of fn under the uniform harness loop; returns seconds
    """

    var t0 (perf_counter)
    for-each [_i (range n)]:
        (fn)
    var t1 (perf_counter)
    (- t1 t0)


def run-cells [names iterations]:
    """
    Warm up, measure the baseline, then time each selected cell.

    :param names: cell names to run, or None for all
    :param iterations: harness loop count per cell
    :return: list of #(name ns-per-op) rows, baseline-subtracted
    """

    var selected (list)
    for-each [[cname cfn] CELLS]:
        when (or (None? names) (in? cname names)):
            (selected.append #(cname cfn))

    ; warmup: build each cell's match functions, fill the caches of
    ; the instructions they run, and stabilize
    for-each [[cname cfn] selected]:
        (time-loop cfn 100)

    (time-loop cell-noop 100)
    var baseline (time-loop cell-noop iterations)

    var rows (list)
    for-each [[cname cfn] selected]:
        var secs (time-loop cfn iterations)
        var nsop (/ (* (- secs baseline) 1e9) iterations)
        (rows.append #(cname nsop))
    rows


def report-text [rows iterations]:
    """
    Print the per-cell table and the anchor ratios
    """

    print f"matchbench: {iterations} iterations/cell, baseline-subtracted"
    print ""
    var found (dict)
    for-each [[cname nsop] rows]:
        (found.__setitem__ cname nsop)
        print f"  {(cname.ljust 24)} {nsop:10.1f} ns/op"
    var am (found.get "anchor-match")
    var asw (found.get "anchor-switch")
    var ac (found.get "anchor-cond")
    when (and am asw):
        print ""
        print f"  match/switch ratio: {(/ am asw):.2f}x"
    when (and am ac):
        print f"  match/cond ratio:   {(/ am ac):.2f}x"
    return 0


def report-json [rows iterations]:
    """
    Emit the rows as a JSON object on stdout
    """

    var cells (dict)
    for-each [[cname nsop] rows]:
        (cells.__setitem__ cname nsop)
    var payload #{
        "iterations": iterations
        "unit": "ns/op"
        "cells": cells}
    print (json.dumps payload indent: 2 sort_keys: True)
    return 0


;; === entry points ===


def build_arguments [parser]:
    """
    Register the matchbench options on a parser or subparser
    """

    (parser.add_argument "cells" nargs: "*"
        help: "cell names to run (default: all)")
    (parser.add_argument "--iterations"
        type: int default: 10000
        help: "harness loop count per cell (default: 10000)")
    (parser.add_argument "--json"
        action: "store_true"
        help: "emit the report as JSON instead of text")
    return parser


def run [options]:
    """
    Run the selected cells and report

    :param options: parsed argparse namespace
    :return: integer exit code
    """

    var names (or options.cells None)
    var rows (run-cells names options.iterations)
    if options.json:
        (report-json rows options.iterations)
    else:
        (report-text rows options.iterations)
    return 0


@entry-point
def main [argv: None]:
    """
    Parse arguments and run the benchmark

    :param argv: optional argument vector; defaults to sys.argv
    :return: integer exit code
    """

    when (None? argv):
        set! argv sys.argv

    var [name *: args] argv

    var parser (ArgumentParser
        prog: (basename name)
        description: "Matcher and match/case micro-benchmarks")

    build_arguments parser
    run (parser.parse_args args)


; The end.
