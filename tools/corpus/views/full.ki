"""
tools.corpus.views.full

koskari-corpus dataset view: every record with all verify stages.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


define VIEW_NAME "koskari-corpus"

define _STAGES #("read" "expand" "eval" "error" "invalid")


@demand
define transform [record provenance]:
    """
    Build one koskari-corpus row from a corpus record

    :param record: parsed corpus record dict
    :param provenance: dict with schema_version and git_ref keys
    :return: row dict for every record
    """

    define verify (or (record.get "verify") #{})

    define row #{
        "corpus_id": record["id"]
        "feature": record["feature"]
        "source": record["source"]
        "references": (or (record.get "references") #[])
        "stability": (record.get "stability")
        "tags": (or (record.get "tags") #[])
        "schema_version": provenance["schema_version"]
        "git_ref": provenance["git_ref"]
    }

    for-each [stage _STAGES]:
        set! row[stage] (verify.get stage)

    return row


; The end.
