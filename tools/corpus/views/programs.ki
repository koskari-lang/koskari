"""
tools.corpus.views.programs

koskari-programs dataset view: example programs served to agents.

One row per Koskari source file and README under examples/, giving
agents composition-level material (whole programs) rather than
single-construct snippets. Unlike the corpus, these rows are
ILLUSTRATIVE and NOT verified; the dataset card labels the config
accordingly.

The same whole-file/Viewer-truncation caveat documented in docs.ki
applies to the ``content`` column here.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from pathlib Path

import-from tools.corpus.views._material:
    ki_title_summary
    markdown_title_summary
    rewrite_markdown_links


define VIEW_NAME "koskari-programs"

define _INCLUDE_SUFFIXES #(".ki")
define _INCLUDE_NAMES #("README.md")


define _is_build_artifact [rel_parts]:
    """
    Return True when a path passes through a build output directory

    :param rel_parts: path components relative to the repository root
    :return: True when any component is a build directory
    """

    return (in? "build" rel_parts)


define _section [rel_parts]:
    """
    Return the example group for a repo-relative path

    :param rel_parts: path components relative to the repository root
    :return: the top-level example group (e.g. examples/life)
    """

    when (> (len rel_parts) 2):
        return ("/".join (item-slice rel_parts 0 2))
    return rel_parts[0]


define _included [path]:
    """
    Return True when a file should be published as a program row

    :param path: candidate file path
    :return: True for Koskari sources and example READMEs
    """

    return (or (in? path.suffix _INCLUDE_SUFFIXES)
               (in? path.name _INCLUDE_NAMES))


@demand
define generate [root provenance]:
    """
    Build koskari-programs rows from files under examples/

    :param root: repository root path
    :param provenance: dict with schema_version and git_ref keys
    :return: list of row dicts sorted by path
    """

    define root_path (Path root)
    define examples_dir (root_path.joinpath "examples")

    define rows #[]
    unless (examples_dir.is_dir):
        return rows

    for-each [path (examples_dir.rglob "*")]:
        unless (and (path.is_file) (_included path)):
            (continue)

        ; Bound rather than written (.parts ...): parts is a property, and
        ; the leading-dot form would call the tuple it returns.
        define relative (path.relative_to root_path)
        define rel_parts relative.parts
        when (_is_build_artifact rel_parts):
            (continue)

        define text (path.read_text encoding: "utf-8")
        define rel_path (relative.as_posix)
        define title None
        define summary None
        if (== path.suffix ".ki"):
            define-values [kt ks] (ki_title_summary text path.stem)
            set! title kt
            set! summary ks
        else:
            set! text (rewrite_markdown_links text rel_path)
            define-values [mt ms] (markdown_title_summary text)
            set! title (or mt path.stem)
            set! summary ms

        rows.append #{
            "path": rel_path
            "title": title
            "summary": summary
            "content": text
            "section": (_section rel_parts)
            "kind": "example"
            "schema_version": provenance["schema_version"]
            "git_ref": provenance["git_ref"]
        }

    rows.sort key: (itemgetter "path")
    return rows


; The end.
