"""
tools.corpus.views

Registry of corpus dataset view transforms.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from importlib import_module


; Imported as modules rather than by name: each view module exports its
; own VIEW_NAME, so importing the names directly would collide.
define _full (import_module "tools.corpus.views.full")
define _docs (import_module "tools.corpus.views.docs")
define _programs (import_module "tools.corpus.views.programs")


; Record-mapped views: each value is a transform(record, provenance)
; callable applied once per corpus record.
define VIEWS (dict)
(set-item VIEWS _full.VIEW_NAME _full.transform)


; Source-generated views: each value is a generate(root, provenance)
; callable that produces rows from repository files rather than from
; corpus records. These publish reference material (docs, example
; programs) that is not part of the verified corpus.
define SOURCE_VIEWS (dict)
(set-item SOURCE_VIEWS _docs.VIEW_NAME _docs.generate)
(set-item SOURCE_VIEWS _programs.VIEW_NAME _programs.generate)


; The end.
