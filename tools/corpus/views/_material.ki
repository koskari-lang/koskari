"""
tools.corpus.views._material

Text helpers for the reference-material views (docs, programs).

Title and summary extraction are best-effort heuristics used only to
populate the ``title`` and ``summary`` columns. Link rewriting
(:func:`rewrite_markdown_links`) normalizes relative Markdown links in
the ``content`` column so an agent reading a stored page can resolve a
link straight through the MCP ``get_reference`` tool.

The public helpers are ``@demand``-wrapped: they are called both from
Koskari views and directly from Python tests, and a bare Koskari
callable would hand a coroutine back to a Python caller.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import posixpath
import re


var _LINK_RE (re.compile "\\[([^\\]]+)\\]\\([^)]*\\)")
var _EMPHASIS_RE (re.compile "[*_`]+")

var _LICENSE_MARKERS #(
    "redistribute"
    "without any warranty"
    "free software foundation"
    "general public license"
    "gnu "
    "see <http"
    "copyright")

var _HEADING_RE (re.compile "#+\\s+(.*)")
var _MD_LINK_RE (re.compile "(!?\\[[^\\]]*\\]\\()([^)]+)(\\))")
var _SCHEME_RE (re.compile "[A-Za-z][A-Za-z0-9+.-]*:")
var _TITLE_RE (re.compile "(\\S+)(\\s+[\"'].*)\\Z")
var _TOCTREE_TITLE_RE (re.compile "(.*<)([^>]+)(>)\\Z")
var _GLOB_CHARS (frozenset "*?[]")


def _clean_inline [text]:
    """
    Strip common inline Markdown so a summary reads as plain prose

    :param text: raw line or paragraph text
    :return: cleaned single-line text
    """

    set! text (_LINK_RE.sub "\\1" text)
    set! text (_EMPHASIS_RE.sub "" text)
    " ".join (text.split)


def _strip_frontmatter [lines]:
    """
    Drop a leading YAML frontmatter block delimited by ``---`` lines

    :param lines: list of source lines
    :return: lines with any leading frontmatter removed
    """

    when (and lines (== (lines[0].strip) "---")):
        for-each [index (range 1 (len lines))]:
            when (== (lines[index].strip) "---"):
                return (item-slice lines (+ index 1))
    return lines


@demand
def markdown_title_summary [text]:
    """
    Extract a heading title and first-paragraph summary from Markdown

    :param text: raw Markdown document text
    :return: tuple of (title or None, summary or None)
    """

    var lines (_strip_frontmatter (text.splitlines))

    var title None
    for-each [line lines]:
        var match (_HEADING_RE.match line)
        when match:
            set! title (_clean_inline (match.group 1))
            (break)

    var summary None
    var in_fence False
    var paragraph #[]

    for-each [line lines]:
        var stripped (line.strip)
        if (stripped.startswith "```"):
            set! in_fence (not in_fence)
        elif in_fence:
            (continue)
        elif (or (stripped.startswith "#") (not stripped)):
            when paragraph:
                (break)
        else:
            (paragraph.append stripped)

    when paragraph:
        set! summary (_clean_inline (" ".join paragraph))

    return title summary


def _normalize_link_target [dest base_dir]:
    """
    Resolve one Markdown link destination to a root-relative path

    Rewrites a repo-internal relative link (possibly containing ``../``)
    into a path rooted at the view's content tree, matching the scheme
    used by the row ``path`` column. External links, ``mailto:``, pure
    ``#anchor`` fragments, site-absolute paths, and links that escape the
    tree are left unchanged.

    :param dest: raw destination text from inside the link parentheses
    :param base_dir: directory of the linking file, as a root-relative
        posix path
    :return: the rewritten destination, or None to leave it unchanged
    """

    var stripped (dest.strip)
    unless stripped:
        return None

    var title ""
    var target stripped
    var match (_TITLE_RE.match stripped)
    when match:
        set! target (match.group 1)
        set! title (match.group 2)

    when (and (target.startswith "<") (target.endswith ">")):
        set! target (item-slice target 1 -1)

    when (or (_SCHEME_RE.match target)
             (in? (item-slice target 0 1) #("#" "/"))):
        return None

    var fragment ""
    var hash_index (target.find "#")
    when (>= hash_index 0):
        set! fragment (item-slice target hash_index)
        set! target (item-slice target 0 hash_index)

    unless target:
        return None

    var resolved (posixpath.normpath (posixpath.join base_dir target))
    when (resolved.startswith ".."):
        return None

    return (+ resolved fragment title)


def _normalize_toctree_entry [entry base_dir]:
    """
    Resolve one ``{toctree}`` child entry to a root-relative page path

    Sphinx toctree entries name a page by its extension-less docname
    (``map``, ``concepts/index``) or as ``Title <docname>``. Rewrites the
    docname to the root-relative ``.md`` path matching the row ``path``
    column. Glob patterns, ``self``, external, and absolute entries are
    left unchanged.

    :param entry: the stripped toctree line text
    :param base_dir: directory of the index file, as a root-relative
        posix path
    :return: the rewritten entry, or None to leave it unchanged
    """

    var prefix ""
    var target entry
    var suffix ""
    var match (_TOCTREE_TITLE_RE.match entry)
    when match:
        set! prefix (match.group 1)
        set! target (.strip (match.group 2))
        set! suffix (match.group 3)

    when (or (not target) (_GLOB_CHARS.intersection target)):
        return None
    when (or (_SCHEME_RE.match target)
             (in? (item-slice target 0 1) #("#" "/"))
             (== target "self")):
        return None

    var resolved (posixpath.normpath (posixpath.join base_dir target))
    when (resolved.startswith ".."):
        return None
    unless (resolved.endswith ".md"):
        set! resolved (+ resolved ".md")
    return (+ prefix resolved suffix)


def _rewrite_toctree_line [line base_dir]:
    """
    Rewrite a single non-glob ``{toctree}`` body line, preserving layout

    :param line: raw line including leading indent and line ending
    :param base_dir: directory of the index file, root-relative posix
    :return: the line with its entry rewritten, or unchanged
    """

    var body (line.rstrip "\r\n")
    var ending (item-slice line (len body))
    var stripped (body.strip)
    when (or (not stripped) (stripped.startswith ":")):
        return line
    var rewritten (_normalize_toctree_entry stripped base_dir)
    when (None? rewritten):
        return line
    var leading (item-slice body 0 (- (len body) (len (body.lstrip))))
    return (+ leading rewritten ending)


@demand
def rewrite_markdown_links [text rel_path]:
    """
    Rewrite relative Markdown links to root-relative content paths

    Applies :func:`_normalize_link_target` to every inline
    ``[text](dest)`` link outside fenced code blocks, and
    :func:`_normalize_toctree_entry` to the child entries of non-glob
    ``{toctree}`` directives, so an agent reading the stored ``content``
    can resolve a link or a navigation entry straight through
    ``get_reference``.

    :param text: raw Markdown document text
    :param rel_path: the document's own root-relative posix path
    :return: text with intra-repo relative links and toctree entries
        rewritten
    """

    var base_dir (posixpath.dirname rel_path)

    @demand
    def sub_fn [match]:
        var replaced (_normalize_link_target (match.group 2) base_dir)
        when (None? replaced):
            return (match.group 0)
        return (+ (match.group 1) replaced (match.group 3))

    var out #[]
    var fence None
    var toctree_glob False

    for-each [line (text.splitlines keepends: True)]:
        var marker (line.lstrip)

        if (None? fence):
            if (or (marker.startswith "```") (marker.startswith "~~~")):
                if (and (marker.startswith "```") (in? "toctree" marker)):
                    set! fence "toctree"
                    set! toctree_glob False
                else:
                    set! fence "code"
            else:
                set! line (_MD_LINK_RE.sub sub_fn line)
            out.append line
        elif (or (marker.startswith "```") (marker.startswith "~~~")):
            set! fence None
            out.append line
        elif (!= fence "toctree"):
            out.append line
        elif (== (marker.strip) ":glob:"):
            set! toctree_glob True
            out.append line
        elif toctree_glob:
            out.append line
        else:
            out.append (_rewrite_toctree_line line base_dir)

    "".join out


def _extract_module_docstring [lines start]:
    """
    Read a triple-double-quoted block beginning at or after ``start``

    :param lines: list of source lines
    :param start: index of the line opening the docstring
    :return: first non-empty line of the docstring, or None
    """

    var body #[]
    var first (lines[start].lstrip)
    unless (first.startswith "\"\"\""):
        return None

    var remainder (item-slice first 3)
    when (in? "\"\"\"" remainder):
        return (or (_clean_inline (remainder.split "\"\"\"" 1)[0]) None)

    body.append remainder
    for-each [line (item-slice lines (+ start 1))]:
        when (in? "\"\"\"" line):
            body.append (line.split "\"\"\"" 1)[0]
            (break)
        body.append line

    for-each [line body]:
        var cleaned (_clean_inline line)
        when cleaned:
            return cleaned

    return None


def _is_boilerplate_comment [line stem]:
    """
    Return True for comment lines that are not a useful summary

    Filters the leading file-path banner, GPL license text, and
    ``:field:`` metadata lines common to Koskari source headers.

    :param line: comment text with leading ``;`` markers removed
    :param stem: file stem, used to spot the path banner line
    :return: True when the line should be skipped
    """

    unless line:
        return True

    var lowered (line.lower)
    when (line.startswith ":"):
        return True

    when (or (line.endswith ".ki") (and (in? "/" line) (in? stem line))):
        return True

    for-each [marker _LICENSE_MARKERS]:
        when (in? marker lowered):
            return True

    return False


@demand
def ki_title_summary [text stem]:
    """
    Extract a title and summary from a Koskari source file

    Prefers a top-level triple-double-quoted module docstring; otherwise
    falls back to the first substantive line of the leading ``;`` comment
    banner.

    :param text: raw Koskari source text
    :param stem: file stem used as the title and to skip the path banner
    :return: tuple of (title, summary or None)
    """

    var lines (text.splitlines)
    var comments #[]

    var index 0
    while (< index (len lines)):
        var stripped (lines[index].strip)
        if (not stripped):
            incr! index
        elif (stripped.startswith ";"):
            comments.append ((stripped.lstrip ";").strip)
            incr! index
        else:
            (break)

    var summary None
    when (and (< index (len lines))
              ((lines[index].lstrip).startswith "\"\"\"")):
        set! summary (_extract_module_docstring lines index)

    when (None? summary):
        for-each [comment comments]:
            unless (_is_boilerplate_comment comment stem):
                set! summary (_clean_inline comment)
                (break)

    return stem summary


; The end.
