"""
tools.corpus.load

Load and dump Koskari corpus records as multi-document YAML shards.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from pathlib Path

import yaml


var _RECORD_FIELD_ORDER #(
    "id"
    "feature"
    "source"
    "verify"
    "references"
    "stability"
    "tags"
    "notes")

var _VERIFY_KEY_ORDER #(
    "read"
    "expand"
    "compile"
    "eval"
    "warning"
    "error"
    "invalid")

@demand
def load_records [records_dir]:
    """
    Load all corpus records from YAML shards in a directory

    :param records_dir: directory containing *.yaml files
    :return: list of record dicts
    :raises ValueError: on malformed YAML with shard name in message
    """

    var records #[]
    var records_path (Path records_dir)
    var shards (sorted (records_path.glob "*.yaml"))

    for-each [shard shards]:
        var text (shard.read_text)
        var docs None
        try:
            set! docs (list (yaml.safe_load_all text))

        ; Koskari's raise takes no explicit cause, so the chain here is
        ; the implicit __context__ from raising inside the handler.
        except [yaml.YAMLError as: exc]:
            raise (ValueError f"{shard.name}: {exc}")

        for-each [[doc_no doc] (enumerate docs 1)]:
            when (None? doc):
                (continue)

            unless (instance? doc dict):
                var kind (type doc).__name__
                raise (ValueError
                    f"{shard.name}:document {doc_no}: expected mapping, got {kind}")

            (records.append doc)

    return records


def _escape_double_quoted [text]:
    """
    Escape a string for YAML double-quoted scalar form
    """

    ((text.replace "\\" "\\\\").replace "\"" "\\\"")


def _yaml_needs_double_quotes [text]:
    """
    Return True when the bare text would not load back as the same
    string. The loader itself is the test, so every YAML shape that
    reads as something else (bool words, numbers, dates, comments,
    nested mappings, flow collections, anchors, leading quotes) is
    covered without a list to maintain
    """

    when (or (not text) (!= (text.strip) text)):
        return True
    try:
        var back (yaml.safe_load f"k: {text}")
    except [Exception]:
        return True
    return (not (and (instance? back dict) (== (back.get "k") text)))


def _use_block_scalar [text]:
    """
    Return True when text should be emitted as a literal block scalar
    """

    return (in? "\n" text)


def _format_inline_scalar [text]:
    """
    Format a single-line string for YAML output
    """

    when (and (>= (len text) 2)
              (== text[0] "\"")
              (== text[-1] "\"")):
        var single (text.replace "'" "''")
        return f"'{single}'"

    when (_yaml_needs_double_quotes text):
        var escaped (_escape_double_quoted text)
        return f"\"{escaped}\""

    return text


def _format_scalar_lines [key text indent]:
    """
    Format one key and string value as YAML lines
    """

    var prefix (* "  " indent)
    when (_use_block_scalar text):
        var lines #[f"{prefix}{key}: |-"]
        for-each [line (text.split "\n")]:
            (lines.append f"{prefix}  {line}")
        return lines

    var scalar (_format_inline_scalar text)
    return #[f"{prefix}{key}: {scalar}"]


def _format_verify [verify indent]:
    """
    Format the verify mapping for YAML output
    """

    var prefix (* "  " indent)
    var lines #[f"{prefix}verify:"]

    for-each [key _VERIFY_KEY_ORDER]:
        unless (in? key verify):
            (continue)

        (lines.extend
            (_format_scalar_lines key verify[key] (+ indent 1)))

    return lines


def _format_list [key values indent]:
    """
    Format a list field as a YAML block sequence.

    An empty list needs the explicit flow form: a bare ``key:`` parses
    back as None, which fails schema validation for the whole shard on
    the next append.
    """

    var prefix (* "  " indent)
    unless values:
        return #[f"{prefix}{key}: []"]

    var lines #[f"{prefix}{key}:"]
    for-each [value values]:
        var scalar (_format_inline_scalar value)
        (lines.append f"{prefix}  - {scalar}")

    return lines


@demand
def dump_record [record]:
    """
    Serialize one corpus record as a YAML document string

    :param record: corpus record dict
    :return: YAML document text without leading document marker
    """

    var lines #[]
    for-each [field _RECORD_FIELD_ORDER]:
        unless (in? field record):
            (continue)

        var value record[field]
        switch field:
            case ["verify"]:
                lines.extend (_format_verify value 0)
            case ["references" "tags"]:
                lines.extend (_format_list field value 0)
            case ["source"]:
                lines.extend (_format_scalar_lines field value 0)
            case ["notes"]:
                lines.extend (_format_scalar_lines field value 0)
            else:
                var scalar (_format_inline_scalar value)
                lines.append f"{field}: {scalar}"

    var text ("\n".join lines)
    (check_round_trip record text)
    return text


def _same_value [want got]:
    """
    Field equality after a YAML round trip. A block scalar's trailing
    newline is dropped by the |- form, so strings compare without one
    """

    when (and (instance? want str) (instance? got str)):
        return (== (want.rstrip "\n") (got.rstrip "\n"))
    return (== want got)


@demand
def check_round_trip [record text]:
    """
    Raise ValueError unless the YAML text loads back to the record's
    fields, naming the first field that differs. Guards every writer
    against a serializer gap, which would otherwise corrupt the shard
    for every later append

    :param record: the record that was serialized
    :param text: the YAML document text
    :raises ValueError: on the first field that does not load back
    """

    var rid (record.get "id" "<no-id>")
    var back (yaml.safe_load text)
    unless (instance? back dict):
        raise (ValueError f"record {rid} did not load back as a mapping")

    for-each [field _RECORD_FIELD_ORDER]:
        unless (in? field record):
            (continue)
        var want record[field]
        var got (back.get field)

        if (== field "verify"):
            var stages (or got #{})
            for-each [[key value] (want.items)]:
                unless (_same_value value (stages.get key)):
                    raise (ValueError
                        f"record {rid} field verify.{key} does not"-
                        f" load back as written: {(repr value)}")
        else:
            unless (_same_value want got):
                raise (ValueError
                    f"record {rid} field {field} does not"-
                    f" load back as written: {(repr want)}")


@demand
def dump_shard [records]:
    """
    Serialize corpus records as a multi-document YAML shard

    :param records: list of corpus record dicts
    :return: full shard text
    """

    var docs (list-each [record records] (dump_record record))
    return (+ ("\n---\n".join docs) "\n")


@demand
def write_shard [path records]:
    """
    Write corpus records to a YAML shard file

    :param path: destination path
    :param records: list of corpus record dicts
    """

    ((Path path).write_text (dump_shard records))


; The end.
