"""
tools.corpus.quick

Quick oracle and validator for corpus generation. Thin CLI over the
existing record runner in ``tests/corpus`` and the YAML serializer in
``tools/corpus/load.ki`` -- it does not reimplement read, expand, eval,
verify, or serialization logic, so its output matches what the corpus
test phase accepts.

Intended to run via ``uv run`` against a worktree's own ``.venv`` (built
with ``make venv``), not through tox; see
``design/corpus-generation-agent.md`` and ``docs/corpus/CLAUDE.md``.

Subcommands:

  verify    run a source form through the implementation and emit
            corpus-encoded read/expand/eval strings (advisory)
  insert    schema-check, dedupe, run every verify stage, and append a
            candidate record to a shard (authoritative)
  coverage  report features with fewer than N entries

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import json
import sys

import-from argparse ArgumentParser
import-from pathlib Path


define _HERE ((Path __file__).resolve)
define REPO_ROOT _HERE.parents[2]

when (not-in? (str REPO_ROOT) sys.path):
    sys.path.insert 0 (str REPO_ROOT)


; Importing the runner triggers the koskari bootstrap (the warmup cost
; that justifies one shared script rather than three).
(import-from tests.corpus
    HANDLERS
    CorpusTestCase
    default_records_dir
    default_schema_path
    eval_values_equal
    forms_equal
    load_corpus_index
    load_schema
    parse_eval_expected)


import-from tools.corpus load


; Categories whose entries route to a known shard when --shard is omitted.
define _CATEGORY_TO_SHARD #{
    "conditional": "conditionals"
    "function": "functions"
    "class": "classes"
    "variable": "variables"
    "object": "objects"
    "iter": "iter"
    "syntax": "syntax"
    "special": "specials"
    "macro": "syntax"
}


define _make_case [feature: None block: False fixtures: None]:
    """
    Build a bound CorpusTestCase for an ad-hoc source form

    :param feature: optional feature string (selects the reader)
    :param block: when True, force the layout/block reader
    :param fixtures: optional extra eval bindings to merge
    :return: a bound CorpusTestCase
    """

    define record #{
        "id": "<quick>"
        "feature": (or feature "")
        "source": ""
        "tags": (if block #["surface:block"] #[])
    }

    define case (CorpusTestCase "bind_record")
    (case.bind_record record)

    when fixtures:
        for-each [[key val] (fixtures.items)]:
            set! case.module_ns[key] val

    return case


define _json_or_none [value separators: None]:
    """
    Encode a value as JSON, or None when it cannot be encoded
    """

    try:
        if (None? separators):
            json.dumps value
        else:
            json.dumps value separators: separators

    except [#(TypeError ValueError)]:
        return None


define _scalar_token [value]:
    """
    Render one pair element as a proper/improper-list token

    :param value: a list element (symbol or json scalar)
    :return: token text
    :raises TypeError: when the element cannot be encoded
    """

    if (symbol? value):
        (str value)
    else:
        (json.dumps value)


define _pair_candidates [got]:
    """
    Yield proper-list/improper-list encodings for a pair value

    :param got: a pair value
    :return: iterator of candidate encoding strings
    """

    define out None
    try:
        if (proper? got):
            define items (list (unpack got))
            define encoded (json.dumps items separators: #("," ":"))
            set! out f"proper-list:{encoded}"

        else:
            define parts #[]
            define cur got
            while (pair? cur):
                (parts.append (_scalar_token (car cur)))
                set! cur (cdr cur)
            (parts.append (_scalar_token cur))

            define head (" ".join (item-slice parts 0 -1))
            define tail parts[-1]
            set! out f"improper-list:({head} . {tail})"

    except [#(TypeError ValueError)]:
        (return)

    yield out


define _eval_candidates [got]:
    """
    Yield candidate corpus eval encodings for a runtime value

    Each candidate is validated by the caller against the real
    comparator before being trusted, so over-generating is harmless.

    :param got: the runtime eval result
    :return: iterator of candidate encoding strings
    """

    when (or (None? got) (nil? got)):
        yield "null"
        (return)

    when (is? got True):
        yield "true"
        (return)

    when (is? got False):
        yield "false"
        (return)

    when (symbol? got):
        define name (str got)
        yield f"symbol:{name}"
        (return)

    when (instance? got #(int float)):
        define number (_json_or_none got)
        unless (None? number):
            yield number
        (return)

    when (str? got):
        yield (json.dumps got)
        (return)

    when (list? got):
        define listing (_json_or_none got separators: #("," ":"))
        unless (None? listing):
            yield f"list:{listing}"
        (return)

    when (tuple? got):
        define parts:
            list-each [x got]:
                _json_or_none x separators: #("," ":")

        unless (in? None parts):
            define joined (",".join parts)
            yield f"tuple:({joined})"
        (return)

    when (pair? got):
        yield-from (_pair_candidates got)
        (return)

    define fallback (_json_or_none got)
    unless (None? fallback):
        yield fallback


define suggest_eval_encoding [got]:
    """
    Return a corpus eval encoding that is verified to match the value

    Only an encoding that round-trips through the real parse + compare
    helpers is returned, so a non-None result is always correct.

    :param got: the runtime eval result
    :return: an encoding string, or None when none could be verified
    """

    for-each [cand (_eval_candidates got)]:
        define kind None
        define payload None
        define parsed True

        try:
            define-values [k p] (parse_eval_expected cand)
            set! kind k
            set! payload p
        except [Exception]:
            set! parsed False

        when (and parsed (== kind "literal")):
            define matched False
            try:
                set! matched (eval_values_equal got payload)
            except [Exception]:
                set! matched False
            when matched:
                return cand

    return None


define _stage_read [case source warnings]:
    """
    Produce the read-stage encoding for a source form
    """

    define form (case.read_source source)
    define text (repr form)
    define reread (case.parse_expected_form text)

    unless (forms_equal form reread):
        warnings.append "read string did not round-trip; verify by hand"

    return text


define _stage_expand [case source warnings]:
    """
    Produce the expand-stage encoding for a source form
    """

    define form (case.read_source source)
    define expanded (case.macroexpand1 form)
    define text (repr expanded)
    define reread (case.parse_expected_form text)

    unless (forms_equal expanded reread):
        (warnings.append "expand string did not round-trip; verify by hand")

    return text


define _stage_eval [case source result]:
    """
    Produce the eval-stage encoding for a source form

    Writes the verified encoding under "eval" when one is found;
    otherwise records the raw repr and type for manual encoding.
    """

    define got (case.eval_source source)
    define encoding (suggest_eval_encoding got)

    if (not (None? encoding)):
        set! result["eval"] encoding

    else:
        set! result["eval_raw"] (py-repr got)
        set! result["eval_type"] (type got).__name__

        ((result.setdefault "warnings" #[]).append
            "could not auto-encode eval result; choose a literal or"-
            " @marked: encoding by hand (see docs/corpus/SCHEMA.md)"-
            " and confirm with \"quick insert --dry-run\"")


define cmd_verify [options]:
    """
    verify subcommand: run a form and emit corpus-encoded strings

    :param options: parsed CLI arguments
    :return: process exit code
    """

    define source options.form
    when (None? source):
        set! source (sys.stdin.read)

    set! source (source.strip)
    unless source:
        print (json.dumps #{"error": "empty source" "stage": "read"})
        return 1

    define stages #[]
    if (or options.all
           (not (or options.read options.expand options.eval))):
        set! stages #["read" "expand" "eval"]

    else:
        when options.read:
            stages.append "read"
        when options.expand:
            stages.append "expand"
        when options.eval:
            stages.append "eval"

    define fixtures (if options.fixture (json.loads options.fixture) None)
    define case (_make_case
        feature: options.feature block: options.block fixtures: fixtures)

    define result #{}
    define warnings #[]
    define errors #{}

    for-each [stage stages]:
        try:
            if (== stage "read"):
                set! result["read"] (_stage_read case source warnings)
            elif (== stage "expand"):
                set! result["expand"] (_stage_expand case source warnings)
            else:
                (_stage_eval case source result)
        except [Exception as: exc]:
            define kind (type exc).__name__
            set! errors[stage] f"{kind}: {exc}"

    when warnings:
        ((result.setdefault "warnings" #[]).extend warnings)

    when errors:
        set! result["errors"] errors

    define single (== (len stages) 1)
    when (and single (in? stages[0] errors)):
        define only (item stages 0)
        print (json.dumps #{"error": errors[only] "stage": only})
        return 1

    define produced False
    for-each [key #("read" "expand" "eval" "eval_raw")]:
        when (in? key result):
            set! produced True

    print (json.dumps result indent: 2)
    return (if produced 0 1)


define _read_candidate [options]:
    """
    Read a candidate record from --file or stdin

    :param options: parsed CLI arguments
    :return: the parsed record dict
    """

    import yaml

    define text (if options.file
        (.read_text (Path options.file))
        (sys.stdin.read))

    define doc (yaml.safe_load text)
    unless (dict? doc):
        raise (ValueError "candidate is not a single YAML mapping")

    return doc


define _verify_stages [record]:
    """
    Run every applicable verify stage for a record

    :param record: candidate record dict
    :raises Exception: when a stage fails (assertion or otherwise)
    """

    define verify (or (record.get "verify") (dict))
    define case (CorpusTestCase "bind_record")
    (case.bind_record record)

    define ran 0
    for-each [[stage expected] (.items verify)]:
        when (== stage "invalid"):
            (continue)

        define handler (HANDLERS.get stage)
        unless handler:
            raise (ValueError f"no handler for verify stage '{stage}'")

        (handler case expected)
        incr! ran

    unless ran:
        raise (ValueError "record has no runnable verify stages")


define _category_of [record]:
    """
    Return the routing category tag for a record, or None
    """

    for-each [tag (or (record.get "tags") #[])]:
        unless (in? ":" tag):
            return tag
    return None


define _target_shard [record records_dir override]:
    """
    Resolve the shard path a record should be appended to

    :param record: candidate record dict
    :param records_dir: records directory path
    :param override: explicit --shard value, or None
    :return: shard Path
    :raises ValueError: when the shard cannot be inferred
    """

    when override:
        define name:
            if (override.endswith ".yaml"):
                override
            else:
                f"{override}.yaml"
        return ((Path records_dir).joinpath name)

    define category (_category_of record)
    define base (_CATEGORY_TO_SHARD.get category)
    when (None? base):
        define tags (record.get "tags")
        raise (ValueError
            f"cannot infer shard from tags {tags}; pass --shard")

    define verify (or (record.get "verify") #{})
    define invalid (or (== (record.get "stability") "invalid")
                       (in? "error" verify)
                       (in? "invalid" verify))

    when invalid:
        define inv ((Path records_dir).joinpath f"{base}-invalid.yaml")
        when (inv.exists):
            return inv

    return ((Path records_dir).joinpath f"{base}.yaml")


define _append_record [path record]:
    """
    Append one record as a new YAML document to a shard file

    Existing documents are left byte-for-byte unchanged.

    :param path: shard Path
    :param record: candidate record dict
    """

    define doc (load.dump_record record)
    define new None

    if (and (path.exists) ((path.read_text).strip)):
        define text (path.read_text)
        unless (text.endswith "\n"):
            incr! text "\n"

        set! new f"{text}---\n{doc}\n"
    else:
        set! new f"{doc}\n"

    (path.write_text new)


define cmd_insert [options]:
    """
    insert subcommand: validate and append a candidate record

    :param options: parsed CLI arguments
    :return: process exit code
    """

    import jsonschema

    define record None
    try:
        set! record (_read_candidate options)
    except [Exception as: exc]:
        define kind (type exc).__name__
        print f"FAIL <unparsed> {kind}: {exc}"
        return 1

    define record_id (record.get "id" "<no-id>")

    try:
        define schema (load_schema (default_schema_path))
        (.validate (jsonschema.Draft202012Validator schema) record)
    except [Exception as: exc]:
        print f"FAIL {record_id} schema: {exc}"
        return 1

    define index None
    try:
        set! index (load_corpus_index)
    except [Exception as: exc]:
        print f"FAIL {record_id} corpus-load: {exc}"
        return 1
    when (in? record_id index):
        print f"FAIL {record_id} duplicate id"
        return 1

    try:
        (_verify_stages record)
    except [Exception as: exc]:
        define kind (attr (type exc) __name__)
        print f"FAIL {record_id} verify: {kind}: {exc}"
        return 1

    try:
        (load.dump_record record)
    except [Exception as: exc]:
        print f"FAIL {record_id} serialize: {exc}"
        return 1

    when options.dry_run:
        print f"OK {record_id} (validated, not written)"
        return 0

    define shard None
    try:
        set! shard (_target_shard record (default_records_dir) options.shard)
        (_append_record shard record)
    except [Exception as: exc]:
        print f"FAIL {record_id} write: {exc}"
        return 1

    define rel (shard.relative_to REPO_ROOT)
    print f"OK {record_id} (inserted into {rel})"
    return 0


define cmd_coverage [options]:
    """
    coverage subcommand: report sparsely covered features

    :param options: parsed CLI arguments
    :return: process exit code
    """

    define index None
    try:
        set! index (load_corpus_index)
    except [Exception as: exc]:
        print f"error loading corpus: {exc}"
        return 1

    define counts #{}
    define ids_by_feature #{}
    for-each [record (index.values)]:
        define feature (or (record.get "feature") "<none>")
        set! counts[feature] (+ (counts.get feature 0) 1)
        ((ids_by_feature.setdefault feature #[]).append record["id"])

    when options.feature:
        define n (counts.get options.feature 0)
        print f"{options.feature}\t{n}"
        for-each [rid (sorted (ids_by_feature.get options.feature #[]))]:
            print f"  {rid}"
        return 0

    define rows #[]
    for-each [[f c] (.items counts)]:
        when (< c options.min_entries):
            rows.append #(c f)

    (rows.sort)
    for-each [[count feature] rows]:
        print f"{count}\t{feature}"

    define below (len rows)
    define total (len counts)
    (print
        f"# {below} features below {options.min_entries} entries"-
        f" (of {total} features with any coverage)"
        file: sys.stderr)

    (print
        "# note: lists only features that already appear; gap analysis"-
        " vs the full special/macro registry is not yet implemented"
        file: sys.stderr)
    return 0


define build_arguments [parser]:
    """
    Register the quick subcommands on a parser or subparser

    A distinct ``quick_func`` destination keeps this from colliding with
    the outer dispatcher's own ``func``.
    """

    define sub (parser.add_subparsers dest: "quick_command" required: True)

    define pv (sub.add_parser "verify"
        help: "run a form and emit corpus-encoded strings")
    (pv.add_argument "form" nargs: "?"
        help: "source form; read from stdin when omitted")
    (pv.add_argument "--read" action: "store_true" help: "emit read stage")
    (pv.add_argument "--expand" action: "store_true" help: "emit expand stage")
    (pv.add_argument "--eval" action: "store_true" help: "emit eval stage")
    (pv.add_argument "--all" action: "store_true"
        help: "emit all stages (default when none selected)")
    (pv.add_argument "--block" action: "store_true"
        help: "read with the layout/block reader")
    (pv.add_argument "--feature"
        help: "feature string (influences reader selection)")
    (pv.add_argument "--fixture"
        help: "JSON object of extra eval bindings")
    (pv.set_defaults quick_func: cmd_verify)

    define pi (sub.add_parser "insert"
        help: "validate and append a candidate record")
    (pi.add_argument "--file"
        help: "candidate YAML file; reads stdin when omitted")
    (pi.add_argument "--shard"
        help: "target shard name (recommended; inferred if absent)")
    (pi.add_argument "--dry-run" action: "store_true"
        help: "validate only; do not write")
    (pi.set_defaults quick_func: cmd_insert)

    define pc (sub.add_parser "coverage"
        help: "report sparsely covered features")
    (pc.add_argument "--min-entries" type: int default: 3
        help: "report features with fewer than N entries (default 3)")
    (pc.add_argument "--feature"
        help: "report the count and ids for one feature")
    (pc.set_defaults quick_func: cmd_coverage)

    return parser


define run [options]:
    """
    Dispatch to the selected quick subcommand

    :param options: parsed argument namespace
    :return: integer exit code
    """

    return (options.quick_func options)


define main [argv: None]:
    """
    CLI entry point

    :param argv: optional argument vector; defaults to sys.argv
    :return: process exit code
    """

    when (None? argv):
        set! argv sys.argv

    define-values [_name *: args] argv

    define parser (ArgumentParser
        prog: "quick"
        description: "Corpus oracle, validator, and coverage query.")

    (build_arguments parser)
    run (parser.parse_args args)


when-main:
    (sys.exit (main))


; The end.
