"""
perfstat -- hardware-counter collection over the churn kernels.

Follows the methodology in design/dispatch-sizing.md. The stat mode
runs perf stat per kernel with the bootstrap floor subtracted from the
deterministic instruction count and appends one row per kernel to a
TSV log. The opcodes mode runs perf record over all kernels and
reports per-opcode cycle shares; it expects the running build to be a
KOS_ALL_COLD build, where every handler is its own symbol -- the
perf-opcodes tox env provides one. Both modes are fronted by the perf
and perf-opcodes tox envs, each with its own venv and build, leaving
the dev venv alone.

Run from the repository root:

    tox -qe perf
    tox -qe perf -- --samples 3 --warmup 2
    tox -qe perf-opcodes -- fannkuch nbody

:author: Christopher O'Brien <obriencj@gmail.com>
:license: GNU General Public License v3
"""


import os
import sys
import subprocess

import-from argparse ArgumentParser
import-from datetime date
import-from os.path dirname exists join


define EVENT_KEYS #(
    "instructions:u"
    "cycles:u"
    "branch-misses:u"
    "L1-icache-load-misses:u")

define EVENTS (",".join EVENTS_KEYS)

define CHURN (join "examples" "churn")


;; === churn harness ===


define kernel-names []:
    """
    The churn benchmark names, from the harness's own registry
    """

    (sys.path.insert 0 CHURN)
    import registry
    return (list (registry.discover))


define churn-command [python name samples warmup]:
    """
    Build the churn.py argv for one kernel run

    :param python: interpreter to run the harness with
    :param name: kernel name
    :param samples: measured batches
    :param warmup: warmup batches
    :return: argv list
    """

    return #[
        python "-B" (join CHURN "churn.py")
        "--mode" "koskari"
        "--samples" (str samples) "--warmup" (str warmup)
        name]


;; === perf collection ===


define perf-stat [cmd]:
    """
    Run cmd under perf stat and return {event: count}. Unsupported or
    uncounted events come back as None. The command's own exit status
    is ignored; the bootstrap-floor run fails by design

    :param cmd: argv to run under perf stat
    :return: mapping of event name to count or None
    """

    define argv #["perf" "stat" "-x" "," "-e" EVENTS "--" *: cmd]
    define proc (subprocess.run argv
        stdout: subprocess.DEVNULL stderr: subprocess.PIPE text: True)

    define counts (dict)
    for-each [line (proc.stderr.splitlines)]:
        define parts (line.split ",")
        when (< (len parts) 3):
            (continue)

        define value parts[0]
        define event parts[2]
        when (in? event EVENT_KEYS):
            try:
                set! counts[event] (int value)

            except [ValueError]:
                set! counts[event] None

    return counts


define git-sha []:
    """
    Short SHA of HEAD, or "unknown" if git fails
    """

    define result ```bash immediate: True
    git rev-parse --short HEAD 2>/dev/null || echo unknown
    ```
    return (result.text.strip)


define run-stat [opts]:
    """
    Per-kernel perf stat with the bootstrap floor subtracted from the
    instruction count, appended to the TSV log
    """

    define names (or opts.names (kernel-names))
    define sha (git-sha)
    define today ((date.today).isoformat)

    print "measuring bootstrap floor..."
    define floor (perf-stat (churn-command opts.python names[0] 0 0))
    define floor-instr (or (floor.get "instructions:u") 0)
    print f"floor: {floor-instr:,} instructions"

    define header "date\tsha\tkernel\tinstructions\tinstr_minus_floor\tcycles\tbranch_misses\tl1i_misses\n"

    define rows (list)
    for-each [name names]:
        define counts:
            perf-stat (churn-command opts.python name opts.samples opts.warmup)
        define instr (counts.get "instructions:u")
        define delta (unless (None? instr) (- instr floor-instr))
        define row #(today sha name instr delta
            (counts.get "cycles:u")
            (counts.get "branch-misses:u")
            (counts.get "L1-icache-load-misses:u"))
        (rows.append row)
        (print
            f"{name:16s} instr {(or instr 0):>16,}  "-
            f"minus floor {(or delta 0):>16,}")

    (os.makedirs (dirname opts.log) exist_ok: True)
    define fresh (not (exists opts.log))
    with [fh (open opts.log "a")]:
        when fresh:
            (fh.write header)
        for-each [row rows]:
            (fh.write
                (+ ("\t".join (list-each [v row] (if (None? v) "" (str v))))
                   "\n"))

    print f"appended {(len rows)} rows to {opts.log}"


define run-opcodes [opts]:
    """
    Per-opcode cycle shares by sampling: perf record over every kernel
    in one process, reported by symbol and filtered to the op_ handler
    symbols. Meaningful only on a KOS_ALL_COLD build
    """

    define names (or opts.names (kernel-names))
    define data (join "build" "perf-opcodes.data")
    (os.makedirs "build" exist_ok: True)

    define cmd #[
        opts.python "-B" (join CHURN "churn.py")
        "--mode" "koskari"
        "--samples" (str opts.samples) "--warmup" (str opts.warmup)
        *: names]

    (print "recording:" (" ".join names))
    (subprocess.run
        #["perf" "record" "-e" "cycles:u" "-F" "999" "-o" data "--" *: cmd]
        stdout: subprocess.DEVNULL check: True)

    define proc (subprocess.run
        #["perf" "report" "--stdio" "--no-children"
          "--percent-limit" "0.01" "-i" data]
        capture_output: True text: True check: True)

    define lines:
        list-each [line (proc.stdout.splitlines)]:
            when (in? " op_" line):
                line

    with [fh (open opts.out "w")]:
        (fh.write
            f"# per-opcode cycle shares, {((date.today).isoformat)}"-
            f" at {(git-sha)} (KOS_ALL_COLD sampling build)\n")
        (fh.write (+ ("\n".join lines) "\n"))

    print f"\ntop opcode handlers by cycles ({opts.out}):"
    for-each [line (item-slice lines 0 30)]:
        print line


;; === entry point ===


define main [argv: None]:
    """
    Parse arguments and dispatch to the selected mode

    :param argv: optional argument vector; defaults to sys.argv[1:]
    :return: integer exit code
    """

    define parser (ArgumentParser
        description: "perf collection over the churn kernels")
    (parser.add_argument "mode"
        choices: #("stat" "opcodes")
        help: "stat: per-kernel counters; opcodes: per-op cycle shares")
    (parser.add_argument "names"
        nargs: "*" metavar: "NAME"
        help: "kernels to run (default: all)")
    (parser.add_argument "--python"
        default: sys.executable
        help: "interpreter to run the harness with (default: this one)")
    (parser.add_argument "--samples"
        type: int default: 1
        help: "measured batches per kernel (default: 1)")
    (parser.add_argument "--warmup"
        type: int default: 1
        help: "warmup batches per kernel (default: 1)")
    (parser.add_argument "--log"
        default: (join "design" "perf" "perf.tsv")
        help: "TSV log for stat mode")
    (parser.add_argument "--out"
        default: (join "build" "perf-opcodes.txt")
        help: "report path for opcodes mode")
    define opts (parser.parse_args argv)

    if (== opts.mode "stat"):
        (run-stat opts)
    else:
        (run-opcodes opts)
    return 0


when-main:
    (sys.exit (main))


; The end.
