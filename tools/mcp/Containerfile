# Containerfile for the Koskari corpus MCP server.
#
# The base image is an argument: local builds default to koskari:local
# (built from the repository root Containerfile), while CI passes the
# published GHCR runtime image via --build-arg KOSKARI_BASE=...
#
# Build (requires koskari:local from repository root):
#   make build-mcp
#
# Run (stdio MCP; use -i, never -t):
#   podman run -i --rm koskari-mcp:local
#
# The corpus/docs/programs parquet views are baked into the image under
# /srv/data, so the server serves entirely from memory with no network.
# make build-mcp stages them into tools/mcp/data/ before the build.
#
# author: Christopher O'Brien <obriencj@gmail.com>
# license: GPL v.3

ARG KOSKARI_BASE=koskari:local

FROM ${KOSKARI_BASE}

LABEL maintainer="obriencj@gmail.com" \
      description="Koskari MCP server for the baked-in koskari corpus"

RUN pip install --no-cache-dir --disable-pip-version-check \
    --root-user-action=ignore \
    'mcp>=2' pyarrow

WORKDIR /srv
COPY mcp_server.ki ./mcp_server.ki
COPY index.html ./index.html
COPY koskari-icon.svg ./koskari-icon.svg
COPY data/ ./data/

CMD ["mcp_server.ki"]

# The end.
