"""
Koskari MCP server for the published language corpus

Forwards search and lookup tools to the Hugging Face Dataset Viewer API
for obriencj/koskari config corpus.
"""


import json
import logging
import sys

import httpx
import-from mcp.server.fastmcp FastMCP


define logger (logging.getLogger "koskari.mcp")

(logging.basicConfig
    stream: sys.stderr
    level: logging.WARNING)


define DATASET "obriencj/koskari"
define CONFIG "corpus"
define DOCS_CONFIG "docs"
define PROGRAMS_CONFIG "programs"
define SPLIT "train"
define BASE_URL "https://datasets-server.huggingface.co"

define _VERIFY_KEYS #("read" "expand" "eval" "error" "invalid")
define _META_KEYS #("corpus_id" "feature" "source" "references" "stability"
                     "tags" "schema_version" "git_ref")


define mcp (FastMCP "koskari-corpus")
define http (httpx.AsyncClient timeout: 30.0)


define escape-sql-string [text]:
    """
    Escape a string for single-quoted SQL filter literals
    """

    (text.replace "'" "''")


define viewer-base-params [config: CONFIG]:
    """
    Shared query parameters for every Dataset Viewer request
    """

    #{dataset: DATASET
      config: config
      split: SPLIT}


define viewer-get [path extra: #{} config: CONFIG]:
    """
    Issue a GET to the Dataset Viewer API and return parsed JSON
    """

    define params (dict (viewer-base-params config: config))
    (params.update extra)
    define url f"{BASE_URL}{path}"
    define response (http.get url params: params)
    (response.raise_for_status)
    define data (response.json)
    when (dict.get data "error"):
        define msg (dict.get data "error" "unknown viewer error")
        (logger.error "viewer API error on %s: %s" path msg)
        raise (RuntimeError msg)
    data


define viewer-rows [data]:
    """
    Extract row dicts from a /rows, /search, or /filter response
    """

    define rows (dict.get data "rows" ())
    define out #[]
    for-each [entry rows]:
        define row (item entry "row")
        (out.append row)
    out


define compact-example [row]:
    """
    Build a compact dict with corpus fields useful to agents
    """

    define out #{}

    for-each [key _META_KEYS]:
        define value (row.get key)
        unless (None? value):
            set! (item out key) value

    for-each [key _VERIFY_KEYS]:
        define value (row.get key)
        unless (None? value):
            set! (item out key) value

    out


define format-example [row]:
    """
    Serialize one corpus row for MCP tool output
    """

    (json.dumps (compact-example row))


define format-examples [rows]:
    """
    Serialize multiple corpus rows for MCP tool output
    """

    define items (list-each [row rows] (compact-example row))
    (json.dumps items)


;; === Reference material (docs and programs) ===


define _REFERENCE_FULL_KEYS #("path" "title" "section" "kind" "content")
define _REFERENCE_HIT_KEYS #("path" "title" "summary" "kind")
define _DOC_SEARCH_COLUMNS #("path" "title" "content")


define pick-fields [row keys]:
    """
    Build a dict from the named row keys, skipping missing values
    """

    define out #{}
    for-each [key keys]:
        define value (row.get key)
        unless (None? value):
            set! (item out key) value
    out


define reference-config-for [path]:
    """
    Route a reference path to its Dataset Viewer config

    examples/ paths resolve against the programs config; every other path
    is a documentation page in the docs config.
    """

    if (path.startswith "examples/"):
        PROGRAMS_CONFIG
    else:
        DOCS_CONFIG


define resolve-references [refs]:
    """
    Resolve corpus reference paths to their doc title and summary
    """

    unless refs:
        return #[]
    define clauses:
        list-each [ref refs] f"\"path\"='{(escape-sql-string ref)}'"
    define joined (.join " OR " clauses)
    define where f"({joined})"
    define extra #{where: where offset: 0 length: (len refs)}
    define rows (viewer-rows (viewer-get "/filter" extra config: DOCS_CONFIG))
    (list-each [row rows] (pick-fields row _REFERENCE_HIT_KEYS))


define doc-like-clause [text]:
    """
    Build an OR of LIKE predicates over documentation text columns
    """

    define escaped (escape-sql-string text)
    define needle f"'%{escaped}%'"
    define clauses:
        list-each [column _DOC_SEARCH_COLUMNS] f"\"{column}\" LIKE {needle}"
    define joined (.join " OR " clauses)
    f"({joined})"


define doc-configs-for [kind]:
    """
    Return the Dataset Viewer configs a doc search should cover
    """

    if (== kind "doc"):
        #[DOCS_CONFIG]
    elif (== kind "example"):
        #[PROGRAMS_CONFIG]
    else:
        #[DOCS_CONFIG PROGRAMS_CONFIG]


define search-docs-config [search_text cap config]:
    """
    Search one docs config: full-text first, substring fallback

    Mirrors search_examples: the full-text index drops language stop words,
    so an empty result falls back to substring matching.
    """

    define rows:
        viewer-search-rows "/search" #{query: search_text} cap config: config
    unless rows:
        define clause (doc-like-clause search_text)
        set! rows (viewer-search-rows "/filter" #{where: clause} cap
                       config: config)
    rows


define feature-matches? [row feature]:
    """
    Return True when row feature equals or starts with the filter
    """

    define value (row.get "feature" "")
    if (feature.endswith "/"):
        (value.startswith feature)
    else:
        (== value feature)


define feature-where-clause [feature]:
    """
    Build a Dataset Viewer filter predicate for feature
    """

    if (feature.endswith "/"):
        define escaped (escape-sql-string feature)
        f"\"feature\" LIKE '{escaped}%'"
    else:
        define escaped (escape-sql-string feature)
        f"\"feature\"='{escaped}'"


define filter-rows-by-feature [rows feature]:
    """
    Keep rows whose feature column matches the filter
    """

    define out #[]
    for-each [row rows]:
        when (feature-matches? row feature):
            (out.append row)
    out


define _SEARCH_COLUMNS #("source" "feature" "corpus_id")


define search-like-clause [text]:
    """
    Build an OR of LIKE predicates matching text as a substring across the
    searchable text columns
    """

    define escaped (escape-sql-string text)
    define needle f"'%{escaped}%'"
    define clauses:
        list-each [column _SEARCH_COLUMNS] f"\"{column}\" LIKE {needle}"
    define joined (.join " OR " clauses)
    f"({joined})"


define viewer-search-rows [path extra cap config: CONFIG]:
    """
    Issue a Dataset Viewer query with paging bounds and return its rows
    """

    set! (item extra "offset") 0
    set! (item extra "length") cap
    (viewer-rows (viewer-get path extra config: config))


define fts-search [search_text cap]:
    """
    Full-text search rows via the Dataset Viewer /search endpoint
    """

    (viewer-search-rows "/search" #{query: search_text} cap)


define like-search [search_text feature_path cap]:
    """
    Substring search rows via /filter, covering language keywords the
    full-text index drops as stop words (while, for, each, if, and, or, not)
    """

    define clause (search-like-clause search_text)
    when feature_path:
        set! clause f"{clause} AND {(feature-where-clause feature_path)}"
    (viewer-search-rows "/filter" #{where: clause} cap)


define feature-search [feature_path cap]:
    """
    Fetch rows for a feature filter via the /filter endpoint
    """

    define where (feature-where-clause feature_path)
    (viewer-search-rows "/filter" #{where: where} cap)


@(mcp.tool)
@coroutine-fn
define search_examples [search_text
                        [feature_path :: str value: None]
                        [limit :: int value: 10]]:
    """
    Search verified Koskari corpus examples by text and optional feature

    Text search ranks content words through the full-text index, then
    falls back to substring matching so language keywords the index treats
    as stop words (while, for-each, if, and, or, not) still resolve.
    """

    define cap (min (int limit) 100)
    define rows #[]

    if search_text:
        set! rows (fts-search search_text cap)
        when feature_path:
            set! rows (filter-rows-by-feature rows feature_path)
        unless rows:
            set! rows (like-search search_text feature_path cap)
    elif feature_path:
        set! rows (feature-search feature_path cap)
    else:
        return "Provide search_text and/or feature_path."

    set! rows (item-slice rows 0 cap)
    unless rows:
        return "No matching corpus examples."

    (format-examples rows)


@(mcp.tool)
@coroutine-fn
define get_example [corpus_id]:
    """
    Fetch one corpus record by corpus_id
    """

    define escaped (escape-sql-string corpus_id)
    define where f"\"corpus_id\"='{escaped}'"
    define extra #{
        where: where
        offset: 0
        length: 1
    }
    define data (viewer-get "/filter" extra)
    define rows (viewer-rows data)
    unless rows:
        return f"No corpus example with corpus_id={(repr corpus_id)}."

    define example (compact-example (item rows 0))
    define refs (dict.get example "references")
    when refs:
        set! (item example "references_resolved") (resolve-references refs)
    (json.dumps example)


@(mcp.tool)
@coroutine-fn
define get_reference [path]:
    """
    Fetch one documentation page or example program by its path

    Paths come from a corpus record's references field (documentation
    pages) or are repository-relative example paths beginning with
    examples/. Returns the full raw content.
    """

    define config (reference-config-for path)
    define escaped (escape-sql-string path)
    define where f"\"path\"='{escaped}'"
    define extra #{
        where: where
        offset: 0
        length: 1
    }
    define data (viewer-get "/filter" extra config: config)
    define rows (viewer-rows data)
    unless rows:
        return f"No reference material with path={(repr path)}."
    (json.dumps (pick-fields (item rows 0) _REFERENCE_FULL_KEYS))


@(mcp.tool)
@coroutine-fn
define search_docs [search_text
                    [kind :: str value: None]
                    [limit :: int value: 10]]:
    """
    Search Koskari documentation and example programs by text

    kind restricts results: "doc" for documentation pages, "example" for
    programs; omit it to search both. Returns path, title, and summary for
    each hit; call get_reference with a path for full content.
    """

    define cap (min (int limit) 100)
    define hits #[]
    for-each [config (doc-configs-for kind)]:
        define rows (search-docs-config search_text cap config)
        for-each [row rows]:
            (hits.append (pick-fields row _REFERENCE_HIT_KEYS))

    define limited (item-slice hits 0 cap)
    unless limited:
        return "No matching reference material."
    (json.dumps limited)


@(mcp.tool)
@coroutine-fn
define list_features []:
    """
    List feature paths present in the corpus with occurrence counts
    """

    define seen #{}
    define offset 0
    while True:
        define extra #{
            offset: offset
            length: 100
        }

        define page (viewer-get "/rows" extra)
        define rows (viewer-rows page)
        unless rows:
            (break)

        for-each [row rows]:
            define feature (row.get "feature" "")
            when feature:
                define count (dict.get seen feature 0)
                set! (item seen feature) (+ count 1)

        incr! offset (len rows)

        when (item page "partial"):
            (break)

        when (< (len rows) 100):
            (break)

    unless seen:
        return "No features found."

    define groups #{}
    for-each [pair (sorted (seen.items))]:
        define top (item (.split (item pair 0) "/") 0)
        define bucket (groups.get top)
        when (None? bucket):
            set! bucket #[]
            set! (item groups top) bucket
        (bucket.append pair)

    define lines #[]
    for-each [top (sorted (groups.keys))]:
        define bucket (item groups top)
        define subtotal 0
        for-each [pair bucket]:
            incr! subtotal (item pair 1)
        (lines.append f"{top}/  ({subtotal})")
        for-each [pair bucket]:
            (lines.append f"  {(item pair 0)}\t{(item pair 1)}")
    (.join "\n" lines)


define main []:
    """
    Run the MCP server on stdio transport
    """

    (mcp.run_stdio_async)


when-main:
    (main)


;; The end.
