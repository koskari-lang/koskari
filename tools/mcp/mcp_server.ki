"""
Koskari MCP server for the published language corpus

Forwards search and lookup tools to the Hugging Face Dataset Viewer API
for obriencj/koskari config corpus.

:author: Christopher O'Brien  <obriencj@gmail.com>
:license: GNU General Public License v3
"""


import json
import logging
import sys

import-from argparse ArgumentParser
import-from os getenv
import-from os.path basename

import httpx

import-from mcp.server.fastmcp FastMCP
import-from mcp.server.transport_security TransportSecuritySettings


define logger (logging.getLogger "koskari.mcp")

(logging.basicConfig
    stream: sys.stderr
    level: (getenv "LOGLEVEL" "WARNING"))


define DATASET "obriencj/koskari"
define CONFIG "corpus"
define DOCS_CONFIG "docs"
define PROGRAMS_CONFIG "programs"
define SPLIT "train"
define BASE_URL "https://datasets-server.huggingface.co"

define VERIFY_KEYS #(
    "read" "expand" "eval" "error" "invalid")

define META_KEYS #(
    "corpus_id" "feature" "source" "references" "stability"
    "tags" "schema_version" "git_ref")


define INSTRUCTIONS """
This server is the authoritative and fastest source of truth for the
Koskari language: its documentation, its reference for special forms,
macros, layouts, and reader behavior, and a corpus of verified example
programs with expected results at the read, expand, compile, and eval
phases.

Reach for these tools FIRST -- before reading or grepping repository
source -- whenever a question is about what Koskari is or how it
behaves. This includes "what is X", "how does X work", "how do I write
X", "is this form valid", and "show me an example of X" questions about
any language construct.

Tools:
- search_docs: full-text search across documentation pages and example
  programs. Start here for open-ended questions; each hit returns a path
  to fetch.
- search_examples: search only verified example programs, optionally
  scoped to a feature path. Use to find working (and known-invalid) code.
- get_reference: fetch the full content of one page or example by the
  path returned from a search.
- list_features: enumerate the feature paths present in the corpus.

Typical flow: search_docs or search_examples to locate a path, then
get_reference for the full content. Treat corpus results as ground
truth; fall back to reading source only when the corpus does not cover
the question.
"""


define mcp (FastMCP "koskari-corpus" instructions: INSTRUCTIONS)
define http (httpx.AsyncClient timeout: 30.0)


define escape-sql-string [text]:
    """
    Escape a string for single-quoted SQL filter literals
    """

    (text.replace "'" "''")


define viewer-base-params [config: CONFIG]:
    """
    Shared query parameters for every Dataset Viewer request
    """

    #{dataset: DATASET
      config: config
      split: SPLIT}


define viewer-get [path extra: #{} config: CONFIG]:
    """
    Issue a GET to the Dataset Viewer API and return parsed JSON
    """

    define params (dict (viewer-base-params config: config))
    when extra:
        (params.update extra)

    define url f"{BASE_URL}{path}"
    define response (http.get url params: params)
    (response.raise_for_status)

    define data (response.json)
    define error (data.get "error")

    unless error:
        return data

    (logger.error "viewer API error on %s: %s" path error)
    raise (RuntimeError error)


define viewer-rows [data]:
    """
    Extract row dicts from a /rows, /search, or /filter response
    """

    define rows (data.get "rows" #())
    list-each [entry rows] (item entry "row")


define compact-example [row]:
    """
    Build a compact dict with corpus fields useful to agents
    """

    define out #{}

    for-each [key META_KEYS]:
        define value (row.get key)
        unless (None? value):
            set! (item out key) value

    for-each [key VERIFY_KEYS]:
        define value (row.get key)
        unless (None? value):
            set! (item out key) value

    out


define format-example [row]:
    """
    Serialize one corpus row for MCP tool output
    """

    (json.dumps (compact-example row))


define format-examples [rows]:
    """
    Serialize multiple corpus rows for MCP tool output
    """

    define items (list-each [row rows] (compact-example row))
    (json.dumps items)


;; === Reference material (docs and programs) ===


define REFERENCE_FULL_KEYS #("path" "title" "section" "kind" "content")
define REFERENCE_HIT_KEYS #("path" "title" "summary" "kind")
define DOC_SEARCH_COLUMNS #("path" "title" "content")


define pick-fields [row keys]:
    """
    Build a dict from the named row keys, skipping missing values
    """

    define out #{}
    for-each [key keys]:
        define value (row.get key)
        unless (None? value):
            set! (item out key) value
    out


define reference-config-for [path]:
    """
    Route a reference path to its Dataset Viewer config

    examples/ paths resolve against the programs config; every other path
    is a documentation page in the docs config.
    """

    if (path.startswith "examples/"):
        PROGRAMS_CONFIG
    else:
        DOCS_CONFIG


define resolve-references [refs]:
    """
    Resolve corpus reference paths to their doc title and summary
    """

    unless refs:
        return #[]

    define clauses:
        list-each [ref refs] f"\"path\"='{(escape-sql-string ref)}'"

    define joined (.join " OR " clauses)
    define where f"({joined})"
    define extra #{where: where offset: 0 length: (len refs)}
    define rows (viewer-rows (viewer-get "/filter" extra config: DOCS_CONFIG))

    list-each [row rows]:
        pick-fields row REFERENCE_HIT_KEYS


define doc-like-clause [text]:
    """
    Build an OR of LIKE predicates over documentation text columns
    """

    define escaped (escape-sql-string text)
    define needle f"'%{escaped}%'"
    define clauses:
        list-each [column DOC_SEARCH_COLUMNS]:
            f"\"{column}\" LIKE {needle}"

    define joined (.join " OR " clauses)
    f"({joined})"


define doc-configs-for [kind]:
    """
    Return the Dataset Viewer configs a doc search should cover
    """

    if (== kind "doc"):
        #[DOCS_CONFIG]

    elif (== kind "example"):
        #[PROGRAMS_CONFIG]

    else:
        #[DOCS_CONFIG PROGRAMS_CONFIG]


define search-docs-config [search_text cap config]:
    """
    Search one docs config: full-text first, substring fallback

    Mirrors search_examples: the full-text index drops language stop words,
    so an empty result falls back to substring matching.
    """

    define rows:
        (viewer-search-rows "/search"
            #{query: search_text}
            cap
            config: config)

    unless rows:
        define clause (doc-like-clause search_text)
        set! rows (viewer-search-rows "/filter"
            #{where: clause}
            cap
            config: config)

    rows


define feature-matches? [row feature]:
    """
    Return True when row feature equals or starts with the filter
    """

    define value (row.get "feature" "")
    if (feature.endswith "/"):
        (value.startswith feature)
    else:
        (== value feature)


define feature-where-clause [feature]:
    """
    Build a Dataset Viewer filter predicate for feature
    """

    define escaped (escape-sql-string feature)
    if (feature.endswith "/"):
        f"\"feature\" LIKE '{escaped}%'"
    else:
        f"\"feature\"='{escaped}'"


define filter-rows-by-feature [rows feature]:
    """
    Keep rows whose feature column matches the filter
    """

    (list-each [row rows]
        when: (feature-matches? row feature)
        row)


define SEARCH_COLUMNS #("source" "feature" "corpus_id")


define search-like-clause [text]:
    """
    Build an OR of LIKE predicates matching text as a substring across the
    searchable text columns
    """

    define escaped (escape-sql-string text)
    define needle f"'%{escaped}%'"
    define clauses:
        list-each [column SEARCH_COLUMNS]:
            f"\"{column}\" LIKE {needle}"
    define joined (.join " OR " clauses)
    f"({joined})"


define viewer-search-rows [path extra cap config: CONFIG]:
    """
    Issue a Dataset Viewer query with paging bounds and return its rows
    """

    set! (item extra "offset") 0
    set! (item extra "length") cap
    (viewer-rows (viewer-get path extra config: config))


define fts-search [search_text cap]:
    """
    Full-text search rows via the Dataset Viewer /search endpoint
    """

    (viewer-search-rows "/search" #{query: search_text} cap)


define like-search [search_text feature_path cap]:
    """
    Substring search rows via /filter, covering language keywords the
    full-text index drops as stop words (while, for, each, if, and, or, not)
    """

    define clause (search-like-clause search_text)
    when feature_path:
        set! clause f"{clause} AND {(feature-where-clause feature_path)}"
    (viewer-search-rows "/filter" #{where: clause} cap)


define feature-search [feature_path cap]:
    """
    Fetch rows for a feature filter via the /filter endpoint
    """

    define where (feature-where-clause feature_path)
    (viewer-search-rows "/filter" #{where: where} cap)


define demote-invalid [rows]:
    """
    Sink wrong-usage records below canonical ones without dropping them

    A corpus record tagged ``invalid`` demonstrates a mistake to avoid.
    It stays in the results — searching for it directly is useful — but
    must never outrank a valid example, so a bare form-name query returns
    the canonical usage first rather than a copy-paste footgun. Relative
    order within each group is the search engine's own ranking, preserved.
    """

    define valid #[]
    define wrong #[]
    for-each [row rows]:
        if (in "invalid" (or (row.get "tags") #[])):
            (wrong.append row)
        else:
            (valid.append row)
    (valid.extend wrong)
    valid


@(mcp.tool)
@coroutine-fn
define search_examples [
        search_text
        [feature_path :: str value: None]
        [limit :: int value: 10]]:
    """
    Search verified Koskari corpus examples by text and optional feature

    Text search ranks content words through the full-text index, then
    falls back to substring matching so language keywords the index treats
    as stop words (while, for-each, if, and, or, not) still resolve.
    """

    define cap (min (int limit) 100)
    define rows #[]

    if search_text:
        set! rows (fts-search search_text cap)
        when feature_path:
            set! rows (filter-rows-by-feature rows feature_path)
        unless rows:
            set! rows (like-search search_text feature_path cap)

        ;; A named feature is a valid selector on its own: descriptive
        ;; search_text only matches code columns, so a text miss must not
        ;; suppress the feature's examples.
        unless rows:
            when feature_path:
                set! rows (feature-search feature_path cap)

    elif feature_path:
        set! rows (feature-search feature_path cap)

    else:
        return "Provide search_text and/or feature_path."

    set! rows (item-slice (demote-invalid rows) 0 cap)
    unless rows:
        return "No matching corpus examples."

    (format-examples rows)


@(mcp.tool)
@coroutine-fn
define get_example [corpus_id]:
    """
    Fetch one corpus record by corpus_id
    """

    define escaped (escape-sql-string corpus_id)
    define where f"\"corpus_id\"='{escaped}'"
    define extra #{
        where: where
        offset: 0
        length: 1
    }
    define data (viewer-get "/filter" extra)
    define rows (viewer-rows data)
    unless rows:
        return f"No corpus example with corpus_id={(repr corpus_id)}."

    define example (compact-example (item rows 0))
    define refs (dict.get example "references")
    when refs:
        set! (item example "references_resolved") (resolve-references refs)

    (json.dumps example)


@(mcp.tool)
@coroutine-fn
define get_reference [path]:
    """
    Fetch one documentation page or example program by its path

    Paths come from a corpus record's references field (documentation
    pages) or are repository-relative example paths beginning with
    examples/. Returns the full raw content.
    """

    define config (reference-config-for path)
    define escaped (escape-sql-string path)
    define where f"\"path\"='{escaped}'"
    define extra #{
        where: where
        offset: 0
        length: 1
    }
    define data (viewer-get "/filter" extra config: config)
    define rows (viewer-rows data)
    unless rows:
        return f"No reference material with path={(repr path)}."

    (json.dumps (pick-fields (item rows 0) REFERENCE_FULL_KEYS))


@(mcp.tool)
@coroutine-fn
define search_docs [search_text
                    [kind :: str value: None]
                    [limit :: int value: 10]]:
    """
    Search Koskari documentation and example programs by text

    kind restricts results: "doc" for documentation pages, "example" for
    programs; omit it to search both. Returns path, title, and summary for
    each hit; call get_reference with a path for full content.
    """

    define cap (min (int limit) 100)
    define hits #[]
    for-each [config (doc-configs-for kind)]:
        define rows (search-docs-config search_text cap config)
        for-each [row rows]:
            (hits.append (pick-fields row REFERENCE_HIT_KEYS))

    define limited (item-slice hits 0 cap)
    unless limited:
        return "No matching reference material."

    (json.dumps limited)


@(mcp.tool)
@coroutine-fn
define list_features []:
    """
    List feature paths present in the corpus with occurrence counts
    """

    define seen #{}
    define offset 0
    while True:
        define extra #{
            offset: offset
            length: 100
        }

        define page (viewer-get "/rows" extra)
        define rows (viewer-rows page)
        unless rows:
            (break)

        for-each [row rows]:
            define feature (row.get "feature" "")
            when feature:
                define count (dict.get seen feature 0)
                set! (item seen feature) (+ count 1)

        incr! offset (len rows)

        when (item page "partial"):
            (break)

        when (< (len rows) 100):
            (break)

    unless seen:
        return "No features found."

    define groups #{}
    for-each [p (sorted (seen.items))]:
        define top (item (.split (item p 0) "/") 0)
        define bucket (groups.get top)
        when (None? bucket):
            set! bucket #[]
            set! (item groups top) bucket
        (bucket.append p)

    define lines #[]
    for-each [top (sorted (groups.keys))]:
        define bucket (item groups top)
        define subtotal 0
        for-each [p bucket]:
            incr! subtotal (item p 1)
        (lines.append f"{top}/  ({subtotal})")
        for-each [p bucket]:
            (lines.append f"  {(item p 0)}\t{(item p 1)}")

    (.join "\n" lines)


define main [argv: None]:
    """
    Run the MCP server.

    With no arguments, relay over stdio -- the default, suited to a
    per-session client subprocess. With ``--serve``, serve over
    streamable HTTP bound to all interfaces, for running as a
    shared, long-lived service behind a reverse proxy.
    """

    when (None? argv):
        set! argv sys.argv

    define-values [name *: args] argv

    define parser (ArgumentParser (basename name))
    (parser.add_argument "--serve"
        action: "store_true" default: False
        help: "serve over streamable HTTP (default: stdio only)")
    (parser.add_argument "--host"
        type: str default: "0.0.0.0"
        help: "host when using --serve (default: 0.0.0.0)")
    (parser.add_argument "--port"
        type: int default: 8000
        help: "port when using --serve (default: 8000)")
    (parser.add_argument "--allowed-hosts"
        action: "append" default: #[]
        help: "hostname protection for --serve (default: localhost only)")
    define options (parser.parse_args args)

    ; stdio mode, MCP running in an agent-managed subprocess
    unless options.serve:
        return (mcp.run_stdio_async)

    ; resplit, strip, and filter out empty strings
    define allowed (.split (.join "," options.allowed_hosts) ",")
    set! allowed (list-each [h (map str.strip allowed)] when: h h)

    ; mcp by default filters by requested hostname, allowing only
    ; "localhost" and "127.0.0.1" by default. This needs to be overridden
    ; for the MCP to be accessible from other hosts (eg. proxied and made
    ; publicly accessible).
    when allowed:
        set! mcp.settings.transport_security:
            (TransportSecuritySettings
                allowed_hosts: allowed
                allowed_origins: (list-each [h allowed] f"https://{h}"))

    set! mcp.settings.host options.host
    set! mcp.settings.port options.port

    (logger.info "serving koskari-corpus over http on %s:%i"
        options.host options.port)

    (mcp.run_streamable_http_async)


when-main:
    (main)


; The end.
