"""
Koskari MCP server for the published language corpus

Serves search and lookup tools over a dataset baked into the image at
build time: the corpus, docs, and programs parquet views are loaded into
memory at startup and every query runs against those in-process tables,
so the running service makes no outbound requests.

:author: Christopher O'Brien  <obriencj@gmail.com>
:license: GNU General Public License v3
"""


import json
import logging
import re
import sys

import-from argparse ArgumentParser
import-from os getenv
import-from os.path abspath basename dirname join
import-from pathlib Path

import-from koskari.assets icon_svg_text
import-from mcp.server MCPServer
import-from mcp.server.transport_security TransportSecuritySettings
import-from mcp_types Icon
import-from starlette.responses HTMLResponse JSONResponse PlainTextResponse Response
import-from starlette.routing Route


define logger (logging.getLogger "koskari.mcp")

(logging.basicConfig
    stream: sys.stderr
    level: (getenv "LOGLEVEL" "WARNING"))


;; Baked dataset layout: one parquet per view under the data directory,
;; each written by tools/corpus/export.py as <view>/train.parquet.
define DATA_DIR (getenv "KOSKARI_CORPUS_DATA" "/srv/data")
define CORPUS_VIEW "koskari-corpus"
define DOCS_VIEW "koskari-docs"
define PROGRAMS_VIEW "koskari-programs"


;; The landing page served at the service root over HTTP. It ships
;; beside this script, so the default is resolved from this file rather
;; than from the working directory.
define PAGE_PATH (getenv "KOSKARI_CORPUS_PAGE"
    (join (dirname (abspath __file__)) "index.html"))

;; The project mark comes from the installed koskari.assets package by
;; default -- no local copy needed, since the image already installs
;; koskari itself. KOSKARI_CORPUS_ICON overrides with a path to a
;; different SVG file, for ops flexibility.
define ICON_PATH_OVERRIDE (getenv "KOSKARI_CORPUS_ICON" None)
define ICON_URL "https://corpus.koskari.org/koskari-icon.svg"

define VERIFY_KEYS #(
    "read" "expand" "eval" "error" "invalid")

define META_KEYS #(
    "corpus_id" "feature" "source" "references" "stability"
    "tags" "schema_version" "git_ref")


;; Closed intent-tag vocabulary; source of truth is docs/corpus/SCHEMA.md.
;; Used only to group list_tags output into goal-based vs structural facets.
define INTENT_TAGS #(
    "error-handling" "catch" "cleanup" "re-raise" "guard"
    "loop" "iterate" "accumulate" "early-exit" "filter" "destructure"
    "mutate" "swap" "module-global" "local-binding" "name-resolution"
    "recursion" "default-value" "branch" "multi-way" "short-circuit"
    "higher-order" "closure" "variadic" "compose" "decorate"
    "keyword-argument" "construct" "index" "membership" "await"
    "concurrency" "suspend" "define-type" "inheritance" "predicate"
    "metaprogramming" "hygiene" "idiom" "pitfall")


define INSTRUCTIONS """
This server is the authoritative and fastest source of truth for the
Koskari language: its documentation, its reference for special forms,
macros, layouts, and reader behavior, and a corpus of verified example
programs with expected results at the read, expand, compile, and eval
phases.

Reach for these tools FIRST whenever a question is about what Koskari is
or how it behaves. This includes "what is X", "how does X work", "how do
I write X", "is this form valid", and "show me an example of X" questions
about any language construct.

Cold start: on first use of this server in a session, call
get_reference with path "agents/index.md". It is an orientation page
written for agents: a map of which documentation page answers which
class of question, the rules for writing syntactically valid Koskari
source, and pitfalls for Python/Scheme priors. Pages in the "agents"
section are written explicitly for AI consumers. For effective searching,
see "agents/querying-the-corpus.md".

Tools:
- search_docs: full-text search across documentation pages and example
  programs. Start here for open-ended questions; each hit returns a path
  to fetch.
- search_examples: search only verified example programs, optionally
  scoped to a feature path and narrowed by polarity (valid vs
  wrong-usage). Use to find working (and known-invalid) code.
- get_reference: fetch the full content of one page or example by the
  path returned from a search.
- list_features: enumerate the feature paths present in the corpus.
- list_tags: enumerate searchable tags -- the goal-based intent
  vocabulary and structural tags -- with counts.

Two non-interchangeable kinds of path travel between these tools.
Feature paths (special/compile/cond, layout/try) are
what list_features returns, and search_examples alone accepts them, as
feature_path; a feature filter is an exact match unless it ends in "/",
which makes it a prefix, so "special/compile/" matches that whole
family. Reference paths (reference/specials/compile-cond.md,
agents/index.md, anything under examples/) are what get_reference
takes, and they come from search_docs hits or from the references field
carried by every corpus record. Handed a feature path, get_reference
answers with that feature's reference paths, so a wrong guess still
lands somewhere useful.

Typical flow: search_docs or search_examples to locate a path, then
get_reference for the full content. Treat corpus results as ground
truth; fall back to reading source only when the corpus does not cover
the question. The "agents" documentation section is the fastest route
to correct Koskari syntax.
"""


define mcp:
    (MCPServer "koskari-corpus"
        instructions: INSTRUCTIONS
        icons: #[(Icon src: ICON_URL mime_type: "image/svg+xml" sizes: #["any"])])


;; In-memory tables, each a list of row dicts loaded from parquet at
;; startup, plus the git ref of the baked snapshot and the landing page
;; source. Query functions take a table explicitly and stay pure; the
;; tool bodies read these globals. The dict is mutated in place by
;; load-tables! and load-page!, never rebound.
define STATE #{
    "corpus": #[]
    "docs": #[]
    "programs": #[]
    "git_ref": None
    "page": None
    "icon": None
}


define corpus-table [] STATE["corpus"]
define docs-table [] STATE["docs"]
define programs-table [] STATE["programs"]


;; === Dataset loading ===


define load-parquet [path]:
    """
    Read a parquet file into a list of row dicts

    pyarrow is imported lazily so that merely importing this module (for
    tests or --help) does not require it; it is needed only to serve.
    """

    import-from pyarrow.parquet read_table
    ((read_table path).to_pylist)


define view-path [view]:
    """
    Absolute path to a view's train.parquet under the data directory
    """

    (join DATA_DIR view "train.parquet")


define snapshot-git-ref [rows]:
    """
    Read the baked snapshot's git ref from the first row, or empty string
    """

    if rows:
        (or (rows[0].get "git_ref") "")
    else:
        ""


define load-tables! []:
    """
    Load every baked parquet view into STATE and log the snapshot

    Called once at startup before serving, for every transport mode.
    """

    set! STATE["corpus"] (load-parquet (view-path CORPUS_VIEW))
    set! STATE["docs"] (load-parquet (view-path DOCS_VIEW))
    set! STATE["programs"] (load-parquet (view-path PROGRAMS_VIEW))
    set! STATE["git_ref"] (snapshot-git-ref (corpus-table))

    (logger.info
        "loaded corpus snapshot git_ref=%s (corpus=%i docs=%i programs=%i)"
        STATE["git_ref"]
        (len (corpus-table)) (len (docs-table)) (len (programs-table)))


define load-page! []:
    """
    Load the landing page and project icon into STATE, tolerating
    their absence

    Only the HTTP transports serve either, and the stdio image does
    not ship them, so a missing file leaves the state entry None: the
    root route falls back to a plain pointer at the MCP endpoint, and
    the icon route answers 404.
    """

    try:
        set! STATE["page"] ((Path PAGE_PATH).read_text encoding: "utf-8")
        (logger.info "loaded landing page from %s" PAGE_PATH)
    except [OSError as: exc]:
        (logger.info "no landing page at %s: %s" PAGE_PATH exc)

    try:
        if (None? ICON_PATH_OVERRIDE):
            set! STATE["icon"] (icon_svg_text)
            (logger.info "loaded project icon from koskari.assets")
        else:
            set! STATE["icon"] ((Path ICON_PATH_OVERRIDE).read_text encoding: "utf-8")
            (logger.info "loaded project icon from %s" ICON_PATH_OVERRIDE)
    except [OSError as: exc]:
        (logger.info "no project icon available: %s" exc)


;; === Row shaping ===


define compact-example [row]:
    """
    Build a compact dict with corpus fields useful to agents
    """

    define out #{}

    for-each [key META_KEYS]:
        define value (row.get key)
        unless (None? value):
            set! out[key] value

    for-each [key VERIFY_KEYS]:
        define value (row.get key)
        unless (None? value):
            set! out[key] value

    out


define format-example [row]:
    """
    Serialize one corpus row for MCP tool output
    """

    (json.dumps (compact-example row))


define format-examples [rows]:
    """
    Serialize multiple corpus rows for MCP tool output
    """

    define items (list-each [row rows] (compact-example row))
    (json.dumps items)


define pick-fields [row keys]:
    """
    Build a dict from the named row keys, skipping missing values
    """

    define out #{}
    for-each [key keys]:
        define value (row.get key)
        unless (None? value):
            set! out[key] value
    out


;; === Reference material (docs and programs) ===


define REFERENCE_FULL_KEYS #("path" "title" "section" "kind" "content")
define REFERENCE_HIT_KEYS #("path" "title" "summary" "kind")
define DOC_SEARCH_COLUMNS #("path" "title" "content")
define SEARCH_COLUMNS #("source" "feature" "corpus_id" "tags")


define table-for-path [path]:
    """
    Route a reference path to the table that holds it

    examples/ paths resolve against the programs table; every other path
    is a documentation page in the docs table.
    """

    if (path.startswith "examples/"):
        (programs-table)
    else:
        (docs-table)


define tables-for-kind [kind]:
    """
    Return the tables a doc search should cover

    "doc" restricts to documentation pages, "example" to programs; any
    other value (including None) searches both.
    """

    if (== kind "doc"):
        #[(docs-table)]

    elif (== kind "example"):
        #[(programs-table)]

    else:
        #[(docs-table) (programs-table)]


;; === In-memory query layer ===
;;
;; These pure functions replace the former Dataset Viewer fetch layer.
;; At a few hundred rows a linear scan is sub-millisecond, so no index is
;; warranted. Each takes its table explicitly and is deterministic, which
;; keeps them unit-testable without a network or a real parquet file.


define tokenize [text]:
    """
    Lowercase and split text into content tokens

    The token class keeps hyphens so hyphenated form names (for-each,
    error-handling) tokenize as a single unit rather than fragments.
    """

    (re.findall "[a-z0-9-]+" (.lower (str (or text ""))))


define row-search-text [row columns]:
    """
    Concatenate a row's searchable columns into one string
    """

    " ".join (list-each [column columns] (str (or (row.get column) "")))


define token-score [query_tokens row_tokens]:
    """
    Count how many query tokens appear as whole tokens in the row
    """

    define score 0
    for-each [token query_tokens]:
        when (in? token row_tokens):
            incr! score 1
    score


define token-search [table query columns cap]:
    """
    Rank rows by query-token overlap over the searchable columns

    Content-word matches rank first; rows with no overlap are dropped.
    Ties keep table order, since sorted is stable. Returns up to cap rows.
    """

    define query_tokens (tokenize query)
    unless query_tokens:
        return #[]

    define scored #[]
    for-each [row table]:
        define score (token-score query_tokens (tokenize (row-search-text row columns)))
        when (> score 0):
            (scored.append #(score row))

    define ranked (sorted scored key: (itemgetter 0) reverse: True)
    list-each [pair (item-slice ranked 0 cap)]:
        pair[1]


define substring-search [table query columns cap]:
    """
    Keep rows where the query is a substring of the searchable columns

    Covers language keywords a token match would treat as noise and the
    stop-word-only queries the former full-text index dropped (while,
    for-each, if, and, or, not). Returns up to cap rows in table order.
    """

    define needle (query.lower)
    define out #[]
    for-each [row table]:
        define hay (.lower (row-search-text row columns))
        when (in? needle hay):
            (out.append row)
    (item-slice out 0 cap)


define feature-matches? [row feature]:
    """
    Return True when row feature equals or starts with the filter
    """

    define value (row.get "feature" "")
    if (feature.endswith "/"):
        (value.startswith feature)
    else:
        (== value feature)


define filter-rows-by-feature [rows feature]:
    """
    Keep rows whose feature column matches the filter
    """

    list-each [row rows]:
        when (feature-matches? row feature):
            row


define feature-search [feature_path cap]:
    """
    Rows for a feature filter over the corpus table
    """

    (item-slice (filter-rows-by-feature (corpus-table) feature_path) 0 cap)


define references-for-feature [feature]:
    """
    Distinct reference paths across the corpus records of a feature

    Ordered by first appearance, so the page a feature's earliest
    records cite leads the list.
    """

    define out #[]
    for-each [row (corpus-table)]:
        when (feature-matches? row feature):
            for-each [ref (or (row.get "references") #[])]:
                unless (in? ref out):
                    (out.append ref)
    out


define features-under [prefix]:
    """
    Distinct feature paths beginning with prefix as a path segment

    The prefix is slash-normalized first, so a parent named without its
    trailing slash still finds its family.
    """

    define stem (if (prefix.endswith "/") prefix f"{prefix}/")
    define out #[]
    for-each [row (corpus-table)]:
        define feature (or (row.get "feature") "")
        when (feature.startswith stem):
            unless (in? feature out):
                (out.append feature)
    out


define searchable-table [feature_path]:
    """
    The corpus rows a text search ranks: the whole table, or only the
    rows of a feature, so the feature narrows before the limit cuts
    """

    if feature_path:
        (filter-rows-by-feature (corpus-table) feature_path)
    else:
        (corpus-table)


define fts-search [search_text feature_path cap]:
    """
    Token-ranked corpus search over the code-bearing columns,
    optionally narrowed to a feature
    """

    (token-search (searchable-table feature_path) search_text SEARCH_COLUMNS cap)


define like-search [search_text feature_path cap]:
    """
    Substring corpus search, optionally narrowed to a feature

    Covers language keywords the token search drops as noise (while,
    for-each, if, and, or, not).
    """

    (substring-search (searchable-table feature_path) search_text SEARCH_COLUMNS cap)


define search-docs-table [search_text cap table]:
    """
    Search one docs/programs table: token-ranked first, substring fallback

    Mirrors search_examples: a token miss falls back to substring so short
    keyword queries still resolve.
    """

    or:
        (token-search table search_text DOC_SEARCH_COLUMNS cap)
        (substring-search table search_text DOC_SEARCH_COLUMNS cap)


define first-by-field [table field value]:
    """
    Return the first row whose field equals value, or None
    """

    for-each [row table]:
        when (== (row.get field) value):
            return row
    None


define resolve-references [refs]:
    """
    Resolve corpus reference paths to their doc title and summary
    """

    unless refs:
        return #[]

    define out #[]
    for-each [ref refs]:
        define row (first-by-field (docs-table) "path" ref)
        when row:
            (out.append (pick-fields row REFERENCE_HIT_KEYS))
    out


define row-invalid? [row]:
    """
    True when the record is tagged as wrong-usage (``invalid``)
    """

    (in? "invalid" (or (row.get "tags") #[]))


define demote-invalid [rows]:
    """
    Sink wrong-usage records below canonical ones without dropping them

    A corpus record tagged ``invalid`` demonstrates a mistake to avoid.
    It stays in the results — searching for it directly is useful — but
    must never outrank a valid example, so a bare form-name query returns
    the canonical usage first rather than a copy-paste footgun. Relative
    order within each group is the search ranking, preserved.
    """

    define valid #[]
    define wrong #[]
    for-each [row rows]:
        if (row-invalid? row):
            (wrong.append row)
        else:
            (valid.append row)
    (valid.extend wrong)
    valid


define filter-by-polarity [rows polarity]:
    """
    Restrict rows by validity when polarity asks for it

    ``valid`` keeps canonical usage (drops wrong-usage records);
    ``invalid`` keeps only wrong-usage records, for how-not-to queries.
    Any other value (including None) leaves the set untouched. Applied as
    a refinement of an existing text/feature result, so it narrows within
    the fetched window rather than scanning the whole corpus.
    """

    switch polarity:
        case ["valid"]:
            (list-each [row rows] unless: (row-invalid? row) row)
        case ["invalid"]:
            (list-each [row rows] when: (row-invalid? row) row)
        else:
            rows


define reference-miss [path]:
    """
    Answer a reference lookup that matched no page

    A feature path is the likeliest wrong guess here, since
    list_features hands them out and they name no page at all. When the
    path is one, resolve it to the references its records cite so the
    guess still arrives; when it merely prefixes features, name them and
    the trailing slash that selects them.
    """

    define refs (references-for-feature path)
    when refs:
        return (json.dumps #{
            "path": path
            "kind": "feature"
            "note": "Not a reference path: this is a feature path. "-
                "The pages below document it -- call get_reference on "-
                "one. For the examples themselves, call search_examples "-
                f"with feature_path={(repr path)}."
            "references": refs})

    define under (features-under path)
    when under:
        return (json.dumps #{
            "path": path
            "kind": "feature-prefix"
            "note": "Not a reference path: this names a family of "-
                "features. Pass one of these to search_examples as "-
                "feature_path, or the prefix with a trailing slash to "-
                "take the whole family."
            "features": (item-slice under 0 20)})

    f"No reference material with path={(repr path)}. "-
    "Reference paths come from search_docs hits or from a record's "-
    "references field; feature paths from list_features belong in "-
    "search_examples as feature_path."


;; === Tools ===


@(mcp.tool)
@coroutine-fn
define search_examples [
        search_text
        [feature_path :: str value: None]
        [polarity :: str value: None]
        [limit :: int value: 10]]:
    """
    Search verified Koskari corpus examples by text and optional feature

    Text search ranks content words by token overlap, then falls back to
    substring matching so language keywords the token search drops as
    noise (while, for-each, if, and, or, not) still resolve.

    feature_path takes the paths list_features returns, and is the only
    place they are accepted. It is an exact match unless it ends in "/",
    which makes it a prefix: "special/compile/" matches that whole
    family, while "special/compile" matches nothing. A feature is a
    valid selector on its own, with no search_text.

    polarity narrows by validity: "valid" returns only canonical usage,
    "invalid" returns only wrong-usage (how-not-to) records; omit it for
    both. It refines the text/feature result, so it filters within the
    fetched window.
    """

    define cap (min (int limit) 100)
    define rows #[]

    if search_text:
        set! rows (fts-search search_text feature_path cap)
        unless rows:
            set! rows (like-search search_text feature_path cap)

        ;; A named feature is a valid selector on its own: descriptive
        ;; search_text only matches code columns, so a text miss must not
        ;; suppress the feature's examples.
        unless rows:
            when feature_path:
                set! rows (feature-search feature_path cap)

    elif feature_path:
        set! rows (feature-search feature_path cap)

    else:
        return "Provide search_text and/or feature_path."

    set! rows (filter-by-polarity rows polarity)
    set! rows (item-slice (demote-invalid rows) 0 cap)
    unless rows:
        return "No matching corpus examples. A feature_path is an "-
            "exact match unless it ends in '/', which makes it a prefix "-
            "over the family; its values come from list_features. Free "-
            "text belongs in search_text, and search_docs covers the "-
            "documentation that search_examples does not."

    format-examples rows


@(mcp.tool)
@coroutine-fn
define get_example [corpus_id]:
    """
    Fetch one corpus record by corpus_id
    """

    define row (first-by-field (corpus-table) "corpus_id" corpus_id)
    unless row:
        return f"No corpus example with corpus_id={(repr corpus_id)}."

    define example (compact-example row)
    define refs (example.get "references")
    when refs:
        set! example["references_resolved"] (resolve-references refs)

    json.dumps example


@(mcp.tool)
@coroutine-fn
define get_reference [path]:
    """
    Fetch one documentation page or example program by its path

    Paths come from a corpus record's references field (documentation
    pages) or are repository-relative example paths beginning with
    examples/. Returns the full raw content. The path "agents/index.md"
    is the orientation page for agents.

    A feature path is not a reference path, but passing one here is
    answered with the reference paths that feature's records cite,
    rather than with a miss.
    """

    define row (first-by-field (table-for-path path) "path" path)
    unless row:
        return (reference-miss path)

    json.dumps (pick-fields row REFERENCE_FULL_KEYS)


@(mcp.tool)
@coroutine-fn
define search_docs [
        search_text
        [kind :: str value: None]
        [limit :: int value: 10]]:
    """
    Search Koskari documentation and example programs by text

    kind restricts results: "doc" for documentation pages, "example" for
    programs; omit it to search both. Returns path, title, and summary for
    each hit; call get_reference with a path for full content.
    Documentation in the "agents" section is written for AI consumers.
    """

    define cap (min (int limit) 100)
    define hits #[]
    for-each [table (tables-for-kind kind)]:
        define rows (search-docs-table search_text cap table)
        for-each [row rows]:
            (hits.append (pick-fields row REFERENCE_HIT_KEYS))

    define limited (item-slice hits 0 cap)
    unless limited:
        return "No matching reference material. Try fewer or more "-
            "common words, drop kind to search both pages and programs, "-
            "or call search_examples for corpus records with their "-
            "expected results."

    json.dumps limited


@(mcp.tool)
@coroutine-fn
define list_features []:
    """
    List feature paths present in the corpus with occurrence counts
    """

    define seen #{}
    for-each [row (corpus-table)]:
        define feature (row.get "feature" "")
        when feature:
            define count (seen.get feature 0)
            set! seen[feature] (+ count 1)

    unless seen:
        return "No features found."

    define groups #{}
    for-each [p (sorted (seen.items))]:
        define top (p[0].split "/")[0]

        define bucket (groups.get top)
        unless bucket:
            set! bucket #[]
            set! groups[top] bucket
        bucket.append p

    define lines #[]
    for-each [top (sorted (groups.keys))]:
        define bucket groups[top]
        define subtotal 0

        for-each [p bucket]:
            incr! subtotal p[1]

        lines.append f"{top}/  ({subtotal})"
        for-each [p bucket]:
            lines.append f"  {p[0]}\t{p[1]}"

    ;; The listing is a dead end without this: nothing in a feature path
    ;; says which tool consumes it, or that the group headings above are
    ;; themselves usable as prefixes.
    lines.append ""
    lines.append "Pass any of these to search_examples as "-
        "feature_path, or a group heading with its trailing slash to "-
        "take the whole family. get_reference does not take feature "-
        "paths; a record's references field names its documentation."

    "\n".join lines


@(mcp.tool)
@coroutine-fn
define list_tags []:
    """
    List corpus tags with occurrence counts, grouped by facet

    Tags are searchable, so these are the words search_examples matches
    and the goal vocabulary to pair with polarity. Output splits the
    closed intent (goal-based) vocabulary from structural tags (form
    names, categories, surface markers); each group is sorted by count.
    """

    define seen #{}
    for-each [row (corpus-table)]:
        for-each [tag (or (row.get "tags") #())]:
            define count (seen.get tag 0)
            set! seen[tag] (+ count 1)

    unless seen:
        return "No tags found."

    define ranked:
        (sorted (seen.items)
            key: { #((- %1[1]) %1[0]) })

    define intent #[]
    define structural #[]
    for-each [[tag rank] ranked]:
        define line f"  {tag}\t{rank}"
        if (in? tag INTENT_TAGS):
            (intent.append line)
        else:
            (structural.append line)

    define lines #[]
    lines.append f"intent ({(len intent)}):"
    lines.extend intent
    lines.append f"structural ({(len structural)}):"
    lines.extend structural

    "\n".join lines


@(mcp.tool)
@coroutine-fn
define corpus_version []:
    """
    Report the baked snapshot's git ref and per-view row counts

    Since the dataset is fixed at build time, this identifies exactly
    which snapshot a running deployment is serving.
    """

    json.dumps #{
        "git_ref": STATE["git_ref"]
        "corpus": (len (corpus-table))
        "docs": (len (docs-table))
        "programs": (len (programs-table))
    }


;; === Landing page ===


;; The service root is outside the MCP protocol: custom routes are
;; served by the same app that carries /mcp, so this answers under both
;; --serve and --lambda, and is simply never reached over stdio. The
;; page drives /mcp from the browser on the same origin, so it needs no
;; CORS allowance and no configuration of its own.

@(mcp.custom_route "/" methods: #["GET"])
@coroutine-fn
define landing_page [request]:
    """
    Serve the landing page at the service root
    """

    define page STATE["page"]
    unless page:
        return (PlainTextResponse
            "koskari-corpus MCP server. The endpoint is POST /mcp.\n")

    (HTMLResponse page
        headers: #{"Cache-Control": "public, max-age=300"})


;; The project mark, served both under its own name (referenced by the
;; landing page and the MCP icons: field) and at /favicon.ico, so a
;; browser's automatic favicon fetch gets it too -- browsers sniff the
;; Content-Type here, not the .ico extension.

@(mcp.custom_route "/koskari-icon.svg" methods: #["GET"])
@(mcp.custom_route "/favicon.ico" methods: #["GET"])
@coroutine-fn
define serve_icon [request]:
    """
    Serve the project mark
    """

    define icon STATE["icon"]
    unless icon:
        return (PlainTextResponse "" status_code: 404)

    (Response icon
        media_type: "image/svg+xml"
        headers: #{"Cache-Control": "public, max-age=300"})


;; === GET /mcp fallback ===


;; The streamable-HTTP GET path exists to carry server-initiated
;; messages on an existing session. This deployment is stateless
;; (--lambda and --serve both), so that stream can never receive
;; anything: a client that advertises SSE support in its Accept
;; header -- most MCP clients do, even on a bare probe -- would
;; otherwise hang on GET /mcp until the invocation times out, rather
;; than getting an answer. mcp.custom_route cannot fix this: the SDK's
;; /mcp route matches every method, and custom routes are appended
;; after it, so a decorator-registered GET handler here would never
;; be reached. Instead, run_streamable_http_with_info below builds
;; the app directly and splices this route in ahead of the catch-all.

@coroutine-fn
define serve_mcp_info [request]:
    """
    Answer a plain GET /mcp with server identity
    """

    JSONResponse #{
        "name": "koskari-corpus"
        "protocol": "mcp"
        "transport": "streamable-http"
        "endpoint": "POST /mcp"
        "git_ref": STATE["git_ref"]
    }


define run_streamable_http_with_info [host port **: app_kwargs]:
    """
    Run streamable HTTP, with GET /mcp answered directly

    Reimplements the few lines mcp.run_streamable_http_async wraps, so
    the info route can be spliced ahead of the SDK's catch-all /mcp
    route before serving.
    """

    import uvicorn

    define app:
        (mcp.streamable_http_app
            host: host
            **: app_kwargs)

    (app.routes.insert 0
        (Route "/mcp"
            endpoint: serve_mcp_info
            methods: #["GET"]))

    define config:
        (uvicorn.Config app
            host: host port: port
            log_level: (mcp.settings.log_level.lower))

    define server (uvicorn.Server config)
    (server.serve)


;; === Entry point ===


define main [argv: None]:
    """
    Run the MCP server.

    Loads the baked dataset into memory, then serves in one of three
    mutually exclusive modes. With no flag, relay over stdio -- the
    default, suited to a per-session client subprocess. With ``--serve``,
    serve over streamable HTTP bound to all interfaces, for a shared,
    long-lived service behind a reverse proxy. With ``--lambda``, serve
    stateless streamable HTTP on the loopback port the AWS Lambda Web
    Adapter proxies to. ``--serve`` and ``--lambda`` cannot be combined.
    """

    when (None? argv):
        set! argv sys.argv

    define-values [name *: args] argv

    define parser (ArgumentParser (basename name))
    define mode (parser.add_mutually_exclusive_group)
    (mode.add_argument "--serve"
        action: "store_true" default: False
        help: "serve over streamable HTTP (default: stdio only)")
    (mode.add_argument "--lambda"
        dest: "lambda_mode" action: "store_true" default: False
        help: "serve stateless streamable HTTP behind the AWS Lambda Web Adapter")
    (parser.add_argument "--host"
        type: str default: "0.0.0.0"
        help: "host when using --serve (default: 0.0.0.0)")
    (parser.add_argument "--port"
        type: int default: 8000
        help: "port when using --serve (default: 8000)")
    (parser.add_argument "--allowed-hosts"
        action: "append" default: #[]
        help: "hostname protection for --serve (default: localhost only)")
    define options (parser.parse_args args)

    (load-tables!)
    (load-page!)

    ; Lambda mode: stateless JSON on the loopback port the Lambda Web
    ; Adapter proxies to. Session state must not live in-process, since
    ; consecutive requests from one client can land on different Lambda
    ; execution environments; host protection is enforced at the gateway.
    when options.lambda_mode:
        define port (int (getenv "PORT" "8080"))
        (logger.info "serving koskari-corpus for lambda on 127.0.0.1:%i" port)
        return (run_streamable_http_with_info
            host: "127.0.0.1"
            port: port
            stateless_http: True
            json_response: True
            transport_security: (TransportSecuritySettings
                enable_dns_rebinding_protection: False))

    ; stdio mode, MCP running in an agent-managed subprocess
    unless options.serve:
        return (mcp.run_stdio_async)

    ; resplit, strip, and filter out empty strings
    define allowed ((",".join options.allowed_hosts).split ",")
    set! allowed (list-each [h (map str.strip allowed)] when: h h)

    ; mcp by default filters by requested hostname, allowing only
    ; "localhost" and "127.0.0.1" by default. This needs to be overridden
    ; for the MCP to be accessible from other hosts (eg. proxied and made
    ; publicly accessible).
    define security None
    when allowed:
        set! security:
            (TransportSecuritySettings
                allowed_hosts: allowed
                allowed_origins: (list-each [h allowed] f"https://{h}"))

    (logger.info "serving koskari-corpus over http on %s:%i"
        options.host options.port)

    (run_streamable_http_with_info
        host: options.host
        port: options.port
        transport_security: security)


when-main:
    (main)


; The end.
