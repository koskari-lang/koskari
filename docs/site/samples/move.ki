import-from types SimpleNamespace

define move! [&source &target n]:
    decr! source n
    incr! target n

define shelves #{"front": 5 "back": 0}
define bins #[2 0]
define truck (SimpleNamespace crates: 0)

move! &shelves["front"] &shelves["back"] 3
move! &bins[0] &bins[1] 2
move! &shelves["back"] &truck.crates 1
(print shelves bins truck.crates)
;; {'front': 2, 'back': 2} [0, 2] 1
