import-from itertools count


define-syntax retry:
    syntax-rules []:
        retry times body ...:
            let loop [[left times]]:
                try:
                    (begin body ...)
                except [Exception as: e]:
                    if (> left 1):
                        (loop (- left 1))
                    else:
                        (raise e)


define attempts (count 1)

define flaky []:
    define n (next attempts)
    (print f"attempt {n}")
    if (< n 3):
        (raise (RuntimeError "not yet"))
    else:
        f"ok on attempt {n}"

define result:
    retry 5:
        (flaky)

(print result)
;; attempt 1
;; attempt 2
;; attempt 3
;; ok on attempt 3
