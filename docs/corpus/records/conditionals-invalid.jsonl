{"id":"conditional-layout-if-multiple-else-001","feature":"layout/if","source":"if False:\n  1\nelse:\n  2\nelse:\n  3","verify":{"error":"LayoutError"},"references":["reference/layouts/layout-if.md"],"stability":"evolving","tags":["conditional","if","surface:block","invalid"],"notes":"multiple else peers are not allowed; second else raises LayoutError"}
