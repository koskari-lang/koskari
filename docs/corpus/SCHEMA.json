{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koskari.dev/corpus/schema.json",
  "title": "Koskari corpus record",
  "type": "object",
  "required": ["id", "feature", "source", "verify"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "verify": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "read": { "type": "string" },
        "expand": { "type": "string" },
        "eval": { "type": "string" },
        "error": { "type": "string" },
        "invalid": { "type": "string" },
        "warning": { "type": "string" }
      }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stability": {
      "type": "string",
      "enum": ["stable", "evolving", "experimental"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    }
  }
}
