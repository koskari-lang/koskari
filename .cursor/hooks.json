{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/git-readonly.py",
        "matcher": "git",
        "failClosed": true
      },
      {
        "command": "python3 .cursor/hooks/tox-guard.py",
        "matcher": "tox",
        "failClosed": true
      }
    ]
  }
}
