# Valgrind suppression file for Python
#
# Python's memory allocator and internal structures often trigger
# false positives in Valgrind. These suppressions filter out known
# benign issues to help focus on real problems in our code.
#
# Note: Python allocates many long-lived objects (type objects, interned
# strings, module dicts) that appear as "leaks" but are expected to
# persist for the lifetime of the interpreter.
#
# Usage:
#   valgrind --suppressions=valgrind-python.supp ./test_harness


# Broad pymalloc / PyDict_* / PyList_* / PyTuple_* / PyLong_* / PyUnicode_*
# suppressions are intentionally NOT used: we allocate through those paths
# too, so suppressing them would hide our leaks. Only Python-internal call
# sites below are suppressed.


# === Test harness: initialize_python ===
#
# Leaks whose stack includes our initialize_python() (Py_Initialize call).
# Python init allocates objects that are not always freed before process exit;
# we ignore these so Valgrind output focuses on koskari and test code.

{
   test-harness-initialize-python
   Memcheck:Leak
   ...
   fun:initialize_python
}


# === Test harness: initialize_types ===
#
# Leaks whose stack includes our initialize_types() (koskari_*_init calls).
# Module-init allocates types, enums, and module dict entries that are not
# torn down before process exit; we ignore these so Valgrind focuses on
# runtime leaks in tests and eval.

{
   test-harness-initialize-types
   Memcheck:Leak
   ...
   fun:initialize_types
}


# === Python initialization ===
#
# Memory allocated during Py_Initialize that persists until Py_Finalize.

{
   python-init-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:Py_Initialize*
}

{
   python-init-possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:Py_Initialize*
}


# === Python type system ===
#
# Type objects and related structures that persist for the interpreter lifetime.

{
   python-type-ready
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:PyType_Ready
}

{
   python-type-ready-possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:PyType_Ready
}


# === Python import system ===
#
# Module import machinery allocations.

{
   python-import-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:PyImport_*
}

{
   python-import-possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:PyImport_*
}


# === Python string interning ===
#
# Interned strings persist for interpreter lifetime.

{
   python-unicode-intern
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:PyUnicode_InternInPlace
}

{
   python-unicode-intern-possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:PyUnicode_InternInPlace
}


# === Python GC ===
#
# Garbage collector data structures.

{
   python-gc-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_PyObject_GC_*
}


# === dlopen/dlsym ===
#
# Dynamic loading of shared libraries (extension modules).

{
   dlopen-leak
   Memcheck:Leak
   ...
   fun:dlopen*
}

{
   dlsym-leak
   Memcheck:Leak
   ...
   fun:dlsym*
}


# === glibc ===
#
# Standard library allocations that persist.

{
   glibc-ld-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/ld-*.so*
}

{
   glibc-libc-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libc*.so*
}


# === Conditional jump on uninitialized (common false positives) ===
#
# Some Python internal operations trigger these warnings benignly.

{
   python-cond-uninit
   Memcheck:Cond
   ...
   obj:*/libpython*.so*
}

{
   python-value-uninit
   Memcheck:Value8
   ...
   obj:*/libpython*.so*
}


# === Python finalization ===
#
# Some memory is intentionally not freed during Py_Finalize.

{
   python-finalize-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:Py_Finalize*
}


# === PyRun_String (embedded eval tests) ===
#
# test_eval.c uses PyRun_String to define small Python classes/functions.
# CPython's compiler allocates dicts and related structures during
# _PyAST_Compile that Valgrind still reports as lost at exit even after
# Py_DECREF of the prelude dict and Py_Finalize; this is confined to
# test_eval.c in this harness.

{
   python-pyrun-string-flags-leak
   Memcheck:Leak
   ...
   fun:PyRun_StringFlags
}
