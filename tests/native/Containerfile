# Containerfile for native memory tests with ASan and Valgrind
#
# This container provides a consistent environment for running memory
# tests with AddressSanitizer and Valgrind, regardless of what tools
# are available on the host system.
#
# Build:
#   podman build -t koskari-native-tests -f Containerfile .
#
# Default (normal tests):
#   podman run --rm -v ../../:/src:Z koskari-native-tests
#
# Run specific test mode:
#   podman run --rm -v ../../:/src:Z koskari-native-tests asan
#   podman run --rm -v ../../:/src:Z koskari-native-tests valgrind
#   podman run --rm -v ../../:/src:Z koskari-native-tests all
#
# author: Christopher O'Brien <obriencj@gmail.com>
# license: GPL v.3

FROM fedora:40

LABEL maintainer="obriencj@gmail.com" \
      description="Native memory test environment for koskari"

# Install build dependencies:
# - clang, lld: the compiler (the evaluator needs musttail, which this
#   image's gcc predates) and the LTO linker for the full-suite modes;
#   clang carries its own ASan runtime
# - make: build system
# - python3-devel: Python headers for extension building
# - python3-pip: for the tox install below
# - valgrind: memory error detector
RUN dnf install -y \
    clang \
    lld \
    make \
    python3-devel \
    python3-pip \
    valgrind \
    && dnf clean all

# tox drives the full-suite sanitizer modes (suite-asan,
# suite-valgrind) using the [testenv:asan] / [testenv:valgrind]
# definitions from setup.cfg.
RUN pip3 install --no-cache-dir tox tox-uv

WORKDIR /src/tests/native

ENV BUILD_DIR=/build

ENTRYPOINT ["make", "-f", "tests.mk"]
CMD ["normal"]


# The end.
