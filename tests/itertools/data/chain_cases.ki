"""
Chain shapes exercising koskari.itertools; imported by tests.itertools
"""


import-from koskari.itertools chain


(var mixed (list (chain #[1 2] #(3) "ab")))

(var no-sources (list (chain)))

(var one-source (list (chain (range 3))))

(var empty-sources (list (chain #[] #[1] #[] #[2] #[])))

(var nested (list (chain (chain #[1] #[2]) (chain) #[3])))


def counting []:
  yield 10
  yield 20

(var generator-source (list (chain (counting) #[30])))


(var visits #[])

def visiting [tag]:
  (visits.append tag)
  yield tag

(var lazy-chain (chain (visiting 1) (visiting 2) (visiting 3)))
(var lazy-first (next (iter lazy-chain)))
(var visits-after-first (list visits))
(var lazy-rest (list lazy-chain))
