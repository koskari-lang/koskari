"""
Search shapes exercising koskari.solve; imported by tests.solve
"""


import-from koskari.solve NoActiveSearch amb fail require solve solve-first


(define triples
  (solve
    (lambda []
      (define a (amb (range 1 15)))
      (define b (amb (range a 15)))
      (define c (amb (range b 15)))
      (require (== (+ (* a a) (* b b)) (* c c)))
      (#tuple a b c))))


(define first-triple
  (solve-first
    (lambda []
      (define a (amb (range 1 15)))
      (define b (amb (range a 15)))
      (define c (amb (range b 15)))
      (require (== (+ (* a a) (* b b)) (* c c)))
      (#tuple a b c))))


(define no-solution
  (solve-first
    (lambda []
      (define x (amb (#list 1 2 3)))
      (require (> x 10))
      x)))


(define all-failing
  (solve
    (lambda []
      (define x (amb (#list 1 2 3)))
      (fail))))


; A solve nested inside a solve-first: the inner search runs to
; completion and the outer stop marker does not leak into it.
(define nested
  (solve-first
    (lambda []
      (define outer (amb (#list 1 2 3)))
      (define inner-all
        (solve
          (lambda []
            (define y (amb (#list 10 20)))
            (+ outer y))))
      (require (== outer 2))
      (#tuple outer inner-all))))


; solve-first skips remaining choices once a solution is accepted: with
; choices 1 2 3 and a guard passing from 2 up, only two branches run.
(define visits (#list))

(define first-passing
  (solve-first
    (lambda []
      (define x (amb (#list 1 2 3)))
      (visits.append x)
      (require (> x 1))
      x)))


; amb and fail with no enclosing search delimiter raise the module's
; NoActiveSearch rather than the VM's capture vocabulary.
define catch-no-search [thunk]:
  try:
    (thunk)
    None
  except [e NoActiveSearch]:
    e

(define outside-amb (catch-no-search (lambda [] (amb (#list 1 2 3)))))

(define outside-fail (catch-no-search (lambda [] (fail))))


;; The end.
