"""
Search shapes exercising koskari.solve; imported by tests.solve
"""


import-from koskari.solve NoActiveSearch amb fail require solve solve-first


(var triples
  (solve
    (lambda []
      (var a (amb (range 1 15)))
      (var b (amb (range a 15)))
      (var c (amb (range b 15)))
      (require (== (+ (* a a) (* b b)) (* c c)))
      (#tuple a b c))))


(var first-triple
  (solve-first
    (lambda []
      (var a (amb (range 1 15)))
      (var b (amb (range a 15)))
      (var c (amb (range b 15)))
      (require (== (+ (* a a) (* b b)) (* c c)))
      (#tuple a b c))))


(var no-solution
  (solve-first
    (lambda []
      (var x (amb (#list 1 2 3)))
      (require (> x 10))
      x)))


(var all-failing
  (solve
    (lambda []
      (var x (amb (#list 1 2 3)))
      (fail))))


; A solve nested inside a solve-first: the inner search runs to
; completion and the outer stop marker does not leak into it.
(var nested
  (solve-first
    (lambda []
      (var outer (amb (#list 1 2 3)))
      (var inner-all
        (solve
          (lambda []
            (var y (amb (#list 10 20)))
            (+ outer y))))
      (require (== outer 2))
      (#tuple outer inner-all))))


; solve-first skips remaining choices once a solution is accepted: with
; choices 1 2 3 and a guard passing from 2 up, only two branches run.
(var visits (#list))

(var first-passing
  (solve-first
    (lambda []
      (var x (amb (#list 1 2 3)))
      (visits.append x)
      (require (> x 1))
      x)))


; amb and fail with no enclosing search delimiter raise the module's
; NoActiveSearch rather than the VM's capture vocabulary.
def catch-no-search [thunk]:
  try:
    (thunk)
    None
  except [e NoActiveSearch]:
    e

(var outside-amb (catch-no-search (lambda [] (amb (#list 1 2 3)))))

(var outside-fail (catch-no-search (lambda [] (fail))))


; A reset in the thunk being solved is not a search delimiter: amb
; reaches past it to the search, and each choice runs the rest of the
; thunk, the reset included.
(var reset-in-thunk
  (solve
    (lambda []
      (reset (+ 100 (amb (#list 1 2)))))))


; A reset alone does not delimit a search.
(var reset-without-search
  (catch-no-search (lambda [] (reset (amb (#list 1 2))))))


; A plain shift in the thunk with no reset of its own crosses the
; search delimiter, whose tag differs. It captures up to a reset around
; the solve call, the search included: k runs the rest of the thunk and
; the search, and the handler's value is that reset's value.
(var shift-past-search
  (reset
    (solve
      (lambda []
        (+ 10 (shift k (#tuple "handler" (k 5))))))))


; With no reset around the solve call either, the shift finds no prompt
; of its own tag. The search does not claim the failure.
def catch-not-found [thunk]:
  try:
    (thunk)
    None
  except [e KoskariPromptNotFound]:
    e

(var shift-without-reset
  (catch-not-found
    (lambda [] (solve (lambda [] (shift k (k 5)))))))


;; The end.
