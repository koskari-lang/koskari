;; Full-stack reproducer: a native batched over a koskari generator.
;; The generator's exhaustion arrives on the in-flight path, where the
;; step frame is the live frame, so the short final batch depends on
;; the raise walk handing that exhaustion to the frame's armed resume.


import-from koskari.lib batched


define gen [items]:
    for-each [i items]:
        yield i


define batches [items n]:
    list (batched (gen items) n)


define short_tail []:
    batches #[0 1 2 3 4 5 6] 3


define whole_source_is_one_short_batch []:
    batches #[0 1] 5


define even_division []:
    batches #[0 1 2 3 4 5] 3


define flattened []:
    define out #[]
    for-each [batch (batched (gen #[0 1 2 3 4]) 2)]:
        for-each [item batch]:
            out.append item
    out


;; A source that fails rather than running out. The failure arrives on
;; the same in-flight path as the exhaustion above, so it reaches the
;; step's resume the same way -- and must propagate rather than being
;; read as the source running out.


define boom [at]:
    for-each [i #[0 1 2 3]]:
        if (== i at):
            raise (ValueError "boom")
        yield i


define raise_inside_first_batch []:
    list (batched (boom 1) 3)


define raise_on_a_batch_boundary []:
    list (batched (boom 3) 3)
