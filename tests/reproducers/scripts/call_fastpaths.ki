;; Kernels for the call and return fast paths: self-tail in-place
;; namespace rebind, plain returns delivered into loop / let / foreach
;; extents, and unbound method calls through the cached-frame steal.


;; Self-tail at simple arity: after the first promoted hop the frame's
;; FN tag matches the callee, so every following hop rebinds the live
;; namespace in place.

def tail_sum [n acc]:
    if (<= n 0):
        acc
    else:
        (tail_sum (- n 1) (+ acc n))


def add_one [x]:
    (+ x 1)


;; One helper call per while iteration: every return delivers into the
;; LOOP extent above the caller's frame.

def sum_calls_while [n]:
    var total 0
    var i 0
    while (< i n):
        incr! total (add_one i)
        incr! i
    total


;; One helper call per foreach iteration: returns deliver into the
;; FOREACH extent.

def sum_calls_foreach [n]:
    var total 0
    for-each [i (range n)]:
        incr! total (add_one i)
    total


;; A helper call under a let binding: the return delivers into the NS
;; extent.

def sum_calls_let [n]:
    var total 0
    var i 0
    while (< i n):
        let [[bump (add_one i)]]:
            incr! total bump
        incr! i
    total


define-class Counter []:

    def __init__ [self]:
        set! self.total 0

    def bump [self v]:
        set! self.total (+ self.total v)
        self.total


;; Unbound method calls at simple arity: the self-steal route with the
;; cached frame.

def bump_loop [c n]:
    var i 0
    while (< i n):
        (c.bump i)
        incr! i
    c.total


;; A single warm method-call site for the shadowing tests: the Python
;; side warms it, then plants instance attributes that must shadow the
;; class method on later calls through this same site.

def call_bump [c v]:
    (c.bump v)


;; The end.
