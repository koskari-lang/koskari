;; Full-stack reproducer: runs of consecutive local loads pack into
;; FAST2/FAST3/FAST4 (VAR2/VAR3/VAR4 before fast conversion) and push
;; in source order through the bulk handlers. String concatenation
;; keeps every check order-sensitive.


def verify_fast2 []:
    var a "a"
    var b "b"
    equal? #(a b) #("a" "b")


def verify_fast3 []:
    var a "a"
    var b "b"
    var c "c"
    equal? (+ a b c) "abc"


def verify_fast4_fast3 []:
    var a "a"
    var b "b"
    var c "c"
    var d "d"
    var e "e"
    var f "f"
    var g "g"
    equal? (+ a b c d e f g) "abcdefg"


;; constant runs pack too; the arguments of a call keep the loads
;; apart from constant folding

def cat3 [a b c]:
    (+ a b c)


def cat4 [a b c d]:
    (+ a b c d)


def verify_const3 []:
    equal? (cat3 "x" "y" "z") "xyz"


def verify_const4 []:
    equal? (cat4 "w" "x" "y" "z") "wxyz"


def verify_fast4 []:
    var a "a"
    var b "b"
    var c "c"
    var d "d"
    equal? (+ a b c d) "abcd"


def verify_fast4_fast2 []:
    var a "a"
    var b "b"
    var c "c"
    var d "d"
    var e "e"
    var f "f"
    equal? (+ a b c d e f) "abcdef"


def verify_eight []:
    var a "a"
    var b "b"
    var c "c"
    var d "d"
    var e "e"
    var f "f"
    var g "g"
    var h "h"
    equal? (+ a b c d e f g h) "abcdefgh"


;; closure slots mix with locals in one packed row

def make_adder [x y]:
    lambda [u v]:
        (+ x y u v)


def verify_closure_mix []:
    var add (make_adder 10 20)
    equal? (add 3 4) 37
