;; Reproducer: (super) resolves to the defining class at every level of
;; a hierarchy, from a nested closure, and beside a method that reads
;; __class__ directly.


class A []:
    def __init__ [self]:
        set! self.a 1
    def defining_class [self]:
        __class__
    def via_closure [self]:
        def inner [] (.defining_class (super))
        (inner)


class B (A):
    def __init__ [self]:
        (.__init__ (super))
        set! self.b 2


class C (B):
    def __init__ [self]:
        (.__init__ (super))
        set! self.c 3


class D (C):
    def __init__ [self]:
        (.__init__ (super))
        set! self.d 4


class Widen (A):
    def defining_class [self]:
        (.defining_class (super))


def verify_levels []:
    var d (D)
    (and (equal? d.a 1) (equal? d.b 2) (equal? d.c 3) (equal? d.d 4))


def verify_c_is_three_levels []:
    var c (C)
    (and (equal? c.a 1) (equal? c.b 2) (equal? c.c 3))


def verify_class_is_defining_class []:
    ;; A.defining_class returns A even on a D instance
    (is? (.defining_class (D)) A)


def verify_super_from_nested_closure []:
    ;; Widen.via_closure is inherited from A; its inner lambda's (super)
    ;; is A's super, so the chain reaches object and fails there
    (try
      (.via_closure (Widen))
      (except: False))


def verify_widen_chain []:
    ;; Widen.defining_class calls A.defining_class through (super)
    (is? (.defining_class (Widen)) A)


def verify_explicit_form []:
    var c (C)
    (is? (type (super B c)) super)


;; The end.
