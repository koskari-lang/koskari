;; Full-stack reproducer for float arithmetic through the electors: a
;; temporary left operand made by (* a 1.0), which is a fresh float
;; for any a, so the in-place result arm runs on every pair of the
;; grid; the parameter form, where the operands are shared and the
;; result is fresh; aliasing against a would-be target; a slot
;; accumulator; and a chained accumulation.


def f_add [a b]:
    + a b


def f_sub [a b]:
    - a b


def f_mul [a b]:
    * a b


def f_div [a b]:
    / a b


def f_mod [a b]:
    % a b


def f_floordiv [a b]:
    // a b


def f_add_t [a b]:
    + (* a 1.0) b


def f_sub_t [a b]:
    - (* a 1.0) b


def f_mul_t [a b]:
    * (* a 1.0) b


def f_div_t [a b]:
    / (* a 1.0) b


def f_mod_t [a b]:
    % (* a 1.0) b


def f_floordiv_t [a b]:
    // (* a 1.0) b


def alias_binding [a]:
    var t (* a 1.0)
    var u t
    var v (+ t 1.0)
    #(t u v)


def alias_slot [a]:
    var t (* a 1.0)
    var u t
    incr! t 1.0
    #(t u)


def accumulate [n]:
    var e 0.0
    for-each [i (range n)]:
        incr! e (* 0.5 i)
        decr! e (/ i 3.0)
    e


def mixed_site [values]:
    var total 0.0
    for-each [v values]:
        incr! total v
    total


;; The end.
