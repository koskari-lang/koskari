;; Full-stack reproducer for in-place int results: an operator whose
;; left operand is a temporary the stack alone owns writes its result
;; into that object. Each operator below is applied to a temporary
;; made by (* a 1), which is a fresh int for any a outside the small
;; int range, so the reuse arm runs on every pair of the digit grid
;; and every digit-growth and decline case crosses it. The aliasing
;; functions hold a second reference to the would-be target and show
;; it untouched.


def kos_add_t [a b]:
    + (* a 1) b


def kos_sub_t [a b]:
    - (* a 1) b


def kos_mul_t [a b]:
    * (* a 1) b


def kos_mod_t [a b]:
    % (* a 1) b


def kos_floordiv_t [a b]:
    // (* a 1) b


def kos_truediv_t [a b]:
    / (* a 1) b


def kos_pow_t [a b]:
    ** (* a 1) b


def kos_and_t [a b]:
    & (* a 1) b


def kos_or_t [a b]:
    | (* a 1) b


def kos_xor_t [a b]:
    ^ (* a 1) b


def kos_lshift_t [a b]:
    << (* a 1) b


def kos_rshift_t [a b]:
    >> (* a 1) b


def alias_binding [a]:
    var t (* a 1)
    var u t
    var v (+ t 1)
    #(t u v)


def alias_list [a]:
    var xs #[(* a 1)]
    var y (+ xs[0] 1)
    #(xs y)


def alias_slot [a]:
    var t (* a 1)
    var u t
    incr! t 1
    #(t u)


def chained [a n]:
    var acc (* a 1)
    for-each [i (range n)]:
        set! acc (& (+ (* acc 3) i) 0xffffffff)
    acc


def small_result [a]:
    - (* a 1) 256


;; The end.
