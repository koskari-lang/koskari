;; foreach_step_resume -- the for-each step's element reaches the step's
;; resume on every route: in hand from a plain iterator, by a Koskari
;; generator's yield, through a yield-from delegation two deep, from a
;; generator whose own body loops, from an awaiting generator, and from
;; a Python async iterator.

(import-from asyncio sleep)


def gen [n]:
    for-each [i (range n)]:
        yield i


def delegating [n]:
    yield-from (gen n)


def twice [n]:
    yield-from (delegating n)
    yield-from (delegating n)


def collect_plain [n]:
    var out #[]
    for-each [v (range n)]:
        out.append v
    out


def collect_gen [n]:
    var out #[]
    for-each [v (gen n)]:
        out.append v
    out


def collect_delegated [n]:
    var out #[]
    for-each [v (twice n)]:
        out.append v
    out


def collect_break [n]:
    ;; abandon each delegation after one value; the outer loop goes on
    var out #[]
    for-each [k (range 3)]:
        for-each [v (twice n)]:
            out.append #(k v)
            (break)
    out


def nested_gen [n]:
    for-each [v (gen n)]:
        yield (* v 10)


def collect_nested [n]:
    var out #[]
    for-each [v (nested_gen n)]:
        out.append v
    out


def awaiting_gen [n]:
    for-each [i (range n)]:
        (sleep 0)
        yield i


def collect_awaiting [n]:
    var out #[]
    for-each [v (awaiting_gen n)]:
        out.append v
    out


def collect_source [src]:
    var out #[]
    for-each [v src]:
        out.append v
    out


def collect_else [n]:
    ;; the end of the iteration arrives at the else clause
    var out #[]
    (for-each [v (gen n)]
      (out.append v)
      [else: (out.append "end")])
    out


def sum_then_yield [n]:
    var t 0
    for-each [v (gen n)]:
        (set! t (+ t v))
    yield t


def continue_under_finally [n log]:
    ;; continue unwinds through the finally into the generator's next
    ;; step
    var out #[]
    for-each [v (gen n)]:
        try:
            when (< v 2):
                (continue)
            out.append v
        finally:
            log.append v
    out


def continue_nested [n]:
    ;; continue in an inner loop over a generator, then in the outer
    ;; loop over another
    var out #[]
    for-each [a (gen n)]:
        for-each [b (gen n)]:
            when (== a b):
                (continue)
            out.append #(a b)
        when (== a 0):
            (continue)
        out.append a
    out


var module_out #[]

for-each [mv (gen 3)]:
    module_out.append mv


;; The end.
