;; flat_delivery -- a flattened producer's element reaches its consumer
;; by tail call, so the C stack stays flat however many elements pass:
;; a for-each over a Koskari generator, a next loop over one, a
;; yield-from over one under a for-each, and a for-each over a map of a
;; Koskari function.


def gen [n]:
    for-each [i (range n)]:
        yield i


def relay [n]:
    yield-from (gen n)


def inc [x]:
    (+ x 1)


def count_foreach [n]:
    var t 0
    for-each [v (gen n)]:
        (set! t (+ t 1))
    t


def sum_next [n]:
    var g (gen n)
    var t 0
    for-each [i (range n)]:
        (set! t (+ t (next g)))
    t


def count_delegated [n]:
    var t 0
    for-each [v (relay n)]:
        (set! t (+ t 1))
    t


def sum_mapped [n]:
    var t 0
    for-each [v (map inc (range n))]:
        (set! t (+ t v))
    t
