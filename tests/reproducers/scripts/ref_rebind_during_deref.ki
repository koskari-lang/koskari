;; Reads for tests.reproducers.test_ref_rebind_during_deref: a module
;; name bound to an item ref whose key rebinds that name while the
;; lookup runs.

import-from koskari.lib ItemRef Ref

var ns (globals)

class K []:
    def __hash__ [self]:
        ns.bind "sensor" (Ref "sensor" 42)
        var junk (list-each [i (range 64)] (dict))
        1

bind! sensor (ItemRef "sensor" (dict) (K))

var first:
    try:
        sensor
    except [e KeyError]:
        "keyerror"

var second sensor
