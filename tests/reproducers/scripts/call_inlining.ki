;; Full-stack reproducer: calling an instance whose __call__ is a Koskari
;; function inlines through the KosCallable install slot (KosInstanceCall)
;; rather than re-entering the evaluator via tp_call.


define-class Adder []:

    def __init__ [self base]:
        set! self.base base

    def __call__ [self x]:
        (+ self.base x)


def verify_call_inlines []:
    var a (Adder 10)
    equal? (a 5) 15


def verify_call_multiple []:
    var a (Adder 100)
    and:
        equal? (a 1) 101
        equal? (a 2) 102


;; __call__ keyword and default-argument handling

define-class Greeter []:

    def __init__ [self greeting]:
        set! self.greeting greeting

    def __call__ [self name [punct "!"]]:
        (+ self.greeting (+ name punct))


def verify_call_keywords []:
    var g (Greeter "hi ")
    and:
        equal? (g "bob") "hi bob!"
        equal? (g "bob" punct: "?") "hi bob?"


;; Nested instance call: __call__ invokes another callable, which itself
;; dispatches through the evaluator.

def inc [n]:
    (+ n 1)


define-class Twice []:

    def __init__ [self fn]:
        set! self.fn fn

    def __call__ [self x]:
        (self.fn (self.fn x))


def verify_nested_call []:
    var t (Twice inc)
    equal? (t 5) 7


;; The end.
