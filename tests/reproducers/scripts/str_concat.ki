;; Full-stack reproducer for string concatenation through the electors:
;; an accumulator grown by incr! in a local, in a captured local, on a
;; __slots__ member and on a dict-backed attribute; the reducing forms
;; of + over three and five operands; a nested + whose left is a
;; temporary; a value the outside still holds; and #str through the
;; opcode and through its runtime binding.


def grow [n piece]:
    var s ""
    var i 0
    while (< i n):
        incr! s piece
        incr! i
    s


def grow_captured [n piece]:
    var s ""
    var i 0
    def step [] (incr! s piece)
    while (< i n):
        (step)
        incr! i
    s


define-class DictBox []:

    def __init__ [self]:
        set! self.s ""


define-class SlotBox []:

    var __slots__ #("s")

    def __init__ [self]:
        set! self.s ""


def grow_attr [box n piece]:
    var i 0
    while (< i n):
        incr! box.s piece
        incr! i
    box.s


def grow_dict [n piece]:
    grow_attr (DictBox) n piece


def grow_slots [n piece]:
    grow_attr (SlotBox) n piece


def join3 [a b c]:
    + a b c


def join5 [a b c d e]:
    + a b c d e


def nested [a b c]:
    + (+ a b) c


def build3 [a b c]:
    #str a b c


def build_splat [a rest]:
    #str a *: rest


def build_apply [pieces]:
    apply #str pieces


def build_value []:
    #str


def shared [seed piece]:
    var s seed
    incr! s piece
    incr! s piece
    #(seed s)


;; The end.
