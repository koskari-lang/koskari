;; Full-stack reproducer: the in-place opcodes as the compiler emits
;; them, run through their electors. A local counter (FAST_INPLACE_CONST
;; and FAST_INPLACE), a closure cell updated from an inner function (a
;; ref slot the elected body peeks through), a list element (the
;; inplace-item form on OBJECT_INPLACE), and the same site fed ints,
;; then floats, then ints again.


def count_up [n step]:
    var total 0
    var i 0
    while (< i n):
        incr! total step
        incr! i
    total


def count_down [n]:
    var i n
    var seen 0
    while (> i 0):
        decr! i
        incr! seen
    seen


def closure_counter [n]:
    var total 0
    def bump [step]:
        incr! total step
    for-each [i (range n)]:
        bump i
    total


def item_accumulate [n]:
    var cells #[0 0]
    for-each [i (range n)]:
        incr! cells[0] i
        incr! cells[1] 2
    cells


def mixed_site [values]:
    var total 0
    for-each [v values]:
        incr! total v
    total


def unbound_after [flag]:
    when flag:
        var i 10
    incr! i
    i


def masked_accumulate [n]:
    var acc 1
    for-each [i (range n)]:
        set! acc (& (* acc 3) 0xffffffff)
        incr! acc i
    acc


def closure_float [n]:
    var total 0.5
    def bump [step]:
        incr! total step
    for-each [i (range n)]:
        bump (* i 0.25)
    total


def closure_repeat [n]:
    var total 1000
    def bump []:
        incr! total 1
        decr! total 3
    for-each [i (range n)]:
        (bump)
    total


def constant_incr [seed step]:
    bind! k (constant (+ seed seed))
    incr! k step
    k


def constant_incr_by_one [seed]:
    bind! k (constant (+ seed seed))
    incr! k
    k


def constant_value_survives [seed step]:
    bind! k (constant (+ seed seed))
    try:
        incr! k step
    except [ValueError]:
        None
    k


;; The end.
