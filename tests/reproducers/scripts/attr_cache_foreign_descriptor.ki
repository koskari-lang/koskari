;; Attribute sites for tests.reproducers.test_attr_cache_foreign_descriptor:
;; a __slots__ member of one class installed as an attribute of an
;; unrelated class, read and written through cached attribute sites.

class A [object]:
    var __slots__ #("x" "y" "z" "w" "v")

class B [object]:
    var __slots__ #()

setattr B "x" (getattr A "x")

def read [o]:
    o.x

def write [o v]:
    set! o.x v
    None
