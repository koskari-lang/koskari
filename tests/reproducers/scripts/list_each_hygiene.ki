; Reproducer: list-each hygiene leak.
;
; list-each expands with an accumulator the macro names `col`. When the
; user's loop variable is also `col`, references to `col` nested inside
; the body form used to resolve to the (gensym-renamed) accumulator
; instead of the loop value, corrupting the result. A bare-symbol body
; escaped the leak; any nesting (a call, an f-string) triggered it.

define nested (list-each [col #[1 2 3]] (+ col 10))
define fstr (list-each [col #["a" "b" "c"]] f"<{col}>")

print nested
print fstr

; The end.
