;; next_resume -- the next request names a resume, and the element
;; reaches it on every route: in hand, by a generator's yield, from a
;; transform over a generator, inside a for-each body over another
;; generator, at the end with and without a default, and as a failure
;; the enclosing try catches.


define gen [n]:
    for-each [i (range n)]:
        yield i


define bad []:
    yield 1
    raise (ValueError "boom")


define take_two [n]:
    define g (gen n)
    #((next g) (next g))


define next_in_loop [n]:
    define out #[]
    define g (gen 100)
    for-each [v (gen n)]:
        out.append #(v (next g))
    out


define next_over_map [n]:
    define m (map (lambda [x] (* x 10)) (gen n))
    #((next m) (next m) (next m None))


define default_after_end [n]:
    define g (gen n)
    for-each [_ (range n)]:
        (next g)
    (next g "done")


define stop_after_end [n]:
    define g (gen n)
    for-each [_ (range n)]:
        (next g)
    try:
        (next g)
    except [e StopIteration]:
        "stopped"


define error_in_producer []:
    define g (bad)
    define first (next g)
    try:
        (next g)
    except [e ValueError]:
        #(first (str e))


define error_with_default []:
    ;; the producer's error is not answered with the default
    define g (bad)
    define first (next g)
    try:
        (next g "dflt")
    except [e ValueError]:
        #(first (str e))


define next_by_name [n]:
    ;; the iterator held in a local, the fused step forms
    define g (gen n)
    define a (next g)
    define b (next g 99)
    define c (next g 99)
    #(a b c)


;; The end.
