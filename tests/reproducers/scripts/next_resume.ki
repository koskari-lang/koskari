;; next_resume -- the next request names a resume, and the element
;; reaches it on every route: in hand, by a generator's yield, from a
;; transform over a generator, inside a for-each body over another
;; generator, at the end with and without a default, and as a failure
;; the enclosing try catches.


def gen [n]:
    for-each [i (range n)]:
        yield i


def bad []:
    yield 1
    raise (ValueError "boom")


def take_two [n]:
    var g (gen n)
    #((next g) (next g))


def next_in_loop [n]:
    var out #[]
    var g (gen 100)
    for-each [v (gen n)]:
        out.append #(v (next g))
    out


def next_over_map [n]:
    var m (map (lambda [x] (* x 10)) (gen n))
    #((next m) (next m) (next m None))


def default_after_end [n]:
    var g (gen n)
    for-each [_ (range n)]:
        (next g)
    (next g "done")


def stop_after_end [n]:
    var g (gen n)
    for-each [_ (range n)]:
        (next g)
    try:
        (next g)
    except [e StopIteration]:
        "stopped"


def error_in_producer []:
    var g (bad)
    var first (next g)
    try:
        (next g)
    except [e ValueError]:
        #(first (str e))


def error_with_default []:
    ;; the producer's error is not answered with the default
    var g (bad)
    var first (next g)
    try:
        (next g "dflt")
    except [e ValueError]:
        #(first (str e))


def next_by_name [n]:
    ;; the iterator held in a local, the fused step forms
    var g (gen n)
    var a (next g)
    var b (next g 99)
    var c (next g 99)
    #(a b c)


;; The end.
