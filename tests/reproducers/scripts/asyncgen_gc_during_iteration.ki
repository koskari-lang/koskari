;; Reproducer: a koskari generator must survive cyclic garbage collection
;; while it is still being iterated by a for-each.
;;
;; The GEN node's tp_traverse reported its *borrowed* owner pointer to the
;; cyclic collector.  Under allocation pressure (a large dict), GC ran during
;; iteration, mis-counted the still-live generator as cyclic-only garbage
;; (its only live reference being a GC-invisible FOREACH dynnode), and cleared
;; it -- so iteration stopped after a single item.  A large element count is
;; required to provoke a collection mid-iteration.


define tracked [data]:
    for-each [item (list (data.items))]:
        (yield item)


when (equal? __name__ "__main__"):
    define data #{}
    define i 0
    while (< i 800):
        (set! (item data i) i)
        (set! i (+ i 1))
    define shown 0
    for-each [item (tracked data)]:
        (set! shown (+ shown 1))
    (print "SHOWN" shown "EXPECTED" (len data))


;; The end.
