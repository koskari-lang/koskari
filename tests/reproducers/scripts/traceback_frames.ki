;; Frames for tests.reproducers.test_python_traceback_frames: a
;; two-deep failing call reached through a plain function, a demand
;; function, and from inside Koskari handlers.

import json
import traceback

def inner [x]:
    var a 1
    var b 2
    var c (/ x 0)
    return c

def outer [z]:
    var q 1
    var w 2
    var r (inner z)
    return (+ r 1)

define-demanding douter [z]:
    var q 1
    var r (inner z)
    return (+ r 1)

def handler_frames [thunk]:
    try:
        (thunk)
    except [e Exception]:
        #(e.__traceback__
          (traceback.format_exc))

def python_raise []:
    var v (json.loads "{bad")
    v

def c_raise []:
    var v (int "x")
    v

def koskari_raise []:
    var v (ValueError "boom")
    raise v
