;; Sources for tests.reproducers.test_transform_reentry: iterators
;; whose __next__ steps the transform consuming them, from Koskari.
;; The transform has a step in flight, so the inner step is refused
;; and the outer step completes.

import-from koskari.itertools pairwise zip-longest


define gen_src [box]:
    try:
        (next (item box 0))
    except [e ValueError]:
        (set! (item box 1) (str e))
    yield 1

define-class PairSrc []:
    def __init__ [self]:
        set! self.n 0
        set! self.pw None
        set! self.inner None

    def __iter__ [self]:
        self

    def __next__ [self]:
        set! self.n (+ self.n 1)
        when (== self.n 2):
            try:
                set! self.inner (next self.pw)
            except [e ValueError]:
                set! self.inner (str e)
            return "b"
        when (>= self.n 3):
            raise (StopIteration)
        self.n

def pair_case []:
    var s (PairSrc)
    var pw (pairwise s)
    set! s.pw pw
    #((next pw) s.inner)

define-class ZipSrc []:
    def __init__ [self]:
        set! self.n 0
        set! self.z None
        set! self.inner None

    def __iter__ [self]:
        self

    def __next__ [self]:
        set! self.n (+ self.n 1)
        when (== self.n 1):
            try:
                set! self.inner (next self.z)
            except [e ValueError]:
                set! self.inner (str e)
        self.n

def zip_case []:
    var s (ZipSrc)
    var z (zip-longest s #[10 20])
    set! s.z z
    #((next z) s.inner)


define gen_case []:
    define box #[None None]
    define z (zip (gen_src box) #[10])
    (set! (item box 0) z)
    #((next z) (item box 1))
