;; Sources for tests.reproducers.test_transform_reentry: iterators
;; whose __next__ steps the transform consuming them, from Koskari.
;; The transform has a step in flight, so the inner step is refused
;; and the outer step completes.

import-from koskari.itertools pairwise zip-longest

define-class PairSrc []:
    define __init__ [self]:
        set! self.n 0
        set! self.pw None
        set! self.inner None

    define __iter__ [self]:
        self

    define __next__ [self]:
        set! self.n (+ self.n 1)
        when (== self.n 2):
            try:
                set! self.inner (next self.pw)
            except [e ValueError]:
                set! self.inner (str e)
            return "b"
        when (>= self.n 3):
            raise (StopIteration)
        self.n

define pair_case []:
    define s (PairSrc)
    define pw (pairwise s)
    set! s.pw pw
    #((next pw) s.inner)

define-class ZipSrc []:
    define __init__ [self]:
        set! self.n 0
        set! self.z None
        set! self.inner None

    define __iter__ [self]:
        self

    define __next__ [self]:
        set! self.n (+ self.n 1)
        when (== self.n 1):
            try:
                set! self.inner (next self.z)
            except [e ValueError]:
                set! self.inner (str e)
        self.n

define zip_case []:
    define s (ZipSrc)
    define z (zip-longest s #[10 20])
    set! s.z z
    #((next z) s.inner)
