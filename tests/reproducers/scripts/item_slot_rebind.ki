;; Item sites whose container sits in a captured slot, under a key whose
;; hash rebinds that slot: the row peeks the container borrowed, the
;; dict body's hash runs the rebinding, and the site must finish the
;; access on the container it fetched. The load and in-place
;; containers have no other owner, so the rebinding drops their last
;; reference outside the site.

(var dl (dict))
(var di (dict))
(var ds (dict))
(var first ds)

(class LoadKey []
  (def __hash__ [self] (global var dl (dict)) 1)
  (def __eq__ [self other] False))

(class IncrKey []
  (def __hash__ [self] (global var di (dict)) 1)
  (def __eq__ [self other] False))

(class StoreKey []
  (def __hash__ [self] (global var ds (dict)) 1)
  (def __eq__ [self other] False))

(var dm (dict))
(var armed False)

;; rebinds only once armed, so the cell can be primed first
(class MissKey []
  (def __hash__ [self] (if armed (global var dm (dict)) None) 1)
  (def __eq__ [self other] False))

(var kl (LoadKey))
(var ki (IncrKey))
(var ks (StoreKey))
(var km (MissKey))

(def load [] dl[kl])
(def incr [] (incr! di[ki]) di)
(def store [v] (set! ds[ks] v) ds)
(def prime [v]
  (global var armed False)
  (set! dm[km] v)
  (global var armed True))
(def miss [] (incr! dm[km]) dm)
(def current [] #(dl di ds dm))
