;; Reproducer: Koskari iteration through a KosPyIter (the CPython
;; iterator a KosIter provider's tp_iter returns) flattens into the
;; running evaluator. A parameterize binding made by the consumer is
;; visible to the generator only when the generator runs on the
;; consumer's chain. The drive carries the consumer's own demand state.


(import-from asyncio sleep)


(define-parameter level 1)



(def gen []
  (yield level)
  (yield level))


(def relay []
  (yield-from (iter (gen))))


(def sleeper []
  (sleep 0)
  (yield 1))


(def consume-bare []
  (var out #[])
  (parameterize [[level 10]]
    (for-each [x (gen)]
      (out.append x)))
  out)


(def consume-iter []
  (var out #[])
  (parameterize [[level 10]]
    (for-each [x (iter (gen))]
      (out.append x)))
  out)


(def consume-relay []
  (var out #[])
  (parameterize [[level 10]]
    (for-each [x (relay)]
      (out.append x)))
  out)


(def consume-sleeper []
  (var out #[])
  (for-each [x (iter (sleeper))]
    (out.append x))
  out)


;; The end.
