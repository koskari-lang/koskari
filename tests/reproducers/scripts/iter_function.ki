;; Reproducer: a class __iter__ bound to a generator function is
;; wrapped in IterFunction. Called from Python it presents the
;; generator as an iterator; called from Koskari it returns the
;; generator itself. A non-generator __iter__ stays a Demand.


(define-class Counter []
  (define __iter__ [self]
    (yield 1)
    (yield 2)))


(define-class Plain []
  (define __iter__ [self]
    (iter #[1 2])))


(define koskari-iter-call []
  (.__iter__ (Counter)))


(define koskari-for-each []
  (define out #[])
  (for-each [x (Counter)]
    (out.append x))
  out)


;; The end.
