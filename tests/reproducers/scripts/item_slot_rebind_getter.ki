;; Item sites whose container sits in a fast slot, under a key bound to
;; an attribute ref whose getter rebinds that slot: the row peeks the
;; container borrowed, the key's deref runs the getter, and the site
;; must finish the access on the container it fetched. The container
;; has no other owner, so the rebinding drops its last reference
;; outside the site. Tracked and Rebinder are the Python types the
;; test passes in.

(var load
  (lambda [Tracked Rebinder]
    (var lst (Tracked #["a" "b" "c"]))
    (var box (Rebinder &lst))
    (bind! kk (attr box k))
    (item lst kk)))

(var store
  (lambda [Tracked Rebinder]
    (var lst (Tracked #["a" "b" "c"]))
    (var box (Rebinder &lst))
    (bind! kk (attr box k))
    (var v "stored")
    (set-item lst kk v)
    lst))
