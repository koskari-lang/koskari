;; yield_from_resume -- the delegate of a yield-from is the frame's resume
;; state. What reaches the suspended generator reaches the delegate: a
;; sent value, a thrown exception, a close. The delegation ends with the
;; instruction after it.


var log #[]


def echo [n]:
    ;; a koskari generator that records what is sent into it
    var got #[]
    var i 0
    while (< i n):
        got.append (yield i)
        incr! i
    log.append got


def closing [name]:
    try:
        yield 1
        yield 2
    finally:
        log.append name


def outer [delegate]:
    yield-from delegate
    yield "after"


def guarded [delegate]:
    try:
        yield-from delegate
    except [e ValueError]:
        yield (str e)
    yield "after"


def nested [delegate]:
    yield-from (outer delegate)
    yield "outer-after"


def collect [g]:
    var out #[]
    for-each [v g]:
        out.append v
    out


def collect_pairs [n m]:
    ;; a yield-from inside a for-each body: two step resumes interleave
    var out #[]
    for-each [a (outer (range n))]:
        for-each [b (outer (range m))]:
            out.append #(a b)
    out


def send_through [n]:
    var g (outer (echo n))
    var out #[]
    out.append (next g)
    for-each [k (range 1 n)]:
        out.append (g.asend (* k 10))
    out.append (g.asend (* n 10))
    out.append (next g None)
    out


def send_nested [n]:
    ;; two delegations deep: the sent value reaches the inner delegate
    var g (outer (outer (echo n)))
    var out #[]
    out.append (next g)
    for-each [k (range 1 n)]:
        out.append (g.asend (* k 10))
    out.append (g.asend (* n 10))
    out.append (next g)
    out.append (next g None)
    out


def throw_through [n]:
    var g (guarded (echo n))
    var first (next g)
    var caught (g.athrow (ValueError "zap"))
    #(first caught (next g))


def close_through []:
    var g (outer (closing "closed"))
    var first (next g)
    (g.aclose)
    #(first (list log))


;; The end.
