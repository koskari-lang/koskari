;; Reproducer: define-class inheriting abc.ABC with @abstractmethod methods.
;;
;; Shape is an abstract root (inherits ABC) declaring an abstract `area`
;; property.  Point2D is a concrete coordinate, Shape2D is an abstract
;; positioned 2D shape, and Rectangle is a concrete 2D shape built from a
;; coordinate plus height and width.  (Class names use the Point2D/Shape2D
;; spelling because a leading digit is not a valid identifier.)


import-from abc ABC abstractmethod


;; Abstract root: every Shape must provide an area.

define-class Shape [ABC]:

    @property
    @abstractmethod
    def area [self]:
        None


;; Concrete coordinate; a point encloses no area.

define-class Point2D [Shape]:

    def __init__ [self x y]:
        set! self.x x
        set! self.y y

    @property
    def area [self]:
        0


;; Abstract positioned 2D shape; leaves `area` abstract.

define-class Shape2D [Shape]:

    def __init__ [self origin]:
        set! self.origin origin


;; Concrete rectangle anchored at a coordinate.

define-class Rectangle [Shape2D]:

    def __init__ [self coordinate height width]:
        (.__init__ (super) coordinate)
        set! self.height height
        set! self.width width

    @property
    def area [self]:
        (* self.width self.height)


def verify_point []:
    var p (Point2D 3 4)
    (and (equal? p.x 3)
         (equal? p.y 4)
         (equal? p.area 0))


def verify_rectangle []:
    var origin (Point2D 1 2)
    var r (Rectangle origin 5 4)
    (and (equal? r.width 4)
         (equal? r.height 5)
         (equal? r.area 20)
         (equal? r.origin.x 1)
         (equal? r.origin.y 2))


;; The end.
