;; Reproducer: a Koskari coroutine reaching the await path continues
;; on the running chain, not driven on its own context. A fresh one, as
;; a Python wrapper (functools.partial, a helper) calling a Koskari
;; function returns, is installed as a call frame; awaiting it, or a
;; defer over it, runs on the caller's chain and meets the caller's
;; frame-depth limit. One Python already started and left parked at an
;; await splices its chain under the awaiter and continues from its
;; suspend point, with the goals waiting on its chain. sleeper_partial,
;; Suspender, handled, started and finish_via are injected by the test.


(import _thread)
(import-from functools partial)
(import-from asyncio sleep)
(import-from koskari.lib defer demand)


(def step [n]
  (if (> n 0)
      (+ 1 ((partial step) (- n 1)))
      0))


(def via_partial [n]
  (step n))


(def defer-step [n]
  (if (> n 0)
      (+ 1 (await (defer defer-step (- n 1))))
      0))


(def via_defer [n]
  (defer-step n))


(def add [a b]
  (+ a b))


(def make_defer []
  (defer add 1 2))


(def await_object [c]
  (await c))


(def sleeper []
  (sleep 0)
  "woke")


(def demand_over_partial []
  ((demand sleeper_partial)))


(define-parameter p "root")


(def wait_value []
  (await (Suspender)))


(def wait_on [aw]
  (await aw))


(def wait_then_read []
  (await (Suspender))
  p)


(def wait_guarded []
  (try
    (await (Suspender))
    ([e ValueError] "caught")))


(def await_under [c]
  (parameterize [[p "inner"]]
    (await c)))


(def deep_wait [n]
  (if (> n 0)
      (+ 1 (deep_wait (- n 1)))
      (begin (await (Suspender)) 0)))


(def wait_in_handler []
  (try
    (raise (ValueError "inside"))
    ([e ValueError]
      (await (Suspender))
      (handled))))


(def await_then_handled [c]
  #((await c) (handled)))


(def wait_in_extents [log]
  (parameterize [[p "coro"]]
    (dyn-wind (log.append "before")
              (begin (await (Suspender)) p)
              (log.append "after"))))


(def await_then_read [c]
  (define r (await c))
  #(r p))


(def catch_await [aw]
  (try
    (await aw)
    ([e Exception] (str (type e)))))


(def two_awaits [first second]
  (define r1 (catch_await first))
  (define r2 (await second))
  #(r1 r2))


(def demand_await [c]
  ((demand await_object) c))


(def wait_then_shift_twice []
  (await (Suspender))
  (+ 1 (shift k (+ (k 10) (k 20)))))


(def wait_then_shift_keep []
  (await (Suspender))
  (+ 1 (shift k k)))


(def wait_then_shift_abandon []
  (await (Suspender))
  (+ 1 (shift k "abandoned")))


(def wait_then_callcc []
  (await (Suspender))
  (+ 1 (call/cc (lambda [k] (k 10)))))


(def reset_await [c]
  (reset (+ 100 (await c))))


(def reset_await_apply [c]
  (define k (reset (+ 100 (await c))))
  #((k 1) (k 2)))


(def wait_shift_wait []
  (await (Suspender))
  (define v (shift k (k 5)))
  (+ v (len (await (Suspender)))))


(def await_twice [c]
  (define r (await c))
  (try
    (await c)
    ([e RuntimeError] #(r (str e)))))


(def await_after_interrupt [c]
  (_thread.interrupt_main)
  (await c))


(def wound [log]
  (dyn-wind
    (before: (log.append "in"))
    (body: (yield 1) (yield 2))
    (after: (log.append "out") (await (Suspender)) (log.append "out2"))))


(def wound_on_entry [log gate]
  (dyn-wind
    (before:
      (log.append "in")
      (if gate (await (Suspender)) None)
      (log.append "in2"))
    (body: (yield 1) (yield 2))
    (after: (log.append "out"))))


(def managed [mgr]
  (dyn-with [c mgr]
    (yield 1)
    (yield 2)))


(def collect [gen log]
  (for-each [x gen]
    (log.append x))
  log)


(def collect_gated [gen log gate]
  (for-each [x gen]
    (log.append x)
    (gate.append 1))
  log)


(def abort_through_wait [log]
  (reset
    (dyn-wind
      (before: (log.append "in"))
      (body: (shift k "aborted"))
      (after: (log.append "out") (await (Suspender)) (log.append "out2")))))


(def jumper [log k]
  (dyn-wind
    (before: (log.append "in"))
    (body: (k "jumped"))
    (after: (log.append "out") (await (Suspender)) (log.append "out2"))))


(def await_in_extent [log c]
  (dyn-wind
    (before: (log.append "a-in"))
    (body: (await c))
    (after: (log.append "a-out"))))


(def owner_awaits_jumper [log]
  (define r
    (call/cc
      (lambda [k]
        (define box (started jumper log k))
        (log.append box.first)
        (await_in_extent log box.c)
        "not reached")))
  (log.append r)
  log)


(def other_awaits_jumper [log]
  (define r
    (call/cc
      (lambda [k]
        (define box (started jumper log k))
        (log.append box.first)
        (finish_via await_in_extent log box.c)
        "not reached")))
  (log.append r)
  log)


;; The end.
