;; Full-stack reproducer for the reducing forms over three or more
;; operands: the sites the compiler emits for (+ a b c) and its kin,
;; reached through the fold electors on ints and floats, with every
;; operand loaded from a parameter so nothing folds at compile time,
;; and the runtime operator called on the same run.


def add3 [a b c]:
    + a b c


def sub3 [a b c]:
    - a b c


def mul3 [a b c]:
    * a b c


def floordiv3 [a b c]:
    // a b c


def truediv3 [a b c]:
    / a b c


def and3 [a b c]:
    & a b c


def or3 [a b c]:
    | a b c


def xor3 [a b c]:
    ^ a b c


def add5 [a b c d e]:
    + a b c d e


def mul5 [a b c d e]:
    * a b c d e


def add3_runtime [a b c]:
    apply + #(a b c)


def energy [x y z m]:
    * (+ (* x x) (* y y) (* z z)) m 0.5


def nested_int [a b c d]:
    + (* a b) c d


def nested_float [a b c d]:
    + (* a b) c d


def item_run [seed a b]:
    var cells #[seed seed]
    inplace-item + cells 0 a b
    cells


;; The end.
