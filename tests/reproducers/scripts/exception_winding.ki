;; Exception, winding, and delimited-continuation interactions.
;;
;; Self-checking and pure Koskari: no injected Python helpers, so the
;; script runs directly under the launcher (e.g. wrapped in valgrind)
;; as well as from the reproducer-phase loader test. Raises
;; AssertionError on any mismatch; prints "exception-winding: OK" on
;; success.


def check [tag expect got]:
    unless (equal? expect got):
        print "FAIL" tag "expected:" expect "got:" got
        raise (AssertionError tag)


;; 1. A raise crosses a frame with open extents (let NS) into the
;;    caller's try.

def scenario-frame-cross []:
    def blow [x]:
        let [[y x]]:
          raise (ValueError "boom")

    (check "frame-cross" "caught"
           (try (blow 1) ([e ValueError] "caught")))


;; 2. The dyn-wind after thunk runs exactly once on exception unwind
;;    before the enclosing handler catches.

def scenario-wind-raise []:
    var events #[]
    var result:
        try:
          (dyn-wind
            (events.append "before")
            (raise (ValueError "boom"))
            (events.append "after"))
        except [e ValueError]:
            "caught"

    check "wind-raise result" "caught" result
    check "wind-raise events" #["before" "after"] events


;; 3. A failing after thunk supersedes the original exception, which
;;    chains in as __context__.

def scenario-teardown-supersede []:
    var events #[]
    var result:
        try:
            (dyn-wind
              (events.append "before")
              (raise (ValueError "original"))
              (raise (RuntimeError "teardown")))
        except [e RuntimeError]:
            e

    check "supersede caught" "teardown" (str result)
    check "supersede context" "original" (str result.__context__)


;; 4. In-shift delimited invoke resumes in place: a single before/after
;;    pair, value delivered to the call site.

def scenario-inshift []:
    var events #[]
    var result:
        reset:
          (dyn-wind
            (events.append "before")
            (shift k (k 5))
            (events.append "after"))

    check "inshift result" 5 result
    check "inshift events" #["before" "after"] events


;; 5. Remote invoke instantiates the captured template: one before/after
;;    pair for the capture pass, one for the invoke.

def scenario-remote []:
    var events (list)
    var captured:
        reset:
          (dyn-wind
            (events.append "before")
            (shift k k)
            (events.append "after"))

    check "remote result" 5 (captured 5)
    check "remote events" #["before" "after" "before" "after"] events


;; 6. Multi-shot in-shift invoke: the first call runs in place, the
;;    re-invoke grafts a fresh template instance; one wind pair each.

def scenario-multishot []:
    var events #[]
    var result:
        reset:
          (dyn-wind
            (events.append "before")
            (shift k (+ (k 3) (k 4)))
            (events.append "after"))

    check "multishot result" 7 result
    check "multishot events" #["before" "after" "before" "after"] events


;; 7. Recursive invoke: k called in the path of k via a stashed alias.

def scenario-recursive []:
    var cell #[None None]

    def bump [n]:
        set! (item cell 1) n
        if (< n 3) ((item cell 0) (+ n 1)) n

    var result:
        reset:
          bump:
            shift k:
              set! (item cell 0) k
              k 0

    check "recursive result" 3 result
    check "recursive last" 3 (item cell 1)


;; 8. An exception raised by a remotely-invoked slice reaches the
;;    invoke-site handler.

def scenario-remote-exc []:
    def bad [v]:
        raise (ValueError "slice")

    var captured:
      reset:
        (bad (shift k k))

    (check "remote-exc" "caught"
           (try (call captured 5) ([e ValueError] "caught")))


when-main:
    (scenario-frame-cross)
    (scenario-wind-raise)
    (scenario-teardown-supersede)
    (scenario-inshift)
    (scenario-remote)
    (scenario-multishot)
    (scenario-recursive)
    (scenario-remote-exc)
    (print "exception-winding: OK")


;; The end.
