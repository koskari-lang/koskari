;; Captures for tests.reproducers.test_match_deep_tuple: a raw tuple
;; subject nested deeper than the C stack would carry, and a tuple
;; holding a Datum the user positioned.

import-from koskari.lib Datum

def build [depth]:
    var stack #()
    for-each [i (range depth)]:
        set! stack #(i stack)
    stack

def peek [s]:
    match s:
        case #[top rest]:
            top
        else:
            None

def capture_pair [s]:
    match s:
        case #[first second]:
            second
        else:
            None
