;; Sequences for tests.reproducers.test_each_eager_sequence: the
;; sequence of an each is evaluated when the form runs, in the scope
;; the form is in.

define src #[1 2 3]
define gen (each [x src] (* x 10))
define-global src #[7]
define after_rebind (list gen)

define-class K []:
    define names #["a" "b"]
    define table (dict-each [n names] key: n value: 1)
