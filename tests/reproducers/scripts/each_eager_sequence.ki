;; Sequences for tests.reproducers.test_each_eager_sequence: the
;; sequence of an each is evaluated when the form runs, in the scope
;; the form is in.

var src #[1 2 3]
var gen (each [x src] (* x 10))
global src #[7]
var after_rebind (list gen)

define-class K []:
    var names #["a" "b"]
    var table (dict-each [n names] key: n value: 1)
