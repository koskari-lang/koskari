"""
koskari.cli.repl

Koskari-native read-eval-print loop.  Read and compile happen here; the
eval step crosses the Python boundary shim ``_await_user_form`` so the
user form runs in a fresh coroutine context and REPL infrastructure stays
off its native dynchain (see design/archive/cli-repl-rework.md section 3).  Error
rendering reuses the Python formatters in koskari.exceptions.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import sys

import-from .host:
  _await_user_form _make_repl_prompter
  REPLCodeBoundary REPL_INFRASTRUCTURE_MODULES
  startup_lines
; maybe_print_logo startup_lines  -- logo emission disabled for now
import-from ..exceptions:
  format_code_boundary_exception format_exception_with_koskari_trace
  apply_sys_last_exc CompilerError UncaughtCompilerError
  ReaderEOF ReaderError
import-from ..reader IndentAwareStream source_str READ_EOF
import-from ..module init_module build_module_load_facets find_module_reader
import-from ..lib kos_repr


(declare-exports repl)


; === Continuation heuristics ===


def block_body? [buffer]:
  """
  True if buffer appears to be inside a layout block body (user may add
  more).  A block header (some line ends with a colon) is present and the
  last non-empty line is indented; a blank line will terminate the block.
  """

  unless (and buffer (in? ":" buffer)):
    return False

  var lines (buffer.splitlines)
  unless (any? (each [ln lines] ((ln.rstrip).endswith ":"))):
    return False

  var nonempty (list-each [ln lines] when: (ln.strip) ln)
  unless nonempty:
    return False

  (in? nonempty[-1][0] " \t")


def continuation_indent [buffer]:
  """
  Return the leading whitespace for the next continuation line.

  When buffer ends with a block header (colon), indent one level (4
  spaces) past that line.  When inside a block body, match the indent of
  the last non-empty line.  Otherwise return the empty string.
  """

  unless buffer:
    return ""

  var lines (buffer.splitlines)
  unless lines:
    return ""

  when ((buffer.rstrip).endswith ":"):
    var last lines[-1]
    var indent_len (- (len last) (len (last.lstrip)))
    return (* " " (+ indent_len 4))

  when (block_body? buffer):
    var nonempty (list (filter (lambda [ln] (ln.strip)) lines))
    when nonempty:
      var ln nonempty[-1]
      return (* " " (- (len ln) (len (ln.lstrip))))

  return ""


; === Read step ===


var _INCOMPLETE (object)


syntax incomplete?:
  syntax-rules []:
    case (incomplete? result):
      (is? result _INCOMPLETE)


def read_buffer [ns source]:
  """
  Read every form in a REPL buffer.

  Returns _INCOMPLETE when the reader needs more input for any form,
  otherwise a list of (source_expr, position) pairs in buffer order.
  Reader errors propagate to the caller.
  """

  ;; the session's reader, rebuilt from its pragma when detached, so
  ;; the REPL reads with the same pragma-gated surfaces as a module
  var reader (find_module_reader ns)

  var stream (IndentAwareStream.from_source (source_str source "<stdin>"))

  var forms #[]
  while True:
    var [source_expr position]:
      try:
        reader.read_and_position stream
      except [ReaderEOF]:
        return _INCOMPLETE

    when (is? source_expr READ_EOF):
      break

    forms.append #(source_expr position)

  (if forms forms _INCOMPLETE)


def eval_expression [compiler source_expr position ns]:
  """
  Compile one REPL form into a zero-argument expression to be awaited
  via the boundary shim.  Compile-phase errors propagate to the caller.
  """

  var fragment (compiler.compile_expression source_expr position)
  (fragment.as_expression ns)


; === REPL loop ===


def repl [
    mod
    prompter: None
    histfile: None
    stdin: None
    stdout: None
    stderr: None
    full_trace: False
    quiet: False]:

  """
  Run an interactive read-eval-print loop for a koskari module.

  Each form entered by the user is read, compiled, and evaluated across
  the Python boundary shim.  Multi-line input is supported via a
  continuation prompt.  Non-None results are printed to stdout and the
  last result is stored as '_' in the namespace.

  :param mod: koskari Module to use as the execution context
  :param prompter: input(prompt)-style callable; built via
      _make_repl_prompter when None
  :param histfile: history file path passed to _make_repl_prompter
  :param stdin: input stream, defaults to sys.stdin
  :param stdout: output stream, defaults to sys.stdout
  :param stderr: error stream, defaults to sys.stderr
  :param full_trace: when True, keep REPL boundary frames in tracebacks
  :param quiet: when True, suppress the startup version banner
  """

  set! stdin (or stdin sys.stdin)
  set! stdout (or stdout sys.stdout)
  set! stderr (or stderr sys.stderr)

  var compiler (getattr mod "__compiler__" None)
  when (None? compiler):
    init_module mod "<stdin>"
    var facets (build_module_load_facets mod filename: "<stdin>")
    set! compiler facets[0]

  var ns (vars mod)
  when (None? prompter):
    set! prompter (_make_repl_prompter histfile ns)

  unless quiet:
    ; (maybe_print_logo stdout)
    for-each [line (startup_lines)]:
      print line file: stdout
    print "" file: stdout

  var buffer ""
  var prompt ">>> "

  while True:
    try:
      var indent (if (equal? prompt "... ") (continuation_indent buffer) "")
      var line (await (prompter prompt default: indent))

    except [EOFError]:
      print "" file: stderr
      (stderr.flush)
      break

    except [KeyboardInterrupt]:
      ; as Python's REPL: report, drop the pending lines, prompt again;
      ; only EOF ends the session
      print "\nKeyboardInterrupt" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "
      continue

    incr! buffer (if buffer (+ "\n" line) line)

    unless (buffer.strip):
      set! buffer ""
      continue

    when (line.strip):
      when ((buffer.rstrip).endswith ":"):
        set! prompt "... "
        continue
      when (block_body? buffer):
        set! prompt "... "
        continue

    try:
      var forms (read_buffer ns buffer)

      if (incomplete? forms):
        set! prompt "... "
        continue

      set! buffer ""
      set! prompt ">>> "

      for-each [[source_expr position] forms]:
        var expr (eval_expression compiler source_expr position ns)

        ;; No explicit await here: the call boundary already auto-awaits
        ;; the shim coroutine, and an explicit await would collapse a
        ;; defer handle returned by the user form.
        var result (_await_user_form expr)

        set! ns["_"] result
        unless (None? result):
          print (kos_repr result) file: stdout

    except [KeyboardInterrupt]:
      print "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [EOFError]:
      print "" file: stderr
      (stderr.flush)
      break

    except [ReaderError as: e]:
      print (e.explain) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [REPLCodeBoundary as: boundary]:
      var res (format_code_boundary_exception boundary
        nofold: full_trace
        infrastructure_modules: REPL_INFRASTRUCTURE_MODULES)
      apply_sys_last_exc res[1] res[2] res[3]
      print ("".join res[0]) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [UncaughtCompilerError as: exc]:
      var tb exc.__traceback__
      var elines (format_exception_with_koskari_trace (type exc) exc tb)
      apply_sys_last_exc (type exc) exc tb
      print ("".join elines) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [CompilerError as: exc]:
      apply_sys_last_exc (type exc) exc None
      print (exc.explain) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [Exception]:
      var info (sys.exc_info)
      var elines (format_exception_with_koskari_trace *: info)
      apply_sys_last_exc *: info
      print ("".join elines) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    (stdout.flush)

  print "" file: stdout


; The end.
