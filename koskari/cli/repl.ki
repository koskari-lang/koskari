"""
koskari.cli.repl

Koskari-native read-eval-print loop.  Read and compile happen here; the
eval step crosses the Python boundary shim ``_await_user_form`` so the
user form runs in a fresh coroutine context and REPL infrastructure stays
off its native dynchain (see design/cli-repl-rework.md section 3).  Error
rendering reuses the Python formatters in koskari.exceptions.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import sys

import-from koskari.cli _await_user_form _make_repl_prompter REPLCodeBoundary REPL_INFRASTRUCTURE_MODULES startup_lines
import-from koskari.exceptions format_code_boundary_exception format_exception_with_koskari_trace apply_sys_last_exc CompilerError UncaughtCompilerError ReaderEOF ReaderSyntaxError
import-from koskari.reader LayoutReader source_str READ_EOF
import-from koskari.module init_module build_module_load_facets
import-from koskari.lib kos_repr


(declare-exports repl_async)


; The prompt backend (_make_repl_prompter) is built in Python but returns an
; async callable: the prompt_toolkit path runs cooperatively on our event
; loop via prompt_async (no worker thread), and its EOFError / KeyboardInterrupt
; are delivered back here at the await point, where the loop below catches them.


; === Continuation heuristics ===


define block_body? [buffer]:
  """
  True if buffer appears to be inside a layout block body (user may add
  more).  A block header (some line ends with a colon) is present and the
  last non-empty line is indented; a blank line will terminate the block.
  """

  unless (and buffer (in ":" buffer)):
    return False

  define lines (buffer.splitlines)
  unless (any (each [ln lines] (.endswith (ln.rstrip) ":"))):
    return False

  define nonempty (list (filter (lambda [ln] (ln.strip)) lines))
  unless nonempty:
    return False

  define last (item nonempty -1)
  (in (item last 0) " \t")


define continuation_indent [buffer]:
  """
  Return the leading whitespace for the next continuation line.

  When buffer ends with a block header (colon), indent one level (4
  spaces) past that line.  When inside a block body, match the indent of
  the last non-empty line.  Otherwise return the empty string.
  """

  unless buffer:
    return ""

  define lines (buffer.splitlines)
  unless lines:
    return ""

  when (.endswith (buffer.rstrip) ":"):
    define last (item lines -1)
    define indent_len (- (len last) (len (last.lstrip)))
    return (* " " (+ indent_len 4))

  when (block_body? buffer):
    define nonempty (list (filter (lambda [ln] (ln.strip)) lines))
    when nonempty:
      define ln (item nonempty -1)
      return (* " " (- (len ln) (len (ln.lstrip))))

  return ""


; === Read step ===


define _INCOMPLETE (object)


define-syntax incomplete?:
  syntax-rules []:
    case (incomplete? result):
      (is result _INCOMPLETE)


define eval_expression [compiler source ns]:
  """
  Read and compile one REPL form from source.

  Returns _INCOMPLETE when the reader needs more input, otherwise a
  zero-argument compiled expression to be awaited via the boundary shim.
  Reader- and compile-phase errors propagate to the caller.
  """

  define reader (ns.get "__reader__")
  when (None? reader):
    set! reader (LayoutReader ns)
    (set-item ns "__reader__" reader)

  define stream (source_str source "<stdin>")

  define source_expr:
    try:
      reader.read stream
    except [ReaderEOF]:
      return _INCOMPLETE

  when (is source_expr READ_EOF):
    return _INCOMPLETE

  define fragment (compiler.full_compile source_expr)
  (fragment.as_expression ns)


; === REPL loop ===


define repl_async [
    mod
    prompter: None
    histfile: None
    stdin: None
    stdout: None
    stderr: None
    full_trace: False
    quiet: False]:

  """
  Run an interactive read-eval-print loop for a koskari module.

  Each form entered by the user is read, compiled, and evaluated across
  the Python boundary shim.  Multi-line input is supported via a
  continuation prompt.  Non-None results are printed to stdout and the
  last result is stored as '_' in the namespace.

  :param mod: koskari Module to use as the execution context
  :param prompter: input(prompt)-style callable; built via make_prompter
      when None
  :param histfile: history file path passed to make_prompter
  :param stdin: input stream, defaults to sys.stdin
  :param stdout: output stream, defaults to sys.stdout
  :param stderr: error stream, defaults to sys.stderr
  :param full_trace: when True, keep REPL boundary frames in tracebacks
  :param quiet: when True, suppress the startup version banner
  """

  set! stdin (or stdin sys.stdin)
  set! stdout (or stdout sys.stdout)
  set! stderr (or stderr sys.stderr)

  define compiler (getattr mod "__compiler__" None)
  when (None? compiler):
    init_module mod "<stdin>"
    define facets (build_module_load_facets mod filename: "<stdin>")
    set! compiler (item facets 0)

  define ns (vars mod)
  when (None? prompter):
    set! prompter (_make_repl_prompter histfile ns)

  unless quiet:
    for-each [line (startup_lines)]:
      print line file: stdout
    print "" file: stdout

  define buffer ""
  define prompt ">>> "

  while True:
    try:
      define indent (if (equal? prompt "... ") (continuation_indent buffer) "")
      define line (await (prompter prompt default: indent))

    except [EOFError]:
      print "" file: stderr
      (stderr.flush)
      (break)

    except [KeyboardInterrupt]:
      print "" file: stderr
      (stderr.flush)
      if (buffer.strip):
        set! buffer ""
        set! prompt ">>> "
        (continue)
      else:
        (break)

    incr! buffer (if buffer (+ "\n" line) line)

    unless (buffer.strip):
      set! buffer ""
      (continue)

    when (line.strip):
      when (.endswith (buffer.rstrip) ":"):
        set! prompt "... "
        (continue)
      when (block_body? buffer):
        set! prompt "... "
        (continue)

    try:
      define expr (eval_expression compiler buffer ns)

      if (incomplete? expr):
        set! prompt "... "
        (continue)

      define result (await (_await_user_form expr))

      set! buffer ""
      set! prompt ">>> "

      (set-item ns "_" result)
      unless (None? result):
        print (kos_repr result) file: stdout

    except [KeyboardInterrupt]:
      print "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [EOFError]:
      print "" file: stderr
      (stderr.flush)
      (break)

    except [ReaderSyntaxError as: e]:
      define ename (attr (type e) __name__)
      define emsg e.message
      print f"{ename}: {emsg}" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [REPLCodeBoundary as: boundary]:
      define res (format_code_boundary_exception boundary nofold: full_trace infrastructure_modules: REPL_INFRASTRUCTURE_MODULES)
      apply_sys_last_exc (item res 1) (item res 2) (item res 3)
      print (.join "" (item res 0)) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [UncaughtCompilerError as: exc]:
      define tb (attr exc __traceback__)
      define elines (format_exception_with_koskari_trace (type exc) exc tb)
      apply_sys_last_exc (type exc) exc tb
      print (.join "" elines) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [CompilerError as: exc]:
      apply_sys_last_exc (type exc) exc None
      print (exc.explain) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    except [Exception]:
      define info (sys.exc_info)
      define elines (format_exception_with_koskari_trace (item info 0) (item info 1) (item info 2))
      apply_sys_last_exc (item info 0) (item info 1) (item info 2)
      print (.join "" elines) end: "" file: stderr
      (stderr.flush)
      set! buffer ""
      set! prompt ">>> "

    (stdout.flush)

  print "" file: stdout


; The end.
