"""
koskari.cli.launch

Koskari-native CLI launchpad: option parsing (driving argparse), target
resolution, and run orchestration. Booted through the launcher
(koskari.launcher.run_target) the same way a packaged koskari_scripts
command runs.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import sys

import-from argparse ArgumentParser REMAINDER
import-from errno EISDIR
import-from importlib.util find_spec
import-from os getcwd stat strerror
import-from os.path abspath basename dirname
import-from stat S_ISDIR

import-from .host version_line
import-from ..importer import_module_async source_for_stale_kio
import-from ..lib ParamRef
(import-from ..module new_module init_module
  load_module_async load_module_kio_async load_module_source_async)


(declare-exports run option_parser resolve_cli_target)


; === File execution ===


def run_file [
    mod
    filename
    execute_kio: False
    interactive: False
    spec: None]:
  """
  Load and execute a koskari source file into mod.

  Calls init_module to attach file metadata and compiler specials, then
  awaits load_module_async (or load_module_kio_async when execute_kio).

  :param mod: koskari Module to execute into
  :param filename: path to the .ki source file or .kio when execute_kio
  :param execute_kio: when True, load precompiled .kio bodies
  :param interactive: when True, retain load facets for the ongoing
      session (the module still seals on completion)
  :param spec: the module spec a -m run found the file through, bound
      as __spec__ so relative imports resolve from its parent package
  """

  init_module mod filename spec: spec

  if execute_kio:
    load_module_kio_async mod
  else:
    load_module_async mod detach: (not interactive)


def run_command [
    mod
    command
    filename: "<string>"
    layout: False
    interactive: False]:
  """
  Load and execute koskari source from a string into mod.

  Runs each top-level expression in order.  ``-c`` passes s-expressions
  (``layout`` False): a layout line is one form, so several expressions
  on a line would read as a single implicit call, which is wrong for a
  one-liner.  Source arriving on stdin via ``-`` is a whole program and
  is read as layout, exactly like a file.

  :param mod: koskari Module to execute into
  :param command: koskari source text
  :param filename: value to report as ``__file__``
  :param layout: when True, read layout rather than plain s-expressions
  :param interactive: when True, retain load facets for the ongoing
      session (the module still seals on completion)
  """

  init_module mod filename
  (load_module_source_async mod command
    detach: (not interactive)
    layout: layout)


; === Program entry ===


def entry_status [value]:
  """
  The exit status an entry's return value maps to, as SystemExit maps
  its code: None is 0, an int is the status, and any other value is
  printed to stderr and gives 1

  :param value: the entry's return value
  :return: integer exit code
  """

  if (None? value):
    return 0
  elif (instance? value int):
    return (int value)
  else:
    print value file: sys.stderr
    return 1


def run_entry [mod]:
  """
  Call the entry function mod holds as __entry__, bound by the
  entry-point decorator or defined under that name, with no arguments
  once the module has finished loading.

  :param mod: koskari Module that ran as the program
  :return: the entry's exit status; 0 when mod has no entry
  """

  var ns (vars mod)
  var entry (ns.get "__entry__")
  when (None? entry):
    return 0

  (entry_status (entry))


; === Module execution ===


def find_spec_on_path [fullname path]:
  """
  The spec of a submodule, asked of each meta path finder in turn as
  the import system asks once the parent package is imported, without
  importing it

  :param fullname: dotted name of the submodule
  :param path: the parent package's submodule search locations
  :return: ModuleSpec, or None when no finder has it
  """

  for-each [finder sys.meta_path]:
    var find (getattr finder "find_spec" None)
    unless (None? find):
      var found (find fullname path)
      unless (None? found):
        return found
  return None


def main_module_spec [name]:
  """
  The spec of the module -m runs: the named module, or the __main__
  submodule when the name is a package, found through the import
  machinery as python -m finds it, except that the package is not
  imported to find its __main__: a package without one is the program,
  and it loads once run imports it.

  :param name: dotted module name
  :return: ModuleSpec with a Koskari loader: the module, a package's
      __main__ submodule, or the package itself when it has none, which
      run imports for its entry point
  :raises ImportError: when the name resolves to nothing or to a module
      that is not Koskari source
  """

  var spec (find_spec name)
  when (None? spec):
    raise (ImportError f"No module named {name}")

  unless (None? spec.submodule_search_locations):
    var main_spec (find_spec_on_path
      f"{name}.__main__" spec.submodule_search_locations)
    unless (None? main_spec):
      set! spec main_spec

  when (None? (getattr spec.loader "exec_module_async" None)):
    raise (ImportError
      f"{spec.name} is not a Koskari module; run it with python -m {spec.name}")

  return spec


def main_module_file [spec]:
  """
  The file a -m run executes: the spec's origin, unless that is a .kio
  that has fallen behind its sibling .ki

  :param spec: ModuleSpec from main_module_spec
  :return: path to the .ki or .kio to run
  """

  var filename spec.origin
  when (filename.endswith ".kio"):
    var source (source_for_stale_kio filename)
    unless (None? source):
      set! filename source
  return filename


; === Argument parsing ===


def reject_option_like_rest [parser rest]:
  """
  Error when pre-`--` REMAINDER tokens look like misplaced koskari options.
  """

  for-each [it rest]:
    ; A bare "-" names stdin as the script, so it is a filename here
    ; rather than a misplaced option.
    when (equal? it "-"):
      continue

    when (or (equal? it "--") (it.startswith "-")):
      parser.error f"unrecognized arguments: {it}"


def split_script_rest [parser rest]:
  """
  Split REMAINDER into (filename, script-args).

  When rest contains `--`, only tokens before the first `--` are checked
  for misplaced koskari options; everything after is forwarded verbatim.
  """

  unless (in? "--" rest):
    reject_option_like_rest parser rest
    return rest[0] (item-slice rest 1)

  var idx (rest.index "--")
  var pre (item-slice rest stop: idx)
  var post (item-slice rest (+ idx 1))

  unless pre:
    parser.error "expected script filename before --"

  reject_option_like_rest parser pre
  return pre[0] (+ (item-slice pre 1) post)


def resolve_cli_target [parser options]:
  """
  Flatten the exclusive run-target group into filename / args / execute_kio.

  Script paths and forwarded arguments live in `rest` (REMAINDER) so `-c`
  can accept arguments without competing with an optional filename
  positional.
  """

  when (and options.compile_kio_source_name (None? options.compile_kio)):
    parser.error "--compile-kio-source-name requires --compile-kio"

  var rest (list options.rest)

  when options.command:
    set! options.filename None
    when (and rest (equal? rest[0] "--")):
      set! rest (item-slice rest 1)
    set! options.args rest
    set! options.execute_kio False
    return options

  when options.module:
    set! options.filename None
    when (and rest (equal? rest[0] "--")):
      set! rest (item-slice rest 1)
    set! options.args rest
    set! options.execute_kio False
    return options

  when options.compile_kio:
    when rest:
      var joined (" ".join rest)
      parser.error f"unexpected extra arguments: {joined}"

    var [out_src src] options.compile_kio
    set! options.compile_kio out_src
    set! options.filename src
    set! options.args #[]
    set! options.execute_kio False
    return options

  when options.execute_kio_file:
    when rest:
      var joined (" ".join rest)
      parser.error f"unexpected extra arguments: {joined}"

    set! options.execute_kio True
    set! options.filename options.execute_kio_file[0]
    set! options.args #[]
    return options

  if rest:
    var [fn args] (split_script_rest parser rest)
    set! options.filename fn
    set! options.args args
  else:
    set! options.filename None
    set! options.args #[]

  set! options.execute_kio False
  return options


def option_parser [name]:
  """
  Build and return the ArgumentParser for the koskari CLI.
  """

  var parser (ArgumentParser prog: (basename name))

  (parser.add_argument "--version"
    dest: "show_version" action: "store_true" default: False
    help: "Print Koskari and Python version information, then exit")

  (parser.add_argument "-q" "--quiet"
    dest: "quiet" action: "store_true" default: False
    help: "Suppress REPL startup version banner")

  (parser.add_argument "--no-tweak-path"
    dest: "tweakpath" action: "store_false" default: True
    help: "Do not add the current directory to sys.path")

  (parser.add_argument "--histfile"
    dest: "histfile" action: "store" default: None
    help: "REPL history file path")

  (parser.add_argument "--repl-full-trace"
    dest: "repl_full_trace" action: "store_true" default: False
    help: "Show REPL infrastructure frames in runtime error tracebacks")

  (parser.add_argument "-i" "--interactive"
    dest: "interactive" action: "store_true" default: False
    help: "Enter interactive mode after executing the given script")

  var target (parser.add_mutually_exclusive_group)

  (target.add_argument "-c" "--command"
    dest: "command" metavar: "CMD" default: None
    help: "S-expressions evaluated as a string, then exit; for a layout program use - to read stdin")

  (target.add_argument "-m" "--module"
    dest: "module" metavar: "MODULE" default: None
    help: "Run the named module as __main__ with the current directory first on sys.path, then exit")

  (target.add_argument "--compile-kio"
    dest: "compile_kio" nargs: 2 metavar: #("OUT" "SRC") default: None
    help: "Compile SRC .ki to OUT as .kio, then exit")

  (target.add_argument "--execute-kio"
    dest: "execute_kio_file" metavar: "SRC" nargs: 1 default: None
    help: "Run SRC as a precompiled .kio")

  (parser.add_argument "--compile-kio-source-name"
    dest: "compile_kio_source_name" metavar: "PATH" default: None
    action: "store"
    help: "Logical .ki path stored in the .kio for tracebacks (default: input path)")

  (parser.add_argument "rest"
    nargs: REMAINDER default: #[]
    help: "Script path (- for stdin) and arguments forwarded to the script or REPL session")

  return parser


; === Orchestration ===


def run []:
  """
  Parse sys.argv and execute the requested koskari session.

  Reads sys.argv (set by the launcher's hosted_run), installs the run
  target into sys.argv for the executed program, and dispatches to a
  command, a file, or the REPL.  Runs inside the Domain opened by
  hosted_run, so it does not open its own.

  :return: integer exit code
  """

  var [name *: args] sys.argv

  var parser (option_parser name)
  var options (parser.parse_args args)

  ; additional post-parsing validation
  set! options (resolve_cli_target parser options)

  when options.show_version:
    print (version_line)
    print ""
    print f"Python {sys.version}"
    return 0

  var filename options.filename
  var command options.command

  ; a script, a kio to run, or a source to compile is checked against the
  ; filesystem first, so a path that is not a readable file reports as
  ; python does: one line and status 2. A -m target is resolved by the
  ; import machinery below, and - is stdin.
  when (and filename (not (equal? filename "-")) (not options.module)):
    var problem None
    try:
      var st (stat filename)
      when (S_ISDIR st.st_mode):
        set! problem #(EISDIR (strerror EISDIR))
    except [OSError as: e]:
      set! problem #(e.errno e.strerror)
    when problem:
      var [code text] problem
      print f"{(basename name)}: can't open file '{(abspath filename)}': [Errno {code}] {text}" file: sys.stderr
      return 2

  when options.compile_kio:
    import-from koskari.serialize.incremental compile_ki_file_to_kio_async
    (compile_ki_file_to_kio_async filename options.compile_kio
      source_filename: options.compile_kio_source_name)
    return 0

  ; sys.path[0] is the script's directory for a script, the working
  ; directory for -m, -c, - and the REPL, as for python; absolute, so a
  ; later chdir does not move it
  when options.tweakpath:
    if (and filename (not (equal? filename "-"))):
      sys.path.insert 0 (dirname (abspath filename))
    else:
      sys.path.insert 0 (getcwd)

  ; -m names its file through the import machinery, so the path is
  ; settled first; the module runs as a script of that file
  var spec None
  when options.module:
    try:
      set! spec (main_module_spec options.module)
    except [ImportError as: e]:
      print f"{(basename name)}: {e}" file: sys.stderr
      return 1
    set! filename (main_module_file spec)
    set! options.execute_kio (filename.endswith ".kio")

  ; Present the run target to the executed program as sys.argv.
  if command:
    set! sys.argv #["-c" *: options.args]
  else:
    if filename:
      set! sys.argv #[filename *: options.args]
    else:
      ; an interactive session reports an empty argv[0], as Python does
      set! sys.argv #["" *: options.args]

  var interactive_param (ParamRef "*interactive*")
  interactive_param.store options.interactive

  var package_entry (and spec (not (None? spec.submodule_search_locations)))

  ; the program is sys.modules["__main__"] while it runs, as under
  ; python, so import __main__, pickling and unittest.main find it; the
  ; entry a host had there comes back when the run returns, as runpy
  ; restores it, which keeps an in-process run from leaving the swap
  var previous_main (sys.modules.get "__main__")
  try:
    var mod None
    if package_entry:
      ; a package with no __main__ runs its own entry point: imported
      ; under its real name, as any import would, so its relative imports
      ; resolve and it loads once
      set! mod (import_module_async spec.name)
      unless (in? "__entry__" (vars mod)):
        print f"{(basename name)}: No module named {spec.name}.__main__; '{spec.name}' is a package without an entry point and cannot be directly executed" file: sys.stderr
        return 1

    else:
      set! mod (new_module "__main__" package: (if spec spec.parent None) system: True)

      if command:
        (run_command mod command
          interactive: options.interactive)

      elif (equal? filename "-"):
        (run_command mod (sys.stdin.read)
          filename: "<stdin>"
          layout: True
          interactive: options.interactive)

      elif filename:
        (run_file mod filename
          execute_kio: options.execute_kio
          interactive: options.interactive
          spec: spec)

    ; a program's declared entry runs once its module has loaded and
    ; sealed; an interactive session goes on to the REPL afterward
    when (or command filename):
      var status (run_entry mod)
      unless options.interactive:
        return status

    ; the package run for its entry point stays the importable package;
    ; the session opens in a __main__ of its own, as a bare session does
    when package_entry:
      set! mod (new_module "__main__" system: True)

    ; the session module is read and compiled only for a session: a
    ; script, -c, -m and the kio options never reach it
    import-from .repl repl
    (repl mod
      histfile: options.histfile
      full_trace: options.repl_full_trace
      quiet: options.quiet)

  finally:
    if (None? previous_main):
      (sys.modules.pop "__main__" None)
    else:
      set! sys.modules["__main__"] previous_main


; The end.
