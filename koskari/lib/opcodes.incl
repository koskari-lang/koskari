/**
   koskari/lib/opcodes.incl

   Opcode definitions for Koskari bytecode. This file is included
   multiple times with different definitions of the OP macro to
   generate both the enum and the styles table.

   Format: OP(name, style)

   All Koskari code is async by default. Generators are distinguished
   by the presence of YIELD/YIELD_FROM opcodes which set the
   KOS_CODE_YIELDS flag.

   :author: Christopher O'Brien <obriencj@preoccupied.net>
   :license: GNU General Public License v3
   :ai-assistant: Claude Opus 4.5 via Cursor
*/

/*
   Opcode families (sections below): no-op/debug, stack, control, calls,
   namespaces (GLOBALS/LOCALS), variable access (VAR_* and FAST_*),
   exceptions, check/jump, object protocol (OBJECT_*), blocks (PUSH_* and
   POP_*), continuations (prompt/SHIFT; call/cc PUSH_CC/POP_CC/CAPTURE_CC).
*/

// NOOP must always be first
OP(NOOP, NOARG)

// compile-time pseudo-ops (not emitted to final bytecode)
OP(LABEL, COMPILE)
OP(POSITION, COMPILE)

// stack manipulation
OP(DUP, COUNT)
OP(POP, COUNT)

// constant loading
OP(CONST, CONST)

// pair access and variadic cons
OP(CAR, COUNT)
OP(CDR, COUNT)
OP(CONS, COUNT)
OP(PROPER, COUNT)
OP(PAIR_SPLICE, COUNT)

// mode control - all code is async, yields flag async generators
OP(AWAIT, NOARG)
OP(BREAK, COUNT)
OP(CONTINUE, COUNT)
OP(RAISE, COUNT)
OP(RETURN, COUNT)
OP(YIELD, COUNT)
OP(YIELD_FROM, NOARG)

// iteration
OP(ITER_NEXT, LABEL)
OP(NEXT, COUNT)

// unconditional and conditional jumps
OP(JUMP, LABEL)
OP(JUMP_FALSE, LABEL)
OP(JUMP_TRUE, LABEL)
OP(JUMP_AND, LABEL)
OP(JUMP_OR, LABEL)

// check jumps - jump to label if predicate does not match
OP(CHECK_EQ, LABEL)
OP(CHECK_GE, LABEL)
OP(CHECK_GT, LABEL)
OP(CHECK_LE, LABEL)
OP(CHECK_LT, LABEL)
OP(CHECK_NE, LABEL)

OP(CHECK_IN, LABEL)
OP(CHECK_NOT_IN, LABEL)
OP(CHECK_IS, LABEL)
OP(CHECK_IS_NOT, LABEL)
OP(CHECK_IS_INSTANCE, LABEL)
OP(CHECK_IS_SUBCLASS, LABEL)
OP(CHECK_EXCEPTION, LABEL)

// switch dispatch - retain discriminant on mismatch
OP(SWITCH_EQ, LABEL)
OP(SWITCH_EQ_CONST,     EXTRA, LABEL, CONST,   NOARG, NOARG)
OP(SWITCH_EQ_VAR,       EXTRA, LABEL, VAR,     NOARG, NOARG)
OP(SWITCH_EQ_FAST,      EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(SWITCH_EQ_VAR_ATTR,  EXTRA, LABEL, VAR,     CONST, NOARG)
OP(SWITCH_EQ_FAST_ATTR, EXTRA, LABEL, FASTVAR, CONST, NOARG)

// introspection
OP(GLOBALS, NOARG)
OP(LOCALS, NOARG)

// module import
OP(IMPORT,      CONST)  // arg = cpool str; absolute dotted import; pushes leaf module
OP(IMPORT_REL,  CONST)  // arg = cpool (level:int, name:str|None); relative import; pushes leaf module
OP(IMPORT_FROM, CONST)  // arg = cpool str; PEEK-NOT-POP module at TOS, push named attr — MUST be followed by POP 1

// exception handling
OP(EXCEPTION, NOARG)
OP(EXCEPTION_CLEAR, NOARG)
OP(EXCEPTION_MATCH, NOARG)

// variables by name reference
OP(VAR, VAR)
OP(VAR_BIND, VAR)
OP(VAR_CLEAR, VAR)
OP(VAR_TAKE, VAR)
OP(VAR_REF, VAR)
OP(VAR_STORE, VAR)
OP(VAR_STORE_CONST, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_OBJECT_ADD, VAR)
OP(VAR_OBJECT_BIT_AND, VAR)
OP(VAR_OBJECT_BIT_LEFT, VAR)
OP(VAR_OBJECT_BIT_OR, VAR)
OP(VAR_OBJECT_BIT_RIGHT, VAR)
OP(VAR_OBJECT_BIT_XOR, VAR)
OP(VAR_OBJECT_FLOOR_DIVIDE, VAR)
OP(VAR_OBJECT_MATRIX_MULTIPLY, VAR)
OP(VAR_OBJECT_MODULO, VAR)
OP(VAR_OBJECT_MULTIPLY, VAR)
OP(VAR_OBJECT_POWER, VAR)
OP(VAR_OBJECT_SUBTRACT, VAR)
OP(VAR_OBJECT_TRUE_DIVIDE, VAR)
OP(VAR_ATTR, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ATTR_CLEAR, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ATTR_TAKE, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ATTR_REF, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ATTR_STORE, EXTRA, VAR, CONST, NOARG, NOARG)

// variables by index reference (fast locals)
OP(FAST, FASTVAR)
OP(FAST_BIND, FASTVAR)
OP(FAST_CLEAR, FASTVAR)
OP(FAST_TAKE, FASTVAR)
OP(FAST_REF, FASTVAR)
OP(FAST_STORE, FASTVAR)
OP(FAST_STORE_CONST, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_OBJECT_ADD, FASTVAR)
OP(FAST_OBJECT_BIT_AND, FASTVAR)
OP(FAST_OBJECT_BIT_LEFT, FASTVAR)
OP(FAST_OBJECT_BIT_OR, FASTVAR)
OP(FAST_OBJECT_BIT_RIGHT, FASTVAR)
OP(FAST_OBJECT_BIT_XOR, FASTVAR)
OP(FAST_OBJECT_FLOOR_DIVIDE, FASTVAR)
OP(FAST_OBJECT_MATRIX_MULTIPLY, FASTVAR)
OP(FAST_OBJECT_MODULO, FASTVAR)
OP(FAST_OBJECT_MULTIPLY, FASTVAR)
OP(FAST_OBJECT_POWER, FASTVAR)
OP(FAST_OBJECT_SUBTRACT, FASTVAR)
OP(FAST_OBJECT_TRUE_DIVIDE, FASTVAR)
OP(FAST_ATTR, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ATTR_CLEAR, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ATTR_TAKE, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ATTR_REF, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ATTR_STORE, EXTRA, FASTVAR, CONST, NOARG, NOARG)

// object attribute access
OP(ATTR, CONST)
OP(ATTR_CLEAR, CONST)
OP(ATTR_TAKE, CONST)
OP(ATTR_REF, CONST)
OP(ATTR_STORE, CONST)

// object item indexing (computed key)
OP(ITEM, NOARG)
OP(ITEM_CLEAR, NOARG)
OP(ITEM_TAKE, NOARG)
OP(ITEM_REF, NOARG)
OP(ITEM_STORE, NOARG)

// object item indexing (constant key)
OP(CONST_ITEM, CONST)
OP(CONST_ITEM_CLEAR, CONST)
OP(CONST_ITEM_TAKE, CONST)
OP(CONST_ITEM_REF, CONST)
OP(CONST_ITEM_STORE, CONST)

// reference dereference
OP(DEREF, NOARG)

// argument production
OP(BUILD_ARGS, COUNT)
OP(BUILD_LIST, COUNT)
OP(VAR_LIST_APPEND, VAR)
OP(FAST_LIST_APPEND, FASTVAR)
OP(BUILD_LIST_APPEND, NOARG)
OP(BUILD_CLASS, NOARG)
OP(BUILD_FUNCTION, COUNT)
OP(BUILD_KWDS, PAIR_COUNT)
OP(BUILD_KWDS_NAMES, CONST)
OP(COMBINE_ARGS, COUNT)
OP(COMBINE_KWDS, COUNT)

// simple call
OP(CALL, COUNT)
OP(CALL_NAMES, COUNT)
OP(CALL_STAR, STAR)

// method call
OP(CALL_ATTR, EXTRA, CONST, COUNT, NOARG, NOARG)
OP(CALL_ATTR_NAMES, EXTRA, CONST, CONST, COUNT, NOARG)
OP(CALL_ATTR_STAR, EXTRA, CONST, COUNT, NOARG, NOARG)

// calls on vars
OP(CALL_VAR, EXTRA, VAR, COUNT, NOARG, NOARG)
OP(CALL_VAR_NAMES, EXTRA, VAR, CONST, COUNT, NOARG)
OP(CALL_VAR_STAR, EXTRA, VAR, STAR, NOARG, NOARG)

OP(CALL_VAR_ATTR, EXTRA, VAR, CONST, COUNT, NOARG)
OP(CALL_VAR_ATTR_NAMES, EXTRA, VAR, CONST, CONST, COUNT)
OP(CALL_VAR_ATTR_STAR, EXTRA, VAR, CONST, COUNT, NOARG)

// calls on fastvars
OP(CALL_FAST, EXTRA, FASTVAR, COUNT, NOARG, NOARG)
OP(CALL_FAST_NAMES, EXTRA, FASTVAR, CONST, COUNT, NOARG)
OP(CALL_FAST_STAR, EXTRA, FASTVAR, STAR, NOARG, NOARG)

OP(CALL_FAST_ATTR, EXTRA, FASTVAR, CONST, COUNT, NOARG)
OP(CALL_FAST_ATTR_NAMES, EXTRA, FASTVAR, CONST, CONST, COUNT)
OP(CALL_FAST_ATTR_STAR, EXTRA, FASTVAR, CONST, COUNT, NOARG)

// tail call (replaces current frame)
OP(TAIL_CALL, COUNT)
OP(TAIL_CALL_NAMES, COUNT)
OP(TAIL_CALL_STAR, STAR)

// block control - all foreach/with are async in Koskari
OP(PUSH_FOREACH, NOARG)
OP(PUSH_WITH, CONST)
OP(PUSH_DYN_WITH, CONST)
OP(PUSH_COLLECT, CONST)
OP(PUSH_FINALLY, LABEL)
OP(PUSH_LOOP, NOARG)
OP(PUSH_NS, EXTRA, CONST, CONST, NOARG, NOARG)
OP(PUSH_TRY, LABEL)

OP(CLEAR_FINALLY, NOARG)
OP(CLEAR_LOOP, NOARG)
OP(CLEAR_FOREACH, NOARG)
OP(CLEAR_TRY, NOARG)

OP(POP_WITH, NOARG)
OP(POP_DYN_WITH, NOARG)
OP(POP_FINALLY, NOARG)
OP(POP_LOOP, NOARG)
OP(POP_FOREACH, NOARG)
OP(POP_COLLECT, NOARG)
OP(POP_NS, NOARG)
OP(POP_TRY, NOARG)

// comparison interface
OP(OBJECT_EQ, COUNT)
OP(OBJECT_GE, COUNT)
OP(OBJECT_GT, COUNT)
OP(OBJECT_LE, COUNT)
OP(OBJECT_LT, COUNT)
OP(OBJECT_NE, COUNT)

// predicates
OP(OBJECT_IN, NOARG)
OP(OBJECT_NOT_IN, NOARG)
OP(OBJECT_IS, NOARG)
OP(OBJECT_IS_NOT, NOARG)
OP(OBJECT_IS_INSTANCE, COUNT)
OP(OBJECT_IS_SUBCLASS, COUNT)

// numeric interface
OP(OBJECT_ADD, COUNT)
OP(OBJECT_BIT_AND, COUNT)
OP(OBJECT_BIT_INVERT, NOARG)
OP(OBJECT_BIT_LEFT, NOARG)
OP(OBJECT_BIT_OR, COUNT)
OP(OBJECT_BIT_RIGHT, NOARG)
OP(OBJECT_BIT_XOR, COUNT)
OP(OBJECT_FLOOR_DIVIDE, COUNT)
OP(OBJECT_MATRIX_MULTIPLY, COUNT)
OP(OBJECT_MODULO, NOARG)
OP(OBJECT_MULTIPLY, COUNT)
OP(OBJECT_POWER, COUNT)
OP(OBJECT_SUBTRACT, COUNT)
OP(OBJECT_TRUE_DIVIDE, NOARG)

// general object interface
OP(OBJECT_AITER, NOARG)
OP(OBJECT_DIR, NOARG)
OP(OBJECT_DIVMOD, NOARG)
OP(OBJECT_ITER, NOARG)
OP(OBJECT_LEN, NOARG)
OP(OBJECT_NOT, NOARG)
OP(OBJECT_REPR, NOARG)
OP(OBJECT_STR, COUNT)
OP(OBJECT_FORMAT, COUNT)
OP(OBJECT_FORMAT_CONST, CONST)
OP(OBJECT_TRUTH, NOARG)
OP(OBJECT_TYPE, NOARG)
OP(OBJECT_VARS, NOARG)

// delimited continuation control
OP(PUSH_PROMPT, CONST)         // arg = prompt_id constant pool index
OP(POP_PROMPT, NOARG)          // pop prompt from dynamic chain
OP(PUSH_SHIFT, CONST)          // arg = prompt_id; capture continuation, enter shift block
OP(POP_SHIFT, NOARG)           // pop shift block; return from handler without invoking k

// undelimited continuation (call/cc) block
OP(PUSH_CC, NOARG)             // arg = instruction index after POP_CC (resume PC)
OP(POP_CC, NOARG)              // pop CC block from dynamic chain
OP(CAPTURE_CC, NOARG)          // capture undelimited continuation, push on stack

// dynamic wind control
OP(PUSH_WIND, COUNT)           // arg = 1 (before only) or 2 (both); stack: [..., before, after]
OP(POP_WIND, NOARG)            // pop wind from dynamic chain

// parameterize extent (domain param bindings)
OP(PUSH_PARAM, CONST)          // arg = constant index of names tuple
OP(PARAM, CONST)               // arg = constant index of name (ParamRef key)
OP(POP_PARAM, NOARG)           // pop KOS_DYN_PARAM from chain

// sequence unpack (realize TOS to PySequence, then peel or assign)
OP(UNPACK, COUNT)
OP(UNPACK_STAR, EXTRA, COUNT, COUNT, NOARG, NOARG)
OP(UNPACK_VAR, EXTRA, VAR, VAR, NOARG, NOARG)
OP(UNPACK_FAST, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)

// THEEND must always be last
OP(THEEND, NOARG)


// The end.
