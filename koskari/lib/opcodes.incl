/**
   koskari/lib/opcodes.incl

   Opcode definitions for Koskari bytecode. This file is included
   multiple times with different definitions of the OP macro to
   generate both the enum and the styles table.

   Format: OP(name, cache_slots, style) for simple styles, or
   OP(name, cache_slots, EXTRA, f0, f1, f2, f3) declaring the four
   field kinds of an EXTRA row (NOARG pads unused fields).

   All Koskari code is async by default. Generators are distinguished
   by the presence of YIELD/YIELD_FROM opcodes which set the
   KOS_CODE_YIELDS flag.

   :author: Christopher O'Brien <obriencj@preoccupied.net>
   :license: GNU General Public License v3
*/

/*
   Opcode families (sections below): no-op/debug, stack, control, calls,
   namespaces (GLOBALS/LOCALS), variable access (VAR_* and FAST_*),
   exceptions, check/jump, object protocol (OBJECT_*), blocks (PUSH_* and
   POP_*), continuations (prompt/SHIFT; call/cc PUSH_CC/POP_CC/CAPTURE_CC).
*/

// NOOP must always be first
OP(NOOP, 0, NOARG)

// compile-time pseudo-ops (not emitted to final bytecode)
OP(LABEL, 0, COMPILE)
OP(POSITION, 0, COMPILE)

// stack manipulation
OP(DUP, 0, COUNT)
OP(POP, 0, COUNT)

// constant loading
OP(CONST, 0, CONST)
OP(CONST2, 0, EXTRA, CONST, CONST, NOARG, NOARG)
OP(CONST3, 0, EXTRA, CONST, CONST, CONST, NOARG)
OP(CONST4, 0, EXTRA, CONST, CONST, CONST, CONST)

// pair access and variadic cons
OP(CAR, 0, COUNT)
OP(CDR, 0, COUNT)
OP(CONS, 0, COUNT)
OP(PROPER, 0, COUNT)
OP(BRACKET_CONS, 0, COUNT)
OP(BRACKET_PROPER, 0, COUNT)
OP(PAIR_SPLICE, 0, EXTRA, COUNT, COUNT, NOARG, NOARG)     // count, tail flag
OP(BRACKET_SPLICE, 0, EXTRA, COUNT, COUNT, NOARG, NOARG)  // count, tail flag

// mode control - all code is async, yields flag async generators
OP(AWAIT, 0, COUNT)
OP(BREAK, 0, COUNT)
OP(CONTINUE, 0, COUNT)
OP(RAISE, 0, COUNT)
OP(RETURN, 0, COUNT)
OP(YIELD, 0, COUNT)
OP(RETURN_CONST, 0, CONST)
OP(YIELD_CONST, 0, CONST)
OP(YIELD_FROM, 0, NOARG)

// iteration (the FOREACH region step; the stack-based step is
// OBJECT_NEXT in the object interface section)
OP(ITER_NEXT, 0, LABEL)

// unconditional and conditional jumps
OP(JUMP, 0, LABEL)
OP(JUMP_FALSE, 0, LABEL)
OP(JUMP_TRUE, 0, LABEL)
OP(JUMP_AND, 0, LABEL)
OP(JUMP_OR, 0, LABEL)

// check jumps - jump to label if predicate does not match. The
// comparison check is variadic and selector-keyed: the EXTRA row
// carries (CMP, COUNT, LABEL, COUNT) so a chained compare over COUNT
// operands under any KosCompare selector fuses with its jump; the
// fourth field is the negate flag, under which the check tests the
// negated chain (the OBJECT_COMPARE + JUMP_TRUE fusion). The arity-2
// fused forms absorb their operand feeders: CMPSRC packs the selector
// with per-operand source bits (a set bit overrides that slot from its
// declared kind to CONST) and the same negate bit.
OP(CHECK_COMPARE, 1, EXTRA, CMP, COUNT, LABEL, COUNT)  // cache: elector
OP(CHECK_COMPARE_VAR, 0,  EXTRA, CMPSRC, VAR,     VAR,     LABEL)
OP(CHECK_COMPARE_FAST, 0, EXTRA, CMPSRC, FASTVAR, FASTVAR, LABEL)

OP(CHECK_EXCEPTION, 0, LABEL)
OP(CHECK_NIL, 0, LABEL)        // squashed NILP + JUMP_FALSE: jump if not nil

// switch dispatch - retain discriminant on mismatch
OP(SWITCH_EQ, 0, LABEL)
OP(SWITCH_EQ_CONST, 0,     EXTRA, LABEL, CONST,   NOARG, NOARG)
OP(SWITCH_EQ_VAR, 0,       EXTRA, LABEL, VAR,     NOARG, NOARG)
OP(SWITCH_EQ_FAST, 0,      EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(SWITCH_EQ_VAR_ATTR, 0,  EXTRA, LABEL, VAR,     ATTR, NOARG)
OP(SWITCH_EQ_FAST_ATTR, 0, EXTRA, LABEL, FASTVAR, ATTR, NOARG)

// introspection
OP(GLOBALS, 0, NOARG)
OP(LOCALS, 0, NOARG)

// module import — self-contained: each opcode imports its own module and
// stores its own bindings; no stack effect from any of them
OP(IMPORT, 0,      EXTRA, CONST, COUNT, COUNT, CONST)  // name, level, leaf flag, bind name
OP(IMPORT_FROM, 0, EXTRA, CONST, COUNT, CONST, CONST)  // name, level, attr names tuple, bind names tuple
OP(IMPORT_STAR, 0, EXTRA, CONST, COUNT, NOARG, NOARG)  // name, level; binds the module's public names
OP(IMPORT_USE, 0,  EXTRA, CONST, COUNT, CONST, CONST)  // name, level, feature stems tuple, bind stems tuple

// exception handling
OP(EXCEPTION, 0, NOARG)
OP(EXCEPTION_CLEAR, 0, NOARG)
OP(EXCEPTION_MATCH, 0, NOARG)

// variables by name reference
OP(VAR, 0, VAR)
OP(VAR2, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR3, 0, EXTRA, VAR, VAR, VAR, NOARG)
OP(VAR4, 0, EXTRA, VAR, VAR, VAR, VAR)
OP(VAR_BIND, 0, VAR)
OP(VAR_CLEAR, 0, VAR)
OP(VAR_TAKE, 0, VAR)
OP(VAR_REF, 0, VAR)
OP(VAR_STORE, 0, VAR)
OP(VAR_STORE_CONST, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_INPLACE, 0, EXTRA, OPERAND, VAR, NOARG, NOARG)
OP(VAR_INPLACE_CONST, 0, EXTRA, OPERAND, VAR, CONST, NOARG)
OP(VAR_ATTR, 1, EXTRA, VAR, ATTR, NOARG, NOARG)
OP(VAR_ATTR_CLEAR, 0, EXTRA, VAR, ATTR, NOARG, NOARG)
OP(VAR_ATTR_TAKE, 0, EXTRA, VAR, ATTR, NOARG, NOARG)
OP(VAR_ATTR_REF, 0, EXTRA, VAR, ATTR, NOARG, NOARG)
OP(VAR_ATTR_STORE, 1, EXTRA, VAR, ATTR, NOARG, NOARG)
OP(VAR_ATTR_INPLACE, 1, EXTRA, OPCOUNT, VAR, ATTR, NOARG)
OP(ITEM_STORE_VAR, 0, VAR)
OP(ITEM_CONST_STORE_VAR, 0, EXTRA, CONST, VAR, NOARG, NOARG)
OP(ITEM_VAR, 0, VAR)
OP(ITEM_VAR_CLEAR, 0, VAR)
OP(ITEM_VAR_TAKE, 0, VAR)
OP(ITEM_VAR_REF, 0, VAR)
OP(ITEM_VAR_STORE, 0, VAR)
OP(ITEM_VAR_STORE_CONST, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(ITEM_VAR_STORE_VAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(ITEM_VAR_INPLACE, 0, EXTRA, OPCOUNT, VAR, NOARG, NOARG)
OP(ITEM_VAR_INPLACE_CONST, 0, EXTRA, OPERAND, VAR, CONST, NOARG)
OP(VAR_ITEM, 0, VAR)
OP(VAR_ITEM_CLEAR, 0, VAR)
OP(VAR_ITEM_TAKE, 0, VAR)
OP(VAR_ITEM_REF, 0, VAR)
OP(VAR_ITEM_STORE, 0, VAR)
OP(VAR_ITEM_STORE_CONST, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ITEM_STORE_VAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR_ITEM_INPLACE, 0, EXTRA, OPCOUNT, VAR, NOARG, NOARG)
OP(VAR_ITEM_INPLACE_CONST, 0, EXTRA, OPERAND, VAR, CONST, NOARG)
OP(VAR_ITEM_CONST, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ITEM_CONST_CLEAR, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ITEM_CONST_TAKE, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ITEM_CONST_REF, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ITEM_CONST_STORE, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(VAR_ITEM_CONST_STORE_CONST, 0, EXTRA, VAR, CONST, CONST, NOARG)
OP(VAR_ITEM_CONST_STORE_VAR, 0, EXTRA, VAR, CONST, VAR, NOARG)
OP(VAR_ITEM_CONST_INPLACE, 0, EXTRA, OPCOUNT, VAR, CONST, NOARG)
OP(VAR_ITEM_CONST_INPLACE_CONST, 0, EXTRA, OPERAND, VAR, CONST, CONST)
OP(VAR_ITEM_VAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR_ITEM_VAR_CLEAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR_ITEM_VAR_TAKE, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR_ITEM_VAR_REF, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR_ITEM_VAR_STORE, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(VAR_ITEM_VAR_STORE_CONST, 0, EXTRA, VAR, VAR, CONST, NOARG)
OP(VAR_ITEM_VAR_STORE_VAR, 0, EXTRA, VAR, VAR, VAR, NOARG)
OP(VAR_ITEM_VAR_INPLACE, 0, EXTRA, OPCOUNT, VAR, VAR, NOARG)
OP(VAR_ITEM_VAR_INPLACE_CONST, 0, EXTRA, OPERAND, VAR, VAR, CONST)
OP(VAR_ITER, 0, VAR)
OP(VAR_NEXT, 0, EXTRA, VAR, COUNT, NOARG, NOARG)
OP(VAR_FORMAT, 0, VAR)
OP(VAR_FORMAT_CONST, 0, EXTRA, VAR, CONST, NOARG, NOARG)
OP(RETURN_VAR, 0, VAR)
OP(YIELD_VAR, 0, VAR)

// variables by index reference (fast locals)
OP(FAST, 0, FASTVAR)
OP(FAST2, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)
OP(FAST3, 0, EXTRA, FASTVAR, FASTVAR, FASTVAR, NOARG)
OP(FAST4, 0, EXTRA, FASTVAR, FASTVAR, FASTVAR, FASTVAR)
OP(FAST_BIND, 0, FASTVAR)
OP(FAST_CLEAR, 0, FASTVAR)
OP(FAST_TAKE, 0, FASTVAR)
OP(FAST_REF, 0, FASTVAR)
OP(FAST_STORE, 0, FASTVAR)
OP(FAST_STORE_CONST, 0, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_INPLACE, 1, EXTRA, OPERAND, FASTVAR, NOARG, NOARG)  // cache: elector
OP(FAST_INPLACE_CONST, 1, EXTRA, OPERAND, FASTVAR, CONST, NOARG)  // cache: elector
OP(FAST_ATTR, 1, EXTRA, FASTVAR, ATTR, NOARG, NOARG)
OP(FAST_ATTR_CLEAR, 0, EXTRA, FASTVAR, ATTR, NOARG, NOARG)
OP(FAST_ATTR_TAKE, 0, EXTRA, FASTVAR, ATTR, NOARG, NOARG)
OP(FAST_ATTR_REF, 0, EXTRA, FASTVAR, ATTR, NOARG, NOARG)
OP(FAST_ATTR_STORE, 1, EXTRA, FASTVAR, ATTR, NOARG, NOARG)
OP(FAST_ATTR_INPLACE, 2, EXTRA, OPCOUNT, FASTVAR, ATTR, NOARG)  // cache: field, elector
OP(ITEM_STORE_FAST, 1, FASTVAR)  // cache: elector
OP(ITEM_CONST_STORE_FAST, 1, EXTRA, CONST, FASTVAR, NOARG, NOARG)  // cache: elector
OP(ITEM_FAST, 1, FASTVAR)  // cache: elector
OP(ITEM_FAST_CLEAR, 0, FASTVAR)
OP(ITEM_FAST_TAKE, 0, FASTVAR)
OP(ITEM_FAST_REF, 0, FASTVAR)
OP(ITEM_FAST_STORE, 1, FASTVAR)  // cache: elector
OP(ITEM_FAST_STORE_CONST, 1, EXTRA, FASTVAR, CONST, NOARG, NOARG)  // cache: elector
OP(ITEM_FAST_STORE_FAST, 1, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)  // cache: elector
OP(ITEM_FAST_INPLACE, 1, EXTRA, OPCOUNT, FASTVAR, NOARG, NOARG)  // cache: elector
OP(ITEM_FAST_INPLACE_CONST, 1, EXTRA, OPERAND, FASTVAR, CONST, NOARG)  // cache: elector
OP(FAST_ITEM, 1, FASTVAR)  // cache: elector
OP(FAST_ITEM_CLEAR, 0, FASTVAR)
OP(FAST_ITEM_TAKE, 0, FASTVAR)
OP(FAST_ITEM_REF, 0, FASTVAR)
OP(FAST_ITEM_STORE, 1, FASTVAR)  // cache: elector
OP(FAST_ITEM_STORE_CONST, 1, EXTRA, FASTVAR, CONST, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_STORE_FAST, 1, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_INPLACE, 1, EXTRA, OPCOUNT, FASTVAR, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_INPLACE_CONST, 1, EXTRA, OPERAND, FASTVAR, CONST, NOARG)  // cache: elector
OP(FAST_ITEM_CONST, 1, EXTRA, FASTVAR, CONST, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_CONST_CLEAR, 0, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ITEM_CONST_TAKE, 0, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ITEM_CONST_REF, 0, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(FAST_ITEM_CONST_STORE, 1, EXTRA, FASTVAR, CONST, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_CONST_STORE_CONST, 1, EXTRA, FASTVAR, CONST, CONST, NOARG)  // cache: elector
OP(FAST_ITEM_CONST_STORE_FAST, 1, EXTRA, FASTVAR, CONST, FASTVAR, NOARG)  // cache: elector
OP(FAST_ITEM_CONST_INPLACE, 1, EXTRA, OPCOUNT, FASTVAR, CONST, NOARG)  // cache: elector
OP(FAST_ITEM_CONST_INPLACE_CONST, 1, EXTRA, OPERAND, FASTVAR, CONST, CONST)  // cache: elector
OP(FAST_ITEM_FAST, 1, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_FAST_CLEAR, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)
OP(FAST_ITEM_FAST_TAKE, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)
OP(FAST_ITEM_FAST_REF, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)
OP(FAST_ITEM_FAST_STORE, 1, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)  // cache: elector
OP(FAST_ITEM_FAST_STORE_CONST, 1, EXTRA, FASTVAR, FASTVAR, CONST, NOARG)  // cache: elector
OP(FAST_ITEM_FAST_STORE_FAST, 1, EXTRA, FASTVAR, FASTVAR, FASTVAR, NOARG)  // cache: elector
OP(FAST_ITEM_FAST_INPLACE, 1, EXTRA, OPCOUNT, FASTVAR, FASTVAR, NOARG)  // cache: elector
OP(FAST_ITEM_FAST_INPLACE_CONST, 1, EXTRA, OPERAND, FASTVAR, FASTVAR, CONST)  // cache: elector
OP(FAST_ITER, 0, FASTVAR)
OP(FAST_NEXT, 0, EXTRA, FASTVAR, COUNT, NOARG, NOARG)
OP(FAST_FORMAT, 0, FASTVAR)
OP(FAST_FORMAT_CONST, 0, EXTRA, FASTVAR, CONST, NOARG, NOARG)
OP(RETURN_FAST, 0, FASTVAR)
OP(YIELD_FAST, 0, FASTVAR)

// object attribute access
OP(ATTR, 1, CONST)  // cache: field
OP(ATTR_CLEAR, 0, CONST)
OP(ATTR_TAKE, 0, CONST)
OP(ATTR_REF, 0, CONST)
OP(ATTR_STORE, 1, CONST)  // cache: field
OP(ATTR_INPLACE, 1, EXTRA, OPCOUNT, ATTR, NOARG, NOARG)

// object item indexing: object on the stack, key on the stack,
// in the pool, or in a slot (see design/archive/item-opcode-matrix.md)
OP(ITEM, 1, NOARG)  // cache: elector
OP(ITEM_CLEAR, 0, NOARG)
OP(ITEM_TAKE, 0, NOARG)
OP(ITEM_REF, 0, NOARG)
OP(ITEM_STORE, 1, NOARG)  // cache: elector
OP(ITEM_STORE_CONST, 1, CONST)  // cache: elector
OP(ITEM_INPLACE, 1, OPCOUNT)  // cache: elector
OP(ITEM_INPLACE_CONST, 1, EXTRA, OPERAND, CONST, NOARG, NOARG)  // cache: elector
OP(ITEM_CONST, 1, CONST)  // cache: elector
OP(ITEM_CONST_CLEAR, 0, CONST)
OP(ITEM_CONST_TAKE, 0, CONST)
OP(ITEM_CONST_REF, 0, CONST)
OP(ITEM_CONST_STORE, 1, CONST)  // cache: elector
OP(ITEM_CONST_STORE_CONST, 1, EXTRA, CONST, CONST, NOARG, NOARG)  // cache: elector
OP(ITEM_CONST_INPLACE, 1, EXTRA, OPCOUNT, CONST, NOARG, NOARG)  // cache: elector
OP(ITEM_CONST_INPLACE_CONST, 1, EXTRA, OPERAND, CONST, CONST, NOARG)  // cache: elector

// reference dereference
OP(DEREF, 0, NOARG)

// argument production
OP(BUILD_ARGS, 0, COUNT)
OP(BUILD_LIST, 0, COUNT)
OP(BUILD_LIST_CONST, 0, CONST)
OP(VAR_LIST_APPEND, 0, VAR)
OP(FAST_LIST_APPEND, 0, FASTVAR)
OP(BUILD_LIST_APPEND, 0, COUNT)
OP(BUILD_LIST_APPEND_CONST, 0, CONST)
OP(BUILD_LIST_EXTEND, 0, NOARG)
OP(BUILD_LIST_EXTEND_CONST, 0, CONST)
OP(BUILD_CLASS, 0, NOARG)
OP(BUILD_FUNCTION, 0, EXTRA, CONST, CONST, NOARG, NOARG)
OP(BUILD_KWDS, 0, PAIR_COUNT)
OP(BUILD_KWDS_NAMES, 0, CONST)
OP(COMBINE_ARGS, 0, COUNT)
OP(COMBINE_KWDS, 0, COUNT)

// simple call
OP(CALL, 0, COUNT)
OP(CALL_NAMES, 0, COUNT)
OP(CALL_STAR, 0, STAR)

// method call
OP(CALL_ATTR, 1, EXTRA, ATTR, COUNT, NOARG, NOARG)
OP(CALL_ATTR_NAMES, 1, EXTRA, ATTR, CONST, COUNT, NOARG)
OP(CALL_ATTR_STAR, 1, EXTRA, ATTR, COUNT, NOARG, NOARG)

// calls on vars
OP(CALL_VAR, 0, EXTRA, VAR, COUNT, NOARG, NOARG)
OP(CALL_VAR_NAMES, 0, EXTRA, VAR, CONST, COUNT, NOARG)
OP(CALL_VAR_STAR, 0, EXTRA, VAR, STAR, NOARG, NOARG)

OP(CALL_VAR_ATTR, 1, EXTRA, VAR, ATTR, COUNT, NOARG)
OP(CALL_VAR_ATTR_NAMES, 1, EXTRA, VAR, ATTR, CONST, COUNT)
OP(CALL_VAR_ATTR_STAR, 1, EXTRA, VAR, ATTR, COUNT, NOARG)

// calls on fastvars
OP(CALL_FAST, 0, EXTRA, FASTVAR, COUNT, NOARG, NOARG)
OP(CALL_FAST_NAMES, 0, EXTRA, FASTVAR, CONST, COUNT, NOARG)
OP(CALL_FAST_STAR, 0, EXTRA, FASTVAR, STAR, NOARG, NOARG)

OP(CALL_FAST_ATTR, 1, EXTRA, FASTVAR, ATTR, COUNT, NOARG)
OP(CALL_FAST_ATTR_NAMES, 1, EXTRA, FASTVAR, ATTR, CONST, COUNT)
OP(CALL_FAST_ATTR_STAR, 1, EXTRA, FASTVAR, ATTR, COUNT, NOARG)

// tail call (replaces current frame)
OP(TAIL_CALL, 0, COUNT)
OP(TAIL_CALL_NAMES, 0, COUNT)
OP(TAIL_CALL_STAR, 0, STAR)

// tail method call
OP(TAIL_CALL_ATTR, 1, EXTRA, ATTR, COUNT, NOARG, NOARG)
OP(TAIL_CALL_ATTR_NAMES, 1, EXTRA, ATTR, CONST, COUNT, NOARG)
OP(TAIL_CALL_ATTR_STAR, 1, EXTRA, ATTR, COUNT, NOARG, NOARG)

// tail calls on vars
OP(TAIL_CALL_VAR, 0, EXTRA, VAR, COUNT, NOARG, NOARG)
OP(TAIL_CALL_VAR_NAMES, 0, EXTRA, VAR, CONST, COUNT, NOARG)
OP(TAIL_CALL_VAR_STAR, 0, EXTRA, VAR, STAR, NOARG, NOARG)

OP(TAIL_CALL_VAR_ATTR, 1, EXTRA, VAR, ATTR, COUNT, NOARG)
OP(TAIL_CALL_VAR_ATTR_NAMES, 1, EXTRA, VAR, ATTR, CONST, COUNT)
OP(TAIL_CALL_VAR_ATTR_STAR, 1, EXTRA, VAR, ATTR, COUNT, NOARG)

// tail calls on fastvars
OP(TAIL_CALL_FAST, 0, EXTRA, FASTVAR, COUNT, NOARG, NOARG)
OP(TAIL_CALL_FAST_NAMES, 0, EXTRA, FASTVAR, CONST, COUNT, NOARG)
OP(TAIL_CALL_FAST_STAR, 0, EXTRA, FASTVAR, STAR, NOARG, NOARG)

OP(TAIL_CALL_FAST_ATTR, 1, EXTRA, FASTVAR, ATTR, COUNT, NOARG)
OP(TAIL_CALL_FAST_ATTR_NAMES, 1, EXTRA, FASTVAR, ATTR, CONST, COUNT)
OP(TAIL_CALL_FAST_ATTR_STAR, 1, EXTRA, FASTVAR, ATTR, COUNT, NOARG)

// block control - all foreach/with are async in Koskari
OP(PUSH_FOREACH, 1, NOARG)  // cache: extent close pc
OP(PUSH_WITH, 1, CONST)  // cache: extent close pc
OP(PUSH_DYN_WITH, 1, CONST)  // cache: extent close pc
OP(PUSH_COLLECT, 0, CONST)
OP(PUSH_FINALLY, 0, LABEL)
OP(PUSH_LOOP, 1, NOARG)  // cache: extent close pc
OP(PUSH_NS, 0, EXTRA, CONST, CONST, NOARG, NOARG)
OP(PUSH_TRY, 0, LABEL)

OP(CLEAR_FINALLY, 0, NOARG)
OP(CLEAR_LOOP, 0, NOARG)
OP(CLEAR_FOREACH, 0, NOARG)
OP(CLEAR_TRY, 0, NOARG)

OP(POP_WITH, 0, NOARG)
OP(POP_DYN_WITH, 0, NOARG)
OP(POP_FINALLY, 0, NOARG)
OP(POP_LOOP, 0, NOARG)
OP(POP_FOREACH, 0, NOARG)
OP(POP_COLLECT, 0, NOARG)
OP(POP_NS, 0, NOARG)
OP(POP_TRY, 0, NOARG)

// comparison interface: OBJECT_COMPARE packs a KosCompare selector
// (high byte) with the reducing count (low byte). The ternary fused
// forms carry the bounds idiom (const < x < const) with a bare CMP
// selector and schema-static slots, pushing the chain result.
OP(OBJECT_COMPARE, 1, CMPCOUNT)  // cache: elector
OP(OBJECT_COMPARE_VAR, 0,  EXTRA, CMP, CONST, VAR,     CONST)
OP(OBJECT_COMPARE_FAST, 0, EXTRA, CMP, CONST, FASTVAR, CONST)

// predicates
OP(NILP, 0, NOARG)            // pop TOS, push True if an empty-list singleton

OP(OBJECT_OPERAND, 1, OPCOUNT)  // cache: elector
OP(OBJECT_INPLACE, 1, OPCOUNT)  // cache: elector

// general object interface
OP(OBJECT_BIT_INVERT, 0, NOARG)
OP(OBJECT_DIR, 0, NOARG)
OP(OBJECT_DIVMOD, 0, COUNT)
OP(OBJECT_ITER, 0, NOARG)
OP(OBJECT_LEN, 0, NOARG)
OP(OBJECT_NEXT, 0, COUNT)
OP(OBJECT_NOT, 0, NOARG)
OP(OBJECT_REPR, 0, NOARG)
OP(OBJECT_STR, 0, COUNT)
OP(OBJECT_FORMAT, 0, COUNT)
OP(OBJECT_FORMAT_CONST, 0, CONST)
OP(OBJECT_TRUTH, 0, NOARG)
OP(OBJECT_TYPE, 0, NOARG)
OP(OBJECT_VARS, 0, NOARG)

// delimited continuation control
OP(PUSH_PROMPT, 1, CONST)         // arg = prompt_id constant pool index; cache: extent close pc
OP(POP_PROMPT, 0, NOARG)          // pop prompt from dynamic chain
OP(PUSH_SHIFT, 0, CONST)          // arg = prompt_id; capture continuation, enter shift block
OP(POP_SHIFT, 0, NOARG)           // pop shift block; return from handler without invoking k

// undelimited continuation (call/cc) block
OP(PUSH_CC, 1, NOARG)             // cache: extent close pc
OP(POP_CC, 0, NOARG)              // pop CC block from dynamic chain
OP(CAPTURE_CC, 0, COUNT)          // capture undelimited continuation, push on stack; 1 = set the callee on TOS aside first

// dynamic wind control
OP(PUSH_WIND, 0, COUNT)           // arg = 1 (before only) or 2 (both); stack: [..., before, after]
OP(POP_WIND, 0, NOARG)            // pop wind from dynamic chain

// parameterize extent and parameter reads
OP(PUSH_PARAM, 0, CONST)          // arg = constant index of names tuple
OP(POP_PARAM, 0, NOARG)           // pop KOS_DYN_PARAM from chain
OP(PARAM, 0, EXTRA, CONST, COUNT, NOARG, NOARG)   // name; 0 or 1 stacked default
OP(PARAM_CONST, 0, EXTRA, CONST, CONST, NOARG, NOARG)  // name; const default

// sequence unpack (realize TOS to PySequence, then peel or assign)
OP(UNPACK, 0, COUNT)
OP(UNPACK_STAR, 0, EXTRA, COUNT, COUNT, NOARG, NOARG)
OP(UNPACK_VAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)
OP(UNPACK_FAST, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)

// runtime match/case dispatch — subject held on the stack across arms
OP(MATCH_CASE, 1, EXTRA, LABEL, CONST, CONST, COUNT)  // no-match label; frozen matcher tuple; missing-externs name tuple (values stacked above the subject); keep-subject flag; a match binds the captures into the namespace; cache: thawed Matcher + capture slot indices

// the match instructions (design/interpreter/matcher-bytecode.md): a
// pattern lowered to straight-line code. A pull instruction reads its
// element from the cursor slot it names, advancing the slot in place,
// and pushes nothing unless it says so; a peek instruction tests the
// element on top of the stack and never pops; a miss jumps to the
// row's label with the stack and the cursor as they were. Every slot
// is a VAR field the compiler lowers to its FAST twin. A RAW field is
// the instruction's own immediate: the FORM shapes pack the inner
// pattern's min and max widths, eight bits each, 0xFF unbounded; the
// REST shapes pack the minimum tail and the width of the suffix that
// follows; CLASS carries its positional count, FIELD_POS its index.
OP(MATCH_FORM_VAR, 0, EXTRA, LABEL, VAR, RAW, NOARG)  // peek: the sequence gate on TOS, the cursor into the slot
OP(MATCH_FORM_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, NOARG)
OP(MATCH_NEXT_FORM_VAR, 0, EXTRA, LABEL, VAR, VAR, RAW)  // pull from the first slot, the gate, the inner cursor into the second
OP(MATCH_NEXT_FORM_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, RAW)
OP(MATCH_NEXT_VAR, 0, EXTRA, LABEL, VAR, NOARG, NOARG)  // pull and push the element, boxed from a pair spine
OP(MATCH_NEXT_FAST, 0, EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(MATCH_PEEK_VAR, 0, EXTRA, LABEL, VAR, NOARG, NOARG)  // push the next element without advancing the cursor; the zero-width NOT reads it
OP(MATCH_PEEK_FAST, 0, EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(MATCH_NEXT_BIND_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // pull and store the element into the second slot
OP(MATCH_NEXT_BIND_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_NEXT_TYPE_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // pull; the element must be an instance of the type in the second slot
OP(MATCH_NEXT_TYPE_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_NEXT_TYPE_BIND_VAR, 0, EXTRA, LABEL, VAR, VAR, VAR)  // pull, the type test, the store into the third slot
OP(MATCH_NEXT_TYPE_BIND_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, FASTVAR)
OP(MATCH_NEXT_LITERAL_VAR, 0, EXTRA, LABEL, VAR, CONST, NOARG)  // pull; the element must equal the constant
OP(MATCH_NEXT_LITERAL_FAST, 0, EXTRA, LABEL, FASTVAR, CONST, NOARG)
OP(MATCH_REST_VAR, 0, EXTRA, LABEL, VAR, RAW, NOARG)  // consume the remainder but the suffix; the minimum tail and suffix width packed
OP(MATCH_REST_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, NOARG)
OP(MATCH_REST_BIND_VAR, 0, EXTRA, LABEL, VAR, RAW, VAR)  // the remainder stored into the third slot
OP(MATCH_REST_BIND_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, FASTVAR)
OP(MATCH_END_VAR, 0, EXTRA, LABEL, VAR, NOARG, NOARG)  // the cursor must be at its end
OP(MATCH_END_FAST, 0, EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(MATCH_AVAILABLE_VAR, 0, EXTRA, LABEL, VAR, RAW, NOARG)  // the cursor must have at least the RAW count of elements left: the reservation a suffix makes against a repeat, an optional or a branch
OP(MATCH_AVAILABLE_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, NOARG)
OP(MATCH_LITERAL, 0, EXTRA, LABEL, CONST, NOARG, NOARG)  // peek: TOS must equal the constant
OP(MATCH_TYPE_VAR, 0, EXTRA, LABEL, VAR, NOARG, NOARG)  // peek: TOS must be an instance of the type in the slot
OP(MATCH_TYPE_FAST, 0, EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(MATCH_TYPE_BIND_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // peek: the type test, then TOS stored into the second slot
OP(MATCH_TYPE_BIND_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_BIND_VAR, 0, VAR)  // peek: TOS stored into the slot, nothing popped
OP(MATCH_BIND_FAST, 0, FASTVAR)
OP(MATCH_CLASS_VAR, 0, EXTRA, LABEL, VAR, RAW, NOARG)  // peek: TOS must be an instance of the class in the slot, whose __match_args__ covers the positional count
OP(MATCH_CLASS_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, NOARG)
OP(MATCH_FIELD_POS_VAR, 0, EXTRA, LABEL, VAR, RAW, NOARG)  // peek: push the attribute __match_args__[count] of the class names; a missing attribute is a miss
OP(MATCH_FIELD_POS_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, NOARG)
OP(MATCH_FIELD_POS_BIND_VAR, 0, EXTRA, LABEL, VAR, RAW, VAR)  // the positional attribute stored into the third slot
OP(MATCH_FIELD_POS_BIND_FAST, 0, EXTRA, LABEL, FASTVAR, RAW, FASTVAR)
OP(MATCH_FIELD_KW, 0, EXTRA, LABEL, CONST, NOARG, NOARG)  // peek: push the attribute the constant names; a missing attribute is a miss
OP(MATCH_FIELD_KW_BIND_VAR, 0, EXTRA, LABEL, CONST, VAR, NOARG)  // the named attribute stored into the slot
OP(MATCH_FIELD_KW_BIND_FAST, 0, EXTRA, LABEL, CONST, FASTVAR, NOARG)
OP(MATCH_MAP, 0, LABEL)  // peek: the mapping gate on TOS
OP(MATCH_KEY_CONST, 0, EXTRA, LABEL, CONST, NOARG, NOARG)  // peek: push the value under the constant key; an absent key is a miss
OP(MATCH_KEY_VAR, 0, EXTRA, LABEL, VAR, NOARG, NOARG)  // peek: push the value under the key in the slot
OP(MATCH_KEY_FAST, 0, EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(MATCH_KEY_CONST_BIND_VAR, 0, EXTRA, LABEL, CONST, VAR, NOARG)  // the value under the constant key stored into the slot
OP(MATCH_KEY_CONST_BIND_FAST, 0, EXTRA, LABEL, CONST, FASTVAR, NOARG)
OP(MATCH_KEY_VAR_BIND_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // the value under the key in the first slot stored into the second
OP(MATCH_KEY_FAST_BIND_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_SAME_VAR, 0, EXTRA, LABEL, VAR, NOARG, NOARG)  // peek: TOS must equal the value bound in the slot; an unbound slot is a miss
OP(MATCH_SAME_FAST, 0, EXTRA, LABEL, FASTVAR, NOARG, NOARG)
OP(MATCH_NEXT_SAME_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // pull; the element must equal the value bound in the second slot
OP(MATCH_NEXT_SAME_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_NEXT_APPEND_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // pull and append the element, boxed from a pair spine, to the list in the second slot
OP(MATCH_NEXT_APPEND_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_COLLECT_VAR, 0, EXTRA, LABEL, VAR, VAR, NOARG)  // every remaining element, boxed from a pair spine, appended to the list in the second slot; an improper tail is a miss
OP(MATCH_COLLECT_FAST, 0, EXTRA, LABEL, FASTVAR, FASTVAR, NOARG)
OP(MATCH_MARK_VAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)  // the cursor's position, its cell or its index, stored into the second slot
OP(MATCH_MARK_FAST, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)
OP(MATCH_RESET_VAR, 0, EXTRA, VAR, VAR, NOARG, NOARG)  // the cursor in the first slot moved back to the position in the second
OP(MATCH_RESET_FAST, 0, EXTRA, FASTVAR, FASTVAR, NOARG, NOARG)
OP(MATCH_CAPTURES, 0, EXTRA, CONST, FASTVAR, FASTVAR, FASTVAR)  // push the captures: the names tuple, the first capture slot, the start position, the cursor; a DatumFrame with its source over a pair spine, a dict otherwise; an unbound slot is absent
OP(MATCH_CAPTURES_NAMED_VAR, 0, EXTRA, CONST, VAR, VAR, NOARG)  // the captures read by name: the names tuple, the start position, the cursor
OP(MATCH_CAPTURES_NAMED_FAST, 0, EXTRA, CONST, FASTVAR, FASTVAR, NOARG)
OP(MATCH_ITERATION, 0, EXTRA, CONST, FASTVAR, FASTVAR, FASTVAR)  // push one repeat iteration's value, its captures or the boxed span when none fired, and clear the slots it read
OP(MATCH_ITERATION_NAMED_VAR, 0, EXTRA, CONST, VAR, VAR, NOARG)
OP(MATCH_ITERATION_NAMED_FAST, 0, EXTRA, CONST, FASTVAR, FASTVAR, NOARG)

// binary operator sites with one or both operands off the stack: the
// left operand's source is the prefix (the stack unnamed, VAR, FAST),
// the right operand's source the suffix (CONST, VAR, FAST); the
// operator rides the row as a bare selector since the count is two
OP(OBJECT_OPERAND_CONST, 1, EXTRA, OPERAND, CONST, NOARG, NOARG)  // stack OP const; cache: elector
OP(VAR_OPERAND_CONST, 0, EXTRA, OPERAND, VAR, CONST, NOARG)  // var OP const
OP(FAST_OPERAND_CONST, 1, EXTRA, OPERAND, FASTVAR, CONST, NOARG)  // fast OP const; cache: elector
OP(OBJECT_OPERAND_VAR, 0, EXTRA, OPERAND, VAR, NOARG, NOARG)  // stack OP var
OP(OBJECT_OPERAND_FAST, 1, EXTRA, OPERAND, FASTVAR, NOARG, NOARG)  // stack OP fast; cache: elector
OP(VAR_OPERAND_VAR, 0, EXTRA, OPERAND, VAR, VAR, NOARG)  // var OP var
OP(FAST_OPERAND_FAST, 1, EXTRA, OPERAND, FASTVAR, FASTVAR, NOARG)  // fast OP fast; cache: elector

// the for-each step with its element store: the region's next element
// stored under the row's name or into its fast slot, else jump; the
// ITER_NEXT + VAR_STORE fusion, lowered to the FAST twin
OP(ITER_NEXT_STORE_VAR, 0, EXTRA, VAR, LABEL, NOARG, NOARG)
OP(ITER_NEXT_STORE_FAST, 0, EXTRA, FASTVAR, LABEL, NOARG, NOARG)

// the truth-test branches with their feeder: the tested value read
// from the row's name or fast slot instead of popped; the VAR +
// JUMP_FALSE / JUMP_TRUE fusions, lowered to the FAST twins
OP(JUMP_FALSE_VAR, 0, EXTRA, VAR, LABEL, NOARG, NOARG)
OP(JUMP_TRUE_VAR, 0, EXTRA, VAR, LABEL, NOARG, NOARG)
OP(JUMP_FALSE_FAST, 0, EXTRA, FASTVAR, LABEL, NOARG, NOARG)
OP(JUMP_TRUE_FAST, 0, EXTRA, FASTVAR, LABEL, NOARG, NOARG)

// the short-circuit jumps with their feeder: the tested value read
// from the row's name or fast slot and pushed only on the jumping
// path; the VAR + JUMP_AND / JUMP_OR fusions, lowered to the FAST twins
OP(JUMP_AND_VAR, 0, EXTRA, VAR, LABEL, NOARG, NOARG)
OP(JUMP_OR_VAR, 0, EXTRA, VAR, LABEL, NOARG, NOARG)
OP(JUMP_AND_FAST, 0, EXTRA, FASTVAR, LABEL, NOARG, NOARG)
OP(JUMP_OR_FAST, 0, EXTRA, FASTVAR, LABEL, NOARG, NOARG)

// THEEND must always be last
OP(THEEND, 0, NOARG)


// The end.
