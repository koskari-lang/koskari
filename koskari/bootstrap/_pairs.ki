"""
Portion of koskari.builtins
"""


define-syntax compile/cddr:
  (syntax-rules [] [(cddr x) (cdr (cdr x))])

define-syntax compile/cdddr:
  (syntax-rules [] [(cdddr x) (cdr (cddr x))])

define-syntax compile/cddddr:
  (syntax-rules [] [(cddddr x) (cdr (cdddr x))])

define-syntax compile/cadr:
  (syntax-rules [] [(cadr x) (car (cdr x))])

define-syntax compile/caddr:
  (syntax-rules [] [(caddr x) (car (cddr x))])

define-syntax compile/cadddr:
  (syntax-rules [] [(cadddr x) (car (cdddr x))])

define-syntax compile/caddddr:
  (syntax-rules [] [(caddddr x) (car (cddddr x))])

define cddr [p] (cddr p)
define cdddr [p] (cdddr p)
define cddddr [p] (cddddr p)
define cadr [p] (cadr p)
define caddr [p] (caddr p)
define cadddr [p] (cadddr p)
define caddddr [p] (caddddr p)

define first car
define second cadr
define third caddr
define fourth cadddr
define fifth caddddr


extend-syntax compile/set!:
  syntax-rules [car cdr
                cadr caddr cadddr caddddr
                cddr cdddr cddddr]:
    case (set! (car p) value):
      (set-car p value)
    case (set! (cdr p) value):
      (set-cdr p value)

    case (set! (cadr p) value):
      (set-car (cdr p) value)
    case (set! (caddr p) value):
      (set-car (cddr p) value)
    case (set! (cadddr p) value):
      (set-car (cdddr p) value)
    case (set! (caddddr p) value):
      (set-car (cddddr p) value)

    case (set! (cddr p) value):
      (set-cdr (cdr p) value)
    case (set! (cdddr p) value):
      (set-cdr (cddr p) value)
    case (set! (cddddr p) value):
      (set-cdr (cdddr p) value)


define-syntax compile/build-proper:
  """
  Compile-time optimized version of build-proper, dispatching
  to `compile/cons` or `nil` for an empty call.
  """

  syntax-rules []:
    case (build-proper):
      ()
    case (build-proper value ...):
      (cons value ... nil)


; The end.
