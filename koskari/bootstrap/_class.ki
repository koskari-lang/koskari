"""
Portion of koskari.builtins
"""


define-syntax create-instance-check:
  macro-match:
    case (create-instance-check (BIND name)):
      define pname (datum (symbol f"{name.datum}?"))
      `define ,pname:
        lambda ,pname [value]:
          instance? value ,name


define-syntax compile/define-class:
  """
  Defines a class and a typecheck function for it
  """

  syntax-rules []:
    case (define-class name supers body ...):
      (define name (class name supers body ...))
      create-instance-check name


define-syntax compile/define-dataclass:
  """
  Defines a dataclass and a typecheck function for it.

  eg.::

  (define-dataclass Point []
    (define x :: int 0)
    (define y :: int 0)
  )

  is equivalent to::

  (define Point
    (dataclass (class Point [] (define x :: int 0) (define y :: int 0))))
  (define Point? [value] (instance? value Point))
  """

  syntax-rules [begin]:
    case (define-dataclass name (members ...)):
      (define-dataclass name [] (members ...))
    case (define-dataclass name supers members ...):
      define name:
        let []:
          import-from dataclasses dataclass field
          @dataclass
          class name supers:
            (begin members ...)
      create-instance-check name


define-syntax compile/super:
  syntax-rules []:
    case (super):
      (call super (type self) self)
    case (super args ...):
      (call super args ...)


;; The end.
