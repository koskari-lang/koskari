"""
Portion of koskari.builtins
"""


syntax create-instance-check:
  macro-match:
    case (create-instance-check (BIND name)):
      ;; the predicate is the class's name with ?, under the same marks,
      ;; so a class a template defines has the template's predicate
      var n name.datum
      var pname (datum (if (is n n.base)
                              (symbol f"{n}?")
                              (gensym (symbol f"{n.base}?") marks: n.marks)))
      `var ,pname:
        lambda ,pname [value]:
          instance? value ,name


syntax define-class:
  """
  Defines a class and a typecheck function for it
  """

  syntax-rules []:
    case (define-class name supers body ...):
      (var name (class name supers body ...))
      create-instance-check name


syntax define-dataclass:
  """
  Defines a dataclass and a typecheck function for it.

  eg.::

    (define-dataclass Point []
      (define x :: int 0)
      (define y :: int 0))

  is equivalent to::

    (define Point
      (dataclass (class Point [] (define x :: int 0) (define y :: int 0))))
    (define Point? [value] (instance? value Point))
  """

  syntax-rules []:
    case (define-dataclass name supers members ...):
      var name:
        let []:
          import-from dataclasses dataclass field
          @dataclass
          class name supers:
            (begin members ...)
      create-instance-check name


syntax super:
  syntax-rules []:
    case (super):
      (call super __class__ self)
    case (super args ...):
      (call super args ...)


;; The end.
