"""
Portion of koskari.builtins
"""


syntax class:
  """
  Defines a class and binds it to its name in the scope the form
  appears in.
  """

  syntax-rules []:
    case (class name supers body ...):
      (var name (build-class name supers body ...))


extend-syntax global:
  """
  Followed by class, binds the class at the module rather than in the
  scope the form appears in.
  """

  syntax-rules [class]:
    case (global class name supers body ...):
      (define-global name (build-class name supers body ...))


syntax super:
  syntax-rules []:
    case (super):
      (call super __class__ self)
    case (super args ...):
      (call super args ...)


;; The end.
