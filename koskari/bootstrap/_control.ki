"""
Portion of koskari.builtins
"""


;; The statement words return, continue, break, raise, and yield are
;; call forms, and a common error is expecting the bare symbol to behave
;; as it does in Python. Their bare forms expand the lone symbol through
;; the bare-control-word gate, whose behavior each module selects with
;; the compiler/bare-control-words pragma: convert (the default)
;; silently expands to the call form, warn converts with a
;; SyntaxWarning, and error refuses at compile time. The deliberate
;; cost of conversion: these names always expand, so none of them can
;; name a variable.


let []:

    import-from warnings warn_explicit
    import-from koskari.pragma register


    define pragma-bare-control-words [mode: "convert"]:
        """
        How a bare control word compiles: convert, warn, or error.
        Baseline convert.
        """

        define m (str mode)
        unless (in? m #("convert" "warn" "error")):
            raise (ValueError
                   f"bare-control-words must be convert, warn, or error: {m}")
        m


    (register "compiler/bare-control-words"
              (demand pragma-bare-control-words) "convert")


    define-syntax bare-control-word:
        """
        Gate for a bare control word: expands to the word's call form,
        warning or refusing first when the compiling module's
        compiler/bare-control-words pragma says so. Diagnostics carry
        the source position the bare word was captured at.
        """

        special-rules []:
          case [c (bare-control-word word) tc]:
            define mode (active-pragma compiler/bare-control-words)
            define w word.datum
            define pos word.position

            switch mode:
              case ["error"]:
                raise (CompilerError
                       f"bare {w} (write ({w}); the compiler/"-
                       "bare-control-words pragma is error)"
                        None pos c.filename)

              case ["warn"]:
                define line (if (None? pos) 0 (item pos 0))
                (warn_explicit f"bare {w} converted to ({w})"
                               SyntaxWarning (or c.filename "<koskari>")
                               line)
                `(,w)

              else:
                `(,w)


extend-syntax return:
  bare-syntax return:
    (bare-control-word return)


extend-syntax continue:
  bare-syntax continue:
    (bare-control-word continue)


extend-syntax break:
  bare-syntax break:
    (bare-control-word break)


extend-syntax raise:
  bare-syntax raise:
    (bare-control-word raise)


extend-syntax yield:
  bare-syntax yield:
    (bare-control-word yield)


;; The end.
