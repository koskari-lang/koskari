"""
Portion of koskari.builtins
"""


(define compile/define-syntax
  ;; the macro for defining macros

  (syntax-rules compile/define-syntax
      [syntax-rules syntax-match
       macro-rules macro-match
       special-rules special-match]

    [(define-syntax name docstr (form ...))
      (begin
        (define-syntax name (form ...))
        (set-attr name __doc__ docstr))]

    [(define-syntax name (syntax-rules literals rule ...))
      (compile/define-global name (syntax-rules name literals rule ...))]

    [(define-syntax name (syntax-match rule ...))
      (compile/define-global name (syntax-match name rule ...))]

    [(define-syntax name (macro-rules literals rule ...))
      (compile/define-global name (macro-rules name literals rule ...))]

    [(define-syntax name (macro-match rule ...))
      (compile/define-global name (macro-match name rule ...))]

    [(define-syntax name (special-rules literals rule ...))
      (compile/define-global name (special-rules name literals rule ...))]

    [(define-syntax name (special-match rule ...))
      (compile/define-global name (special-match name rule ...))]))


set-attr compile/define-syntax __doc__:
  """
  Define a syntax transformer

  `syntax-rules`, `macro-rules`, and `special-rules` accept a literals
  list and a list of rules. Each rule is gated by a rule-shaped
  pattern.

  `syntax-match`, `macro-match`, and `special-match` accept a list of rules.
  Each rule is a pair of a pattern and a template, where the pattern is
  an explicit match-style pattern.

  `syntax-rules` and `syntax-match` map rules to templates. Templates are
  declarative transformations of the input source form.

  `macro-rules` and `macro-match` map rules to macros. Macros are procedurally
  evaluated to produce an output form.

  `special-rules` and `special-match` map rules to low-level compiler
  transformations.

  Transformers can be extended with `extend-syntax`
  """


define-syntax compile/extend-syntax:
  """
  Extends an existing Syntax definition with new rules. The newer rules
  take precedence over existing rules.
  """

  syntax-rules [syntax-rules syntax-match
                macro-rules macro-match
                special-rules special-match]:

    case (extend-syntax name (syntax-rules literals rule ...)):
      setq name (+ name (syntax-rules name literals rule ...))

    case (extend-syntax name (syntax-match rule ...)):
      setq name (+ name (syntax-match name rule ...))

    case (extend-syntax name (macro-rules literals rule ...)):
      setq name (+ name (macro-rules name literals rule ...))

    case (extend-syntax name (macro-match rule ...)):
      setq name (+ name (macro-match name rule ...))

    case (extend-syntax name (special-rules literals rule ...)):
      setq name (+ name (special-rules name literals rule ...))

    case (extend-syntax name (special-match rule ...)):
      setq name (+ name (special-match name rule ...))


define-syntax compile/let-syntax:
  special-rules []:
    case [c (let-syntax name (syntax-rules literals rule ...) body ...) tc]:
      ; the each macro isn't defined yet, so we use a manual generator thunk
      define src `(syntax-rules ,name.datum ,literals.datum
                  ,@({(for-each [r rule] (yield r.datum))}))
      define bdy `(begin ,@({(for-each [b body] (yield b.datum))}))
      define frag (c.full_compile src)
      define expr (frag.as_expression (vars c.module))
      with [(c.macro_overlay name.datum (expr))]:
        (c.full_compile bdy tc)


define-syntax compile/datum:
  """
  Captures `expr` form in a datum, recording the source position
  """

  macro-rules [datum]:
    case (datum expr pos):
      `(call datum ,expr ,pos)
    case (datum expr):
      `(call datum ,expr ,(getattr expr "position" None))


define-syntax compile/datumq:
  """
  Captures `expr` form in a datum, recording the source position
  """

  macro-rules [datumq]:
    case (datumq expr pos):
      `(call datum (quote ,expr) ,pos)
    case (datumq expr):
      `(call datum (quote ,expr) ,(getattr expr "position" None))


define-syntax compile/parse-match-patternq:
  """
  Parse a match style pattern to a Pattern.
  """

  syntax-rules []:
    case (parse-match-patternq form):
      (call parse-match-pattern (quote form))


define-syntax compile/parse-rule-patternq:
  """
  Parse a syntax-rules style pattern and literals list to a Pattern.
  """

  syntax-rules []:
    case (parse-rule-patternq form literals):
      (call parse-rule-pattern (quote form) (quote literals))
    case (parse-rule-patternq form):
      (call parse-rule-pattern (quote form) ())


; The end.
