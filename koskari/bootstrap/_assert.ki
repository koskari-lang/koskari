"""
Portion of koskari.builtins
"""


let [[assert-enabled True]]:

    import-from koskari.pragma register


    define pragma-enable-asserts [enabled: True]:
        """
        Whether assert forms expand to their check. Baseline enabled.
        """

        set! assert-enabled (bool enabled)
        assert-enabled


    register "compiler/enable-asserts" (demand pragma-enable-asserts) True


    define-syntax compile/assert:
        """
        Raise AssertionError when the expression is falsey if asserts are
        enabled. Evaluates as None otherwise.

        Usage::

            (assert expr)
            (assert expr message)

        Note that the enablement behavior is gated at compile-time, not run-time.
        The ``expr`` is not evaluated if asserts are disabled.

        Asserts are enabled by default, but may be disabled via the
        ``compiler/enable-asserts`` pragma.

        eg.::

          (pragma [compiler/enable-asserts False])
        """

        macro-rules []:
            case (assert expr message):
                (if assert-enabled
                    `(unless ,expr (raise (AssertionError ,message)))
                    '(begin))

            case (assert expr):
                (if assert-enabled
                    `(unless ,expr (raise (AssertionError)))
                    '(begin))


; The end.
