"""
Portion of koskari.builtins
"""


let [[assert-enabled True]]:

    import-from koskari.pragma register


    define pragma-enable-asserts [enabled: True]:
        """
        Whether assert forms expand to their check. Baseline enabled.
        """

        set! assert-enabled (bool enabled)
        assert-enabled


    register "compiler/enable-asserts" (demand pragma-enable-asserts) True


    define-global compile/assert:
        macro-rules compile/assert []:
            case (assert expr message):
                (if assert-enabled
                    `(unless ,expr (raise (AssertionError ,message)))
                    '(begin))

            case (assert expr):
                (if assert-enabled
                    `(unless ,expr (raise (AssertionError)))
                    '(begin))


    set-attr compile/assert __doc__:
        """
        Raise AssertionError when the expression is falsey

        eg.
        (assert expr)
        (assert expr message)
        """


; The end.
