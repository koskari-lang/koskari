

define-syntax compile/define-fence:
    syntax-rules []:
        case (define-fence name [source-str options] body ...):
            define name:
                let []:
                    import-from koskari.fences FenceHandler
                    (FenceHandler (str 'name)
                        (demand (function name [source-str options]
                            body ...)))


define-fence fence/bash [raw meta]:
    define options (meta.get "options")
    define exec_now (options.pop "immediate" False)

    when options:
        define names (.join " " (sorted options))
        raise (FenceError f"fence/bash got unknown options: {names}")

    if (is? exec_now True):
        `(run-process "bash" "-c" ,raw)
    else:
        `function <fence/bash> [*: args]:
            run-process "bash" "-c" ,raw "bash-fence" *: args


;; The end.
