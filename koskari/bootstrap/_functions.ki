"""
Portion of koskari.builtins
"""


define-syntax compile/define-coroutine:
  """
  Defines a function whose result will be converted to a Python
  coroutine object.
  """

  syntax-rules []:
    case (define-coroutine name args body ...):
      (define name (coroutine-fn (function name args body ...)))


define-syntax compile/define-demanding:
  """
  Defines a function which will be run on the demand path, where
  `await` it denied.
  """

  syntax-rules []:
    case (define-demanding name formals body ...):
      (define name (demand (function name formals body ...)))


define-syntax compile/function-compose:
  """
  Composes multiple functions into a single function, eg.::

  (function-compose fn1 (fn2 foo) fn3))

  is equivalent to::

  (lambda [*: args **: kwds]
    (fn1 ((fn2 foo) (fn3 *: args **: kwds))))

  Note that this composition is syntactic, and the arguments are not
  evaluated until the composed function is called.
  """

  macro-rules []:
    case (function-compose fn1):
      fn1
    case (function-compose fn1 ...):
      define acc `(*: args **: kwds)
      for-each [fn (reversed fn1)]:
        set! acc `((,fn ,@acc))
      `(lambda [*: args **: kwds] ,@acc)


define-syntax compile/flet:
  """
  Binds local functions for the extent of a body, eg.::

    (flet [[double [x] (* x 2)]
           [inc [x] (+ x 1)]]
      (double (inc 20)))

  Each binding is an anonymous function; the initializers are evaluated in
  the enclosing scope, so a binding shadows an outer function of the same
  name but does not see its siblings in the same `flet` (no mutual
  recursion). Use `labels` when the functions must call one another.
  """

  syntax-rules []:
    case (flet [[name formals fbody ...] ...] body ...):
      (let [[name (lambda formals fbody ...)] ...]
        body ...)


define-syntax compile/labels:
  """
  Binds local functions for the extent of a body, with the names visible to
  one another so the functions can be mutually recursive, eg.::

    (labels [[even? [n] (if (== n 0) True (odd? (- n 1)))]
             [odd? [n] (if (== n 0) False (even? (- n 1)))]]
      (even? 10))

  Each function is `define`d inside a shared scope, so a binding's body sees
  every sibling in the same `labels` (unlike `flet`, whose initializers are
  evaluated in the enclosing scope and cannot see siblings).
  """

  syntax-rules []:
    case (labels [[name formals fbody ...] ...] body ...):
      (let []
        (define name (function name formals fbody ...))
        ...
        body ...)


define-global decorate-wraps [inner wrapper]:
  """
  Copies callable metadata from inner onto wrapper, returning wrapper.

  A tolerant functools.update_wrapper: each wrapper assignment is
  attempted independently, so metadata a wrapper cannot accept is
  skipped rather than aborting the copy. Used by the call-with and
  call-parameterize decorator expansions so the delivered wrapper
  answers for the function it wraps.
  """

  import functools

  for-each [attr functools.WRAPPER_ASSIGNMENTS]:
    try:
      setattr wrapper attr (getattr inner attr)
    except [AttributeError]:
      (continue)

  try:
    ((getattr wrapper "__dict__").update (getattr inner "__dict__" #{}))
  except [AttributeError]:
    None

  try:
    setattr wrapper "__wrapped__" inner
  except [AttributeError]:
    None

  wrapper


define-syntax compile/decorate-subject:
  """
  Applies one decorator expression to a subject form.

  A body-less extent form (`let`, `with`, `parameterize`) in decorator
  position is completed by grafting the subject in as its body, so the
  extent spans the evaluation of the subject itself. The call-time
  variants (`call-with`, `call-parameterize`) instead wrap the subject
  in a forwarding function that enters the extent per invocation,
  calls the subject with the passed arguments, and delivers its value
  after the extent closes. Any other decorator expression is evaluated
  and invoked on the subject, mimicking function composition. Further
  shape arms can be registered with `extend-syntax`; registered arms
  are tried before the invocation arm.
  """

  syntax-rules [let with parameterize call-with call-parameterize]:
    case (decorate-subject (let bindings) subject):
      (let bindings subject)
    case (decorate-subject (with binding) subject):
      (with binding subject)
    case (decorate-subject (parameterize params) subject):
      (parameterize params subject)
    case (decorate-subject (call-with binding) subject):
      (let [[inner subject]]
        (decorate-wraps inner
          (lambda [*: args **: kwds]
            (with binding
              (inner *: args **: kwds)))))
    case (decorate-subject (call-parameterize params) subject):
      (let [[inner subject]]
        (decorate-wraps inner
          (lambda [*: args **: kwds]
            (parameterize params
              (inner *: args **: kwds)))))
    case (decorate-subject deco subject):
      (deco subject)


define-syntax compile/decorate:
  """
  Handler for the decorator layout syntax, can also be used to apply
  decorator-style wrappers to an s-expr form.

  Each decorator is applied to the accumulated subject via
  `decorate-subject`, outermost decorator first.
  """

  syntax-rules [define-class define compile/define-class compile/define]:
    case (decorate [] fn):
      fn
    case (decorate [decorators ...] (define-class name supers body ...)):
      (define name (decorate [decorators ...] (class name supers (begin body ...))))
    case (decorate [decorators ...] (compile/define-class name supers body ...)):
      (define name (decorate [decorators ...] (class name supers (begin body ...))))
    case (decorate [decorators ...] (define name formals body ...)):
      (define name (decorate [decorators ...] (function name formals body ...)))
    case (decorate [decorators ...] (compile/define name formals body ...)):
      (define name (decorate [decorators ...] (function name formals body ...)))
    case (decorate [d rest ...] fn):
      (decorate-subject d (decorate [rest ...] fn))


;; The end.
