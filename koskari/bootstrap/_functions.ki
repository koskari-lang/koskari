"""
Portion of koskari.builtins
"""


define-syntax compile/define-coroutine:
  """
  Defines a function whose result will be converted to a Python
  coroutine object.
  """

  syntax-rules []:
    case (define-coroutine name args body ...):
      (define name (coroutine-fn (function name args body ...)))


define-syntax compile/define-demanding:
  """
  Defines a function which will be run on the demand path, where
  `await` it denied.
  """

  syntax-rules []:
    case (define-demanding name formals body ...):
      (define name (demand (function name formals body ...)))


define-syntax compile/function-compose:
  """
  Composes multiple functions into a single function, eg.::

  (function-compose fn1 (fn2 foo) fn3))

  is equivalent to::

  (lambda [*: args **: kwds]
    (fn1 ((fn2 foo) (fn3 *: args **: kwds))))

  Note that this composition is syntactic, and the arguments are not
  evaluated until the composed function is called.
  """

  macro-rules []:
    case (function-compose fn1):
      fn1
    case (function-compose fn1 ...):
      define acc `(*: args **: kwds)
      for-each [fn (reversed fn1)]:
        set! acc `((,fn ,@acc))
      `(lambda [*: args **: kwds] ,@acc)


define-syntax compile/flet:
  """
  Binds local functions for the extent of a body, eg.::

    (flet [[double [x] (* x 2)]
           [inc [x] (+ x 1)]]
      (double (inc 20)))

  Each binding is an anonymous function; the initializers are evaluated in
  the enclosing scope, so a binding shadows an outer function of the same
  name but does not see its siblings in the same `flet` (no mutual
  recursion). Use `labels` when the functions must call one another.
  """

  syntax-rules []:
    case (flet [[name formals fbody ...] ...] body ...):
      (let [[name (lambda formals fbody ...)] ...]
        body ...)


define-syntax compile/labels:
  """
  Binds local functions for the extent of a body, with the names visible to
  one another so the functions can be mutually recursive, eg.::

    (labels [[even? [n] (if (== n 0) True (odd? (- n 1)))]
             [odd? [n] (if (== n 0) False (even? (- n 1)))]]
      (even? 10))

  Each function is `define`d inside a shared scope, so a binding's body sees
  every sibling in the same `labels` (unlike `flet`, whose initializers are
  evaluated in the enclosing scope and cannot see siblings).
  """

  syntax-rules []:
    case (labels [[name formals fbody ...] ...] body ...):
      (let []
        (define name (function name formals fbody ...))
        ...
        body ...)


define-syntax compile/decorate:
  """
  Handler for the decorator layout syntax, can also be used to apply
  decorator-style wrappers to an s-expr form.
  """

  syntax-rules [define-class define compile/define-class compile/define]:
    case (decorate [] fn):
      fn
    case (decorate [decorators ...] (define-class name supers body ...)):
      (define name (decorate [decorators ...] (class name supers (begin body ...))))
    case (decorate [decorators ...] (compile/define-class name supers body ...)):
      (define name (decorate [decorators ...] (class name supers (begin body ...))))
    case (decorate [decorators ...] (define name formals body ...)):
      (define name (decorate [decorators ...] (function name formals body ...)))
    case (decorate [decorators ...] (compile/define name formals body ...)):
      (define name (decorate [decorators ...] (function name formals body ...)))
    case (decorate [decorators ...] fn):
      ((function-compose decorators ...) fn)


;; The end.
