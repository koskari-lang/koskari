"""
Portion of koskari.builtins
"""


define-syntax compile/cadr:
  (syntax-rules [] [(cadr x) (car (cdr x))])

define-syntax compile/caddr:
  (syntax-rules [] [(caddr x) (car (cdr (cdr x)))])

define-syntax compile/cadddr:
  (syntax-rules [] [(cadddr x) (car (cdr (cdr (cdr x))))])

define-syntax compile/caddddr:
  (syntax-rules [] [(caddddr x) (car (cdr (cdr (cdr (cdr x)))))])


define compile/first compile/car
define compile/second compile/cadr
define compile/third compile/caddr
define compile/fourth compile/cadddr
define compile/fifth compile/caddddr


define-syntax compile/help:
  syntax-rules []:
    case (help obj ns):
      (compile/call help obj ns)
    case (help obj):
      (compile/call help 'obj (globals))
    case (help):
      (compile/call help 'help (globals))


let []:
  import-from koskari.syntax Syntax SyntaxTransform MacroTransform


  define-global macroexpand [form ns]:
    """
    Apply an expansion step to a source object in the given namespace
    """

    define compiler (item ns "__compiler__")
    define name (if (pair? form) (car form) form)
    define special (compiler.find_compiled name)

    unless special:
      raise (Exception "macroexpand-1: special form {name} not found")

    unless (instance? special Syntax):
      return form

    define-values [tf mr] (special.match_transformer form)
    unless tf:
      return form

    unless (instance? tf #(SyntaxTransform MacroTransform)):
      return form

    define expanded (tf.handle_expand compiler form mr False)

    if (and (pair? expanded)
            (equal? (.length expanded) 2)
            (in (car expanded) #('begin 'compile/begin))):
      ;; many of the macros written in layout form have an additional
      ;; `begin` wrapper, so we strip it if it's present and not needed
      ;; to combine multiple expressions.
      cdr expanded
    else:
      expanded


define-syntax compile/macroexpand:
  syntax-rules []:
    case (macroexpand form ns):
      (call macroexpand form ns)
    case (macroexpand form):
      (call macroexpand form (locals))


define-syntax compile/macroexpandq:
  syntax-rules []:
    case (macroexpandq form ns):
      (call macroexpand (quote form) ns)
    case (macroexpandq form):
      (call macroexpand (quote form) (locals))


let []:
  import-from koskari.lib Code Expression Function
  import-from koskari.compile ByteCodeFragment


  define-global compile [source_obj ns]:
      """
      Compile a source object into a code object via the compiler from
      the given namespace
      """

      when (instance? source_obj #(Expression Function)):
          return source_obj

      define compiler (ns.get "__compiler__" None)
      unless compiler:
          raise (ValueError "__compiler__ not found in namespace")

      define frag (compiler.full_compile source_obj)
      frag.as_expression ns


  define-global evaluate [source_obj ns]:
      """
      Compile and evaluate a source object as an expression in the given
      namespace
      """

      define code source_obj
      unless (instance? source_obj Code):
          set! code (compile source_obj ns)

      define expr (code.as_expression ns)
      (expr)


define-syntax compile/evaluate:
  syntax-rules []:
    case (evaluate form ns):
      (call evaluate form ns)
    case (evaluate form):
      (call evaluate form (locals))


define-syntax compile/compileq:
  syntax-rules []:
    case (compileq form ns):
      (call compile (quote form) ns)
    case (compileq form):
      (call compile (quote form) (locals))


;; The end.
