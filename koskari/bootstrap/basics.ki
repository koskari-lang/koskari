"""
Portion of koskari.builtins
"""


define-syntax compile/cadr:
  (syntax-rules [] [(cadr x) (car (cdr x))])

define-syntax compile/caddr:
  (syntax-rules [] [(caddr x) (car (cdr (cdr x)))])

define-syntax compile/cadddr:
  (syntax-rules [] [(cadddr x) (car (cdr (cdr (cdr x))))])

define-syntax compile/caddddr:
  (syntax-rules [] [(caddddr x) (car (cdr (cdr (cdr (cdr x)))))])


define compile/first compile/car
define compile/second compile/cadr
define compile/third compile/caddr
define compile/fourth compile/cadddr
define compile/fifth compile/caddddr


define-syntax compile/help:
  syntax-rules []:
    case (help obj ns):
      (compile/call help obj ns)
    case (help obj):
      (compile/call help 'obj (globals))
    case (help):
      (compile/call help 'help (globals))


;; The end.
