"""
Portion of koskari.builtins
"""


let []:
  import-from koskari.compile Compiler
  import-from koskari.pragma ModulePragma
  import-from koskari.module find_package_pragma


  define-global get-compiler [ns]:
    """
    The compiler for the module owning ns. Returns the bound
    __compiler__, or rebuilds one from __pragma__ and binds it when the
    load-time facet was detached
    """

    ;; walk from a function or let namespace up to the module namespace
    while (getattr ns "parent" None):
      set! ns ns.parent

    define compiler (ns.get "__compiler__")
    when compiler:
      return compiler

    define pragma (ns.get "__pragma__")
    when (None? pragma):
      define inherited (find_package_pragma ns)
      set! pragma (if inherited (inherited.copy) (ModulePragma))
      set! ns["__pragma__"] pragma

    set! compiler (Compiler.from_pragma (getattr ns "__name__" "<module>") ns
                    filename: (ns.get "__file__") pragma: pragma)
    set! ns["__compiler__"] compiler
    compiler


define-syntax get-compiler:
  syntax-rules []:
    case (get-compiler ns):
      (call get-compiler ns)
    case (get-compiler):
      (call get-compiler (locals))


let []:
  import-from koskari.syntax Syntax SyntaxTransform MacroTransform


  define-global macroexpand-1 [form ns]:
    """
    Apply an expansion step to a source form object in the given namespace.
    """

    define compiler (get-compiler ns)
    define name (if (pair? form) (car form) form)
    define special (compiler.find_compiled name)

    unless (instance? special Syntax):
      return form

    define-values [tf mr] (special.match_transformer form)
    unless tf:
      return form

    unless (instance? tf #(SyntaxTransform MacroTransform)):
      return form

    define expanded (tf.handle_expand compiler form mr)

    if (and (pair? expanded)
            (equal? (.length expanded) 2)
            (in? (car expanded) #('begin))):
      ;; many of the macros written in layout form have an additional
      ;; `begin` wrapper, so we strip it if it's present and not needed
      ;; to combine multiple expressions.
      cadr expanded
    else:
      expanded


  define-global macroexpand [form ns]:
    """
    Expand a source form object in the given namespace. Repeat until the
    result is no longer a macro.
    """

    define compiler (get-compiler ns)

    while True:
      define name (if (pair? form) (car form) form)
      define special (compiler.find_compiled name)

      unless (instance? special Syntax):
        return form

      define-values [tf mr] (special.match_transformer form)
      unless tf:
        return form

      unless (instance? tf #(SyntaxTransform MacroTransform)):
        return form

      set! form (tf.handle_expand compiler form mr)


define-syntax macroexpand-1:
  """
  Apply a single expansion step to a source form object in the given
  namespace, or the current globals namespace if unspecified.
  """

  syntax-rules []:
    case (macroexpand-1 form ns):
      (call macroexpand-1 form ns)
    case (macroexpand-1 form):
      (call macroexpand-1 form (globals))


define-syntax macroexpand:
  """
  Expand a source form object in the given namespace, or the current globals
  namespace if unspecified. Repeat until the result is no longer a
  macro.
  """

  syntax-rules []:
    case (macroexpand form ns):
      (call macroexpand form ns)
    case (macroexpand form):
      (call macroexpand form (globals))


define-syntax macroexpandq-1:
  """
  Quote and expand a source object in the given namespace, or
  the current globals namespace if unspecified.

  See also: macroexpand-1
  """

  syntax-rules []:
    case (macroexpandq-1 form ns):
      (call macroexpand-1 (quote form) ns)
    case (macroexpandq-1 form):
      (call macroexpand-1 (quote form) (globals))


define-syntax macroexpandq:
  """
  Quote and expand a source object in the given namespace, or
  the current globals namespace if unspecified. Repeat until the result
  is no longer a macro.

  See also: macroexpand
  """

  syntax-rules []:
    case (macroexpandq form ns):
      (call macroexpand (quote form) ns)
    case (macroexpandq form):
      (call macroexpand (quote form) (globals))


let []:
  import-from koskari.lib Code Expression Function
  import-from koskari.compile ByteCodeFragment


  define-global compile [source_obj ns]:
    """
    Compile a source object into an Expression via the compiler from
    the given namespace
    """

    when (instance? source_obj #(Expression Function)):
      return source_obj

    define compiler (get-compiler ns)
    define frag (compiler.compile_expression source_obj)
    frag.as_expression ns


  define-global evaluate [source_obj ns]:
    """
    Compile and evaluate a source object as an expression in the given
    namespace
    """

    define expr source_obj
    if (instance? source_obj Code):
      set! expr (source_obj.expression ns)
    else:
      set! expr (compile source_obj ns)
    (expr)


define-syntax evaluate:
  syntax-rules []:
    case (evaluate form ns):
      (call evaluate form ns)
    case (evaluate form):
      (call evaluate form (locals))


define-syntax compileq:
  syntax-rules []:
    case (compileq form ns):
      (call compile (quote form) ns)
    case (compileq form):
      (call compile (quote form) (locals))


define-syntax inline-macro:
  """
  Evaluate body and expand to the resulting form
  """

  special-rules []:
    case [c (inline-macro body ...)]:
      define source `(let [] ,@(each [b body] b.datum))
      define frag (c.full_compile source)
      define expr (frag.as_expression (vars c.module))
      (expr)


;; The end.
