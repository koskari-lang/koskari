"""
Portion of koskari.builtins
"""


define-syntax compile/set!:
  """
  Flexible assignment syntax
  """

  syntax-rules []:
    case (set! name value):
      (setq name value)


extend-syntax compile/set!:
  ;; extending set! to handle item, attr, and deref places

  syntax-rules [item attr deref]:

    case (set! (item obj name) value):
      (set-item obj name value)

    case (set! (attr obj name) value):
      (set-attr obj name value)

    case (set! (deref ref) value):
      (.store ref value)


extend-syntax compile/set!:
  ;; extending set! to handle augmented assignment

  syntax-rules [+ - * / // % ** @ << >> & ^ |]:

    case (set! name (+ name value)):
      (inplace + name value)
    case (set! name (- name value)):
      (inplace - name value)
    case (set! name (* name value)):
      (inplace * name value)
    case (set! name (/ name value)):
      (inplace / name value)
    case (set! name (// name value)):
      (inplace // name value)
    case (set! name (% name value)):
      (inplace % name value)
    case (set! name (** name value)):
      (inplace ** name value)
    case (set! name (@ name value)):
      (inplace @ name value)
    case (set! name (<< name value)):
      (inplace << name value)
    case (set! name (>> name value)):
      (inplace >> name value)
    case (set! name (& name value)):
      (inplace & name value)
    case (set! name (^ name value)):
      (inplace ^ name value)
    case (set! name (| name value)):
      (inplace | name value)


extend-syntax compile/set!:
  ;; extending set! to handle values pattern

  syntax-rules [values]:
    case (set! (values pattern ...) value):
      (setq-values [pattern ...] value)


extend-syntax compile/inplace:
  syntax-rules [item attr]:
    case (inplace op (item obj name) value):
      (inplace-item op obj name value)

    case (inplace op (attr obj name) value):
      (inplace-attr op obj name value)


define-syntax compile/unassigned?:
  """
  True if a storage location currently has no value
  """

  syntax-rules []:
    case (unassigned? location):
      (not (ref location))


define-syntax compile/default!:
  """
  Assigns value to a storage location if that location is not already
  assigned to a truthy value of its own.
  """

  syntax-rules []:
    case (default! location value):
      unless (and (ref location) location):
        set! location value


define-syntax compile/del!:
  """
  Clears a binding, or deletes an attribute, or item.
  """

  syntax-rules [item attr]:
    case (del! (item obj name)):
      (del-item obj name)
    case (del! (attr obj name)):
      (del-attr obj name)

    case (del! name):
      (delq name)


define-syntax compile/take!:
  """
  Takes a value from a binding, attribute, or item, clearing it.
  """

  syntax-rules [item attr]:
    case (take! (item obj name)):
      (take-item obj name)
    case (take! (attr obj name)):
      (take-attr obj name)

    case (take! name):
      (takeq name)


define-syntax compile/incr!:
  """
  Increment a variable in-place. If `value` is not provided, increment by 1.
  """

  syntax-rules []:
    case (incr! location):
      (inplace + location 1)
    case (incr! location value):
      (inplace + location value)


define-syntax compile/decr!:
  """
  Decrement a variable in-place. If `value` is not provided, decrement by 1.
  """

  syntax-rules []:
    case (decr! location):
      (inplace - location 1)
    case (decr! location value):
      (inplace - location value)


define-syntax compile/ref:
  """
  Obtain a reference to a storage location
  """

  syntax-rules [item attr
                dynamic
                constant
                memoized
                parameter
                environ]:

    case (ref (item obj name)):
      (ref-item obj name)

    case (ref (attr obj name)):
      (ref-attr obj name)

    case (ref (dynamic r ...)):
      (DynamicRef '<dynamic> r ...)

    case (ref (constant value)):
      (ConstantRef '<constant> value)

    case (ref (memoized getfn)):
      (MemoizedRef '<memoized> getfn)

    case (ref (parameter name default)):
      (ParamRef 'name default)
    case (ref (parameter name)):
      (ParamRef 'name)

    case (ref (environ key default)):
      (environ-ref 'key default)
    case (ref (environ key)):
      (environ-ref 'key)

    case (ref name):
      (refq name)


define-syntax compile/bind!:
  """
  Bind a reference to a name in the current scope
  """

  syntax-rules [item attr
                dynamic
                constant
                memoized
                parameter
                environ]:

    case (bind! name (item obj key)):
      (bindq name (ref-item obj key))

    case (bind! name (attr obj key)):
      (bindq name (ref-attr obj key))

    case (bind! name (dynamic r ...)):
      (bindq name (DynamicRef 'name r ...))

    case (bind! name (constant value)):
      (bindq name (ConstantRef 'name value))

    case (bind! name (memoized getfn)):
      (bindq name (MemoizedRef 'name getfn))

    case (bind! name (parameter param-name default)):
      (bindq name (ParamRef 'param-name default))
    case (bind! name (parameter param-name)):
      (bindq name (ParamRef 'param-name))

    case (bind! name (environ key default)):
      (bindq name (environ-ref 'key default))
    case (bind! name (environ key)):
      (bindq name (environ-ref 'key))

    case (bind! name value):
      (bindq name value)


define environ-ref [key: None default: None]:
  unless key:
    raise (ValueError "environ-ref requires a non-empty key")

  set! key (str key)

  import-from os environ
  if (None? default):
    (ItemRef key environ key)

  else:
    (DynamicRef key
      { (environ.get key default) }
      { (set! (item environ key) %1) }
      { (del! (item environ key)) })


define-syntax compile/global:
  """
  Declare a name as a global variable in a scope, and optionally
  assign a value to it. Convenience wrapper for `compile/define-global`
  """

  syntax-rules []:
    case (global name):
      (define-global name)
    case (global name value):
      (define-global name value)


define-syntax compile/local:
  """
  Declare a name as a local variable in a scope, and optionally
  assign a value to it. Convenience wrapper for `compile/define`
  """

  syntax-rules []:
    case (local name):
      (define name)
    case (local name value):
      (define name value)


define-syntax compile/define-parameter:
  """
  Declare a name as a parameter in a scope, with an optional default value.
  """

  syntax-rules []:
    case (define-parameter name):
      (define name)
      (bindq name (ParamRef 'name))
    case (define-parameter name default):
      (define name)
      (bindq name (ParamRef 'name default))


define-syntax compile/parameterq:
  """
  Resolve a parameter by literal name. Lowers to the PARAM opcode
  family; `parameter` remains for names computed at runtime.
  """

  syntax-rules []:
    case (parameterq name):
      (parameter name)
    case (parameterq name default):
      (parameter name default)


define-syntax compile/define-environ:
  """
  Declare a name as an environment variable in a scope, with an optional
  default value if the environment variable is not set.
  """

  syntax-rules []:
    case (define-environ name default):
      (define name)
      (bindq name (environ-ref 'name default))
    case (define-environ name):
      (define name)
      (bindq name (environ-ref 'name))


define-syntax compile/let-values:
  """
  Evaluates body in a new scope with binding values defined from unpacking
  the sequence `value` according to `pattern`.

  Example::

  (let-values [[a b *: more] my-val]
    body ...)

  performs an unpacking assignment from sequence `my-val` into the bindings
  `a`, `b`, and `more`, with `more` being a sequence of the remaining values.
  """

  syntax-rules []:
    case (let-values [pattern value] body ...):
      (let [[resolved value]]
        (define-values pattern resolved) body ...)


define-syntax compile/let*:
  """
  Nested `let` bindings, where the bindings are evaluated in order
  from left to right.
  """

  syntax-rules [let let*]:
    case (let* [] body ...):
      (let [] body ...)
    case (let* [first] body ...):
      (let [first] body ...)
    case (let* [first rest ...] body ...):
      (let [first] (let* [rest ...] body ...))


define-syntax compile/item*:
  """
  Nested item access, where the key is evaluated in order from left to right.

  For example::

  (item* obj key1 key2 key3)

  is equivalent to::

  (item (item (item obj key1) key2) key3)
  """

  syntax-rules []:
    case (item* obj key):
      (item obj key)
    case (item* obj key rest ...):
      (item* (item obj key) rest ...)


define-syntax compile/attr*:
  """
  Nested attribute access, where the name is evaluated in order from left to right.

  For example::

  (attr* obj name1 name2)

  is equivalent to::

  (attr (attr obj name1) name2)
  """

  syntax-rules []:
    case (attr* obj name):
      (attr obj name)
    case (attr* obj name rest ...):
      (attr* (attr obj name) rest ...)


define-syntax compile/declare-exports:
  """
  Declare a list of names as exports

  Expands to a global definition of __all__ with the given names as strings,
  sorted and deduplicated.

  (declare-exports name1 name2 ...)

  is equivalent to

  (define-global __all__ #("name1" "name2" ...))
  """

  macro-rules []:
    case (declare-exports):
      `(define-global ,(datum '__all__) #())
    case (declare-exports [names ...]):
      `(define-global ,(datum '__all__)
        #(,@(sorted (set (list-each [n names] (str n.datum))))))
    case (declare-exports names ...):
      `(define-global ,(datum '__all__)
        #(,@(sorted (set (list-each [n names] (str n.datum))))))


;; The end.
