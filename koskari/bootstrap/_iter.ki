"""
Portion of koskari.builtins
"""


syntax each:
  """
  Generator comprehension over a sequence
  """

  syntax-rules [when: unless: when unless]:
    case (each [binding seq] (when condition body ...)):
      (each [binding seq] when: condition body ...)

    case (each [binding seq] (unless condition body ...)):
      (each [binding seq] unless: condition body ...)

    case (each [binding seq] when: condition body):
      ((lambda each [source] (for-each [binding source]
         (when condition (yield body)))) seq)

    case (each [binding seq] when: condition body ...):
      (each [binding seq] when: condition (begin body ...))

    case (each [binding seq] unless: condition body):
      ((lambda each [source] (for-each [binding source]
         (unless condition (yield body)))) seq)

    case (each [binding seq] unless: condition body ...):
      (each [binding seq] unless: condition (begin body ...))

    case (each [binding seq] body):
      ((lambda each [source] (for-each [binding source]
         (yield body))) seq)

    case (each [binding seq] body ...):
      (each [binding seq] (begin body ...))


syntax list-each:
  """
  List comprehension over a sequence.

  A body that is a single `when` or `unless` form is a filter: the
  collection happens inside the conditional, so skipped elements
  contribute nothing (no None gaps). This applies only when the
  conditional encompasses the whole body, and filters do not compose --
  a nested `when` is an ordinary expression whose None lands in the
  list. Write `(when (and a b) ...)` for a composite check, or
  `(if rule x None)` to collect the None deliberately.

  The sequence is evaluated first, in the scope the form is in, so a
  class-body name is in reach.
  """

  syntax-rules [when unless]:
    case (list-each [binding seq] (when condition body ...)):
      (list-each [binding seq] when: condition body ...)

    case (list-each [binding seq] (unless condition body ...)):
      (list-each [binding seq] unless: condition body ...)

    case (list-each [binding seq] when: condition body):
      let [[src seq] [col (#list)]]:
        for-each [binding src]:
          when condition:
            #list-append col body
        col

    case (list-each [binding seq] when: condition body ...):
      (list-each [binding seq] when: condition (begin body ...))

    case (list-each [binding seq] unless: condition body):
      let [[src seq] [col (#list)]]:
        for-each [binding src]:
          unless condition:
            #list-append col body
        col

    case (list-each [binding seq] unless: condition body ...):
      (list-each [binding seq] unless: condition (begin body ...))

    case (list-each [binding seq] body):
      let [[src seq] [col (#list)]]:
        for-each [binding src]:
          #list-append col body
        col

    case (list-each [binding seq] body ...):
      (list-each [binding seq] (begin body ...))


syntax dict-each:
  """
  Dict comprehension over a sequence.

  With `key:` and `value:` clauses, each element stores KEY to VALUE.
  Otherwise the body is a (key value) pair per element. A `when:` or
  `unless:` clause filters, as does a body that is a single `when` or
  `unless` form, with the same whole-body rule as `list-each`. The
  sequence is evaluated first, in the scope the form is in, so a
  class-body name is in reach.
  """

  syntax-rules [when: unless: key: value: when unless]:
    case (dict-each [binding seq] key: key value: value):
      let [[src seq] [col (#dict)]]:
        for-each [binding src]:
          set! col[key] value
        col

    case (dict-each [binding seq] when: condition key: key value: value):
      let [[src seq] [col (#dict)]]:
        for-each [binding src]:
          when condition:
            set! col[key] value
        col

    case (dict-each [binding seq] unless: condition key: key value: value):
      let [[src seq] [col (#dict)]]:
        for-each [binding src]:
          unless condition:
            set! col[key] value
        col

    case (dict-each [binding seq] (when condition body ...)):
      (dict-each [binding seq] when: condition body ...)

    case (dict-each [binding seq] (unless condition body ...)):
      (dict-each [binding seq] unless: condition body ...)

    case (dict-each [binding seq] when: condition body):
      let [[src seq] [col (#dict)]]:
        for-each [binding src]:
          when condition:
            (let-values [[k v] body] (set! col[k] v))
        col

    case (dict-each [binding seq] when: condition body ...):
      (dict-each [binding seq] when: condition (begin body ...))

    case (dict-each [binding seq] unless: condition body):
      let [[src seq] [col (#dict)]]:
        for-each [binding src]:
          unless condition:
            (let-values [[k v] body] (set! col[k] v))
        col

    case (dict-each [binding seq] unless: condition body ...):
      (dict-each [binding seq] unless: condition (begin body ...))

    case (dict-each [binding seq] body):
      let [[src seq] [col (#dict)]]:
        for-each [binding src]:
          (let-values [[k v] body] (set! col[k] v))
        col

    case (dict-each [binding seq] body ...):
      (dict-each [binding seq] (begin body ...))


syntax has?:
  """
  True if the collection contains the element
  """

  syntax-rules []:
    case (has? collection element):
      (in element collection)


def build-slice [start: None stop: None step: None]:
  """
  Simple slice class constructor that accepts keyword arguments
  """

  (slice start stop step)


syntax slice:
  """
  Adapter to route slice invocations to the build-slice function to
  enable keyword argument passing
  """

  syntax-rules []:
    case (slice):
      (call build-slice)
    case (slice args ...):
      (call build-slice args ...)


syntax item-slice:
  """
  Slice a sequence.

  Example::

  (item-slice sequence start ...)

  is equivalent to::

  (item sequence (slice start ...))
  """

  syntax-rules []:
    case (item-slice sequence):
      (item sequence (call build-slice))
    case (item-slice sequence args ...):
      (item sequence (call build-slice args ...))


@let [[py-sorted sorted]]
global def sorted [iterable key: None reverse: False]:
  """
  Koskari wrapper for Python's sorted function. Automatically
  wraps the key argument as a demand.

  Returns a new sorted list.

  Example::

    (sorted iterable key: (itemgetter 1 0))

  Example using a thunk::

    (sorted iterable key: { #((item %1 1) (item %1 0)) })
  """

  (py-sorted
    iterable
    key: (and key (demand key))
    reverse: reverse)


@let [[UNDEFINED ((build-class Undefined []
                   (def __repr__ [self]
                     "<raise>")))]]
global def next [it default: UNDEFINED]:
  """
  Get the next item from an iterator.

  If the iterator is exhausted, return the default value.
  If the default value is not provided, raise an error.
  """

  if (is? default UNDEFINED):
    next it
  else:
    next it default


global def iter [val]:
  """
  Produce an iterator for an iterable value
  """

  iter val


;; The end.
