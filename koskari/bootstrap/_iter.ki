"""
Portion of koskari.builtins
"""


define-syntax compile/each:
  """
  Generator comprehension over a sequence
  """

  syntax-rules [when: unless:]:
    case (each [binding seq] when: condition body):
      ((lambda each [] (for-each [binding seq]
         (when condition (yield body)))))
    case (each [binding seq] unless: condition body):
      ((lambda each [] (for-each [binding seq]
         (unless condition (yield body)))))
    case (each [binding seq] body):
      ((lambda each [] (for-each [binding seq]
         (yield body))))


define-syntax compile/list-each:
  """
  List comprehension over a sequence
  """

  syntax-rules []:
    case (list-each [binding seq] body):
      letrec [[col (list)] [colap col.append]]:
        for-each [binding seq] (colap body)
        col


define-syntax compile/dict-each:
  """
  Dict comprehension over a sequence via `compile/each`
  """

  syntax-rules [when: unless: key: value:]:
    case (dict-each [binding seq] key: key value: value):
      (dict (each [binding seq] #(key value) ))
    case (dict-each [binding seq] when: condition key: key value: value):
      (dict (each [binding seq] when: condition #(key value)))
    case (dict-each [binding seq] unless: condition key: key value: value):
      (dict (each [binding seq] unless: condition #(key value)))

    case (dict-each [binding seq] body):
      (dict (each [binding seq] body))


define-syntax compile/has?:
  """
  True if the collection contains the element
  """

  syntax-rules []:
    case (has? collection element):
      (compile/in element collection)


define build-slice [start: None stop: None step: None]:
  """
  Simple slice class constructor that accepts keyword arguments
  """

  (slice start stop step)


define-syntax compile/slice:
  """
  Adapter to route slice invocations to the build-slice function to
  enable keyword argument passing
  """

  syntax-rules []:
    case (slice):
      (call build-slice)
    case (slice args ...):
      (call build-slice args ...)


define-syntax compile/item-slice:
  """
  Slice a sequence.

  Example::

  (item-slice sequence start ...)

  is equivalent to::

  (item sequence (slice start ...))
  """

  syntax-rules []:
    case (item-slice sequence):
      (item sequence (call build-slice))
    case (item-slice sequence args ...):
      (item sequence (call build-slice args ...))


;; The end.
