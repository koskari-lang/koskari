"""
Portion of koskari.builtins
"""


define-syntax compile/if:
  """
  Evaluates the `then` body only when the `condition` is truthy.
  Evaluates the `else` body otherwise, or `None` if not provided.
  """

  syntax-rules []:
    case (if condition then: then else: else):
      (cond
        [condition then]
        [else: else])
    case (if condition then else):
      (cond
        [condition then]
        [else: else])
    case (if condition then):
      (cond
        [condition then]
        [else: None])


define-syntax compile/when:
  """
  Evaluates the body only when the condition is true
  Evaluates as None otherwise.
  """

  syntax-rules []:
    case (when condition then ...):
      (cond
        [condition then ...]
        [else: None])


define-syntax compile/unless:
  """
  Evaluates the body only when the condition is false.
  Evaluates as None otherwise.
  """

  syntax-rules []:
    case (unless condition then ...):
      (cond
        [condition None]
        [else: then ...])


define-syntax compile/?:
  syntax-rules []:
    case (? condition then else):
      (cond
        [condition then]
        [else: else])
    case (? condition then):
      (cond
        [condition then]
        [else: False])
    case (? condition):
      (truth condition)


define-syntax compile/bool:
  """
  Compile-time object truthiness as a boolean.
  """

  syntax-rules []:
    case (bool value):
      (truth value)


define-syntax compile/when-main:
  """
  Evaluates the body only when the current module's name is "__main__"
  """

  syntax-rules []:
    case (when-main body ...):
      when (equal? __name__ "__main__"):
        (begin body ...)


define-syntax compile/None?:
  """
  Identity predicate for the None singleton
  """

  syntax-rules []:
    case (None? value):
      (is value None)


;; nil? is compiled by the compile/nil? special (koskari.compile.specials.
;; object), which emits the NILP opcode — matching either empty-list
;; singleton (nil or bracket-nil). Compression lowers NILP + JUMP_FALSE to
;; CHECK_NIL. The runtime koskari.lib.nilp backs first-class use of nil?.


define on-demand? :: bool []:
  """
  True if current context is being evaluated via demand-call and
  cannot use `await` to suspend.
  """

  try:
    (await)
  except [KoskariSyncViolation]:
    True
  else:
    False


;; The end.
