"""
Portion of koskari.builtins
"""


let []:
  import-from functools update_wrapper

  define-global [decorate-wraps inner wrapper]:
    """
    Copies callable metadata from inner onto wrapper via
    functools.update_wrapper, returning wrapper. When inner is a
    coroutine function, wrapper is first passed through coroutine-fn
    and that result is returned, so it is a coroutine function too.
    Used by the call-with and call-parameterize decorator expansions so
    the delivered wrapper answers for the function it wraps.
    """

    import-from inspect iscoroutinefunction
    if (iscoroutinefunction inner):
      update_wrapper (coroutine-fn wrapper) inner
    else:
      update_wrapper wrapper inner


syntax decorate-nothing:
  """
  The error for a decorator over a declaration. A declaration binds no
  value, so a decorator has nothing to transform and its result would
  be dropped; the decorate arms route every valueless binding subject
  here, which refuses it at compile time naming the form.
  """

  special-rules []:
    case [c (decorate-nothing form)]:
      raise (CompilerError
        f"nothing to decorate: {form.datum} declares a name and binds"-
        " no value"
        None form.position c.filename)


syntax decorate-subject:
  """
  Applies one decorator expression to a subject form.

  A body-less extent form (`let`, `with`, `parameterize`) in decorator
  position is completed by grafting the subject in as its body, so the
  extent spans the evaluation of the subject itself. The call-time
  variants (`call-with`, `call-parameterize`) instead wrap the subject
  in a forwarding function that enters the extent per invocation,
  calls the subject with the passed arguments, and delivers its value
  after the extent closes. `entry-point` binds the subject as the
  module's `__entry__`, the function the launcher calls with no
  arguments once the module has loaded as a program, and delivers the
  subject unchanged. Any other decorator expression is evaluated and
  invoked on the subject, mimicking function composition. Further
  shape arms can be registered with `extend-syntax`; registered arms
  are tried before the invocation arm.
  """

  syntax-rules [let with parameterize call-with call-parameterize
                entry-point]:
    case (decorate-subject (let bindings) subject):
      (let bindings subject)

    case (decorate-subject (with binding) subject):
      (with binding subject)

    case (decorate-subject (parameterize params) subject):
      (parameterize params subject)

    case (decorate-subject (call-with binding) subject):
      (let [[inner subject]]
        (decorate-wraps inner
          (lambda [*: args **: kwds]
            (with binding
              (inner *: args **: kwds)))))

    case (decorate-subject (call-parameterize params) subject):
      (let [[inner subject]]
        (decorate-wraps inner
          (lambda [*: args **: kwds]
            (parameterize params
              (inner *: args **: kwds)))))

    case (decorate-subject entry-point subject):
      (let [[fn subject]]
        (define-global -'__entry__ fn)
        fn)

    case (decorate-subject deco subject):
      (deco subject)


syntax decorate:
  """
  Handler for the decorator layout syntax, can also be used to apply
  decorator-style wrappers to an s-expr form.

  Each decorator is applied to the accumulated subject via
  `decorate-subject`, outermost decorator first.
  """

  syntax-rules [define define-global def var global class]:
    case (decorate [] fn):
      fn

    case (decorate [decorators ...] (def name rest ...)):
      var name (decorate [decorators ...] (function name rest ...))

    ;; a value subject keeps its annotation and wraps only the value; a
    ;; declaration, or any other shape under the head, has no value to
    ;; wrap and is refused
    case (decorate [decorators ...] (var name :: type value)):
      var name :: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (var name type: type value)):
      var name type: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (var name value)):
      var name (decorate [decorators ...] value)

    case (decorate [decorators ...] (var name)):
      decorate-nothing (var name)

    case (decorate [decorators ...] (var name :: type)):
      decorate-nothing (var name :: type)

    case (decorate [decorators ...] (var name type: type)):
      decorate-nothing (var name type: type)

    case (decorate [decorators ...] (global var name :: type value)):
      global var name :: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (global var name type: type value)):
      global var name type: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (global var name value)):
      global var name (decorate [decorators ...] value)

    case (decorate [decorators ...] (global var name)):
      decorate-nothing (global var name)

    case (decorate [decorators ...] (global var name :: type)):
      decorate-nothing (global var name :: type)

    case (decorate [decorators ...] (global var name type: type)):
      decorate-nothing (global var name type: type)

    case (decorate [decorators ...] (global def name rest ...)):
      define-global name (decorate [decorators ...] (function name rest ...))

    case (decorate [decorators ...] (global class name supers body ...)):
      define-global name:
        decorate [decorators ...] (build-class name supers body ...)

    case (decorate [decorators ...] (class name supers body ...)):
      var name (decorate [decorators ...] (build-class name supers body ...))

    ;; the Scheme define: a (NAME FORMALS ...) head is a function, with
    ;; an optional return type bundled with the name as ((NAME :: TYPE)
    ;; FORMALS ...); a name is a value; the decorators wrap the value
    ;; either way
    case (decorate [decorators ...] (define ((name :: rtype) formals ...) body ...)):
      var name:
        decorate [decorators ...] (function name :: rtype [formals ...] body ...)

    case (decorate [decorators ...] (define ((name type: rtype) formals ...) body ...)):
      var name:
        decorate [decorators ...] (function name type: rtype [formals ...] body ...)

    case (decorate [decorators ...] (define (name formals ...) body ...)):
      var name (decorate [decorators ...] (function name [formals ...] body ...))

    case (decorate [decorators ...] (define name :: type value)):
      var name :: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (define name type: type value)):
      var name type: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (define name value)):
      var name (decorate [decorators ...] value)

    case (decorate [decorators ...] (define name)):
      decorate-nothing (define name)

    case (decorate [decorators ...] (define name :: type)):
      decorate-nothing (define name :: type)

    case (decorate [decorators ...] (define name type: type)):
      decorate-nothing (define name type: type)

    case (decorate [decorators ...] (define-global ((name :: rtype) formals ...) body ...)):
      define-global name:
        decorate [decorators ...] (function name :: rtype [formals ...] body ...)

    case (decorate [decorators ...] (define-global ((name type: rtype) formals ...) body ...)):
      define-global name:
        decorate [decorators ...] (function name type: rtype [formals ...] body ...)

    case (decorate [decorators ...] (define-global (name formals ...) body ...)):
      define-global name:
        decorate [decorators ...] (function name [formals ...] body ...)

    case (decorate [decorators ...] (define-global name :: type value)):
      define-global name :: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (define-global name type: type value)):
      define-global name type: type (decorate [decorators ...] value)

    case (decorate [decorators ...] (define-global name value)):
      define-global name (decorate [decorators ...] value)

    case (decorate [decorators ...] (define-global name)):
      decorate-nothing (define-global name)

    case (decorate [decorators ...] (define-global name :: type)):
      decorate-nothing (define-global name :: type)

    case (decorate [decorators ...] (define-global name type: type)):
      decorate-nothing (define-global name type: type)

    case (decorate [d rest ...] fn):
      decorate-subject d (decorate [rest ...] fn)


;; The end.
