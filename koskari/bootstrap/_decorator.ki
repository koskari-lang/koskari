"""
Portion of koskari.builtins
"""


let []:
  import-from functools update_wrapper

  global def decorate-wraps [inner wrapper]:
    """
    Copies callable metadata from inner onto wrapper via
    functools.update_wrapper, returning wrapper. When inner is a
    coroutine function, wrapper is first passed through coroutine-fn
    and that result is returned, so it is a coroutine function too.
    Used by the call-with and call-parameterize decorator expansions so
    the delivered wrapper answers for the function it wraps.
    """

    import-from inspect iscoroutinefunction
    if (iscoroutinefunction inner):
      update_wrapper (coroutine-fn wrapper) inner
    else:
      update_wrapper wrapper inner


syntax decorate-subject:
  """
  Applies one decorator expression to a subject form.

  A body-less extent form (`let`, `with`, `parameterize`) in decorator
  position is completed by grafting the subject in as its body, so the
  extent spans the evaluation of the subject itself. The call-time
  variants (`call-with`, `call-parameterize`) instead wrap the subject
  in a forwarding function that enters the extent per invocation,
  calls the subject with the passed arguments, and delivers its value
  after the extent closes. `entry-point` binds the subject as the
  module's `__entry__`, the function the launcher calls with no
  arguments once the module has loaded as a program, and delivers the
  subject unchanged. Any other decorator expression is evaluated and
  invoked on the subject, mimicking function composition. Further
  shape arms can be registered with `extend-syntax`; registered arms
  are tried before the invocation arm.
  """

  syntax-rules [let with parameterize call-with call-parameterize
                entry-point]:
    case (decorate-subject (let bindings) subject):
      (let bindings subject)

    case (decorate-subject (with binding) subject):
      (with binding subject)

    case (decorate-subject (parameterize params) subject):
      (parameterize params subject)

    case (decorate-subject (call-with binding) subject):
      (let [[inner subject]]
        (decorate-wraps inner
          (lambda [*: args **: kwds]
            (with binding
              (inner *: args **: kwds)))))

    case (decorate-subject (call-parameterize params) subject):
      (let [[inner subject]]
        (decorate-wraps inner
          (lambda [*: args **: kwds]
            (parameterize params
              (inner *: args **: kwds)))))

    case (decorate-subject entry-point subject):
      (let [[fn subject]]
        (define-global -'__entry__ fn)
        fn)

    case (decorate-subject deco subject):
      (deco subject)


syntax decorate:
  """
  Handler for the decorator layout syntax, can also be used to apply
  decorator-style wrappers to an s-expr form.

  Each decorator is applied to the accumulated subject via
  `decorate-subject`, outermost decorator first.
  """

  syntax-rules [define define-global def var global class]:
    case (decorate [] fn):
      fn

    case (decorate [decorators ...] (def name rest ...)):
      var name (decorate [decorators ...] (function name rest ...))

    case (decorate [decorators ...] (var name value)):
      var name (decorate [decorators ...] value)

    case (decorate [decorators ...] (global def name rest ...)):
      global name (decorate [decorators ...] (function name rest ...))

    case (decorate [decorators ...] (global class name supers body ...)):
      global name:
        decorate [decorators ...] (build-class name supers body ...)

    case (decorate [decorators ...] (class name supers body ...)):
      var name (decorate [decorators ...] (build-class name supers body ...))

    ;; the Scheme define: a (NAME FORMALS ...) head is a function, a
    ;; name is a value; the decorators wrap the value either way
    case (decorate [decorators ...] (define (name formals ...) body ...)):
      var name (decorate [decorators ...] (function name [formals ...] body ...))

    case (decorate [decorators ...] (define name value)):
      var name (decorate [decorators ...] value)

    case (decorate [decorators ...] (define-global (name formals ...) body ...)):
      global name:
        decorate [decorators ...] (function name [formals ...] body ...)

    case (decorate [decorators ...] (define-global name value)):
      global name (decorate [decorators ...] value)

    case (decorate [d rest ...] fn):
      decorate-subject d (decorate [rest ...] fn)


;; The end.
