"""
koskari.fences.bash

Runtime support for the fence/bash handler. An expanded bash fence
imports bash_script from this module at run time, inside its own let
scope, so nothing needs to be pre-bound in the surrounding module's
namespace.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from asyncio create_subprocess_exec
import-from asyncio.subprocess PIPE
import-from subprocess CalledProcessError
import-from json [loads as: json-loads]


define bash_script [script filter: None]:
  """
  Build a callable that runs SCRIPT in a bash subprocess

  The callable is async: invoking it launches `bash -c SCRIPT` with
  stdout and stderr captured, and returns the decoded stdout text.
  With filter "json" the stdout is decoded as JSON instead. A nonzero
  exit status raises subprocess.CalledProcessError.
  """

  when (and filter (!= (str filter) "json")):
    raise (ValueError f"unsupported bash_script filter: {filter}")

  define run-script []:
    define proc (create_subprocess_exec
      "bash" "-c" script
      stdout: PIPE stderr: PIPE)
    define-values [out err] (proc.communicate)
    when proc.returncode:
      raise (CalledProcessError
        proc.returncode #("bash" "-c" script)
        output: out stderr: err)
    if filter:
      (json-loads (out.decode))
    else:
      (out.decode)

  run-script


; The end.
