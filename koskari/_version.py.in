"""
koskari._version

Auto-generated at build time. Do not edit by hand.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""

version = %(version)r
major = %(major)r
minor = %(minor)r
micro = %(micro)r
release = %(release)r

version_info = %(version_info)r
__version__ = f"{version}+{release}"

build_kind = %(build_kind)r
commit = %(commit)r
dirty = %(dirty)r


# The end.
