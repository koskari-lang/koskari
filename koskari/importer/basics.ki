;; koskari.importer.basics
;;
;; Koskari-defined builtins loaded on top of bootstrap.  This module is
;; merged with bootstrap to form the full builtins environment for
;; all .ki modules.  Add macros, helpers, and other builtin definitions
;; here; they will be available in every module without import.


(define compile/define-syntax
  ;; the macro for defining macros

  (syntax-rules compile/define-syntax
      [syntax-rules syntax-match
       macro-rules macro-match
       special-rules special-match]

    [(define-syntax name (syntax-rules literals rule ...))
      (compile/define name (syntax-rules name literals rule ...))]

    [(define-syntax name (syntax-match rule ...))
      (compile/define name (syntax-match name rule ...))]

    [(define-syntax name (macro-rules literals rule ...))
      (compile/define name (macro-rules name literals rule ...))]

    [(define-syntax name (macro-match rule ...))
      (compile/define name (macro-match name rule ...))]

    [(define-syntax name (special-rules literals rule ...))
      (compile/define name (special-rules name literals rule ...))]

    [(define-syntax name (special-match rule ...))
      (compile/define name (special-match name rule ...))]))


define layout/define-syntax layout/flat


define-syntax compile/set!:
  syntax-rules [item attr deref
                compile/item compile/attr compile/deref
                + - * / // % ** @ << >> & ^ |]:
    case (set! (item obj name) value):
      (compile/set-item obj name value)
    case (set! (compile/item obj name) value):
      (compile/set-item obj name value)

    case (set! (attr obj name) value):
      (compile/set-attr obj name value)
    case (set! (compile/attr obj name) value):
      (compile/set-attr obj name value)

    case (set! (deref ref) value):
      (compile/set-ref ref value)
    case (set! (compile/deref ref) value):
      (compile/set-ref ref value)

    case (set! (values pattern ...) value):
      (compile/setq-values [pattern ...] value)

    case (set! name (+ name value)):
      (compile/inplace + name value)
    case (set! name (- name value)):
      (compile/inplace - name value)
    case (set! name (* name value)):
      (compile/inplace * name value)
    case (set! name (/ name value)):
      (compile/inplace / name value)
    case (set! name (// name value)):
      (compile/inplace // name value)
    case (set! name (% name value)):
      (compile/inplace % name value)
    case (set! name (** name value)):
      (compile/inplace ** name value)
    case (set! name (@ name value)):
      (compile/inplace @ name value)
    case (set! name (<< name value)):
      (compile/inplace << name value)
    case (set! name (>> name value)):
      (compile/inplace >> name value)
    case (set! name (& name value)):
      (compile/inplace & name value)
    case (set! name (^ name value)):
      (compile/inplace ^ name value)
    case (set! name (| name value)):
      (compile/inplace | name value)

    case (set! name value):
      (setq name value)


define-syntax compile/del!:
  syntax-rules []:
    case (del! name):
      (delq name)
    case (del! (item obj name)):
      (del-item obj name)
    case (del! (compile/item obj name)):
      (del-item obj name)
    case (del! (attr obj name)):
      (del-attr obj name)
    case (del! (compile/attr obj name)):
      (del-attr obj name)


define-syntax compile/let-values:
  syntax-rules []:
    case (let-values [pattern value] body ...):
      (let [[resolved value]]
        (compile/define-values pattern resolved) body ...)


define-syntax compile/let*:
  syntax-rules [let let*]:
    case (let* [] body ...):
      (let [] body ...)
    case (let* [first] body ...):
      (let [first] body ...)
    case (let* [first rest ...] body ...):
      (let [first] (let* [rest ...] body ...))


define-syntax compile/item*:
  syntax-rules []:
    case (item* obj key):
      (item obj key)
    case (item* obj key rest ...):
      (item* (item obj key) rest ...)


define-syntax compile/ref:
  syntax-rules [item compile/item attr compile/attr parameter]:
    case (ref (item obj name)):
      (compile/ref-item obj name)
    case (ref (compile/item obj name)):
      (compile/ref-item obj name)

    case (ref (attr obj name)):
      (compile/ref-attr obj name)
    case (ref (compile/attr obj name)):
      (compile/ref-attr obj name)

    case (ref (parameter name)):
      (ParamRef 'name)

    case (ref name):
      (compile/refq name)


define-syntax compile/bind!:
  syntax-rules [item compile/item
                attr compile/attr
                dynamic
                constant
                memoized
                parameter]:

    case (bind! name (item obj key)):
      (compile/bindq name (ref-item obj key))
    case (bind! name (compile/item obj key)):
      (compile/bindq name (ref-item obj key))

    case (bind! name (attr obj key)):
      (compile/bindq name (ref-attr obj key))
    case (bind! name (compile/attr obj key)):
      (compile/bindq name (ref-attr obj key))

    case (bind! name (dynamic r ...)):
      (compile/bindq name (DynamicRef 'name r ...))

    case (bind! name (constant value)):
      (compile/bindq name (ConstantRef 'name value))

    case (bind! name (memoized getfn)):
      (compile/bindq name (MemoizedRef 'name getfn))

    case (bind! name (parameter param-name r ...)):
      (compile/bindq name (ParamRef 'param-name r ...))

    case (bind! name value):
      (compile/bindq name value)


define-syntax compile/if:
  syntax-rules []:
    case (if condition then: then else: else):
      (compile/cond
        [condition then]
        [else: else])
    case (if condition then else):
      (compile/cond
        [condition then]
        [else: else])
    case (if condition then):
      (compile/cond
        [condition then]
        [else: None])


define-syntax compile/when:
  syntax-rules []:
    case (when condition then):
      (compile/cond
        [condition then]
        [else: None])


define-syntax compile/unless:
  syntax-rules []:
    case (unless condition then):
      (compile/cond
        [condition None]
        [else: then])


define-syntax compile/define-parameter:
  syntax-rules []:
    case (define-parameter name):
      (compile/define name)
      (compile/bindq name (ParamRef 'name))
    case (define-parameter name default):
      (compile/define name)
      (compile/bindq name (ParamRef 'name default))


define-syntax compile/parameterq:
  syntax-rules []:
    case (parameterq name):
      (parameter 'name)
    case (parameterq name default):
      (parameter 'name default)


define-syntax define-coroutine:
  syntax-rules []:
    case (define-coroutine name args body ...):
      (define name (as-coroutine (lambda name args body ...)))


define-syntax when-main:
  syntax-rules []:
    case (when-main body ...):
      when (equal? __name__ "__main__"):
        (begin body ...)


define-syntax compile/each:
  syntax-rules [when: unless:]:
    case (each [binding seq] when: condition body):
      ((lambda each [] (for-each [binding seq]
         (when condition (yield body)))))
    case (each [binding seq] unless: condition body):
      ((lambda each [] (for-each [binding seq]
         (unless condition (yield body)))))
    case (each [binding seq] body):
      ((lambda each [] (for-each [binding seq]
         (yield body))))


define-syntax compile/list-each:
  syntax-rules []:
    case (list-each [binding seq] body):
      (list (each [binding seq] body))


define-syntax compile/dict-each:
  syntax-rules [when: unless: key: value:]:
    case (dict-each [binding seq] key: key value: value):
      (dict (each [binding seq] #(key value) ))
    case (dict-each [binding seq] when: condition key: key value: value):
      (dict (each [binding seq] when: condition #(key value)))
    case (dict-each [binding seq] unless: condition key: key value: value):
      (dict (each [binding seq] unless: condition #(key value)))

    case (dict-each [binding seq] body):
      (dict (each [binding seq] body))


define-syntax compile/None?:
  syntax-rules []:
    case (None? value):
      (compile/is None value)


define-syntax compile/nil?:
  syntax-rules []:
    case (nil? value):
      (compile/is nil value)


define-syntax compile/define-class:
  syntax-rules []:
    case (define-class name supers body ...):
      (define name (class name supers body ...))


define-syntax compile/define-demanding:
  syntax-rules []:
    case (define-demanding name formals body ...):
      (define name (demand (lambda name formals body ...)))


define-syntax compile/function-compose:
  macro-rules []:
    case (function-compose fn1):
      fn1
    case (function-compose fn1 ...):
      define acc `(*: args **: kwds)
      define elems (list-each [fn fn1] #((gensym) fn))
      for-each [[sym fn] (reversed elems)]:
        set! acc `((,sym ,@acc))
      `(let [,@(each [[sym fn] elems] (cons sym fn nil))]
        (lambda [*: args **: kwds] ,@acc))


define-syntax compile/decorate:
  syntax-rules [define-class define compile/define-class compile/define]:
    case (decorate [] fn):
      fn
    case (decorate [decorators ...] (define-class name supers body ...)):
      (define name (decorate [decorators ...] (class name supers (begin body ...))))
    case (decorate [decorators ...] (compile/define-class name supers body ...)):
      (define name (decorate [decorators ...] (class name supers (begin body ...))))
    case (decorate [decorators ...] (define name formals body ...)):
      (define name (decorate [decorators ...] (lambda name formals body ...)))
    case (decorate [decorators ...] (compile/define name formals body ...)):
      (define name (decorate [decorators ...] (lambda name formals body ...)))
    case (decorate [decorators ...] fn):
      ((function-compose decorators ...) fn)


define-syntax compile/cadr:
  (syntax-rules [] [(cadr x) (car (cdr x))])

define-syntax compile/caddr:
  (syntax-rules [] [(caddr x) (car (cdr (cdr x)))])

define-syntax compile/cadddr:
  (syntax-rules [] [(cadddr x) (car (cdr (cdr (cdr x))))])

define-syntax compile/caddddr:
  (syntax-rules [] [(caddddr x) (car (cdr (cdr (cdr (cdr x)))))])


define compile/first compile/car
define compile/second compile/cadr
define compile/third compile/caddr
define compile/fourth compile/cadddr
define compile/fifth compile/caddddr


define on-demand? []:
  """
  True if current context is being evaluated via demand-call and
  cannot use `await` to suspend.
  """
  import-from koskari.exceptions KoskariSyncViolation
  try:
    (await)
  except [KoskariSyncViolation]:
    True
  else:
    False


define-syntax compile/datum:
  macro-rules []:
    case (_ expr pos):
      `(call datum ,expr ,pos)
    case (_ expr):
      define pos (getattr expr "position" None)
      `(call datum ,expr ,pos)


define-syntax create-instance-check:
  macro-match:
    case (create-instance-check (BIND name)):
      define pname (datum (symbol f"{name.datum}?"))
      `define ,pname:
        let [[tp ,name]]:
          lambda ,pname [value]:
            compile/isinstance value tp


define-syntax compile/define-dataclass:
  syntax-rules [begin]:
    case (define-dataclass name (members ...)):
      (define-dataclass name [] (members ...))
    case (define-dataclass name supers members ...):
      define name:
        let []:
          import-from dataclasses dataclass field
          @dataclass
          class name supers:
            (begin members ...)
      create-instance-check name


define-syntax compile/super:
  syntax-rules []:
    case (super):
      (compile/call super (type self) self)
    case (super args ...):
      (compile/call super args ...)


define-syntax compile/extend:
  syntax-rules []:
    case (extend sym val):
      set! sym (+ sym val)


define-syntax compile/define-extend:
  syntax-rules []:
    case (define-extend sym):
      define sym
    case (define-extend sym val):
      if &sym:
        extend sym val
      else:
        define sym val


define-syntax compile/extend-syntax:
  syntax-rules [syntax-rules syntax-match
                macro-rules macro-match
                special-rules special-match]:

    case (extend-syntax name (syntax-rules literals rule ...)):
      define-extend name (syntax-rules name literals rule ...)

    case (extend-syntax name (syntax-match rule ...)):
      define-extend name (syntax-match name rule ...)

    case (extend-syntax name (macro-rules literals rule ...)):
      define-extend name (macro-rules name literals rule ...)

    case (extend-syntax name (macro-match rule ...)):
      compile/define name (macro-match name rule ...)

    case (extend-syntax name (special-rules literals rule ...)):
      define-extend name (special-rules name literals rule ...)

    case (extend-syntax name (special-match rule ...)):
      define-extend name (special-match name rule ...)


define layout/extend-syntax layout/flat


define-syntax compile/help:
  syntax-rules []:
    case (help obj ns):
      (compile/call help obj ns)
    case (help obj):
      (compile/call help 'obj (globals))
    case (help):
      (compile/call help 'help (globals))


;; The end.
