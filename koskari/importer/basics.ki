;; koskari.importer.basics
;;
;; Koskari-defined builtins loaded on top of bootstrap.  This module is
;; merged with bootstrap to form the full builtins environment for
;; all .ki modules.  Add macros, helpers, and other builtin definitions
;; here; they will be available in every module without import.


define-syntax compile/set!:
  syntax-rules [item attr deref + - * / // % ** @ << >> & ^ |]:
    match (set! (item obj name) value):
      (set-item obj name value)
    match (set! (attr obj name) value):
      (set-attr obj name value)
    match (set! (deref ref) value):
      (set-ref ref value)
    match (set! name (+ name value)):
      (compile/inplace + name value)
    match (set! name (- name value)):
      (compile/inplace - name value)
    match (set! name (* name value)):
      (compile/inplace * name value)
    match (set! name (/ name value)):
      (compile/inplace / name value)
    match (set! name (// name value)):
      (compile/inplace // name value)
    match (set! name (% name value)):
      (compile/inplace % name value)
    match (set! name (** name value)):
      (compile/inplace ** name value)
    match (set! name (@ name value)):
      (compile/inplace @ name value)
    match (set! name (<< name value)):
      (compile/inplace << name value)
    match (set! name (>> name value)):
      (compile/inplace >> name value)
    match (set! name (& name value)):
      (compile/inplace & name value)
    match (set! name (^ name value)):
      (compile/inplace ^ name value)
    match (set! name (| name value)):
      (compile/inplace | name value)
    match (set! name value):
      (setq name value)


define-syntax compile/ref:
  syntax-rules [item compile/item attr compile/attr]:
    match (ref (item obj name)):
      (compile/ref-item obj name)
    match (ref (compile/item obj name)):
      (compile/ref-item obj name)

    match (ref (attr obj name)):
      (compile/ref-attr obj name)
    match (ref (compile/attr obj name)):
      (compile/ref-attr obj name)

    match (ref name):
      (compile/refq name)


;; The end.
