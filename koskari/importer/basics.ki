;; koskari.importer.basics
;;
;; Koskari-defined builtins loaded on top of bootstrap.  This module is
;; merged with bootstrap to form the full builtins environment for
;; all .ki modules.  Add macros, helpers, and other builtin definitions
;; here; they will be available in every module without import.


define-syntax compile/set!:
  syntax-rules [item attr deref compile/item compile/attr compile/deref
                + - * / // % ** @ << >> & ^ |]:
    match (set! (item obj name) value):
      (compile/set-item obj name value)
    match (set! (compile/item obj name) value):
      (compile/set-item obj name value)

    match (set! (attr obj name) value):
      (compile/set-attr obj name value)
    match (set! (compile/attr obj name) value):
      (compile/set-attr obj name value)

    match (set! (deref ref) value):
      (compile/set-ref ref value)
    match (set! (compile/deref ref) value):
      (compile/set-ref ref value)

    match (set! (values pattern ...) value):
      (compile/setq-values [pattern ...] value)

    match (set! name (+ name value)):
      (compile/inplace + name value)
    match (set! name (- name value)):
      (compile/inplace - name value)
    match (set! name (* name value)):
      (compile/inplace * name value)
    match (set! name (/ name value)):
      (compile/inplace / name value)
    match (set! name (// name value)):
      (compile/inplace // name value)
    match (set! name (% name value)):
      (compile/inplace % name value)
    match (set! name (** name value)):
      (compile/inplace ** name value)
    match (set! name (@ name value)):
      (compile/inplace @ name value)
    match (set! name (<< name value)):
      (compile/inplace << name value)
    match (set! name (>> name value)):
      (compile/inplace >> name value)
    match (set! name (& name value)):
      (compile/inplace & name value)
    match (set! name (^ name value)):
      (compile/inplace ^ name value)
    match (set! name (| name value)):
      (compile/inplace | name value)

    match (set! name value):
      (setq name value)


define-syntax compile/let-values:
  syntax-rules []:
    match (let-values [pattern value] body ...):
      (let [[resolved value]]
        (compile/define-values pattern resolved) body ...)


define-syntax compile/let*:
  syntax-rules [let let*]:
    match (let* [] body ...):
      (let [] body ...)
    match (let* [first] body ...):
      (let [first] body ...)
    match (let* [first rest ...] body ...):
      (let [first] (let* [rest ...] body ...))


define-syntax compile/ref:
  syntax-rules [item compile/item attr compile/attr parameter]:
    match (ref (item obj name)):
      (compile/ref-item obj name)
    match (ref (compile/item obj name)):
      (compile/ref-item obj name)

    match (ref (attr obj name)):
      (compile/ref-attr obj name)
    match (ref (compile/attr obj name)):
      (compile/ref-attr obj name)

    match (ref (parameter name)):
      (ParamRef 'name)

    match (ref name):
      (compile/refq name)


define-syntax compile/bind!:
  syntax-rules [item compile/item
                attr compile/attr
                dynamic
                constant
                memoized
                parameter]:

    match (bind! name (item obj key)):
      (compile/bindq name (ref-item obj key))
    match (bind! name (compile/item obj key)):
      (compile/bindq name (ref-item obj key))

    match (bind! name (attr obj key)):
      (compile/bindq name (ref-attr obj key))
    match (bind! name (compile/attr obj key)):
      (compile/bindq name (ref-attr obj key))

    match (bind! name (dynamic r ...)):
      (compile/bindq name (DynamicRef 'name r ...))

    match (bind! name (constant value)):
      (compile/bindq name (ConstantRef 'name value))

    match (bind! name (memoized getfn)):
      (compile/bindq name (MemoizedRef 'name getfn))

    match (bind! name (parameter param-name r ...)):
      (compile/bindq name (ParamRef 'param-name r ...))

    match (bind! name value):
      (compile/bindq name value)


define-syntax compile/if:
  syntax-rules []:
    match (if condition then: then else: else):
      (compile/cond
        [condition then]
        [else: else])
    match (if condition then else):
      (compile/cond
        [condition then]
        [else: else])
    match (if condition then):
      (compile/cond
        [condition then]
        [else: None])


define-syntax compile/when:
  syntax-rules []:
    match (when condition then):
      (compile/cond
        [condition then]
        [else: None])


define-syntax compile/unless:
  syntax-rules []:
    match (unless condition then):
      (compile/cond
        [condition None]
        [else: then])


define-syntax compile/define-parameter:
  syntax-rules []:
    match (define-parameter name):
      (compile/define name)
      (compile/bindq name (ParamRef 'name))
    match (define-parameter name default):
      (compile/define name)
      (compile/bindq name (ParamRef 'name default))


define-syntax compile/parameterq:
  syntax-rules []:
    match (parameterq name):
      (parameter 'name)
    match (parameterq name default):
      (parameter 'name default)


define-syntax define-coroutine:
  syntax-rules []:
    match (define-coroutine name args body ...):
      (define name (as-coroutine (lambda name args body ...)))


define-syntax when-main:
  syntax-rules []:
    match (when-main body ...):
      when (eq? __name__ "__main__"):
        body ...


define-syntax compile/each:
  syntax-rules [when: unless:]:
    match (each [binding seq] when: condition body):
      ((lambda [] (for-each [binding seq]
         (when condition (yield body)))))
    match (each [binding seq] unless: condition body):
      ((lambda [] (for-each [binding seq]
         (unless condition (yield body)))))
    match (each [binding seq] body):
      ((lambda [] (for-each [binding seq]
         (yield body))))


define-syntax compile/list-each:
  syntax-rules []:
    match (list-each [binding seq] body ...):
      (list (each [binding seq] body ...))


define-syntax compile/dict-each:
  syntax-rules [when: unless: key: value:]:
    match (dict-each [binding seq] key: key value: value):
      (dict (each [binding seq] (cons key value) ))
    match (dict-each [binding seq] when: condition key: key value: value):
      (dict (each [binding seq] when: condition (cons key value)))
    match (dict-each [binding seq] unless: condition key: key value: value):
      (dict (each [binding seq] unless: condition (cons key value)))

    match (dict-each [binding seq] body ...):
      (dict (each [binding seq] body ...))


define-syntax compile/None?:
  syntax-rules []:
    match (None? value):
      (compile/is None value)


define-syntax compile/nil?:
  syntax-rules []:
    match (nil? value):
      (compile/is nil value)


let []:
  import-from functools partial wraps
  define-global demanding [fn]:
    """
    A demand wrapper for fn
    """
    ((wraps fn) (partial demand fn))


define-syntax compile/define-demanding:
  syntax-rules []:
    match (define-demanding name formals body ...):
      (define name (demanding (lambda name formals body ...)))


;; The end.
