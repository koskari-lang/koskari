"""
koskari.dis

Disassembler for Koskari code objects. Similar to Python's dis module:
unpacks constant pool, vars (local_syms), closure refs (closure_syms from
namespace_spec), and prints indexed opcodes with human-readable arguments
(e.g. constant pool index as repr of value, jump targets as instruction
indices). Also accepts BoundMethod (unwraps __func__ for bytecode, prints
__self__ in a leading section).

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from koskari.lib BoundMethod Code Compare Expression Function NamespaceSpec OpCode Operand OpStyle


(declare-exports dis)


define _boundmethod_inner_function [bm]:
  """
  Return the KosFunction behind a BoundMethod, unwrapping Demand if needed

  :param bm: BoundMethod instance
  :return: Function instance
  :raises TypeError: when __func__ is not Function or Demand(Function)
  """
  define func bm.__func__
  when (demand? func):
    set! func func.__wrapped__

  unless (instance? func Function):
    (raise
      (TypeError
        f"BoundMethod __func__ must be Function or Demand(Function), got {(attr (type func) __name__)}"))
  return func


define _get_code [x]:
  """
  Return Code for disassembly targets: Code, or Expression (unwrap .code).

  :param x: value to check
  :return: Code instance or None
  """
  if (instance? x Code):
    x
  elif (instance? x Expression):
    x.code
  else:
    None


define _format_constant [val]:
  """
  Repr suitable for constant pool display (bounded length)

  :param val: constant pool value
  :return: string representation of the value
  """
  define r (repr val)
  if (> (len r) 60):
    f"{(item-slice r stop: 57)}..."
  else:
    r


define _write_function_instance_section [file fn]:
  """
  Write a leading section for a Function instance: name, formals,
  base_ns (closures).

  :param file: file-like object to write to
  :param fn: Function instance (KosFunction)
  """
  define name fn.name
  define name_repr (repr name)

  file.write "Function instance:\n"
  file.write f"  name: {name_repr}\n"
  file.write "  formals:\n"

  define formals fn.formals
  if formals:
    for-each [attr_name #("pos" "pos_only" "kwd" "kwd_only" "star" "starstar" "defaults")]:
      define val (getattr formals attr_name None)
      file.write f"    {attr_name}: {(repr val)}\n"
  else:
    file.write "    (none)\n"

  define base_ns fn.base_ns
  file.write "  base_ns (closures):\n"
  if base_ns:
    try:
      define items (base_ns.items)
    except [#(AttributeError TypeError)]:
      file.write "    (unable to iterate)\n"
    else:
      for-each [kv items]:
        define k kv[0]
        define v kv[1]
        file.write f"    {(repr k)}: {(_format_constant v)}\n"
  else:
    file.write "    (none)\n"
  file.write "\n"


define _write_bound_method_section [file bm]:
  """
  Write a leading section for a BoundMethod: bound __self__.

  :param file: file-like object to write to
  :param bm: BoundMethod instance
  """
  file.write "Bound method instance:\n"
  file.write f"  __self__: {(_format_constant bm.__self__)}\n"
  file.write "\n"


define _format_nspec_inline [cpool_idx nspec]:
  """
  Short inline label for a NamespaceSpec used in instruction annotations.

  Returns a string of the form "ns#K 'name'" where K is the constant
  pool index and name is the namespace name.

  :param cpool_idx: integer index into the constant pool
  :param nspec: NamespaceSpec instance
  :return: inline annotation string
  """
  define ns_name nspec.name
  define name_repr (repr ns_name)
  return f"ns#{cpool_idx} {name_repr}"


define _write_nspec_cpool_entry [file cpool_idx nspec]:
  """
  Write an expanded constant pool entry for a NamespaceSpec.

  Emits the ns# label line followed by indented locals and closures
  lines, so the reader can see all names available in the namespace.

  :param file: file-like object to write to
  :param cpool_idx: integer index into the constant pool
  :param nspec: NamespaceSpec instance
  """
  define ns_name nspec.name
  define name_repr (repr ns_name)
  define local_syms nspec.local_syms
  define closure_syms nspec.closure_syms
  define global_syms nspec.global_syms
  define all_captured (+ (tuple closure_syms) (tuple global_syms))

  file.write f"  ns#{cpool_idx}: NamespaceSpec {name_repr}\n"
  file.write f"          locals:   {(repr (tuple local_syms))}\n"
  file.write f"          closures: {(repr (tuple all_captured))}\n"


define _build_ns_const_map [code]:
  """
  Pre-scan instructions and return a mapping from PUSH_NS / PUSH_COLLECT
  instruction index to the constant pool index of the NamespaceSpec.

  PUSH_NS: extra row slot a0 is the constant pool index of the NamespaceSpec.
  PUSH_COLLECT: arg is the constant pool index.

  :param code: Code instance
  :return: dict mapping instruction index -> constant pool index
  """
  define result #{}
  define i 0
  define n (code.length)

  while (< i n):
    define oparg (code.oparg i)
    define op_int oparg[0]
    define arg oparg[1]
    define op (OpCode op_int)

    if (equal? op OpCode.PUSH_NS):
      define ext (code.extra_tuple arg)
      set! result[i] ext[0]
    elif (equal? op OpCode.PUSH_COLLECT):
      set! result[i] arg

    incr! i

  return result


define _format_fast_part [val local_names closure_names]:
  """
  Format FAST slot display as local or closure
  """
  define n_local (if local_names (len local_names) 0)

  if (< val n_local):
    (define name
      (if local_names
       then: local_names[val]
       else: f"local[{val}]"))
    f"fast {val} ({(repr name)})"
  else:
    define idx (- val n_local)
    if (and closure_names (<= 0 idx) (< idx (len closure_names))):
      f"fast {val} (closure {(repr closure_names[idx])})"
    else:
      f"fast {val}"


define _compare_name [sel]:
  """
  Short display name for a Compare selector value (e.g. 5 -> "GE")
  """

  try:
    define member (Compare sel)
  except [ValueError]:
    return (str sel)
  member.name


define _operand_name [sel]:
  """
  Short display name for an Operand selector value (e.g. 0 -> "ADD")
  """

  try:
    define member (Operand sel)
  except [ValueError]:
    return (str sel)
  member.name


define _format_cmpsrc_row [arg ext schema cpool local_names closure_names]:
  """
  Render a CMPSRC row: the selector name, then each operand per its
  source bit (constant pool when the bit is set, else the slot's
  declared primary kind), then the jump target
  """

  define src ext[0]
  define bits (// src 16)
  define parts #[]
  parts.append (_compare_name (% src 16))

  define render_operand [slot_idx const_bit fk]:
    define val ext[slot_idx]
    if const_bit:
      if (and (<= 0 val) (< val (len cpool))):
        parts.append f"c#{val} ({(_format_constant cpool[val])})"
      else:
        parts.append (str val)
    elif (equal? fk OpStyle.FASTVAR):
      parts.append (_format_fast_part val local_names closure_names)
    else:
      if (and (<= 0 val) (< val (len cpool))):
        parts.append f"v#{val} ({(repr cpool[val])})"
      else:
        parts.append (str val)

  render_operand 1 (% bits 2) schema[1]
  render_operand 2 (% (// bits 2) 2) schema[2]
  parts.append f"-> {(item ext 3)}"

  define joined (", ".join parts)
  f"{arg} ({joined})"


define _format_arg [code op_style arg cpool local_names closure_names
                    ns_label: None extra_schema: #()]:
  """
  Format an opcode argument for display. Uses constant pool, local
  names, and closure names when the argument is an index into them.

  For PUSH_NS and PUSH_CLASS, the optional ns_label string is appended
  to annotate which namespace is being pushed.

  :param code: Koskari Code
  :param op_style: OpStyle member (op.style)
  :param arg: raw argument value
  :param cpool: code.constants_pool (sequence)
  :param local_names: sequence of local sym names from nspec
  :param closure_names: sequence of closure sym names from nspec
  :param ns_label: optional inline namespace label for PUSH_NS / PUSH_CLASS
  :param extra_schema: op.extra -- a 4-tuple of OpStyle field kinds for
    an EXTRA-style opcode, empty for every other style
  :return: string description of the argument
  """

  switch op_style:

    case [OpStyle.EXTRA]:
      if extra_schema:
        define schema extra_schema
        try:
          define ext (code.extra_tuple arg)
        except [#(IndexError TypeError)]:
          return (str arg)

        if (equal? (item schema 0) OpStyle.CMPSRC):
          return (_format_cmpsrc_row arg ext schema cpool
                                     local_names closure_names)

        define parts #[]
        for-each [[val fk] (zip ext schema)]:
          if (or (equal? fk OpStyle.CONST) (equal? fk OpStyle.VAR)):
            if (and (<= 0 val) (< val (len cpool))):
              (define prefix
                (if (equal? fk OpStyle.CONST) "c" "v"))
              (define cval (item cpool val))
              (define inner
                (if (and (equal? fk OpStyle.CONST)
                        (instance? cval NamespaceSpec))
                  then: (_format_nspec_inline val cval)
                  else: (_format_constant cval)))
              (parts.append f"{prefix}#{val} ({inner})")
            else:
              parts.append (str val)

          elif (equal? fk OpStyle.FASTVAR):
            parts.append (_format_fast_part val local_names closure_names)
          elif (equal? fk OpStyle.COUNT):
            parts.append (str val)
          elif (equal? fk OpStyle.CMP):
            parts.append (_compare_name val)
          elif (equal? fk OpStyle.OPERAND):
            parts.append (_operand_name val)
          elif (equal? fk OpStyle.LABEL):
            parts.append f"-> {val}"
          else:
            parts.append (str val)

        define joined (", ".join parts)
        return f"{arg} ({joined})"

      else:
        return (str arg)

    case [OpStyle.CONST]:
      if (< -1 arg (len cpool)):
        define val cpool[arg]
        if (instance? val NamespaceSpec):
          return f"{arg} ({(_format_nspec_inline arg val)})"
        else:
          return f"{arg} ({(_format_constant val)})"
      return (str arg)

    case [OpStyle.VAR]:
      if (< -1 arg (len cpool)):
        define name cpool[arg]
        return f"{arg} ({(repr name)})"
      return (str arg)

    case [OpStyle.FASTVAR]:
      define n_local (if local_names (len local_names) 0)

      if (< arg n_local):
        define name (if local_names local_names[arg] f"local[{arg}]")
        return f"{arg} (local {(repr name)})"

      define idx (- arg n_local)
      if (and closure_names (< -1 idx (len closure_names))):
        return f"{arg} (closure {(repr closure_names[idx])})"
      return (str arg)

    case [OpStyle.LABEL]:
      return f"{arg} (-> {arg})"

    case [OpStyle.CMPCOUNT]:
      define sc (divmod arg 256)
      return f"{arg} ({(_compare_name sc[0])} x{(item sc 1)})"

    case [OpStyle.COUNT
          OpStyle.PAIR_COUNT
          OpStyle.STAR]:

      unless (None? ns_label):
        return f"{arg} ({ns_label})"

  return (str arg)


define _local_and_closure_syms [code]:
  """
  Return (local_syms tuple, closure_syms tuple) from code.namespace_spec.
  Closure syms include both closure_syms and global_syms (all captured refs).
  """

  define nspec code.namespace_spec
  if (None? nspec):
    return #() #()

  else:
    define all_captured #(*: nspec.closure_syms *: nspec.global_syms)
    return nspec.local_syms all_captured


define _resolve_file [file]:
  """
  Resolve output file, defaulting to sys.stdout
  """

  import sys
  or file sys.stdout


define dis [x file: None]:
  """
  Print a disassembly of a Koskari Code or Function object.

  For Function: prints a leading section with function instance details
  (name, formals, base_ns closures), then the disassembly of its code.

  For BoundMethod: prints a bound-method section (__self__), then the
  same function-instance section and code disassembly as for __func__.

  For Code: output includes constant pool (with NamespaceSpec entries
  expanded to show their locals and closures), vars (local_syms from
  namespace_spec), closure refs (closure_syms from namespace_spec),
  and indexed instructions with decoded arguments. FAST_* instructions
  show whether the slot is a local or closure. PUSH_NS and PUSH_CLASS
  instructions are annotated with the namespace ID (ns#K) and name of
  the NamespaceSpec they push.

  :param x: Code, Expression (unwraps to Code), Function, or BoundMethod
  :param file: file-like object to print to (default: stdout)
  """

  define code None
  define out file

  if (instance? x Function):
    set! code x.code
    set! out (_resolve_file out)
    _write_function_instance_section out x

  elif (instance? x BoundMethod):
    define fn (_boundmethod_inner_function x)
    set! code fn.code
    set! out (_resolve_file out)
    _write_bound_method_section out x
    _write_function_instance_section out fn

  else:
    set! code (_get_code x)
    unless code:
      raise (TypeError
          f"expected Code, Expression, Function, or BoundMethod, got {(attr (type x) __name__)}")

  set! out (_resolve_file out)
  define cpool code.constants_pool
  define lcs (_local_and_closure_syms code)
  define local_syms lcs[0]
  define closure_syms lcs[1]
  define ns_const_map (_build_ns_const_map code)

  define name code.name
  define filename code.filename
  define yields code.yields
  out.write f"KosCode {(repr name)}\n"
  out.write f"  filename: {(repr filename)}\n"
  out.write f"  yields: {yields}\n"
  out.write "\n"

  out.write f"Constant pool ({(len cpool)}):\n"
  define i 0
  while (< i (len cpool)):
    define val cpool[i]
    if (instance? val NamespaceSpec):
      _write_nspec_cpool_entry out i val
    else:
      out.write f"""  {i "3d"}: {(_format_constant val)}\n"""
    incr! i
  out.write "\n"

  out.write f"Vars (local_syms, {(len local_syms)}):\n"
  if local_syms:
    define i 0
    while (< i (len local_syms)):
      out.write f"""  {i "3d"}: {(repr local_syms[i])}\n"""
      incr! i
  else:
    out.write "  (none)\n"
  out.write "\n"

  out.write f"Closure refs ({(len closure_syms)}):\n"
  if closure_syms:
    define i 0
    while (< i (len closure_syms)):
      out.write f"""  {i "3d"}: {(repr closure_syms[i])}\n"""
      incr! i
  else:
    out.write "  (none)\n"
  out.write "\n"

  define n (code.length)
  out.write f"Instructions ({n}):\n"
  define i 0
  while (< i n):
    define oparg (code.oparg i)
    define op_int oparg[0]
    define arg oparg[1]
    define op (OpCode op_int)
    define op_style op.style
    define extra_schema op.extra
    define ns_label None

    when (in? i ns_const_map):
      define ns_idx ns_const_map[i]
      set! ns_label (_format_nspec_inline ns_idx cpool[ns_idx])
    (define arg_str
      (_format_arg code op_style arg cpool local_syms closure_syms
                   ns_label: ns_label
                   extra_schema: extra_schema))
    define pos_str ""
    try:
      define pos (code.position i)
      define line pos[0]
      define col pos[1]
      set! pos_str f"  # line {line}, col {col}"
    except [#(IndexError TypeError)]:
      None

    out.write f"""  {i "3d"}  {op.name "24s"} {arg_str}{pos_str}\n"""
    incr! i

  out.write "\n"


define _get_instruction_lines [code]:
  """
  Yield (index, op_name, arg_str) for each instruction (for tests/API)
  """

  define cpool code.constants_pool
  define lcs (_local_and_closure_syms code)
  define local_syms lcs[0]
  define closure_syms lcs[1]
  define ns_const_map (_build_ns_const_map code)
  define n (code.length)

  define i 0
  while (< i n):
    define oparg (code.oparg i)
    define op_int oparg[0]
    define arg oparg[1]
    define op (OpCode op_int)
    define op_style op.style
    define extra_schema op.extra
    define ns_label None

    when (in? i ns_const_map):
      define ns_idx ns_const_map[i]
      set! ns_label (_format_nspec_inline ns_idx cpool[ns_idx])

    define arg_str (_format_arg
      code op_style arg cpool local_syms closure_syms
      ns_label: ns_label
      extra_schema: extra_schema)

    yield i op.name arg_str
    incr! i


;; The end.
