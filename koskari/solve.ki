"""
koskari.solve

Nondeterministic choice on delimited continuations. `amb` picks a value
from a sequence of choices, `require` prunes the current branch, `fail`
abandons it outright, and `solve` / `solve-first` delimit a search and
collect what survives. `amb` is an ordinary function -- a shift whose
handler invokes the continuation once per choice and gathers each
choice's solutions -- so choice points compose across function calls
and nest to any depth: every `(amb ...)` inside another choice's
continuation multiplies the search.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from koskari.exceptions KoskariContinuationError KoskariPromptNotFound


(declare-exports SearchError NoActiveSearch
                 amb fail require solve solve-first)


class SearchError [KoskariContinuationError]:
  """
  Base class for search errors raised by koskari.solve
  """

  pass


class NoActiveSearch [SearchError]:
  """
  amb, fail, or require was called with no enclosing solve or
  solve-first to delimit the search
  """

  pass


; Dynamic stop marker for solve-first
(define-parameter amb-stop-marker None)


; compile/reset and compile/shift delimit with the default prompt tag,
; which a capture failure reports as None. A failure carrying it failed
; against the search delimiter; any other tag belongs to a foreign
; delimiter and is not ours to interpret.
(var search-prompt-tag None)


def amb [choices]:
  """
  Nondeterministically choose a value from choices.

  Captures the continuation up to the enclosing search delimiter and
  invokes it once per choice, collecting each choice's solutions; the
  collected list becomes the search's result at the delimiter. Raises
  NoActiveSearch when no solve or solve-first delimits the call
  """

  try:
    shift k:
      let [[out #[]]]:
        for-each [c choices]:
          when amb-stop-marker:
            break
          out.extend (k c)
        out

  except [e KoskariPromptNotFound]:
    if (is? e.tag search-prompt-tag):
      raise (NoActiveSearch "amb requires an enclosing solve or solve-first")
    else:
      raise


def fail []:
  """
  Abandon the current branch; it contributes no solutions.

  Raises NoActiveSearch when no solve or solve-first delimits the call
  """

  try:
    shift k #()
  except [e KoskariPromptNotFound]:
    if (is? e.tag search-prompt-tag):
      raise (NoActiveSearch "fail requires an enclosing solve or solve-first")
    else:
      raise


def require [test]:
  """
  Prune the current branch unless test is truthy
  """

  unless test (fail)
  test


def solve [thunk]:
  """
  Every solution of thunk, as a list, in choice order
  """

  parameterize [[amb-stop-marker None]]:
    reset:
      #[(thunk)]


def solve-first [thunk]:
  """
  The first solution of thunk, or None when every branch fails.

  Once a solution is accepted the remaining choices at every level are
  skipped; their continuations are never invoked
  """

  var found #[]

  parameterize [[amb-stop-marker found]]:

    ; the shifts are expecting a list wrapping the result.
    reset:
      let [[solution (thunk)]]:
        found.append solution
        #[solution]

  when found found[0]


;; The end.
