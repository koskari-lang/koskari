"""
koskari.itertools

Iterator combinators, native and koskari-written. A source may be a
sync iterable, an async iterable, or a KosIter provider, and a
callable argument runs in the evaluator. Python's itertools drives a
source through tp_iternext and calls a predicate across the Python
boundary, so it takes neither.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from koskari.lib:
  accumulate batched compress cycle dropwhile filterfalse islice
  pairwise starmap takewhile zip-longest


(declare-exports accumulate batched chain compress cycle dropwhile
                 filterfalse islice pairwise starmap takewhile
                 zip-longest)


define chain [*: srcs]:
  """
  Yield every element of each source in turn
  """

  for-each [x srcs]:
    yield-from x


define _takewhile [pred src]:
  """
  Yield elements of src while pred holds; stop at the first that fails,
  leaving the rest of src unconsumed

  Superseded by the native takewhile, kept for comparison
  """

  for-each [x src]:
    unless (pred x):
      return
    yield x


; The end.
