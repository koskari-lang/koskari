"""
koskari.itertools

Iterator combinators written in Koskari. Each is a generator over its
sources, so a source may be a sync iterable, an async iterable, or a
KosIter provider, and a callable argument runs in the evaluator.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


(declare-exports chain takewhile)


define chain [*: srcs]:
  """
  Yield every element of each source in turn
  """

  for-each [x srcs]:
    yield-from x


define takewhile [pred src]:
  """
  Yield elements of src while pred holds; stop at the first that fails,
  leaving the rest of src unconsumed
  """

  for-each [x src]:
    unless (pred x):
      return
    yield x


; The end.
