"""
koskari.help.syntax

Registry help renderer for koskari.syntax.Syntax

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""


import-from ..syntax Syntax
import-from .tools help_for


(declare-exports format_accept_pattern help_for_syntax)


@demand
define format_accept_pattern [pattern head]:
  """
  Render one accepted-arm pattern for help text and SyntaxMatchError
  """

  import-from ..matcher CALLEDBY MATCH

  unless (instance? pattern MATCH):
    try:
      return (repr pattern)
    except [Exception]:
      return "<unrenderable pattern>"

  define children pattern._children

  try:
    if (and children (instance? children[0] CALLEDBY)):
      define h (or head "(CALLEDBY)")

      define reprs (list-each [c (item-slice children 1)] (repr c))
      define rest (" ".join reprs)

      if rest:
        f"({h} {rest})"
      else:
        f"({h})"

    else:
      define reprs (list-each [c children] (repr c))
      define body (" ".join reprs)
      f"({body})"

  except [Exception]:
    "<unrenderable pattern>"


@(help_for Syntax)
define help_for_syntax [obj formatter]:
  """
  Fill formatter with Syntax dispatcher documentation
  """

  define doc (getattr obj "__doc__" None)
  when doc:
    formatter.paragraph doc

  when obj.transforms:
    define acc (formatter.section "Accepts")
    define head (str obj.name)
    for-each [transform obj.transforms]:
      acc.item (format_accept_pattern transform.pattern head)


; The end.
