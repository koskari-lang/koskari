#! /usr/bin/env koskari

;; example.ki -- a Koskari asyncio job scheduler.
;;
;; The definition reads like YAML, but each block is either DATA (a
;; config) or CODE (a job handler). See README.md for the surface, how
;; it lowers to a live JobSet, and how to add a job variety.


import-from datetime datetime
use kosrunner


jobset workload:

    ;; --- CONFIGS: `config <type> [name]:` (data blocks) --------------
    ;; The first config of a type is its default; named ones are opt-in.

    config logging:
        level: "DEBUG"

    ;; First kafka config: unnamed, so it is the default kafka config.
    config kafka:
        servers: "localhost:9092"
        security_protocol: "PLAINTEXT"

    ;; A second kafka config MUST be named; jobs opt into it by name.
    config kafka audit-cluster:
        servers: "audit-1:9092,audit-2:9092"
        security_protocol: "SSL"

    ;; Default UMB config. The bus speaks STOMP over TLS and authenticates
    ;; with an x509 client cert, so the cert files ARE the credentials --
    ;; idiomatically `(reqenv "UMB_CERT")`, the secrets pattern; literal
    ;; here so the example still loads with no environment set.
    config umb:
        servers: "umb-broker01.example.com,umb-broker02.example.com"
        ssl_certfile: "/etc/pki/umb/client.crt"
        ssl_keyfile: "/etc/pki/umb/client.key"
        ssl_cafile: "/etc/pki/umb/ca.crt"

    ;; Default webhook config -- also backs inbound job triggers.
    config webhook:
        port: 8080
        prefix: "/webhook"

    ;; Control-plane server config. Same host:port as the webhook above,
    ;; so admin SHARES that FastAPI server (interned by host:port); only
    ;; the prefix differs. Give it a different port for a standalone server.
    config admin:
        port: 8080
        prefix: "/admin"

    ;; Web UI config -- same host:port again, so it shares that one FastAPI
    ;; server too, mounting human-facing HTML under /ui.
    config ui:
        port: 8080
        prefix: "/ui"


    ;; --- JOBS: `job <type> <name> <trigger...>:` ---------------------
    ;; The header is the constructor; each sub-item is a method call on
    ;; the job (handler/config inherited; on-error is a kafka setter).

    ;; cron trigger-key is the 5 classic fields; the handler takes no
    ;; args, so its formals are the empty bracket `[]`.
    job cron heartbeat [* * * * *]:
        handler []:
            (print f"The time is {(datetime.now)}")

    ;; A disabled job: present, listed, but not started until enabled
    ;; via the control plane (constraint 6 + 7). `disabled:` is a config
    ;; field like any other; with no cron config declared, this block
    ;; builds a fresh default one carrying the flag.
    job cron nightly-report [0 0 * * *]:
        config:
            disabled: True
        handler []:
            (print "running the nightly report")

    ;; A whole handler can be one call into the framework. This one samples
    ;; process memory (see kosrunner/memwatch.ki); each fire logs its
    ;; report into its own run, so the history doubles as the trend.
    ;; `mnemonic` labels the run with the sample's headline numbers, which
    ;; is what makes the history scannable.
    job cron memwatch [*/5 * * * *]:
        handler []:
            (mnemonic (memory-report))

    ;; webhook job on the default webhook config; handler returns the
    ;; response payload.
    job webhook ping:
        handler [payload]:
            (print f"Webhook received: {payload}")
            #{"ok": True "msg": "pong"}

    job webhook echo:
        handler [payload]:
            #{"ok": True "payload": payload}

    ;; The control plane, as a job. No sub-items: it serves from its
    ;; config alone, sharing the webhook's server (same port) and mounting
    ;; GET /admin/jobs, POST /admin/enable/<name>, POST /admin/disable/<name>.
    job admin control

    ;; The web UI, as a job. Reads the JobSet + run store in-process and
    ;; renders a jobs/runs dashboard (with enable/disable/retrigger) at /ui.
    job ui web

    ;; kafka job on the DEFAULT kafka config (unnamed one above),
    ;; refined with `disabled` until a real broker is reachable.
    job kafka orders "topic.orders":
        config:
            disabled: True
        handler [msg]:
            (print f"order: {msg}")

    ;; kafka job showing all three sub-item flavours: the inherited
    ;; `config` (data setter) selecting a named base + overriding a key,
    ;; a kafka-VARIETY `on-error` (code setter), and the inherited
    ;; `handler` (code setter). Order is irrelevant -- they are just
    ;; method calls on the constructed KafkaJob.
    job kafka audit "topic.audit":
        config:
            via: audit-cluster
            group_id: "audit-consumers"
            disabled: True
        on-error [err msg]:
            (print f"audit dropped {msg}: {err}")
        handler [msg]:
            (print f"audit: {msg}")

    ;; umb job on the DEFAULT umb config, disabled until a real bus is
    ;; reachable. The destination is the trigger key, and the sub-items are
    ;; the same three flavours kafka uses. This handler returns None, so
    ;; nothing is published back -- a plain event consumer.
    job umb builds "/topic/VirtualTopic.eng.brew.build.complete":
        config:
            disabled: True
        on-error [err msg]:
            (print f"build event dropped {msg}: {err}")
        handler [msg]:
            (print f"build: {msg}")

    ;; A request/reply umb job: the handler's return value is published to
    ;; the requesting message's `reply-to` -- or to the config's, when the
    ;; requester named none -- carrying the correlation id it matches on.
    job umb status "/queue/kosrunner.status.request":
        config:
            disabled: True
            reply_to: "/queue/kosrunner.status.reply"
        handler [msg]:
            #{"ok": True "asked": msg}


@entry-point
def main []:
    (workload heartbeat: 20 snore: True)


;; The end.
