#! /usr/bin/env koskari


import-from datetime datetime


; this would be a great use of the use-bundle feature, if it
; existed. Just a `use-bundle kosrunner`
import-from kosrunner use-kosrunner
(use-kosrunner)


logging-config:
    level: "DEBUG"


kafka-config default-kafka:
    servers: "localhost:9092"
    security_protocol: "PLAINTEXT"


webhook-config app:
    port: 8080
    prefix: "/webhook"


jobset workload:
    on-cron * * * * *:
        (print f"The time is {(datetime.now)}")

    ; on-kafka default-kafka "topic.test" [msg topic]:
    ;     (print f"Received message: {msg} on topic: {topic}")

    on-webhook app ping [payload]:
        (print f"Webhook received: {payload}")
        #{ok: True msg: "pong"}

    on-webhook app echo [payload]:
        (print f"Webhook received: {payload}")
        #{ok: True payload: payload}


when-main:
    (workload heartbeat: 20 snore: True)


; The end.
