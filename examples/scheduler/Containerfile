FROM python:3.14-alpine as builder

RUN apk add --no-cache \
    gcc musl-dev python3-dev zlib-dev

WORKDIR /wheels

# aiokafka binary wheel isn't available for 3.14 alpine, so
# we build it from the sdist along with the koskrunner
RUN pip wheel \
    --no-cache-dir \
    -w /wheels \
    aiokafka

RUN pip install \
    --root-user-action=ignore \
    --no-cache-dir \
    --disable-pip-version-check \
    uv setuptools

WORKDIR /build
COPY pyproject.toml ./
COPY kosrunner/ ./kosrunner/
RUN uv build . --wheel -o /wheels


FROM koskari:local

ENV TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

COPY --from=builder /wheels/*.whl /wheels/
RUN pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --root-user-action=ignore \
        --find-links=/wheels \
        koskari-kosrunner ; \
    rm -rf /wheels

WORKDIR /job
COPY example.ki ./run.ki

CMD ["run.ki"]


# The end.
