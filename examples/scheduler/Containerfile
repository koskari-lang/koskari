FROM koskari:local as builder

RUN pip install \
        --root-user-action=ignore \
        --no-cache-dir \
        --disable-pip-version-check \
        uv setuptools wheel

WORKDIR /build
COPY setup.cfg pyproject.toml ./
COPY kosrunner/ ./kosrunner/
RUN uv build . --wheel


FROM koskari:local

ENV TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

COPY --from=builder /build/dist/*.whl /build/
RUN pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --root-user-action=ignore \
        --find-links=/build \
        koskari-kosrunner ; \
    rm -rf /build

WORKDIR /job
COPY example.ki ./run.ki

CMD ["run.ki"]

# The end.
