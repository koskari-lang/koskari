# kosrunner example -- test runner.
#
# Tests run under a tox-driven venv (see tox.ini): koskari is installed
# editable from the repo root and the example's own deps come with it. The
# example carries heavy runtime deps the repo's own tox env does not, so it
# has its own; this is the seed of the standalone suite the example gains
# at fork time.

.PHONY: test
test:
	tox

# The end.
