;; Memory sampling as a job handler. The report is only useful if it
;; reaches the run history, so the check that matters is the round trip:
;; fire a tracked run whose handler is `memory-report`, then read the
;; sample back out of that run's captured output.

import logging

import-from .harness SchedulerAsyncTestCase
import-from kosrunner CronJob memory-census memory-report vmrss


class TestMemwatch [SchedulerAsyncTestCase]:

    @coroutine-fn
    def test-vmrss-is-a-positive-size [self]:
        ;; None off Linux; a real reading is KiB, so smaller than the
        ;; RSS of any live CPython would be a misparse
        var rss (vmrss)
        unless (None? rss):
            (self.assertGreater rss 1000)


    @coroutine-fn
    def test-census-counts-live-objects-by-type [self]:
        var [collected counts] (memory-census)
        (self.assertGreaterEqual collected 0)
        ;; the census is taken from inside a test case, so the case
        ;; itself is among the objects it counts
        (self.assertGreater (counts.get "TestMemwatch" 0) 0)


    @coroutine-fn
    def test-report-lands-in-the-run-history [self]:
        var js (self.jobset-with-store)
        var job (CronJob "*/5 * * * *")
        (job.configure)
        (job.handler (lambda [] (memory-report)))
        (js.register "memwatch" job)

        ;; capture only sees records the logger actually emits, and no
        ;; `config logging:` has run here to lower the level
        var lg (logging.getLogger "kosrunner")
        var was lg.level
        (lg.setLevel logging.INFO)
        (self.addCleanup (demand (lambda [] (lg.setLevel was))))

        (job.run cause: "schedule")
        (job.run cause: "schedule")

        var runs (js.store.list-runs job: "memwatch")
        (self.assertEqual (len runs) 2)

        var detail (js.store.run-detail (item (item runs 0) "run_id"))
        (self.assertEqual (item detail "status") "success")
        var output (item detail "output")
        (self.assertIn "rss=" output)
        (self.assertIn "blocks=" output)
        ;; the second sample has a baseline to measure against, so it
        ;; carries per-type drift lines the first one cannot
        (self.assertIn "sample=2" output)
        (self.assertIn "last " output)
        (self.assertIn "first +" output)


;; The end.
