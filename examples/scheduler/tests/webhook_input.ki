;; R3: webhook input parameters. A handler's typed formals ARE its input
;; spec: the POSTed JSON is validated and coerced against them and bound
;; as named args; unknown keys, missing required keys, and uncoercible
;; values are a 400. An untyped handler takes the raw payload as before.
;; The coerced kwargs land in trigger.json, so retrigger replays them.

import-from .harness SchedulerAsyncTestCase
import-from kosrunner HttpServer


define-class TestWebhookInput [SchedulerAsyncTestCase]:

    @coroutine-fn
    define asyncSetUp [self]:
        set! self.server (HttpServer "127.0.0.1" 8080)
        set! self.http (self.http-client self.server)


    @coroutine-fn
    define test-typed-input-binds-and-coerces [self]:
        (self.webhook self.server "deploy"
            (lambda [[ref :: str] [count :: int]] #{"ref": ref "count": count}))
        define resp (self.http.post "/webhook/deploy"
            json: #{"ref": "main" "count": "5"})
        (self.assertEqual resp.status_code 200)
        define body (resp.json)
        (self.assertEqual (item body "ref") "main")
        (self.assertEqual (item body "count") 5)


    @coroutine-fn
    define test-optional-default-applied [self]:
        (self.webhook self.server "deploy"
            (lambda [[ref :: str] [force :: bool value: False]]
                #{"ref": ref "force": force}))
        define resp (self.http.post "/webhook/deploy" json: #{"ref": "main"})
        (self.assertEqual resp.status_code 200)
        (self.assertEqual (item (resp.json) "force") False)


    @coroutine-fn
    define test-missing-required-is-400 [self]:
        (self.webhook self.server "deploy"
            (lambda [[ref :: str]] #{"ref": ref}))
        define resp (self.http.post "/webhook/deploy" json: #{})
        (self.assertEqual resp.status_code 400)


    @coroutine-fn
    define test-unknown-key-is-400 [self]:
        (self.webhook self.server "deploy"
            (lambda [[ref :: str]] #{"ref": ref}))
        define resp (self.http.post "/webhook/deploy"
            json: #{"ref": "main" "bogus": 1})
        (self.assertEqual resp.status_code 400)


    @coroutine-fn
    define test-uncoercible-value-is-400 [self]:
        (self.webhook self.server "deploy"
            (lambda [[count :: int]] #{"count": count}))
        define resp (self.http.post "/webhook/deploy" json: #{"count": "abc"})
        (self.assertEqual resp.status_code 400)


    @coroutine-fn
    define test-untyped-handler-passes-raw-payload [self]:
        (self.webhook self.server "echo"
            (lambda [payload] #{"got": payload}))
        define resp (self.http.post "/webhook/echo" json: #{"any": "shape"})
        (self.assertEqual resp.status_code 200)
        (self.assertEqual (item (resp.json) "got") #{"any": "shape"})


    @coroutine-fn
    define test-retrigger-replays-kwargs [self]:
        set! self.js (self.jobset-with-store)
        define seen #[]

        define handler [[ref :: str]]:
            (seen.append ref)
            #{"ok": True}

        (self.webhook self.server "deploy" handler jobset: self.js)
        define resp (self.http.post "/webhook/deploy" json: #{"ref": "v1.2"})
        (self.assertEqual resp.status_code 200)
        (self.assertEqual seen #["v1.2"])

        define runs (self.js.store.list-runs)
        (self.assertEqual (len runs) 1)
        define runid (item (item runs 0) "run_id")

        ;; the coerced kwargs were persisted with the trigger
        define trig (self.js.store.get-trigger runid)
        (self.assertEqual (item trig "kwargs") #{"ref": "v1.2"})

        ;; and replay feeds them back through the same named channel
        define out (self.js.retrigger runid)
        (self.assertTrue (item out "ok"))
        (self.assertEqual seen #["v1.2" "v1.2"])
        (self.assertEqual (len (self.js.store.list-runs)) 2)


;; The end.
