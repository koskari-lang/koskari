;; Registry keys and display names come from the names a definition
;; writes. A macro whose template writes a jobset, a job, or a group
;; still registers them under those names, not their hygienic
;; spellings; and a config entry with no settings is the unnamed case.

import-from unittest TestCase
import-all-from kosrunner


syntax template-jobset:
    syntax-rules []:
        case (template-jobset getter):
            (begin
                (jobset ws (job fake j1))
                (def getter [] ws))


syntax template-group:
    syntax-rules []:
        case (template-group getter):
            (begin
                (group admins "root@example.com")
                (def getter [] admins))


(template-jobset get-ws)
(template-group get-admins)

(jobset bare-config-ws
    (config fake)
    (job fake j2))


define-class TestJobsetLabels [TestCase]:

    def test-template-job-registers-by-written-name [self]:
        (self.assertEqual (list (attr (get-ws) jobs)) #["j1"])


    def test-template-jobset-is-named-as-written [self]:
        (self.assertEqual (attr (get-ws) name) "ws")


    def test-template-group-is-named-as-written [self]:
        (self.assertEqual (attr (get-admins) name) "admins")


    def test-empty-config-entry [self]:
        (self.assertEqual (list bare-config-ws.jobs) #["j2"])


;; The end.
