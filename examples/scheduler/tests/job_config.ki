;; Config construction and the disabled field. A `config:` with no base
;; builds a fresh instance of the job's config-class (raw Config on the
;; base Job); `disabled` lives on the base Config, so any config --
;; including a shared or named one -- can declare its jobs dormant, and
;; a per-job override wins by ordinary merge.

import-from .harness SchedulerAsyncTestCase
import-from kosrunner Config Job KafkaConfig KafkaJob WebhookConfig WebhookJob


class TestJobConfig [SchedulerAsyncTestCase]:

    @coroutine-fn
    def test-baseless-configure-builds-fresh-config [self]:
        var job (WebhookJob "hook")
        (job.configure port: 9999)
        (self.assertIsInstance job.config WebhookConfig)
        (self.assertEqual job.config.port 9999)
        ;; untouched fields keep their dataclass defaults
        (self.assertEqual job.config.prefix "")
        (self.assertTrue job.enabled)


    @coroutine-fn
    def test-base-job-falls-back-to-raw-config [self]:
        var job (Job)
        (job.configure)
        (self.assertIsInstance job.config Config)
        (self.assertFalse job.config.disabled)


    @coroutine-fn
    def test-disabled-config-disables-job [self]:
        var job (WebhookJob "hook")
        (job.configure disabled: True)
        (self.assertFalse job.enabled)


    @coroutine-fn
    def test-shared-disabled-config-and-override [self]:
        ;; a shared config carrying disabled dims every job wired to it...
        var shared (KafkaConfig servers: "k:9092" disabled: True)
        var a (KafkaJob "topic.a")
        var b (KafkaJob "topic.b")
        (a.configure via: shared)
        (b.configure via: shared)
        (self.assertFalse a.enabled)
        (self.assertFalse b.enabled)
        ;; ...and a per-job override wins by ordinary merge
        var c (KafkaJob "topic.c")
        (c.configure via: shared disabled: False)
        (self.assertTrue c.enabled)
        (self.assertEqual c.config.servers "k:9092")


;; The end.
