;; Async unittest harness for the kosrunner example, authored in koskari.
;; Because these run through koskari's ambient auto-await, calls read
;; naturally -- dashed method names, no getattr, no explicit await -- which
;; is the whole reason to write the tests in koskari. They must run under
;; `python -m unittest` (which owns the loop); the koskari CLI cannot host
;; IsolatedAsyncioTestCase, as its ambient loop collides with the runner's.

import asyncio
import tempfile

import httpx

import-from unittest IsolatedAsyncioTestCase

import-from kosrunner:
    RunStore JobSet StorageConfig WebhookJob WebhookConfig


define-class SchedulerAsyncTestCase [IsolatedAsyncioTestCase]:
    """
    Base for tests exercising kosrunner through its live async surface: a
    temp-dir store, an ASGI HTTP client, and a one-call webhook builder.
    """

    def temp-store [self]:
        """
        A RunStore rooted at a fresh temp dir, opened for the test and
        closed on teardown.
        """

        var tmp (tempfile.TemporaryDirectory)
        (self.addCleanup tmp.cleanup)
        var store (RunStore tmp.name)
        (store.open)
        ;; coroutine-fn: addAsyncCleanup only awaits native coroutine
        ;; functions; a bare koskari method would be called and its
        ;; coroutine dropped unawaited, leaving the DB thread alive
        (self.addAsyncCleanup (coroutine-fn store.close))
        store


    def jobset-with-store [self]:
        """
        A JobSet whose RunStore is rooted at a fresh temp dir (via the same
        bind-store path production uses, seeded with an explicit root),
        opened for the test and closed on teardown.
        """

        var tmp (tempfile.TemporaryDirectory)
        (self.addCleanup tmp.cleanup)
        var js (JobSet "test")
        (js.bind-store (StorageConfig root: tmp.name))
        (js.store.open)
        (self.addAsyncCleanup (coroutine-fn js.store.close))
        js


    def http-client [self server]:
        """
        An httpx.AsyncClient wired to `server.app` over ASGITransport (no
        live uvicorn), closed on teardown.
        """

        var transport (httpx.ASGITransport app: server.app)
        var client (httpx.AsyncClient transport: transport base_url: "http://test")
        (self.addAsyncCleanup client.aclose)
        client


    def webhook [self server route handler jobset: None prefix: "/webhook" **: config]:
        """
        Build a WebhookJob, wire its config and handler, optionally register
        it on `jobset` (so its runs are tracked and async replies have a
        store), mount it on `server`, and return it. `config` keywords
        (token, wait, ...) seed its WebhookConfig.

        Mounts both routes `start` does -- the POST door and the run
        read-back one segment deeper -- so a test sees the same surface a
        live webhook serves.
        """

        var job (WebhookJob route)
        var base (WebhookConfig prefix: prefix **: config)
        (job.configure via: base)
        (job.handler handler)
        unless (None? jobset):
            (jobset.register route job)
        (server.add-route prefix route job.dispatch)
        (server.add-detail prefix route job.read-run)
        job


;; The end.
