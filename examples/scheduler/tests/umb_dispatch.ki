;; The umb variety over stompman's real client, against an in-memory
;; broker (tests/fakebroker.py): a delivered message becomes a tracked run
;; and the handler's return value becomes a reply frame carrying the
;; correlation id. This exercises the whole path -- handshake, SUBSCRIBE,
;; the awaited handler callback, ACK, SEND -- with no socket.

import-from stompman.frames:
    AckFrame SendFrame SubscribeFrame UnsubscribeFrame

import-from .fakebroker FakeBroker
import-from .harness SchedulerAsyncTestCase
import-from kosrunner UmbConfig UmbJob


var DESTINATION "/topic/VirtualTopic.eng.test"


define-class UmbDispatchTestCase [SchedulerAsyncTestCase]:
    """
    Base for the dispatch tests: one call builds a started UmbJob talking
    to a fake broker, registered on a jobset with a temp-dir store so its
    runs are tracked, and stopped on teardown.
    """

    def umb-job [self handler **: config]:
        var broker (FakeBroker)
        var js (self.jobset-with-store)
        var job (UmbJob DESTINATION)
        (job.configure via: (UmbConfig
            servers: "bus.example.com"
            connection_class: broker.connection_class
            **: config))
        (job.handler handler)
        (js.register "umbtest" job)
        (job.start)
        ;; coroutine-fn: addAsyncCleanup only awaits native coroutine
        ;; functions, and stop must run before the loop closes under the
        ;; client's task group
        (self.addAsyncCleanup (coroutine-fn job.stop))
        (values job broker)


define-class TestUmbSubscription [UmbDispatchTestCase]:

    @coroutine-fn
    def test-start-subscribes-to-the-destination [self]:
        var [job broker] (self.umb-job (lambda [msg] None))
        var frames (broker.wait_for_frame SubscribeFrame)
        var sub (item frames 0)
        var headers sub.headers
        (self.assertEqual (item headers "destination") DESTINATION)
        (self.assertEqual (item headers "ack") "client-individual")
        (self.assertTrue job.running)


    @coroutine-fn
    def test-subscribe-headers-ride-along [self]:
        var [job broker] (self.umb-job (lambda [msg] None)
            subscribe_headers: #{"selector": "type = 'build'"})
        var frames (broker.wait_for_frame SubscribeFrame)
        var sub (item frames 0)
        (self.assertEqual (item sub.headers "selector") "type = 'build'")


    @coroutine-fn
    def test-stop-unsubscribes [self]:
        var [job broker] (self.umb-job (lambda [msg] None))
        (broker.wait_for_frame SubscribeFrame)
        (job.stop)
        (self.assertFalse job.running)
        (self.assertEqual (len (broker.frames_of UnsubscribeFrame)) 1)


define-class TestUmbDispatch [UmbDispatchTestCase]:

    @coroutine-fn
    def test-message-body-reaches-the-handler [self]:
        var seen #[]
        def handler [msg]:
            (seen.append msg)
            None

        var [job broker] (self.umb-job handler)
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"hello")
        (broker.wait_for_frame AckFrame)
        (self.assertEqual seen #["hello"])


    @coroutine-fn
    def test-run-is-tracked-with-umb-cause [self]:
        var [job broker] (self.umb-job (lambda [msg] None))
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"hello")
        (broker.wait_for_frame AckFrame)

        var runs (job.jobset.store.list-runs job: "umbtest")
        (self.assertEqual (len runs) 1)
        var run (item runs 0)
        (self.assertEqual (item run "cause") "umb")
        (self.assertEqual (item run "status") "success")


define-class TestUmbReply [UmbDispatchTestCase]:

    @coroutine-fn
    def test-return-value-replies-to-the-reply-to-header [self]:
        def handler [msg]:
            #{"echo": msg}

        var [job broker] (self.umb-job handler)
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping"
            headers: #{"reply-to": "/queue/replies"})

        var frames (broker.wait_for_frame SendFrame)
        var sent (item frames 0)
        (self.assertEqual (item sent.headers "destination") "/queue/replies")
        (self.assertEqual (item sent.headers "content-type") "application/json")
        (self.assertEqual sent.body b"{\"echo\": \"ping\"}")


    @coroutine-fn
    def test-reply-echoes-the-requesters-correlation-id [self]:
        var [job broker] (self.umb-job (lambda [msg] "pong"))
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping"
            headers: #{"reply-to": "/queue/replies"
                       "correlation-id": "corr-7"})

        var frames (broker.wait_for_frame SendFrame)
        var sent (item frames 0)
        (self.assertEqual (item sent.headers "correlation-id") "corr-7")
        ;; a plain str reply rides as utf-8 with no declared content type
        (self.assertEqual sent.body b"pong")
        (self.assertNotIn "content-type" sent.headers)


    @coroutine-fn
    def test-reply-falls-back-to-the-message-id [self]:
        ;; a requester that sent no correlation id waits on its message id
        var [job broker] (self.umb-job (lambda [msg] "pong"))
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping"
            message_id: "msg-42"
            headers: #{"reply-to": "/queue/replies"})

        var frames (broker.wait_for_frame SendFrame)
        var sent (item frames 0)
        (self.assertEqual (item sent.headers "correlation-id") "msg-42")


    @coroutine-fn
    def test-config-reply-to-answers-a-message-carrying-none [self]:
        var [job broker] (self.umb-job (lambda [msg] "pong")
            reply_to: "/queue/default-replies")
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping")

        var frames (broker.wait_for_frame SendFrame)
        var sent (item frames 0)
        (self.assertEqual (item sent.headers "destination")
            "/queue/default-replies")


    @coroutine-fn
    def test-none-return-sends-nothing [self]:
        var [job broker] (self.umb-job (lambda [msg] None))
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping"
            headers: #{"reply-to": "/queue/replies"})
        ;; the ack proves the message was fully handled, so an absent SEND
        ;; is a decision and not a race
        (broker.wait_for_frame AckFrame)
        (self.assertEqual (len (broker.frames_of SendFrame)) 0)


    @coroutine-fn
    def test-no-destination-anywhere-drops-the-reply [self]:
        var [job broker] (self.umb-job (lambda [msg] "pong"))
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping")
        (broker.wait_for_frame AckFrame)
        (self.assertEqual (len (broker.frames_of SendFrame)) 0)


    @coroutine-fn
    def test-failed-handler-fires-on-error-and-does-not-reply [self]:
        var errs #[]
        def handler [msg]:
            raise (RuntimeError "boom")

        var [job broker] (self.umb-job handler)
        (job.on-error (lambda [err msg] (errs.append err)))
        (broker.wait_for_frame SubscribeFrame)
        (broker.deliver job._subscription.id b"ping"
            headers: #{"reply-to": "/queue/replies"})
        (broker.wait_for_frame AckFrame)

        (self.assertEqual (len errs) 1)
        (self.assertIsInstance (item errs 0) RuntimeError)
        (self.assertEqual (len (broker.frames_of SendFrame)) 0)

        var runs (job.jobset.store.list-runs job: "umbtest")
        var run (item runs 0)
        (self.assertEqual (item run "status") "failed")


;; The end.
