;; R1: the webhook token guard. A webhook with a configured token demands
;; it in the X-Kosrunner-Token header (missing or wrong -> 401); a
;; token-less webhook stays open.
;;
;; The methods unittest calls directly -- asyncSetUp and each test -- are
;; decorated @coroutine-fn so they present as native coroutine functions
;; (koskari.asyncio wraps them in an `async def`); unittest asserts that of
;; asyncSetUp and would warn on a plain koskari method's return value. The
;; harness helpers stay bare: they are called koskari-to-koskari and just
;; auto-await in place.

import-from .harness SchedulerAsyncTestCase
import-from kosrunner HttpServer


class TestWebhookToken [SchedulerAsyncTestCase]:

    @coroutine-fn
    def asyncSetUp [self]:
        set! self.server (HttpServer "127.0.0.1" 8080)
        set! self.http (self.http-client self.server)


    @coroutine-fn
    def test-correct-token-runs-and-returns-result [self]:
        (self.webhook self.server "ping"
            (lambda [payload] #{"ok": True "echo": payload})
            token: "sekret")
        var resp (self.http.post "/webhook/ping"
            json: #{"a": 1}
            headers: #{"X-Kosrunner-Token": "sekret"})
        (self.assertEqual resp.status_code 200)
        (self.assertEqual (item (resp.json) "echo") #{"a": 1})


    @coroutine-fn
    def test-wrong-token-is-rejected [self]:
        (self.webhook self.server "ping"
            (lambda [payload] #{"ok": True})
            token: "sekret")
        var resp (self.http.post "/webhook/ping"
            json: #{"a": 1}
            headers: #{"X-Kosrunner-Token": "nope"})
        (self.assertEqual resp.status_code 401)


    @coroutine-fn
    def test-missing-token-is-rejected [self]:
        (self.webhook self.server "ping"
            (lambda [payload] #{"ok": True})
            token: "sekret")
        var resp (self.http.post "/webhook/ping" json: #{"a": 1})
        (self.assertEqual resp.status_code 401)


    @coroutine-fn
    def test-open-webhook-stays-open [self]:
        (self.webhook self.server "echo"
            (lambda [payload] #{"ok": True}))
        var resp (self.http.post "/webhook/echo" json: #{})
        (self.assertEqual resp.status_code 200)


;; The end.
