;; Run mnemonics: an optional, non-unique label a handler hangs on its
;; OWN run, so the job history reads as text rather than as run ids. The
;; contextvar holds a mutable cell precisely because a `.set` performed
;; inside the handler would not carry back out to the invoke that has to
;; read it, which is the same reason log capture appends to a buffer.

import asyncio
import sqlite3
import tempfile

import-from pathlib Path

import-from .harness SchedulerAsyncTestCase
import-from kosrunner CronJob RunStore clean-mnemonic mnemonic
import-from kosrunner.ui stamp


class TestCleanMnemonic [SchedulerAsyncTestCase]:

    @coroutine-fn
    def test-collapses-to-one-line [self]:
        (self.assertEqual (clean-mnemonic "  DOC-1234 \n  reindexed\t ")
            "DOC-1234 reindexed")


    @coroutine-fn
    def test-empty-is-no-mnemonic [self]:
        (self.assertIsNone (clean-mnemonic None))
        (self.assertIsNone (clean-mnemonic "   \n "))


    @coroutine-fn
    def test-long-text-is-capped [self]:
        var long (* "x" 500)
        var got (clean-mnemonic long)
        (self.assertEqual (len got) 200)
        (self.assertTrue (got.endswith "..."))


    @coroutine-fn
    def test-outside-a-run-is-a-noop [self]:
        ;; a handler stays callable directly, in a test or a REPL
        (self.assertEqual (mnemonic "loose") "loose")


class TestRunMnemonic [SchedulerAsyncTestCase]:

    def job-firing [self js handler]:
        var job (CronJob "* * * * *")
        (job.configure)
        (job.handler handler)
        (js.register "labelled" job)
        job


    @coroutine-fn
    def test-handler-labels-its-own-run [self]:
        var js (self.jobset-with-store)
        var job (self.job-firing js (lambda [] (mnemonic "DOC-1234 reindexed")))
        (job.run cause: "schedule")

        var row (item (js.store.list-runs job: "labelled") 0)
        (self.assertEqual (item row "mnemonic") "DOC-1234 reindexed")


    @coroutine-fn
    def test-unlabelled-run-has-none [self]:
        var js (self.jobset-with-store)
        var job (self.job-firing js (lambda [] 1))
        (job.run cause: "schedule")

        var row (item (js.store.list-runs job: "labelled") 0)
        (self.assertIsNone (item row "mnemonic"))


    @coroutine-fn
    def test-last-call-wins [self]:
        var js (self.jobset-with-store)
        def twice []:
            (mnemonic "provisional")
            (mnemonic "final")
        var job (self.job-firing js twice)
        (job.run cause: "schedule")

        var row (item (js.store.list-runs job: "labelled") 0)
        (self.assertEqual (item row "mnemonic") "final")


    @coroutine-fn
    def test-failed-run-keeps-its-label [self]:
        var js (self.jobset-with-store)
        def boom []:
            (mnemonic "DOC-1234 reindexed")
            raise (RuntimeError "no")
        var job (self.job-firing js boom)
        (job.run cause: "schedule")

        ;; the label is worth the most on the run that failed
        var row (item (js.store.list-runs job: "labelled") 0)
        (self.assertEqual (item row "status") "failed")
        (self.assertEqual (item row "mnemonic") "DOC-1234 reindexed")


    @coroutine-fn
    def test-concurrent-runs-keep-their-own [self]:
        var js (self.jobset-with-store)
        var job (CronJob "* * * * *")
        (job.configure)
        (job.handler (lambda [tag] (mnemonic tag)))
        (js.register "labelled" job)

        ;; both runs are in flight together, so each must read the cell
        ;; its own invoke put in context
        (job.run "first" cause: "schedule" wait: False)
        (job.run "second" cause: "schedule" wait: False)
        (await (asyncio.gather *: (list js._inflight) return_exceptions: True))

        var got (set (list-each [r (js.store.list-runs job: "labelled")]
            (item r "mnemonic")))
        (self.assertEqual got (set #["first" "second"]))


    @coroutine-fn
    def test-retrigger-does-not-inherit [self]:
        var js (self.jobset-with-store)
        var labels (iter #["original" "replay"])
        var job (self.job-firing js (lambda [] (mnemonic (next labels))))
        (job.run cause: "schedule")

        var first (item (js.store.list-runs job: "labelled") 0)
        (js.retrigger (item first "run_id"))

        ;; the replay computes its own label rather than carrying the
        ;; original's over -- a mnemonic belongs to the run, not the trigger
        var rows (js.store.list-runs job: "labelled")
        (self.assertEqual (len rows) 2)
        (self.assertEqual (item (item rows 0) "mnemonic") "replay")
        (self.assertEqual (item (item rows 1) "mnemonic") "original")


class TestStoreMigration [SchedulerAsyncTestCase]:

    @coroutine-fn
    def test-open-adds-the-column-to-an-older-store [self]:
        var tmp (tempfile.TemporaryDirectory)
        (self.addCleanup tmp.cleanup)
        var root (Path tmp.name)
        (.mkdir (root.joinpath "runs") parents: True exist_ok: True)

        ;; a store as an earlier version left it: the runs table without
        ;; the column, carrying a row that has to survive the upgrade
        var path (str (root.joinpath "index.db"))
        var con (sqlite3.connect path)
        (con.execute (#str
            "CREATE TABLE runs (run_id TEXT PRIMARY KEY, job TEXT NOT NULL,"
            " job_dir TEXT NOT NULL, type TEXT NOT NULL, cause TEXT NOT NULL,"
            " parent TEXT, status TEXT NOT NULL, started_at TEXT NOT NULL,"
            " finished_at TEXT, error TEXT)"))
        (con.execute (#str
            "INSERT INTO runs (run_id, job, job_dir, type, cause, status,"
            " started_at) VALUES ('old-1', 'j', 'j', 'cron', 'schedule',"
            " 'success', '2026-01-01T00:00:00+00:00')"))
        (con.commit)
        (con.close)

        var store (RunStore (str root))
        (store.open)
        (self.addAsyncCleanup (coroutine-fn store.close))

        var row (store.get-run "old-1")
        (self.assertIsNone (item row "mnemonic"))
        (self.assertEqual (item row "status") "success")


class TestStamp [SchedulerAsyncTestCase]:

    @coroutine-fn
    def test-drops-fraction-and-offset [self]:
        (self.assertEqual (stamp "2026-08-05T11:35:00.123456+00:00")
            "2026-08-05 11:35:00")


    @coroutine-fn
    def test-missing-renders-empty [self]:
        (self.assertEqual (stamp None) "")


;; The end.
