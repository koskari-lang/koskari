;; The webhook run read-back: `GET {prefix}/{route}/{runid}`, the other
;; half of an async webhook's `{run_id, status}` receipt. It lives on the
;; webhook's own door -- same prefix, same token -- so a caller trusted to
;; fire a job can follow its run without being sent to the control plane,
;; whose run surface is the anonymous floor over every job's history.
;;
;; The scoping is the security claim: a run of another job reads as a 404
;; exactly like an unknown id, so the route never confirms that someone
;; else's run exists.

import asyncio
import logging

import-from .harness SchedulerAsyncTestCase
import-from kosrunner HttpServer


define TOKEN "s3cret"


define-class WebhookReadbackTestCase [SchedulerAsyncTestCase]:

    @coroutine-fn
    define asyncSetUp [self]:
        define lg (logging.getLogger "kosrunner")
        (lg.setLevel logging.DEBUG)
        set! self.server (HttpServer "127.0.0.1" 8080)
        set! self.http (self.http-client self.server)
        set! self.js (self.jobset-with-store)


define-class TestWebhookReadback [WebhookReadbackTestCase]:

    @coroutine-fn
    define test-receipt-run-id-is-readable-through-the-webhook-door [self]:
        define gate (asyncio.Event)

        define handler [payload]:
            define lg (logging.getLogger "kosrunner.test")
            (lg.info "working on %s" payload)
            (gate.wait)
            #{"done": True}

        (self.webhook self.server "slow" handler jobset: self.js wait: False)

        define resp (self.http.post "/webhook/slow" json: #{"n": 7})
        define runid (item (resp.json) "run_id")

        ;; still parked on the gate: the read-back sees it open
        define open-resp (self.http.get f"/webhook/slow/{runid}")
        (self.assertEqual open-resp.status_code 200)
        (self.assertEqual (item (open-resp.json) "status") "running")

        (gate.set)
        (await (asyncio.gather *: (list self.js._inflight)))

        ;; and closed, with the run's own result and captured output
        define done-resp (self.http.get f"/webhook/slow/{runid}")
        define body (done-resp.json)
        (self.assertEqual (item body "status") "success")
        ;; the stored result artifact wraps the handler's value, the same
        ;; shape /admin/runs/{id} serves
        (self.assertEqual (item (item body "result") "result") #{"done": True})
        (self.assertIn "working on" (item body "output"))


    @coroutine-fn
    define test-unknown-run-id-is-404 [self]:
        (self.webhook self.server "ping" (lambda [payload] None)
            jobset: self.js)
        define resp (self.http.get "/webhook/ping/no-such-run")
        (self.assertEqual resp.status_code 404)


    @coroutine-fn
    define test-another-jobs-run-is-404 [self]:
        (self.webhook self.server "ping" (lambda [payload] #{"ok": True})
            jobset: self.js)
        (self.webhook self.server "other" (lambda [payload] #{"ok": True})
            jobset: self.js)

        ;; fire `other`, then try to read its run through `ping`'s door
        (self.http.post "/webhook/other" json: #{})
        define runs (self.js.store.list-runs job: "other")
        define runid (item (item runs 0) "run_id")

        define mine (self.http.get f"/webhook/other/{runid}")
        (self.assertEqual mine.status_code 200)

        define theirs (self.http.get f"/webhook/ping/{runid}")
        (self.assertEqual theirs.status_code 404)


define-class TestWebhookReadbackToken [WebhookReadbackTestCase]:
    """
    The read-back takes the same machine-door token the POST takes: a
    webhook whose fire is guarded must not have an unguarded reader.
    """

    @coroutine-fn
    define fire [self]:
        (self.webhook self.server "guarded" (lambda [payload] #{"ok": True})
            jobset: self.js token: TOKEN)
        define resp (self.http.post "/webhook/guarded" json: #{}
            headers: #{"X-Kosrunner-Token": TOKEN})
        (self.assertEqual resp.status_code 200)
        define runs (self.js.store.list-runs job: "guarded")
        (item (item runs 0) "run_id")


    @coroutine-fn
    define test-read-back-with-the-token-succeeds [self]:
        define runid (self.fire)
        define resp (self.http.get f"/webhook/guarded/{runid}"
            headers: #{"X-Kosrunner-Token": TOKEN})
        (self.assertEqual resp.status_code 200)
        (self.assertEqual (item (resp.json) "status") "success")


    @coroutine-fn
    define test-read-back-without-a-token-is-401 [self]:
        define runid (self.fire)
        define resp (self.http.get f"/webhook/guarded/{runid}")
        (self.assertEqual resp.status_code 401)


    @coroutine-fn
    define test-read-back-with-a-wrong-token-is-401 [self]:
        define runid (self.fire)
        define resp (self.http.get f"/webhook/guarded/{runid}"
            headers: #{"X-Kosrunner-Token": "nope"})
        (self.assertEqual resp.status_code 401)


;; The end.
