import logging

import-from .job Config


define logger (logging.getLogger "kosrunner.server")


define-dataclass ServerConfig [Config]:
    """
    Shared shape for HTTP-server-backed configs (webhook, admin). The
    server is interned by host:port, so two of these sharing a port share
    one server; each mounts under its own prefix.
    """

    define [host :: str] "0.0.0.0"
    define [port :: int] 8080
    define [prefix :: str] ""


define-class RequestContext []:
    """
    The request-context seam (Phase 5). A route handler sees only what it
    needs off the raw Request -- headers now, resolved identity later (R4/
    R5) -- never the Request itself. Born in R1 so the webhook token guard
    can read its header; the intent is to widen it downstream (hang the
    caller's identity here) without reaching into every route again.
    """

    define __init__ [self request]:
        set! self.headers request.headers

    define header [self name default: None]:
        """
        Look up a request header (case-insensitive, via FastAPI's Headers),
        returning `default` when it is absent.
        """

        (self.headers.get name default)


define-class HttpServer []:
    """
    A shared FastAPI/uvicorn server. It is interned by host:port (see
    get-server), so any jobs that resolve to the same host:port -- webhook
    routes and the admin control plane, say -- mount on ONE server, each
    under its own prefix. The prefix lives on the route, not the server.
    """

    define __init__ [self host port]:
        import fastapi
        set! self.host host
        set! self.port port
        set! self.app (fastapi.FastAPI)
        set! self._server None
        set! self._serve_task None


    define add-route [self prefix name handler]:
        """
        POST {prefix}/{name}; the parsed JSON body and a RequestContext
        are passed to handler. An HTTPException the handler raises (e.g. a
        token guard's 401) is let through as the real HTTP error; any other
        failure is logged and swallowed, since a handler bug should not tear
        the door off its hinges.
        """

        import-from fastapi HTTPException Request
        define path f"{prefix}/{name}"
        (logger.info "route POST %s" path)
        define app self.app

        @(app.post path)
        @coroutine-fn
        define inner [[request :: Request]]:
            define ctx (RequestContext request)
            try:
                define payload (request.json)
                (handler payload ctx)
            except [HTTPException]:
                (raise)
            except [Exception]:
                (logger.error "route failed: %s" path exc_info: True)


    define add-listing [self prefix name handler]:
        """
        GET {prefix}/{name}; handler takes a RequestContext and returns
        data
        """

        import-from fastapi Request
        define path f"{prefix}/{name}"
        (logger.info "route GET %s" path)
        define app self.app

        @(app.get path)
        @coroutine-fn
        define inner [[request :: Request]]:
            (handler (RequestContext request))


    define add-action [self prefix name handler]:
        """
        POST {prefix}/{name}/{item}; the path item and a RequestContext
        are passed to handler
        """

        import-from fastapi Request
        define path f"{prefix}/{name}/{{item}}"
        (logger.info "route POST %s" path)
        define app self.app

        @(app.post path)
        @coroutine-fn
        define inner [item [request :: Request]]:
            (handler item (RequestContext request))


    define add-detail [self prefix name handler]:
        """
        GET {prefix}/{name}/{item}; the path item and a RequestContext are
        passed to handler, which returns the item's data (or None -> null
        for a miss)
        """

        import-from fastapi Request
        define path f"{prefix}/{name}/{{item}}"
        (logger.info "route GET %s" path)
        define app self.app

        @(app.get path)
        @coroutine-fn
        define inner [item [request :: Request]]:
            (handler item (RequestContext request))


    define add-page [self path handler]:
        """
        GET {path}; handler takes a RequestContext and returns a Response
        (HTML). Used by the UI variety to serve rendered pages.
        """

        import-from fastapi Request
        (logger.info "route GET %s (html)" path)
        define app self.app

        @(app.get path)
        @coroutine-fn
        define inner [[request :: Request]]:
            (handler (RequestContext request))


    define add-page-item [self path handler]:
        """
        GET {path}/{item}; the path item and a RequestContext are passed
        to handler, which returns a Response (HTML).
        """

        import-from fastapi Request
        define full f"{path}/{{item}}"
        (logger.info "route GET %s (html)" full)
        define app self.app

        @(app.get full)
        @coroutine-fn
        define inner [item [request :: Request]]:
            (handler item (RequestContext request))


    define add-form [self path handler]:
        """
        POST {path}/{item} with an HTML form body; the path item, the
        form fields as a dict, and a RequestContext are passed to handler.
        Used by the UI's manual-trigger forms.
        """

        import-from fastapi Request
        define full f"{path}/{{item}}"
        (logger.info "route POST %s (form)" full)
        define app self.app

        @(app.post full)
        @coroutine-fn
        define inner [item [request :: Request]]:
            define form (dict (request.form))
            (handler item form (RequestContext request))


    define start [self]:
        when self._server:
            (return)

        (logger.info "starting server on %s:%i" self.host self.port)

        import-from uvicorn Config Server

        define config (Config self.app
            host: self.host
            port: self.port)

        set! self._server (Server config)
        ;; keep the Task: the loop holds only a weak reference
        set! self._serve_task (create-task (defer self._server.serve))


    define stop [self]:
        when self._server:
            set! self._server.should_exit True   ; makes uvicorn's serve() return
            (self._server.shutdown)              ; graceful: drain in-flight requests
            set! self._server None
            set! self._serve_task None


;; one server per host:port, shared across every job that resolves there
define _servers #{}


define get-server [config]:
    define key f"{config.host}:{config.port}"

    define server (_servers.get key)
    unless server:
        set! server (HttpServer config.host config.port)
        (set! (item _servers key) server)

    server


define stop-all-servers []:
    """
    Stop every interned server. Called at jobset teardown so the shared
    uvicorn serve() tasks return and the loop can drain and exit.
    """

    for-each [server (_servers.values)]:
        try:
            (server.stop)
        except [Exception]:
            (logger.error "server stop failed" exc_info: True)
    (_servers.clear)


;; The end.
