import inspect
import logging

import-from fastapi HTTPException
import-from hmac compare_digest

import-from .job Job
import-from .server get-server normalize-prefix ServerConfig


define logger (logging.getLogger "kosrunner.webhook")

;; The machine-door secret rides in a header, keeping it out of URLs and
;; access logs (the R1 choice among header / path / query).
define TOKEN-HEADER "X-Kosrunner-Token"


define-dataclass WebhookConfig [ServerConfig]:
    """
    Config for a webhook route's shared server (host, port, prefix). An
    optional `token` arms the machine-door guard: when set, a caller must
    present it in the X-Kosrunner-Token header or be turned away with a
    401. Left unset the route stays open, so existing webhooks are
    unchanged.

    `wait` picks the reply model. The default (True) awaits the handler and
    returns its result. Set it False for a background run: the route replies
    at once with a `{run_id, status}` receipt and the handler runs on, its
    run id the handle the admin/ui read surface polls.
    """

    define [token :: str] None
    define [wait :: bool] True


define derive-input-spec [fn]:
    """
    Read a handler's input spec off its own typed formals: each annotated
    parameter (`[ref :: str]`, `[force :: bool value: False]`) becomes a
    name -> type (required) or name -> #(type default) (optional) entry.
    Returns None when no formal is annotated -- an untyped handler takes
    the raw payload as today.
    """

    define spec #{}
    define sig (inspect.signature fn)
    for-each [[name param] (sig.parameters.items)]:
        unless (== param.annotation inspect.Parameter.empty):
            if (== param.default inspect.Parameter.empty):
                (set! (item spec name) param.annotation)
            else:
                (set! (item spec name) #(param.annotation param.default))

    (or spec None)


define coerce-input [spec payload]:
    """
    Validate and coerce a POSTed JSON payload against an input spec,
    returning the named args for the handler. The spec maps name -> type
    (required) or #(type default) (optional). Unknown keys, missing
    required keys, and uncoercible values raise a 400.
    """

    define bad [msg]:
        (raise (HTTPException status_code: 400 detail: msg))

    unless (instance? payload dict):
        (bad "payload must be a JSON object")

    for-each [key (payload.keys)]:
        unless (in? key spec):
            (bad f"unknown input: {key}")

    define kwargs #{}
    for-each [[name typ] (spec.items)]:
        define-values [t default required] (if (instance? typ tuple)
            (values (item typ 0) (item typ 1) False)
            (values typ None True))
        if (in? name payload):
            define val (item payload name)
            if (instance? val t):
                (set! (item kwargs name) val)
            else:
                try:
                    (set! (item kwargs name) (t val))
                except [Exception]:
                    (bad f"bad value for {name}: expected {t.__name__}")
        elif required:
            (bad f"missing required input: {name}")
        else:
            (set! (item kwargs name) default)
    kwargs


define-class WebhookJob [Job]:
    """
    An inbound HTTP route; its name is the route path segment
    """

    define __init__ [self route]:
        (Job.__init__ self)
        set! self.route route
        set! self.input_spec None


    define handler [self fn]:
        """
        The inherited code sub-item, plus the webhook's input contract:
        the handler's own typed formals ARE the input spec. Setting the
        handler derives it, so one declaration drives coercion (and later
        the UI trigger forms).
        """

        (Job.handler self fn)
        set! self.input_spec (derive-input-spec fn)
        self


    define trigger-spec [self]:
        ;; the typed formals ARE the manual-trigger fields; an untyped
        ;; webhook is not manually triggerable (the UI cannot invent its
        ;; payload -- replay a past run instead)
        self.input_spec


    define check-token [self ctx]:
        """
        Enforce the per-webhook token when one is configured: the caller
        must present it in TOKEN-HEADER, compared in constant time. Raises
        401 on a missing or wrong token; a no-op for an open (token-less)
        webhook. Runs at the route boundary, BEFORE any run is recorded, so
        a rejected call leaves no run behind.
        """

        define want self.config.token
        when want:
            define got (ctx.header TOKEN-HEADER)
            unless (and got (compare_digest got want)):
                raise (HTTPException status_code: 401
                    detail: "invalid or missing webhook token")


    define dispatch [self payload ctx]:
        """
        The route-boundary entry mounted by `start`: guard the door,
        coerce the payload when an input spec is declared, then fire the
        handler as a tracked run. The handler's return value flows back as
        the HTTP response.
        """

        (self.check-token ctx)
        if (None? self.input_spec):
            (self.run payload cause: "webhook" wait: self.config.wait)
        else:
            define kwargs (coerce-input self.input_spec payload)
            (self.run **: kwargs cause: "webhook" wait: self.config.wait)


    define start [self]:
        set! self.running True
        define server (get-server self.config)
        ;; dispatch guards the token at the boundary, then routes through
        ;; Job.run so each accepted request is a tracked run whose return
        ;; value flows back as the HTTP response
        (server.add-route (normalize-prefix self.config.prefix) self.route
            self.dispatch)
        (server.start)


    define stop [self]:
        set! self.running False


define-syntax config/webhook:
    syntax-rules []:
        case (config/webhook () setting ...):
            (begin
                (define default/webhook)
                (unless &default/webhook
                    (set! default/webhook (WebhookConfig setting ...))))
        case (config/webhook nm setting ...):
            (begin
                (define nm (WebhookConfig setting ...))
                (define default/webhook)
                (unless &default/webhook (set! default/webhook nm)))


;; `job webhook <name> [disabled]:` -- no trigger key; the name is the route.
define-syntax job/webhook:
    syntax-rules [disabled]:
        case (job/webhook name disabled (subhead subrest ...) ...):
            (begin
                (define name (WebhookJob 'name))
                (set! name.enabled False)
                (define default/webhook)
                (when &default/webhook (.configure name via: default/webhook))
                (subhead (webhook name) subrest ...) ...)

        case (job/webhook name (subhead subrest ...) ...):
            (begin
                (define name (WebhookJob 'name))
                (define default/webhook)
                (when &default/webhook (.configure name via: default/webhook))
                (subhead (webhook name) subrest ...) ...)


;; The end.
