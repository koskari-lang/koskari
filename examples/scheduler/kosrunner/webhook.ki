import logging

import-from .job Job
import-from .server get-server ServerConfig


define logger (logging.getLogger "kosrunner.webhook")


define-dataclass WebhookConfig [ServerConfig]:
    """
    Config for a webhook route's shared server (host, port, prefix)
    """


define-class WebhookJob [Job]:
    """
    An inbound HTTP route; its name is the route path segment
    """

    define __init__ [self route]:
        (Job.__init__ self)
        set! self.route route


    define start [self]:
        set! self.running True
        define server (get-server self.config)
        (server.add-route self.config.prefix self.route self.callback)
        (server.start)


    define stop [self]:
        set! self.running False


define-syntax config/webhook:
    syntax-rules []:
        case (config/webhook () setting ...):
            (begin
                (define default/webhook)
                (unless &default/webhook
                    (set! default/webhook (WebhookConfig setting ...))))
        case (config/webhook nm setting ...):
            (begin
                (define nm (WebhookConfig setting ...))
                (define default/webhook)
                (unless &default/webhook (set! default/webhook nm)))


;; `job webhook <name> [disabled]:` -- no trigger key; the name is the route.
define-syntax job/webhook:
    syntax-rules [disabled]:
        case (job/webhook name disabled (subhead subrest ...) ...):
            (begin
                (define name (WebhookJob 'name))
                (set! name.enabled False)
                (define default/webhook)
                (when &default/webhook (.configure name via: default/webhook))
                (subhead (webhook name) subrest ...) ...)

        case (job/webhook name (subhead subrest ...) ...):
            (begin
                (define name (WebhookJob 'name))
                (define default/webhook)
                (when &default/webhook (.configure name via: default/webhook))
                (subhead (webhook name) subrest ...) ...)


;; The end.
