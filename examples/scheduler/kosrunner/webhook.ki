import logging

import fastapi
import uvicorn
import-from fastapi Request

import-from .job Job


define logger (logging.getLogger "kosrunner.webhook")


define-class WebhookServer [Job]:

    define __init__ [self name host: "0.0.0.0" port: 8080 prefix: ""]:
        set! self.name name
        set! self.host host
        set! self.port port
        set! self.prefix prefix
        set! self.app (fastapi.FastAPI title: name)
        set! self._server None


    define add-route [self name handler]:
        define path f"{self.prefix}/{name}"
        logger.info "Registering webhook %s at %s" name path

        define app self.app

        @(app.post path)
        @coroutine-fn
        define inner [[request :: Request]]:
            logger.info "Webhook triggered: %s" name
            try:
                define payload (request.json)
                define result (handler payload)
                logger.info "Webhook completed: %s" name
                result
            except [Exception]:
                logger.error "Webhook failed: %s" name exc_info: True

        import inspect
        print "inspecting inner" name
        print "  " (inspect.signature inner)
        print "  " inner.__annotations__
        print "  " inner.__signature__


    define serve [self]:
        (logger.info
            "Starting webhook server %s on %s:%i"
            self.name self.host self.port)

        define config (uvicorn.Config
            self.app
            host: self.host
            port: self.port
            log_level: "info")
        set! self._server (uvicorn.Server config)

        create-task (defer self._server.serve)


    define start [self]:
        unless self._server:
            (self.serve)


    define stop [self]:
        (logger.info "Stopping webhook server: %s" self.name)
        when self._server:
            (self._server.shutdown)
            set! self._server None


define-class WebhookJob [Job]:

    define __init__ [self server name callback]:
        set! self.server server
        set! self.name name
        set! self.callback callback
        (server.add-route name callback)

    define start [self]:
        (self.server.start)

    define stop [self]:
        (self.server.stop)


define-syntax webhook-config:
    syntax-rules []:
        case (webhook-config name args ...):
            define name (WebhookServer (str 'name) args ...)


; the inline block handler allows us to put key: val for the config
; on individual lines
define layout/webhook-config layout/inline-block


define-syntax on-webhook:
    syntax-rules []:
        case (on-webhook server name [payload] body ...):
            (WebhookJob server (str 'name) (lambda [payload] body ...))

        case (on-webhook server name callback):
            (WebhookJob server (str 'name) callback)


;; The end.
