import logging

import-from dataclasses field

(use .job Config)


define logger (logging.getLogger "kosrunner.access")

;; The identity the OIDC front-end (oauth2-proxy) injects after a real
;; login. Authn is the proxy's job; these lists are authz only. Absent
;; header = anonymous, the read floor of the ladder.
define IDENTITY-HEADER "X-Forwarded-Email"


define-dataclass Group []:
    """
    A named set of member emails -- a real value, so jobs reference it by
    BINDING (`allow #[deployers]`), not by string key: a typo'd group is a
    load-time NameError, never a silently empty match. Declared with the
    `group` macro, which names the value after its binding.
    """

    define [name :: str] (field)
    define [members :: list] (field)


define-dataclass AccessConfig [Config]:
    """
    The committed access lists: `operators` are emails with the run of the
    place (trigger anything, enable/disable); `groups` lists the Group
    values whose members hold `control` -- the right to trigger jobs whose
    `allow` list carries one of their groups. Everyone else (including
    logged-in but unlisted users) is `anonymous`: read-only. A jobset with
    no access config at all is fully open.
    """

    define [operators :: list] None
    define [groups :: list] None


;; --- the identity -> level seam ------------------------------------

define resolve-identity [ctx]:
    """
    The caller's identity off the request context: the proxy-verified
    email, or None for anonymous.
    """

    (ctx.header IDENTITY-HEADER)


define groups-of [access identity]:
    """
    The Group values under `access` that `identity` belongs to.
    """

    (list-each [g (or access.groups #())]
        when: (in? identity g.members)
        g)


define resolve-level [access identity]:
    """
    identity -> ladder level under `access`: "operator", "control" (in at
    least one group), or "anonymous". The swappable seam: replace this to
    source levels from somewhere richer than the committed lists.
    """

    if (None? identity):
        "anonymous"
    elif (in? identity (or access.operators #[])):
        "operator"
    elif (groups-of access identity):
        "control"
    else:
        "anonymous"


;; --- checks ---------------------------------------------------------

define operator? [access ctx]:
    """
    May the caller act as an operator (enable/disable, shutdown, trigger
    anything)? Open when there is no access config.
    """

    (or (None? access)
        (== (resolve-level access (resolve-identity ctx)) "operator"))


define may-trigger? [access identity job]:
    """
    May `identity` trigger `job`? Operators always; otherwise membership
    in any Group on the job's allow list, tested directly against the
    group VALUES the job references -- no name lookup. A job with no
    allow list is operator-only. Open when there is no access config.
    The identity-pure core, usable at render time (R5 projection) as
    well as at the request boundary.
    """

    when (None? access):
        ; no access config, so everyone is operator
        return True

    when (None? identity):
        ; no identity, so anonymous
        return False

    when (== (resolve-level access identity) "operator"):
        ; operator level, so allowed
        return True

    ; check that the identity is a member of any of the allowed groups
    for-each [g (or job.allowed_groups #())]:
        when (in? identity g.members):
            break True
    else:
        False


define trigger-allowed? [access ctx job]:
    """
    The request-boundary wrapper over may-trigger?: resolve the caller's
    identity off the request context, then ask.
    """

    (may-trigger? access (resolve-identity ctx) job)


define require-operator! [access ctx]:
    """
    403 unless the caller holds operator level (or there is no access
    config). The JSON-flavored guard for the admin API.
    """

    import-from fastapi HTTPException
    unless (operator? access ctx):
        raise (HTTPException status_code: 403
            detail: "operator access required")


define require-trigger! [access ctx job]:
    """
    403 unless the caller may trigger `job` (or there is no access
    config). The JSON-flavored guard for the admin API.
    """

    import-from fastapi HTTPException
    unless (trigger-allowed? access ctx job):
        raise (HTTPException status_code: 403
            detail: f"not allowed to trigger {job.name}")


;; `group <name>:` -- bind a Group value, named after its own binding:
;;
;;     group deployers:
;;         "dev@example.com"
;;         "carol@example.com"
;;
;; A plain top-level definer (it lives beside the jobset block, not
;; inside it), so `allow #[deployers]` and `groups: #[deployers]`
;; reference the binding directly.
define-syntax group:
    macro-rules []:
        case (group name member ...):
            `(define ,name (Group ,(str name.datum) (#list ,@member)))


;; --- variety entry syntax -------------------------------------------

;; Access is singular per jobset, so only the unnamed `()` case exists:
;; `config access:` binds the first-wins `default/access` slot the jobset
;; macro reads when it wires the JobSet.
define-syntax config/access:
    syntax-rules []:
        case (config/access () setting ...):
            define -'default/access
            unless &-'default/access:
                set! -'default/access (AccessConfig setting ...)


;; The end.
