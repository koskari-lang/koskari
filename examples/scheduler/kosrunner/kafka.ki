import logging

import-from .job Config Job


define logger (logging.getLogger "kosrunner.kafka")


define-class KafkaConfig [Config]:
    """Settings bag for a kafka broker connection (servers, protocol...)."""


define-class KafkaJob [Job]:
    """Consumes one topic; dispatches each message to the handler."""

    define __init__ [self topic]:
        (Job.__init__ self)
        set! self.topic topic
        set! self.on_error_cb None
        set! self._consumer None
        set! self._task None


    ;; kafka-variety sub-item setter (paired with the `on-error` macro)
    define on-error [self fn]:
        set! self.on_error_cb fn
        self


    define make-consumer [self]:
        import-from aiokafka AIOKafkaConsumer
        define c self.config
        (AIOKafkaConsumer
            self.topic
            bootstrap_servers: (c.get "servers")
            group_id: (c.get "group_id")
            security_protocol: (c.get "security_protocol" "PLAINTEXT")
            auto_offset_reset: (c.get "auto_offset_reset" "latest")
            enable_auto_commit: (c.get "enable_auto_commit" True))


    define _consume [self]:
        (logger.info "consumer loop started: %s" self.topic)
        for-each [msg self._consumer]:
            define raw msg.value
            define value (if (None? raw) None (raw.decode "utf-8"))
            try:
                (self.callback value)
            except [Exception as: err]:
                if self.on_error_cb:
                    (self.on_error_cb err value)
                else:
                    (logger.error "callback error on %s" self.topic exc_info: True)


    define start [self]:
        when self._consumer:
            return
        set! self.running True
        (logger.info "starting kafka consumer: %s" self.topic)
        set! self._consumer (self.make-consumer)
        (self._consumer.start)
        set! self._task (create-task (defer self._consume))


    define stop [self]:
        set! self.running False
        when self._consumer:
            (self._consumer.stop)
            set! self._consumer None
        when self._task:
            (self._task.cancel)
            set! self._task None


define-syntax config/kafka:
    syntax-rules []:
        case (config/kafka () setting ...):
            (begin
                (define default/kafka)
                (unless &default/kafka
                    (set! default/kafka (KafkaConfig setting ...))))

        case (config/kafka nm setting ...):
            (begin
                (define nm (KafkaConfig setting ...))
                (define default/kafka)
                (unless &default/kafka (set! default/kafka nm)))


;; `job kafka <name> <topic> [disabled]:` -- trigger key is the topic.
define-syntax job/kafka:
    syntax-rules [disabled]:
        case (job/kafka name topic disabled (subhead subrest ...) ...):
            (begin
                (define name (KafkaJob topic))
                (set! name.enabled False)
                (define default/kafka)
                (when &default/kafka (.configure name via: default/kafka))
                (subhead (kafka name) subrest ...) ...)

        case (job/kafka name topic (subhead subrest ...) ...):
            (begin
                (define name (KafkaJob topic))
                (define default/kafka)
                (when &default/kafka (.configure name via: default/kafka))
                (subhead (kafka name) subrest ...) ...)


;; The end.
