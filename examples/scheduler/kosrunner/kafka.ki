import logging

import-from aiokafka AIOKafkaConsumer
import-from aiokafka.helpers create_ssl_context

import-from .job Job


define logger (logging.getLogger "kosrunner.kafka")


define-dataclass KafkaConfig []:
    define [name :: str] (field)

    define [servers :: "list[str]"] (field)

    define [group_id :: str] None

    define [ssl_context :: Any] None
    define [ssl_cafile :: str] None
    define [security_protocol :: str] "PLAINTEXT"

    define [sasl_mechanism :: str] None
    define [sasl_plain_username :: str] None
    define [sasl_plain_password :: str] None

    define auto_offset_reset "latest"
    define enable_auto_commit True

    define client_id "kosrunner-kafka-job"
    define value_encoding "utf-8"
    define jobs #{}


define-syntax kafka-config:
    syntax-rules []:
        case (kafka-config name args ...):
            define name (KafkaConfig (str 'name) args ...)


define-class KafkaJob [Job]:

    define __init__ [self config topic callback]:
        set! self.config config
        set! self.topic topic
        set! self.callback callback
        set! self._consumer None
        set! self._task None


    define decode-value [self msg]:
        """
        Decode a consumer record value using the config encoding
        """

        define raw msg.value
        unless (None? raw):
            raw.decode self.config.value_encoding


    define make-consumer [self]:
        """
        Build an aiokafka consumer for this job's topic
        """

        define cfg self.config

        define security_protocol cfg.security_protocol
        define ssl_context cfg.ssl_context
        unless ssl_context:
            when (or cfg.ssl_cafile
                    (? security_protocol (has? security_protocol "SSL"))):
                set! ssl_context (create_ssl_context cafile: cfg.ssl_cafile)

        (AIOKafkaConsumer
            self.topic

            bootstrap_servers: cfg.servers
            group_id: cfg.group_id

            security_protocol: security_protocol
            ssl_context: ssl_context

            sasl_mechanism: cfg.sasl_mechanism
            sasl_plain_username: cfg.sasl_plain_username
            sasl_plain_password: cfg.sasl_plain_password

            auto_offset_reset: cfg.auto_offset_reset
            enable_auto_commit: cfg.enable_auto_commit)


    define _consume [self]:
        """
        Read messages until the consumer is stopped
        """

        (logger.info "Consumer loop started: %s" self.topic)
        for-each [msg self._consumer]:
            define value (self.decode-value msg)
            (logger.debug "Message received: %s" self.topic)
            try:
                (self.callback value)
            except [Exception]:
                (logger.error "Callback error on %s" self.topic exc_info: True)
        (logger.info "Consumer loop ended: %s" self.topic)


    define start [self]:
        """
        Start the consumer and background read loop for this topic
        """

        when self._consumer:
            return

        define jobs self.config.jobs
        when (has? jobs self.topic):
            raise (RuntimeError
                f"kafka job already registered for topic {self.topic}")

        (logger.info "Starting kafka consumer: %s" self.topic)
        set! self._consumer (self.make-consumer)
        (self._consumer.start)

        ; Wrap the consume method in a defer to prevent implicit auto-await
        ; so we can pass the awaitable to create-task.
        set! self._task (create-task (defer self._consume))
        set! (item jobs self.topic) self


    define stop [self]:
        """
        Stop the read loop and close the consumer for this topic
        """

        (logger.info "Stopping kafka consumer: %s" self.topic)
        when self._consumer:
            (self._consumer.stop)
            set! self._consumer None

        when self._task:
            (self._task.cancel)
            (self._task.join)
            set! self._task None

        define jobs self.config.jobs
        when (has? jobs self.topic):
            del! (item jobs self.topic)


define-syntax on-kafka:
    syntax-rules []:
        case (on-kafka config topic callback):
            (KafkaJob config topic callback)
        case (on-kafka config topic [msg] body ...):
            (KafkaJob config topic
                (lambda [msg] body ...))
        case (on-kafka config topic [msg topic_arg] body ...):
            (KafkaJob config topic
                (lambda [msg [topic_arg topic]] body ...))


;; The end.
