import asyncio
import logging
import signal

import-from asyncio CancelledError
import-from dataclasses replace
import-from importlib import_module


var logger (logging.getLogger "kosrunner")


def require-extra [module extra]:
    """
    Resolve a variety's optional client library, raising a message that
    names the extra to install when it is absent. A variety whose library
    is an extra calls this from its CONSTRUCTOR, so a definition using it
    dies at load time -- the same bargain `reqenv` makes -- rather than at
    first connect. The variety module itself stays importable either way,
    so `import kosrunner` never depends on an extra being present.
    """

    try:
        (return (import_module module))
    except [ImportError]:
        ;; adjacent literals are separate ARGS in koskari; #str is the
        ;; variadic join that spreads one message over several lines
        raise (ImportError (#str
            f"the {extra} job variety needs the '{module}' package:"
            f" pip install koskari-kosrunner[{extra}]"))


def watch-task [task what job: None]:
    """
    Watch a long-lived background task so that its death is reported.

    Retrieving the exception is the substance of this: an un-retrieved
    failure keeps the task, the exception, and every frame's locals
    behind that traceback alive for as long as anything holds the task,
    and asyncio only complains about the loss once the task is collected
    -- which never happens while its owner keeps it in a slot. The owner
    is left holding a dead task it believes is working.

    Pass `job` and a crash also clears its `running` flag, because a job
    whose background work has stopped must not keep reporting itself
    healthy to the dashboard. Returns the task, so a caller can watch it
    in the same expression that stores it.
    """

    def _done [t]:
        unless (None? job):
            set! job.running False
        try:
            var exc (t.exception)
        except [CancelledError]:
            (logger.info "%s cancelled" what)
            (return)
        if exc:
            (logger.error "%s crashed" what exc_info: exc)
        else:
            (logger.info "%s ended" what)

    (task.add_done_callback (demand _done))
    task


define-class ConfigBase []:
    """
    Method carrier for Config (a dataclass body holds fields, so the
    behavior lives one class up). `merge` builds a NEW config instance
    combining a base's fields with per-job overrides (unknown fields
    raise).
    """

    def merge [self **: overrides]:
        (replace self **: overrides)


define-dataclass Config [ConfigBase]:
    """
    Base config. Subclasses are dataclasses that declare their fields,
    valid shape, and sensible defaults; every config additionally
    carries `disabled` (False), so a config -- including a shared or
    named one -- can declare the jobs wired to it dormant. NOTE: base
    fields precede subclass fields in the dataclass init, so a subclass
    field after this defaulted one cannot be required-positional --
    default it and guard at start instead.
    """

    var disabled :: bool False


define-class Job []:
    """
    Base job: a unit of work with enable/disable state and the inherited
    sub-item vocabulary (configure/handler). Varieties override start/stop
    and may add their own sub-item setters.
    """

    def __init__ [self]:
        set! self.name None            ; set by JobSet.register
        set! self.config None
        set! self.callback None
        set! self.on_error_cb None
        set! self.enabled True
        set! self.running False
        set! self.jobset None
        set! self.allowed_groups None


    ; --- inherited sub-item setters ---

    ;; the variety's Config class, used when a job is configured with no
    ;; base to merge onto; subclasses override (WebhookJob -> WebhookConfig)
    var config-class Config

    def configure [self via: None **: overrides]:
        """
        The `config:` sub-item. `via` selects a base Config (the type
        default or a named one); with no `via` the job's current config is
        refined instead, and a job with no config at all builds a FRESH
        instance of its variety's config-class from the overrides alone
        (missing required fields raise, courtesy of the dataclass). The
        merged result also declares the job's build-time enabled state via
        its `disabled` field; runtime enable/disable toggles are applied
        afterwards and unaffected.
        """

        var base (or via self.config)
        set! self.config (if base
            (base.merge **: overrides)
            (self.config-class **: overrides))
        set! self.enabled (not self.config.disabled)
        self


    def handler [self fn]:
        """
        The `handler [..]:` sub-item -- the code run when the job fires.
        """

        set! self.callback fn
        self


    def allow [self groups]:
        """
        The `allow #[..]` sub-item -- the Group values whose members may
        trigger this job (operators always may), referenced by BINDING,
        e.g. `allow #[deployers]`. Under an access config a job with no
        allow list is operator-only; with no access config everything is
        open.
        """

        set! self.allowed_groups (list groups)
        self


    def trigger-spec [self]:
        """
        The manual-trigger contract. None (the base) means this job cannot
        be fired fresh from the UI -- admin/ui/kafka and untyped webhooks
        inherit or return it, since a fresh fire either means nothing or
        needs a payload the UI cannot invent. An empty dict means fire
        with no fields (cron); a typed webhook returns its input spec so
        the trigger form renders its fields. Re-running a PAST run
        (retrigger) is separate and always supported: it replays real
        recorded args.
        """

        None


    ; --- tracked execution ---

    def _job-kind [self]:
        var cls (type self)
        (.lower (.removesuffix cls.__name__ "Job"))


    def _invoke [self args kwargs]:
        (if (None? self.callback)
            None
            (self.callback *: args **: kwargs))


    def _tracked-invoke [self store runid args kwargs]:
        """
        The recorded body of a run: set the per-run log buffer and
        mnemonic slot, invoke the callback, dispatch the on-error hook on
        failure, and flush the outcome to the store. This runs as ONE unit
        in whatever context executes the callback -- inline for a
        synchronous run, or inside the background task for an async one --
        because the capture contextvars must be set in the same context
        the callback runs in, or the buffer the log handler reads and the
        cell `mnemonic` writes are not the ones this invoke set. Returns
        the callback result.
        """

        ;; local import dodges the job<->store load-time cycle
        import-from .store _current-run _current-mnemonic

        var buf #[]
        ;; a one-slot cell rather than a value: `mnemonic` mutates this
        ;; from inside the handler, where a contextvar `.set` would not
        ;; carry back out to this context
        var label #[None]
        var token (_current-run.set buf)
        var mtoken (_current-mnemonic.set label)
        var status "success"
        var result None
        var err None

        try:
            set! result (self._invoke args kwargs)

        except [Exception as: exc]:
            set! status "failed"
            set! err exc
            if self.on_error_cb:
                try:
                    (self.on_error_cb exc *: args **: kwargs)
                except [Exception]:
                    (logger.error "on-error handler failed: %s"
                        self.name exc_info: True)
            else:
                (logger.error "job failed: %s"
                    self.name exc_info: True)

        finally:
            (_current-run.reset token)
            (_current-mnemonic.reset mtoken)
            ;; the mnemonic is read here, in the finally, so a run that
            ;; labelled itself and then failed keeps the label -- which is
            ;; the case where it is worth the most
            (store.record-finish runid
                status: status
                result: result
                error: err
                log: (when buf ("\n".join buf))
                mnemonic: (item label 0))

        result


    def run [
            self
            *: args
            cause: "manual"
            parent: None
            wait: True
            **: kwargs]:
        """
        Fire the handler once as a TRACKED run: record it in the jobset's
        store, capture its log output, invoke the callback with `args` and
        `kwargs` (the named-args channel typed webhook inputs bind
        through), and record the outcome (with the on-error hook on
        failure). Both channels land in trigger.json, so re-trigger is
        just a `run` with `cause: "manual"` and the stored args/kwargs.
        Every variety funnels its trigger through here.

        `wait` picks the reply. A synchronous run (the default) invokes
        inline and returns the callback result -- webhook needs it back,
        and cron/kafka/retrigger have no caller to answer. An asynchronous
        run (`wait: False`) records the start, spins the invoke-and-finish
        as a background task, and returns a receipt `{run_id, status}` at
        once; the run id is the handle the read surface polls as the run
        flips running -> success/failed. Degrades to a plain invoke when
        there is no store (e.g. an unregistered job).
        """

        var store (if self.jobset self.jobset.store None)
        when (None? store):
            (return (self._invoke args kwargs))

        var runid (store.record-start self.name
            (self._job-kind) cause
            args: args
            kwargs: kwargs
            parent: parent)

        if wait:
            (self._tracked-invoke store runid args kwargs)
        else:
            (self.jobset.spawn-run
                (lambda [] (self._tracked-invoke store runid args kwargs)))
            #{"run_id": runid
              "status": "started"}


    ; --- lifecycle (varieties implement) ---

    def start [self]:
        raise (NotImplementedError f"{self}.start")


    def stop [self]:
        raise (NotImplementedError f"{self}.stop")


define-class JobSet []:
    """
    Tracks jobs by name and offers the control-plane surface (list /
    enable / disable) that the REST layer will call. Starting runs only
    enabled jobs; disabled ones stay registered but dormant.
    """

    def __init__ [self name]:
        set! self.name name
        set! self.jobs #{}
        set! self.store None              ; RunStore, wired by the jobset macro
        set! self.access None             ; AccessConfig, wired by the jobset macro
        set! self._stopping None          ; asyncio.Event, live only while running
        set! self._inflight (set)         ; background run tasks (async webhooks)


    def bind-store [self config]:
        """
        Construct the run store from an optional StorageConfig (the jobset
        macro passes `&default/storage`, which is falsey when the
        definition carried no `config storage:`). Resolution falls through
        config.root -> env -> <cwd>/.kosrunner. Does not open the
        connection -- that happens at run time in `__call__`.
        """

        ;; local import dodges the job<->store load-time cycle
        import-from .store RunStore resolve-storage-root
        var root (resolve-storage-root config)
        set! self.store (RunStore (str root) config: config)
        self.store


    def bind-access [self config]:
        """
        Attach the access lists (the jobset macro passes `&default/access`,
        falsey when the definition carried no `config access:`). None
        means the control surface is open -- today's behavior.
        """

        set! self.access (if config config None)
        self.access


    def register [self name job]:
        set! (item self.jobs name) job
        set! job.jobset self
        set! job.name name
        (logger.info "registered job: %s" name)
        job


    def list-jobs [self]:
        list-each [[name job] (self.jobs.items)]:
            #{"name": name
              "enabled": job.enabled
              "running": job.running}


    def visible-jobs [self identity]:
        """
        The per-user projection of list-jobs: each row carries what THIS
        identity may do with the job -- `may_trigger` (fire/replay it) and
        `may_control` (enable/disable), computed from the access lists;
        everything True when there are none. Projection is DISPLAY only:
        the action handlers enforce the same checks underneath (R4), so
        hiding a button is never the only control.
        """

        ;; local import dodges the job<->access load-time cycle
        import-from .access may-trigger? resolve-level
        var access self.access
        var control (or (None? access)
            (== (resolve-level access identity) "operator"))
        var lasts (if self.store (self.store.last-runs) #{})
        list-each [[name job] (self.jobs.items)]:
            #{"name": name
              "type": (job._job-kind)
              "enabled": job.enabled
              "running": job.running
              "last": (lasts.get name)
              "may_trigger": (may-trigger? access identity job)
              "may_control": control}


    def enable [self name]:
        var job self.jobs[name]
        set! job.enabled True
        unless job.running:
            (job.start)
        job


    def disable [self name]:
        var job self.jobs[name]
        set! job.enabled False
        when job.running:
            (job.stop)
        job


    def retrigger [self runid]:
        """
        Replay a past run by id: read its stored trigger args and fire the
        same job again as a new `manual` run linked to the original via
        `parent`. Works on a disabled job -- exactly what failure replay
        needs. Returns a small status dict for the control plane.
        """

        var trig (self.store.get-trigger runid)
        unless trig:
            return #{"error": "no such run"
                     "run_id": runid}

        var jobname trig["job"]
        var job (self.jobs.get jobname)

        unless job:
            return #{"error": "unknown job"
                     "job": jobname}

        var args (or (trig.get "args") #[])
        var kwargs (or (trig.get "kwargs") #{})
        (job.run *: args **: kwargs cause: "manual" parent: runid)

        #{"ok": True
          "retriggered": runid
          "job": jobname}


    def spawn-run [self thunk]:
        """
        Run a run's recorded body as a background task (an async webhook's
        reply). The task is held in `_inflight` -- the loop keeps only a
        weak reference otherwise, so a fire-and-forget run could be GC'd
        mid-flight -- and drained at teardown. The done-callback discards
        it and surfaces any crash that escaped the run's own error handling.
        """

        var task (create-task (defer thunk))
        (self._inflight.add task)
        (task.add_done_callback (demand self._run-done))
        task


    def _run-done [self task]:
        (self._inflight.discard task)
        try:
            var exc (task.exception)
        except [CancelledError]:
            (return)
        when exc:
            (logger.error "background run crashed" exc_info: exc)


    def start [self]:
        (logger.info "starting jobset: %s" self.name)
        for-each [[name job] (self.jobs.items)]:
            when job.enabled:
                (logger.info "  start: %s" name)
                (job.start)


    def stop [self]:
        (logger.info "stopping jobset: %s" self.name)
        for-each [[name job] (self.jobs.items)]:
            when job.running:
                (logger.info "  stop: %s" name)
                try:
                    (job.stop)
                except [Exception]:
                    (logger.error "stop failed: %s" name exc_info: True)


    def shutdown [self]:
        """
        Signal the run loop to tear down. Safe to call from a request
        handler or a signal handler -- it only trips the event; the actual
        teardown happens once, in __call__'s finally.
        """

        (logger.info "shutdown requested: %s" self.name)
        when self._stopping:
            (self._stopping.set)


    def _install-signals [self]:
        var loop (asyncio.get_running_loop)
        for-each [sig #[signal.SIGINT signal.SIGTERM]]:
            try:
                (loop.add_signal_handler sig (demand self.shutdown))
            except [NotImplementedError]:
                (logger.warning "signals unsupported on this loop: %s" sig)


    def _remove-signals [self]:
        var loop (asyncio.get_running_loop)
        for-each [sig #[signal.SIGINT signal.SIGTERM]]:
            try:
                (loop.remove_signal_handler sig)
            except [Exception]:
                None


    def _teardown [self]:
        (self._remove-signals)
        (self.stop)
        ;; let in-flight background runs finish writing before the store
        ;; closes under them (a snapshot: the done-callback mutates the set)
        when self._inflight:
            (await (asyncio.gather *: (list self._inflight) return_exceptions: True))
        ;; local import dodges the job<->server load-time cycle
        import-from .server stop-all-servers
        (stop-all-servers)
        when self.store:
            (self.store.close)


    def __call__ [self heartbeat: 3600 snore: False]:
        """
        Start enabled jobs and keep the process alive. Job start methods
        schedule their work on the ambient event loop; the run loop holds
        it open until a shutdown is signalled (admin route or SIGINT/
        SIGTERM), then tears everything down on the way out.
        """

        set! self._stopping (asyncio.Event)
        (self._install-signals)

        when self.store:
            (self.store.open)
        (self.start)

        try:
            while (not (self._stopping.is_set)):
                try:
                    ;; defer holds the coroutine so wait_for gets a real
                    ;; awaitable, not an auto-awaited value -- same reason
                    ;; the kafka job defers its consume loop.
                    (asyncio.wait_for (defer self._stopping.wait) heartbeat)
                except [asyncio.TimeoutError]:
                    (logger.debug "heartbeat")
                    when snore:
                        (print "zzz")
        finally:
            (self._teardown)


;; The end.
