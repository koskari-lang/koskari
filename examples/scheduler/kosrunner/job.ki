import asyncio
import logging
import signal

import-from dataclasses replace


define logger (logging.getLogger "kosrunner")


define-class Config []:
    """
    Base config. Subclasses are dataclasses that declare their fields,
    valid shape, and sensible defaults. This base supplies the dataclass
    -style `merge`: a NEW config instance combining a base's fields with
    per-job overrides (unknown fields raise).
    """

    define merge [self **: overrides]:
        (replace self **: overrides)


define-class Job []:
    """
    Base job: a unit of work with enable/disable state and the inherited
    sub-item vocabulary (configure/handler). Varieties override start/stop
    and may add their own sub-item setters.
    """

    define __init__ [self]:
        set! self.name None            ; set by JobSet.register
        set! self.config None
        set! self.callback None
        set! self.on_error_cb None
        set! self.enabled True
        set! self.running False
        set! self.jobset None


    ; --- inherited sub-item setters ---

    define configure [self via: None **: overrides]:
        """
        The `config:` sub-item. `via` selects a base Config (the type
        default or a named one); with no `via` the job's current config is
        refined instead. Overrides are layered on by dataclass merge, and
        the resulting config INSTANCE is stored on the job.
        """

        define base (if via via self.config)
        when (None? base):
            raise (ValueError
                "config override has no base config to merge onto")
        set! self.config (base.merge **: overrides)
        self


    define handler [self fn]:
        """
        The `handler [..]:` sub-item -- the code run when the job fires.
        """

        set! self.callback fn
        self


    ; --- tracked execution ---

    define _job-kind [self]:
        define cls (type self)
        (.lower (.removesuffix cls.__name__ "Job"))


    define _invoke [self args]:
        (if (None? self.callback)
            None
            (self.callback *: args))


    define run [self *: args cause: "manual" parent: None]:
        """
        Fire the handler once as a TRACKED run: record it in the jobset's
        store, capture its log output, invoke the callback with `args`,
        and record the outcome (with the kafka-style `on-error` hook on
        failure). Returns the callback result -- webhook needs it back.
        Every variety funnels its trigger through here, and re-trigger is
        just a `run` with `cause: "manual"` and the stored args. Degrades
        to a plain invoke when there is no store (e.g. an unregistered
        job).
        """

        ;; local import dodges the job<->store load-time cycle. The capture
        ;; contextvar must be set HERE -- in the same context as the callback
        ;; -- so the run's log output is routed to this run's buffer.
        import-from .store _current-run

        define store (if self.jobset self.jobset.store None)
        when (None? store):
            (return (self._invoke args))

        define runid (store.record-start self.name (self._job-kind) cause args: args parent: parent)
        define buf #[]
        define token (_current-run.set buf)
        define status "success"
        define result None
        define err None
        try:
            set! result (self._invoke args)
        except [Exception as: exc]:
            set! status "failed"
            set! err exc
            if self.on_error_cb:
                try:
                    (self.on_error_cb exc *: args)
                except [Exception]:
                    (logger.error "on-error handler failed: %s" self.name exc_info: True)
            else:
                (logger.error "job failed: %s" self.name exc_info: True)
        finally:
            (_current-run.reset token)
            define log (if buf (.join "\n" buf) None)
            (store.record-finish runid status: status result: result error: err log: log)
        result


    ; --- lifecycle (varieties implement) ---

    define start [self]:
        raise (NotImplementedError f"{self}.start")


    define stop [self]:
        raise (NotImplementedError f"{self}.stop")


define-class JobSet []:
    """
    Tracks jobs by name and offers the control-plane surface (list /
    enable / disable) that the REST layer will call. Starting runs only
    enabled jobs; disabled ones stay registered but dormant.
    """

    define __init__ [self name]:
        set! self.name name
        set! self.jobs #{}
        set! self.store None              ; RunStore, wired by the jobset macro
        set! self._stopping None          ; asyncio.Event, live only while running


    define bind-store [self config]:
        """
        Construct the run store from an optional StorageConfig (the jobset
        macro passes `&default/storage`, which is falsey when the
        definition carried no `config storage:`). Resolution falls through
        config.root -> env -> <cwd>/.kosrunner. Does not open the
        connection -- that happens at run time in `__call__`.
        """

        ;; local import dodges the job<->store load-time cycle
        import-from .store RunStore resolve-storage-root
        define root (resolve-storage-root config)
        set! self.store (RunStore (str root) config: config)
        self.store


    define register [self name job]:
        set! (item self.jobs name) job
        set! job.jobset self
        set! job.name name
        (logger.info "registered job: %s" name)
        job


    define list-jobs [self]:
        list-each [[name job] (self.jobs.items)]:
            #{name: name
              enabled: job.enabled
              running: job.running}


    define enable [self name]:
        define job (item self.jobs name)
        set! job.enabled True
        unless job.running:
            (job.start)
        job


    define disable [self name]:
        define job (item self.jobs name)
        set! job.enabled False
        when job.running:
            (job.stop)
        job


    define retrigger [self runid]:
        """
        Replay a past run by id: read its stored trigger args and fire the
        same job again as a new `manual` run linked to the original via
        `parent`. Works on a disabled job -- exactly what failure replay
        needs. Returns a small status dict for the control plane.
        """

        define trig (self.store.get-trigger runid)
        if (None? trig):
            #{error: "no such run" run_id: runid}
        else:
            define jobname (item trig "job")
            define job (self.jobs.get jobname)
            if (None? job):
                #{error: "unknown job" job: jobname}
            else:
                define args (or (item trig "args") #[])
                (job.run *: args cause: "manual" parent: runid)
                #{ok: True retriggered: runid job: jobname}


    define start [self]:
        (logger.info "starting jobset: %s" self.name)
        for-each [[name job] (self.jobs.items)]:
            when job.enabled:
                (logger.info "  start: %s" name)
                (job.start)


    define stop [self]:
        (logger.info "stopping jobset: %s" self.name)
        for-each [[name job] (self.jobs.items)]:
            when job.running:
                (logger.info "  stop: %s" name)
                try:
                    (job.stop)
                except [Exception]:
                    (logger.error "stop failed: %s" name exc_info: True)


    define shutdown [self]:
        """
        Signal the run loop to tear down. Safe to call from a request
        handler or a signal handler -- it only trips the event; the actual
        teardown happens once, in __call__'s finally.
        """

        (logger.info "shutdown requested: %s" self.name)
        when self._stopping:
            (self._stopping.set)


    define _install-signals [self]:
        define loop (asyncio.get_running_loop)
        for-each [sig #[signal.SIGINT signal.SIGTERM]]:
            try:
                (loop.add_signal_handler sig (demand self.shutdown))
            except [NotImplementedError]:
                (logger.warning "signals unsupported on this loop: %s" sig)


    define _remove-signals [self]:
        define loop (asyncio.get_running_loop)
        for-each [sig #[signal.SIGINT signal.SIGTERM]]:
            try:
                (loop.remove_signal_handler sig)
            except [Exception]:
                None


    define _teardown [self]:
        (self._remove-signals)
        (self.stop)
        ;; local import dodges the job<->server load-time cycle
        import-from .server stop-all-servers
        (stop-all-servers)
        when self.store:
            (self.store.close)


    define __call__ [self heartbeat: 3600 snore: False]:
        """
        Start enabled jobs and keep the process alive. Job start methods
        schedule their work on the ambient event loop; the run loop holds
        it open until a shutdown is signalled (admin route or SIGINT/
        SIGTERM), then tears everything down on the way out.
        """

        set! self._stopping (asyncio.Event)
        (self._install-signals)
        when self.store:
            (self.store.open)
        (self.start)
        try:
            while (not (self._stopping.is_set)):
                try:
                    ;; defer holds the coroutine so wait_for gets a real
                    ;; awaitable, not an auto-awaited value -- same reason
                    ;; the kafka job defers its consume loop.
                    (asyncio.wait_for (defer self._stopping.wait) heartbeat)
                except [asyncio.TimeoutError]:
                    (logger.debug "heartbeat")
                    when snore:
                        (print "zzz")
        finally:
            (self._teardown)


;; The end.
