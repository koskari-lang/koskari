import-from logging getLogger


define logger (getLogger "kosrunner")


define-class JobConfig []:

    define __init__ [self]:
        set! self.conf #{}

    define add-config [self key value]:
        set! (item self.conf key) value

    define get-config [self key]:
        item self.conf key


define-class Job []:
    """
    Abstract job protocol; subclasses implement start and stop
    """

    define start [self]:
        raise (NotImplementedError f"{self}.start")

    define stop [self]:
        raise (NotImplementedError f"{self}.stop")


define-class JobSet []:

    define __init__ [self name jobs: nil]:
        set! self.name name
        set! self.jobs jobs

    define __call__ [self heartbeat: 3600 snore: False]:
        (self.start)
        while True:
            sleep heartbeat
            (logger.debug "Heartbeat")
            when snore (print "zzz")

    define start [self]:
        (logger.info "Starting jobset: %s" self.name)
        for-each [job self.jobs]:
            (job.start)
        (logger.info "Started %i jobs" (len self.jobs))

    define stop [self]:
        (logger.info "Stopping jobset: %s" self.name)
        for-each [job self.jobs]:
            (job.stop)


define-syntax jobset:
    macro-rules []:
        case (jobset name job ...):
            define n (str name.datum)
            `(define ,name (JobSet ,n jobs: #[,@job]))


;; The end.