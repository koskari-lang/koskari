import os

import-from logging basicConfig

(use .job JobSet)


;; Base sub-item vocabulary. The job macro rewrites each of a job's
;; sub-item lines into a TYPE-TAGGED form -- `(head (<type> <name>) ...)`
;; -- and these generic fall-throughs route them to the inherited setter
;; on the named job instance. `tp` is an ordinary (ignored) pattern
;; variable, so ANY type works with no per-type syntax. A variety
;; overrides only when it needs to, via `extend-syntax` with its type as
;; a literal (newer rules take precedence), e.g.
;;
;;     extend-syntax config:
;;         syntax-rules [kafka]:
;;             case (config (kafka name) params ...): ...
;;
;; exactly like `(help (pragma key))`.


;; The generic `job` entry point is a thin DISPATCHER: it builds the
;; per-type syntax name `job/<type>` and delegates the whole tail to it.
;; A variety self-registers simply by defining its `job/<type>` syntax,
;; which owns that type's header grammar and tag-injects the sub-items.

define-syntax job:
    macro-rules []:
        case (job tp rest ...):
            ;; the type tag is a label: its base names the variety
            `(,(datum (symbol f"job/{tp.datum.base}")) ,@rest)


;; The `jobset` macro is a partition-and-splice over its entries. It never
;; enumerates types: config entries are rewritten to `(config/<type> ...)`
;; and emitted FIRST (so `default/<type>` slots and named configs exist
;; before any job wires to them); job entries stay `(job <type> ...)` (they
;; self-dispatch) and each resulting binding is registered by name. An
;; unnamed config (settings start with a keyword) is rewritten with a `()`
;; name sentinel; a named one keeps its symbol.
define-syntax jobset:
    macro-rules []:
        case (jobset jsname entry ...):
            define configs #[]
            define jobforms #[]
            define regs #[]

            ;; an entry is the caller's code: it goes back out as its
            ;; match, or rebuilt inside a datum, so hygiene leaves it be
            for-each [e entry]:
                define-values [head [tp rest]] e.datum
                if (== (str head.base) "config"):
                    define newhead (symbol f"config/{tp.base}")
                    if (keyword? (car rest)):
                        (configs.append (datum (cons newhead nil rest)))
                    else:
                        (configs.append (datum (cons newhead rest)))
                else:
                    (jobforms.append e)
                    define jname (car rest)
                    (regs.append
                        `(.register ,jsname ,(str jname) ,(datum jname)))

            ;; the storage and access slots are the ones their configs
            ;; bound at the use site, written raw
            `(begin
                ,@configs
                ,@jobforms
                (define ,jsname (JobSet ,(str jsname.datum)))
                (define ,-'default/storage)
                (if &,-'default/storage
                    (.bind-store ,jsname ,-'default/storage)
                    (.bind-store ,jsname None))
                (define ,-'default/access)
                (if &,-'default/access
                    (.bind-access ,jsname ,-'default/access)
                    (.bind-access ,jsname None))
                ,@regs)


define-syntax config:
    syntax-rules []:
        case (config (tp name) params ...):
            (.configure name params ...)


define-syntax handler:
    syntax-rules []:
        case (handler (tp name) [formals ...] body ...):
            (.handler name (lambda [formals ...] body ...))
        case (handler (tp name) [] body ...):
            (.handler name (lambda [] body ...))


;; A second inherited CODE sub-item: `on-error [err msg]:` routes to the
;; job's `on-error` setter. Varieties that support it (e.g. kafka) define
;; the method; others simply never receive the sub-item.
define-syntax on-error:
    syntax-rules []:
        case (on-error (tp name) [formals ...] body ...):
            (.on-error name (lambda [formals ...] body ...))
        case (on-error (tp name) [] body ...):
            (.on-error name (lambda [] body ...))


;; `allow #[..]` -- the access sub-item: the group names whose members
;; may trigger the job. A childless line in the job block (no colon, no
;; body), routed to the inherited `allow` setter.
define-syntax allow:
    syntax-rules []:
        case (allow (tp name) groups):
            (.allow name groups)


;; `with-subitems` factors the tag injection so a procedural (macro-rules)
;; variety -- one that must compute its header, like cron's schedule --
;; can still splice sub-items uniformly: it emits
;; `(with-subitems (cron name) subitem ...)` and this maps the tag into
;; each. Syntax-rules varieties can inline the same `(subhead (t n) ...)
;; ...` pattern directly instead.
define-syntax with-subitems:
    syntax-rules []:
        case (with-subitems tag (subhead subrest ...) ...):
            (begin (subhead tag subrest ...) ...)


;; --- config-value helpers ------------------------------------------

;; A required-env reader for use inside config blocks. It resolves an
;; environment variable at load time and raises when unset, so a
;; misconfigured pod dies at startup rather than at first connect.
;; Exported into the baseline so a jobset definition can name it
;; directly in a config value:
;;
;;     config kafka:
;;         sasl_plain_password: (reqenv "SECRET_KAFKA_PASS")
define reqenv [name]:
    define val (os.getenv name)
    when (None? val):
        raise (KeyError f"required environment variable unset: {name}")
    val


;; --- service configs (config-only types, no jobs) ------------------

;; `config logging:` -> configure the stdlib logger. The expansion calls
;; an EXPORTED helper (not basicConfig directly), because a macro's free
;; names resolve at the USE site -- and the user module imports the
;; kosrunner exports, not logging.basicConfig.
define configure-logging [**: kw]:
    (basicConfig **: kw)


define-syntax config/logging:
    syntax-rules []:
        case (config/logging () setting ...):
            (configure-logging setting ...)


;; The end.
