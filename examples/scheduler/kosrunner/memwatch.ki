;; Process memory sampling for a long-lived runner. `memory-report` is
;; meant to be the whole body of a cron job's handler: each fire logs one
;; line of process totals plus the types that grew since the last fire,
;; and because it logs to a `kosrunner.*` logger the report lands in that
;; run's own output.log alongside every other run in the history.

import gc
import sys
import asyncio
import logging
import threading
import tracemalloc

import-from collections Counter
import-from pathlib Path


var logger (logging.getLogger "kosrunner.memwatch")

var _STATUS (Path "/proc/self/status")

;; Two references to measure against: the previous sample (movement) and
;; the first one of this process (drift). Drift is the leak signal --
;; per-sample movement alone cannot tell a climb from jitter, because a
;; count oscillating around a stable mean is up half the time it is
;; sampled. Module-level, so two memwatch jobs in one definition would
;; share (and fight over) them.
var _prev #{}
var _base #{}
var _base-totals #{}
var _samples 0

;; the previous sample's per-line tracemalloc statistics, held only
;; while tracing is on -- never the Snapshot itself, which materializes
;; millions of blocks and would be traced by the next take_snapshot
var _snap None


def vmrss []:
    """
    This process's resident set size in KiB, read from /proc/self/status.
    None where that file does not exist (anywhere but Linux).
    """

    unless (_STATUS.exists):
        return None
    for-each [line ((_STATUS.read_text).splitlines)]:
        when (line.startswith "VmRSS:"):
            return (int (line.split)[1])
    None


def memory-census []:
    """
    Live objects by type name, counted AFTER a full collection so that
    everything counted is genuinely reachable rather than cyclic garbage
    that has simply not been swept yet. Returns the collection's count
    and the census.
    """

    var collected (gc.collect)
    var counts (Counter
        (list-each [obj (gc.get_objects)] obj.__class__.__name__))
    (values collected counts)


def _drift [key value unit: ""]:
    """
    One header figure as `<total><unit>(<drift>)`, the drift measured
    against this process's first sample of that figure -- a total on its
    own says nothing about which way it is going. The first sample IS the
    baseline, so it prints bare.
    """

    when (None? value):
        return "n/a"

    var first (_base-totals.get key)
    when (None? first):
        set! _base-totals[key] value
        return f"{value}{unit}"

    f"{value}{unit}({(- value first):+d})"


def _task-count []:
    try:
        len (asyncio.all_tasks)
    except [RuntimeError]:
        None


def _snapshot-report [top]:
    """
    Log the `top` allocation sites whose retained bytes have moved the
    most since the previous sample, ranked like the census by the size
    of the move in either direction. Does nothing unless tracemalloc is
    tracing -- enable it by starting the process with
    PYTHONTRACEMALLOC=<frames>. Only per-line statistics survive
    between samples; holding the Snapshot would hand the next
    take_snapshot millions of its own blocks to trace, tripling the
    walk and ratcheting RSS. The transient snapshot still costs one
    walk of the traced blocks per fire. The first tracing sample only
    captures the baseline, so movements begin one sample later.
    """

    unless (tracemalloc.is_tracing):
        return None

    var snap ((tracemalloc.take_snapshot).filter_traces
        #((tracemalloc.Filter False "<frozen importlib._bootstrap>")
          (tracemalloc.Filter False "<unknown>")
          (tracemalloc.Filter False tracemalloc.__file__)))

    var stats #{}
    for-each [stat (snap.statistics "lineno")]:
        let [[frame stat.traceback[0]]]:
            (set! stats[f"{frame.filename}:{frame.lineno}"]
                #(stat.size stat.count))

    global var _snap
    var prev _snap
    set! _snap stats

    when (None? prev):
        logger.info "  tracemalloc baseline captured"
        return None

    ;; every line seen in either sample, so a site that vanished shows
    ;; its fall rather than silently dropping out of the report
    var keys (set (stats.keys))
    keys.update (prev.keys)

    var moved:
        list-each [where keys]:
            let [[cur (stats.get where #(0 0))]
                 [old (prev.get where #(0 0))]]:

                #((abs (- cur[0] old[0]))
                  (- cur[0] old[0])
                  (- cur[1] old[1])
                  cur[0] cur[1] where)

    for-each [[mag sdiff cdiff size count where]
              (item-slice (sorted moved reverse: True) stop: top)]:
        when mag:
            (logger.info "  %-52s %9dB (%+d)  blocks %d (%+d)"
                where size sdiff count cdiff)
    None


def memory-report [top: 10]:
    """
    Log one memory sample: process totals, then the `top` types that have
    drifted furthest since this process's first sample. Every figure is
    reported as a total AND a movement -- a total alone cannot show a
    trend, and a delta alone cannot show the scale it moved against.
    Returns the totals line, so a handler can pass it to `mnemonic` and
    put this sample's numbers straight into the run history.

    `blocks` (every live pymalloc block) is the number that decides
    whether a climbing RSS is a leak. `live` counts only GC-TRACKED
    containers, and CPython untracks a dict whose values are all scalars,
    so a pile-up of strings, ints, or scalar dicts moves `blocks` while
    leaving `live` flat. Blocks climbing with RSS is retention -- the
    types below usually name it. Blocks flat under a climbing RSS is
    allocator fragmentation or allocation outside pymalloc (thread
    stacks, sqlite, the extension), and nothing this process is holding.

    Read the two per-type numbers together. Only a `first` that keeps
    climbing sample after sample is retention; one that wanders either
    side of zero while `last` flips sign is a count that jitters, which
    plenty of them do. The first few samples of a process include its
    warm-up, so treat an early drift as a baseline still settling.

    When tracemalloc is tracing (start the process with
    PYTHONTRACEMALLOC=<frames>), each sample also logs the allocation
    sites whose retained bytes moved most since the previous sample --
    the file:line view of the drift that `blocks` shows only in
    aggregate.
    """

    var [collected counts] (memory-census)

    global var _samples
    incr! _samples

    ;; built as one string rather than logged with args, because it is
    ;; also the return value -- a handler hands it to `mnemonic` to label
    ;; its own run with the numbers the history is scanned for
    var sample _samples
    var rss (_drift "rss" (vmrss) unit: "KiB")
    var blocks (_drift "blocks" (sys.getallocatedblocks))
    var live (_drift "live" (sum (counts.values)))
    var threads (threading.active_count)
    var tasks (_task-count)
    var line f"sample={sample} rss={rss} blocks={blocks} live={live}"-
                f" collected={collected} threads={threads} tasks={tasks}"
    (logger.info "%s" line)

    ;; ranked by the SIZE of the drift, not its sign: a count that fell
    ;; is as much of a clue as one that rose, and hiding the falls is
    ;; what makes an oscillating count read as a leak
    when _base:
        var moved (list-each [[name n] (counts.items)]
            (let [[drift (- n (_base.get name 0))]]
                #((abs drift) drift (- n (_prev.get name 0)) n name)))

        for-each [[mag drift delta n name]
                  (item-slice (sorted moved reverse: True) stop: top)]:
            when drift:
                (logger.info "  %-28s %8s  last %+d  first %+d" name n delta drift)

    unless _base:
        (_base.update counts)
    (_prev.clear)
    (_prev.update counts)

    (_snapshot-report top)
    line


;; The end.
