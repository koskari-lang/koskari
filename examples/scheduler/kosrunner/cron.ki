import logging

import-from dataclasses dataclass

(use .job Config Job)
(use .subitems with-subitems)


var logger (logging.getLogger "kosrunner.cron")


@dataclass
class CronConfig [Config]:
    """
    Cron config; usually left default (cron jobs carry no config)
    """

    var timezone :: str None


class CronJob [Job]:
    """
    A schedule-driven job; fires its handler on the crontab schedule
    """

    var config-class CronConfig

    def __init__ [self schedule]:
        (Job.__init__ self)
        set! self.schedule schedule
        set! self._handle None


    def trigger-spec [self]:
        ;; fire now, no fields; the schedule is ignored for a manual run
        #{}


    def start [self]:
        import aiocron

        set! self.running True
        (logger.info "scheduling cron job: %s" self.schedule)

        ;; the tracked run (record + capture + on-error) lives in Job.run
        def fire []:
            (self.run cause: "schedule")

        set! self._handle (aiocron.crontab
            self.schedule
            func: fire
            start: True)


    def stop [self]:
        set! self.running False
        unless (None? self._handle):
            (self._handle.stop)
            set! self._handle None


;; `config cron [name]:` -- optional; cron jobs run fine with no config.
syntax config/cron:
    syntax-rules []:
        case (config/cron () setting ...):
            (begin
                (var -'default/cron)
                (unless &-'default/cron
                    (set! -'default/cron (CronConfig setting ...))))
        case (config/cron nm setting ...):
            (begin
                (var nm (CronConfig setting ...))
                (var -'default/cron)
                (unless &-'default/cron (set! -'default/cron nm)))


;; `(job cron <name> [<m> <h> <dom> <mon> <dow>] ...)`
;; `(job cron <name> <schedule-string> ...)`
;;
;; -- the trigger key is the 5 crontab fields, joined into a schedule
;; string at expand time (the fields include `*`, which cannot be passed
;; as a runtime value). macro-rules is needed for that; sub-items go through
;; `with-subitems`.
syntax job/cron:
    macro-rules []:
        case (job/cron name [mi hr dom mon dow] sub ...):
            var sched f"{mi.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}"
            `(job/cron ,name ,sched ,@sub)

        case (job/cron name sched sub ...):
            `(begin
                (var ,name (CronJob ,sched))
                (var ,-'default/cron)
                (if &,-'default/cron
                    (.configure ,name via: ,-'default/cron)
                    (.configure ,name))
                (with-subitems (cron ,name) ,@sub))


;; The end.
