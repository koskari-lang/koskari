import logging

(use .job Config Job)
(use .subitems with-subitems)


define logger (logging.getLogger "kosrunner.cron")


define-dataclass CronConfig [Config]:
    """
    Cron config; usually left default (cron jobs carry no config)
    """

    define [timezone :: str] None


define-class CronJob [Job]:
    """
    A schedule-driven job; fires its handler on the crontab schedule
    """

    define config-class CronConfig

    define __init__ [self schedule]:
        (Job.__init__ self)
        set! self.schedule schedule
        set! self._handle None


    define trigger-spec [self]:
        ;; fire now, no fields; the schedule is ignored for a manual run
        #{}


    define start [self]:
        import aiocron

        set! self.running True
        (logger.info "scheduling cron job: %s" self.schedule)

        ;; the tracked run (record + capture + on-error) lives in Job.run
        define fire []:
            (self.run cause: "schedule")

        set! self._handle (aiocron.crontab
            self.schedule
            func: fire
            start: True)


    define stop [self]:
        set! self.running False
        unless (None? self._handle):
            (self._handle.stop)
            set! self._handle None


;; `config cron [name]:` -- optional; cron jobs run fine with no config.
define-syntax config/cron:
    syntax-rules []:
        case (config/cron slot () setting ...):
            (begin
                (define slot)
                (unless &slot
                    (set! slot (CronConfig setting ...))))
        case (config/cron slot nm setting ...):
            (begin
                (define nm (CronConfig setting ...))
                (define slot)
                (unless &slot (set! slot nm)))


;; `(job cron <name> [<m> <h> <dom> <mon> <dow>] ...)`
;; `(job cron <name> <schedule-string> ...)`
;;
;; -- the trigger key is the 5 crontab fields, joined into a schedule
;; string at expand time (the fields include `*`, which cannot be passed
;; as a runtime value). macro-rules is needed for that; sub-items go through
;; `with-subitems`.
define-syntax job/cron:
    macro-rules []:
        case (job/cron slot name [mi hr dom mon dow] sub ...):
            define sched f"{mi.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}"
            `(begin
                (define ,name (CronJob ,sched))
                (define ,slot)
                (if &,slot
                    (.configure ,name via: ,slot)
                    (.configure ,name))
                (with-subitems (cron ,name) ,@sub))

        case (job/cron slot name sched sub ...):
            `(begin
                (define ,name (CronJob ,sched))
                (define ,slot)
                (if &,slot
                    (.configure ,name via: ,slot)
                    (.configure ,name))
                (with-subitems (cron ,name) ,@sub))


;; The end.
