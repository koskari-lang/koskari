import logging

import aiocron

import-from .job Job


define logger (logging.getLogger "kosrunner.cron")


define-class CronJob [Job]:

    define __init__ [self schedule callback]:
        set! self.schedule schedule
        set! self.callback callback
        set! self._handle None

    define start [self]:
        (logger.info "Scheduling cron job: %s" self.schedule)
        define cb self.callback
        define sched self.schedule
        define fire []:
            (logger.info "Firing cron job: %s" sched)
            try:
                (cb)
                (logger.info "Cron job completed: %s" sched)
            except [Exception]:
                (logger.error "Cron job failed: %s" sched exc_info: True)
        set! self._handle (aiocron.crontab
            self.schedule
            func: fire
            start: True)

    define stop [self]:
        (logger.info "Stopping cron job: %s" self.schedule)
        unless (None? self._handle):
            (self._handle.stop)
            set! self._handle None


define-syntax on-cron:
    macro-rules [compile/begin]:

        case (on-cron min hr dom mon dow (compile/begin body ...)):
            (define schedule
                f"{min.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}")
            `(CronJob ,schedule (lambda [] ,@body))

        case (on-cron [min hr dom mon dow] body ...):
            (define schedule
                f"{min.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}")
            `(CronJob ,schedule (lambda [] ,@body))

        case (on-cron schedule (begin body ...)):
            `(CronJob ,schedule (lambda [] ,@body))

        case (on-cron schedule fn):
            `(CronJob ,schedule ,fn)


define layout/on-cron layout/block-begin


;; The end.
