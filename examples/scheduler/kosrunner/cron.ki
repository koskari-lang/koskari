import logging

import-from .job Config Job
import-from .subitems with-subitems


define logger (logging.getLogger "kosrunner.cron")


define-class CronConfig [Config]:
    """Settings bag for cron (e.g. timezone); usually left default."""


define-class CronJob [Job]:
    """A schedule-driven job; fires its handler on the crontab schedule."""

    define __init__ [self schedule]:
        (Job.__init__ self)
        set! self.schedule schedule
        set! self._handle None

    define start [self]:
        import aiocron
        set! self.running True
        (logger.info "scheduling cron job: %s" self.schedule)
        define cb self.callback
        define sched self.schedule
        define fire []:
            (logger.info "firing cron job: %s" sched)
            try:
                (cb)
            except [Exception]:
                (logger.error "cron job failed: %s" sched exc_info: True)
        set! self._handle (aiocron.crontab self.schedule func: fire start: True)

    define stop [self]:
        set! self.running False
        unless (None? self._handle):
            (self._handle.stop)
            set! self._handle None


;; `config cron [name]:` -- optional; cron jobs run fine with no config.
define-syntax config/cron:
    syntax-rules []:
        case (config/cron () setting ...):
            (begin
                (define default/cron)
                (unless &default/cron
                    (set! default/cron (CronConfig setting ...))))
        case (config/cron nm setting ...):
            (begin
                (define nm (CronConfig setting ...))
                (define default/cron)
                (unless &default/cron (set! default/cron nm)))


;; `job cron <name> <m> <h> <dom> <mon> <dow> [disabled]:` -- the trigger
;; key is the 5 crontab fields, joined into a schedule string at expand
;; time (the fields include `*`, which cannot be passed as a runtime
;; value). macro-rules is needed for that; sub-items go through
;; `with-subitems`.
define-syntax job/cron:
    macro-rules [disabled]:
        case (job/cron name mi hr dom mon dow disabled sub ...):
            define sched f"{mi.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}"
            `(begin
                (define ,name (CronJob ,sched))
                (set! (attr ,name enabled) False)
                (define default/cron)
                (when &default/cron (.configure ,name via: default/cron))
                (with-subitems (cron ,name) ,@sub))

        case (job/cron name mi hr dom mon dow sub ...):
            define sched f"{mi.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}"
            `(begin
                (define ,name (CronJob ,sched))
                (define default/cron)
                (when &default/cron (.configure ,name via: default/cron))
                (with-subitems (cron ,name) ,@sub))


;; The end.
