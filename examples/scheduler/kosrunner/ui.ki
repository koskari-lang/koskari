import os
import html
import logging

import jinja2

import-from importlib.util find_spec
import-from fastapi.responses HTMLResponse RedirectResponse

import-from .access operator? resolve-identity trigger-allowed?
import-from .job Job
import-from .server get-server normalize-prefix ServerConfig
import-from .webhook coerce-input


;; run-history rows per page on the job page
define PAGE-SIZE 20


define logger (logging.getLogger "kosrunner.ui")


define-dataclass UiConfig [ServerConfig]:
    """
    Config for the human-facing web UI's shared server; prefix defaults
    to /ui. Same host:port as a webhook/admin config -> one FastAPI
    server, each mounting under its own prefix.
    """

    define [prefix :: str] "/ui"


;; Templates ship as package data. Koskari modules have no __file__, so
;; the package directory is located via its import spec.
define _build-env []:
    define spec (find_spec "kosrunner")
    define pkgdir (item (list spec.submodule_search_locations) 0)
    define tdir (os.path.join pkgdir "templates")
    (jinja2.Environment
        loader: (jinja2.FileSystemLoader tdir)
        autoescape: True)


define _render [env name ctx]:
    define template (env.get_template name)
    (HTMLResponse (template.render ctx))


define _redirect [target]:
    ;; 303 so the browser re-GETs after a form POST
    (RedirectResponse target status_code: 303)


define _forbid []:
    ;; the human-flavored 403 (the admin API's guards answer in JSON)
    (HTMLResponse "<h1>403 Forbidden</h1><p>you are not allowed to do that</p>"
        status_code: 403)


define _trigger-fields [spec]:
    """
    Flatten a webhook input spec (name -> type or #(type default)) into
    the field descriptors the trigger form template renders.
    """

    define out #[]
    when spec:
        for-each [[name typ] (spec.items)]:
            define-values [t default required] (if (instance? typ tuple)
                (values (item typ 0) (item typ 1) False)
                (values typ None True))
            (out.append #{"name": name
                          "type": t.__name__
                          "required": required
                          "default": default})
    out


define-class UiJob [Job]:
    """
    The human-facing control plane: Jinja2-rendered HTML mounted on the
    shared server. Reads the live JobSet and its run store in-process
    (`self.jobset` / `self.jobset.store`) -- no HTTP hop to the admin
    API. Its form actions POST to its own prefix and redirect back.
    """

    define config-class UiConfig

    define mount [self server]:
        """
        Mount the UI page hierarchy on `server`: the dashboard is a
        gateway (jobs grouped by variety, each with its last run), the
        job page holds the actions (gated enable/disable, the trigger
        form when the job's trigger-spec allows one, and paged run
        history), and the run page shows one run under its job. Pages are
        the anonymous read floor; actions are guarded against the
        jobset's access lists (open when there are none), answering 403
        as HTML. Split from `start` so an embedding (or a test) can mount
        on a server it manages itself.
        """

        define prefix (normalize-prefix self.config.prefix)
        define root (if (== prefix "") "/" prefix)
        define js self.jobset
        define env (_build-env)

        define job-url [name]:
            f"{prefix}/jobs/{name}"

        ;; dashboard: the gateway. Jobs grouped by variety, one status
        ;; line each, the name linking into the job page and the last run
        ;; linking straight into that run.
        define page-dashboard [ctx]:
            define identity (resolve-identity ctx)
            define groups #{}
            for-each [j (js.visible-jobs identity)]:
                define tp (item j "type")
                unless (in? tp groups):
                    (set! (item groups tp) #[])
                (.append (item groups tp) j)
            (_render env "dashboard.html"
                #{"prefix": prefix
                  "root": root
                  "groups": groups
                  "crumbs": #[]})

        ;; job page: status + gated actions + optional trigger form +
        ;; paged run history (newest first; fetch one over the page size
        ;; to know whether an older page exists)
        define page-job [name ctx]:
            define job (js.jobs.get name)
            if (None? job):
                (HTMLResponse "<h1>404</h1><p>no such job</p>" status_code: 404)
            else:
                define spec (job.trigger-spec)
                define page (max 1 (try (int (or (ctx.param "page") 1))
                    (except: 1)))
                define offset (* (- page 1) PAGE-SIZE)
                define rows (if js.store
                    (js.store.list-runs job: name limit: (+ PAGE-SIZE 1) offset: offset)
                    #[])
                (_render env "job.html"
                    #{"prefix": prefix
                      "root": root
                      "name": name
                      "type": (job._job-kind)
                      "enabled": job.enabled
                      "running": job.running
                      "may_control": (operator? js.access ctx)
                      "may_trigger": (trigger-allowed? js.access ctx job)
                      "fields": (if (None? spec) None (_trigger-fields spec))
                      "runs": (item-slice rows stop: PAGE-SIZE)
                      "page": page
                      "has_next": (> (len rows) PAGE-SIZE)
                      "crumbs": #[#{"label": name}]})

        ;; run page: one run's detail (metadata + trigger + captured
        ;; output/result), under its job in the breadcrumb
        define page-run [runid ctx]:
            define detail (js.store.run-detail runid)
            if (None? detail):
                (HTMLResponse "<h1>404</h1><p>no such run</p>" status_code: 404)
            else:
                define jobname (item detail "job")
                define job (js.jobs.get jobname)
                (_render env "run.html"
                    #{"prefix": prefix
                      "root": root
                      "run": detail
                      "may_retrigger": (and job (trigger-allowed? js.access ctx job))
                      "crumbs": #[#{"label": jobname "href": (job-url jobname)}
                                  #{"label": (item detail "run_id")}]})

        (server.add-page root page-dashboard)
        (server.add-page-item f"{prefix}/jobs" page-job)
        (server.add-page-item f"{prefix}/runs" page-run)

        ;; form actions -> guard, act, then redirect back to the job page
        define do-enable [name ctx]:
            (if (operator? js.access ctx)
                (begin (js.enable name) (_redirect (job-url name)))
                (_forbid))

        define do-disable [name ctx]:
            (if (operator? js.access ctx)
                (begin (js.disable name) (_redirect (job-url name)))
                (_forbid))

        define do-retrigger [runid ctx]:
            define trig (js.store.get-trigger runid)
            define jobname (if (None? trig) None (item trig "job"))
            define job (if (None? jobname) None (js.jobs.get jobname))
            (if (or (None? job) (trigger-allowed? js.access ctx job))
                (begin
                    (js.retrigger runid)
                    (_redirect (if jobname (job-url jobname) root)))
                (_forbid))

        ;; manual trigger: the job's trigger-spec drives both the form
        ;; fields and the coercion of what comes back; a job whose spec
        ;; is None cannot be fired fresh from here
        define do-trigger [name form ctx]:
            import-from fastapi HTTPException
            define job (js.jobs.get name)
            define spec (if (None? job) None (job.trigger-spec))
            if (None? job):
                (HTMLResponse "<h1>404</h1><p>no such job</p>" status_code: 404)
            elif (not (trigger-allowed? js.access ctx job)):
                (_forbid)
            elif (None? spec):
                (HTMLResponse
                    "<h1>400</h1><p>this job cannot be triggered manually</p>"
                    status_code: 400)
            else:
                try:
                    define kwargs (coerce-input spec form)
                    (job.run **: kwargs cause: "manual")
                    (_redirect (job-url name))
                except [HTTPException as: exc]:
                    (HTMLResponse
                        f"<h1>400</h1><p>{(html.escape (str exc.detail))}</p>"
                        status_code: 400)

        (server.add-action prefix "enable" do-enable)
        (server.add-action prefix "disable" do-disable)
        (server.add-action prefix "retrigger" do-retrigger)
        (server.add-form f"{prefix}/trigger" do-trigger)


    define start [self]:
        set! self.running True
        define server (get-server self.config)
        (self.mount server)
        (server.start)
        (logger.info "web ui mounted at %s" self.config.prefix)


    define stop [self]:
        set! self.running False


define-syntax config/ui:
    syntax-rules []:
        case (config/ui () setting ...):
            (begin
                (define default/ui)
                (unless &default/ui
                    (set! default/ui (UiConfig setting ...))))
        case (config/ui nm setting ...):
            (begin
                (define nm (UiConfig setting ...))
                (define default/ui)
                (unless &default/ui (set! default/ui nm)))


;; `job ui <name>` -- no trigger key; serves from its config.
define-syntax job/ui:
    syntax-rules []:
        case (job/ui name (subhead subrest ...) ...):
            (begin
                (define name (UiJob))
                (define default/ui)
                (if &default/ui
                    (.configure name via: default/ui)
                    (.configure name))
                (subhead (ui name) subrest ...) ...)


;; The end.
