"""
Koskari asyncio job scheduler example

Framework types, jobset/on-cron syntax, and a demo cron workload.

:author: Christopher O'Brien <obriencj@preoccupied.net>
:license: GNU General Public License v3
"""

import-from datetime datetime
import-from logging getLogger basicConfig
import-from typing Protocol

import-from .job JobSet jobset
import-from .cron:
    CronJob on-cron layout/on-cron
import-from .kafka:
    KafkaConfig KafkaJob kafka-config on-kafka
    layout/kafka-config
import-from .webhook:
    WebhookServer WebhookJob webhook-config on-webhook
    layout/webhook-config


declare-exports [
    JobSet
    jobset

    logging-config
    layout/logging-config

    CronJob
    on-cron
    layout/on-cron

    KafkaConfig
    kafka-config
    layout/kafka-config

    KafkaJob
    on-kafka

    WebhookServer
    webhook-config
    layout/webhook-config

    WebhookJob
    on-webhook
]


define-syntax use-kosrunner:
    macro-rules []:
        case (use-kosrunner):
            (define names (list-each [n __all__] (symbol n)))
            `(import-from ,__name__ ,@names)


define logging-config [level: "WARN" **: kwargs]:
    basicConfig level: level **: kwargs


define layout/logging-config layout/inline-block


;; The end.
