"""
Koskari asyncio job scheduler example

Framework types, jobset/on-cron syntax, and a demo cron workload.
"""


import aiocron
import-from datetime datetime
import-from typing Protocol


declare-exports [
    JobSet
    CronJob
    Job

    on-cron
    jobset

    layout/on-cron
]


;; Types


define-class Job []:
    """
    Abstract job protocol; subclasses implement start and stop
    """

    define start [self]:
        (raise (NotImplementedError f"{self}.start"))

    define stop [self]:
        (raise (NotImplementedError f"{self}.stop"))


define-class CronJob [Job]:

    define __init__ [self schedule callback]:
        set! self.schedule schedule
        set! self.callback callback
        set! self._handle None

    define start [self]:
        set! self._handle (aiocron.crontab
            self.schedule
            func: self.callback
            start: True)

    define stop [self]:
        unless (None? self._handle):
            (self._handle.stop)
            set! self._handle None


define-class JobSet []:

    define __init__ [self name jobs: nil]:
        set! self.name name
        set! self.jobs jobs

    define __call__ [self heartbeat: 3600 snore: False]:
        (self.start)
        while True:
            (when snore (print "zzz"))
            (sleep heartbeat)

    define start [self]:
        for-each [job self.jobs]:
            (job.start)

    define stop [self]:
        for-each [job self.jobs]:
            (job.stop)


;; Layout and syntax


define layout/on-cron layout/block-begin


define-syntax on-cron:
    macro-rules [compile/begin]:

        case (on-cron min hr dom mon dow (compile/begin body ...)):
            (define schedule
                f"{min.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}")
            `(CronJob ,schedule (lambda [] ,@body))

        case (on-cron [min hr dom mon dow] body ...):
            (define schedule
                f"{min.datum} {hr.datum} {dom.datum} {mon.datum} {dow.datum}")
            `(CronJob ,schedule (lambda [] ,@body))

        case (on-cron schedule (begin body ...)):
            `(CronJob ,schedule (lambda [] ,@body))

        case (on-cron schedule fn):
            `(CronJob ,schedule ,fn)


define-syntax jobset:
    macro-rules []:
        case (jobset name job ...):
            define n (str name.datum)
            `(define ,name (JobSet ,n jobs: #[,@job]))


define-syntax use-kosrunner:
    macro-rules []:
        case (use-kosrunner):
            (define names (list-each [n __all__] (symbol n)))
            `(import-from ,__name__ ,@names)


;; The end.
