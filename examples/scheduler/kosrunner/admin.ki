import logging

(use .access require-operator! require-trigger!)
(use .job Job)
(use .server get-server normalize-prefix ServerConfig)


define logger (logging.getLogger "kosrunner.admin")


define-dataclass AdminConfig [ServerConfig]:
    """
    Config for the control-plane server; prefix defaults to /admin
    """

    define [prefix :: str] "/admin"


define-class AdminJob [Job]:
    """
    The jobset's control plane as HTTP routes. It reaches its parent
    JobSet through the `jobset` back-reference the JobSet sets at register
    time, and mounts list/enable/disable under its config's prefix. Its
    config is a plain server config, so if it shares a host:port with a
    webhook it shares that webhook's FastAPI server (see server.get-server).
    """

    define config-class AdminConfig

    define mount [self server]:
        """
        Mount the control-plane routes on `server`. Reads are the
        anonymous floor; mutations are guarded against the jobset's access
        lists (open when there are none) -- enable/disable/shutdown need
        operator level, retrigger needs trigger rights on the run's job.
        Split from `start` so an embedding (or a test) can mount on a
        server it manages itself.
        """

        define prefix (normalize-prefix self.config.prefix)
        define js self.jobset

        define do-enable [name ctx]:
            (require-operator! js.access ctx)
            (js.enable name)
            #{"enabled": name}

        define do-disable [name ctx]:
            (require-operator! js.access ctx)
            (js.disable name)
            #{"disabled": name}

        define do-shutdown [payload ctx]:
            (require-operator! js.access ctx)
            (js.shutdown)
            #{"ok": True}

        define do-retrigger [runid ctx]:
            define trig (js.store.get-trigger runid)
            unless (None? trig):
                define job (js.jobs.get (item trig "job"))
                unless (None? job):
                    (require-trigger! js.access ctx job)
            (js.retrigger runid)

        (server.add-listing prefix "jobs"
            (lambda [ctx] (js.list-jobs)))
        (server.add-action prefix "enable" do-enable)
        (server.add-action prefix "disable" do-disable)
        (server.add-route prefix "shutdown" do-shutdown)

        ;; run history + replay
        (server.add-listing prefix "runs"
            (lambda [ctx] (js.store.list-runs)))
        (server.add-detail prefix "runs"
            (lambda [runid ctx] (js.store.run-detail runid)))
        (server.add-action prefix "retrigger" do-retrigger)


    define start [self]:
        set! self.running True
        define server (get-server self.config)
        (self.mount server)
        (server.start)
        (logger.info "admin control plane mounted at %s" self.config.prefix)


    define stop [self]:
        set! self.running False


define-syntax config/admin:
    syntax-rules []:
        case (config/admin () setting ...):
            (begin
                (define -'default/admin)
                (unless &-'default/admin
                    (set! -'default/admin (AdminConfig setting ...))))
        case (config/admin nm setting ...):
            (begin
                (define nm (AdminConfig setting ...))
                (define -'default/admin)
                (unless &-'default/admin (set! -'default/admin nm)))


;; `job admin <name>` -- no trigger key and usually no sub-items; it
;; serves the control plane from its config alone.
define-syntax job/admin:
    syntax-rules []:
        case (job/admin name (subhead subrest ...) ...):
            (begin
                (define name (AdminJob))
                (define -'default/admin)
                (if &-'default/admin
                    (.configure name via: -'default/admin)
                    (.configure name))
                (subhead (admin name) subrest ...) ...)


;; The end.
