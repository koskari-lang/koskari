import os
import re
import json
import uuid
import hashlib
import asyncio
import logging

import aiosqlite

import-from contextvars ContextVar
import-from datetime datetime timezone
import-from pathlib Path

import-from .job Config


define logger (logging.getLogger "kosrunner.store")


define-dataclass StorageConfig [Config]:
    """
    Where run history lives. `root` is the store directory; when it is
    None the root is resolved from the KOSRUNNER_STORAGE_ROOT env var,
    then falls back to <cwd>/.kosrunner. `keep_runs` / `keep_days` are
    retention caps (0 = unlimited); pruning is not wired yet.
    """

    define [root :: str] None
    define [keep_runs :: int] 0
    define [keep_days :: int] 0


;; --- root + name resolution ----------------------------------------

define STORAGE-ENV "KOSRUNNER_STORAGE_ROOT"
define _SAFE-RE (re.compile "[^A-Za-z0-9._-]")


define resolve-storage-root [config]:
    """
    config.root (verbatim) -> $KOSRUNNER_STORAGE_ROOT (verbatim) ->
    <cwd>/.kosrunner. The `.kosrunner` holder is applied ONLY in the
    cwd-default case; an explicit config or env root is never suffixed.
    """

    define explicit (when config config.root)
    define fromenv (os.getenv STORAGE-ENV)
    if explicit:
        (Path explicit)
    elif fromenv:
        (Path fromenv)
    else:
        (.joinpath (Path (os.getcwd)) ".kosrunner")


define safe-segment [name]:
    """
    Turn a job name into a safe single-directory segment: allowlist
    [A-Za-z0-9._-], everything else to `_`, `.`/`..`/empty neutralized,
    length-capped. A clean name is used verbatim; only a name that was
    actually changed gets a `-<sha256[:8] of the original>` suffix, so
    distinct names never share a directory.
    """

    define raw (str name)
    define cleaned (_SAFE-RE.sub "_" raw)

    define guarded (if (in? cleaned #("" "." "..")) "_" cleaned)

    define capped (item-slice guarded stop: 100)
    if (== capped raw):
        capped
    else:
        define digest (hashlib.sha256 (raw.encode "utf-8"))
        f"{capped}-{(item-slice (digest.hexdigest) stop: 8)}"


define _utcnow []:
    (datetime.now timezone.utc)


define _utcnow-iso []:
    (.isoformat (_utcnow))


define _make-runid []:
    define stamp (.strftime (_utcnow) "%Y%m%dT%H%M%SZ")
    define token (uuid.uuid4)
    f"{stamp}-{(item-slice token.hex stop: 6)}"


;; --- schema --------------------------------------------------------

define _SCHEMA #[
    "CREATE TABLE IF NOT EXISTS runs (run_id TEXT PRIMARY KEY, job TEXT NOT NULL, job_dir TEXT NOT NULL, type TEXT NOT NULL, cause TEXT NOT NULL, parent TEXT, status TEXT NOT NULL, started_at TEXT NOT NULL, finished_at TEXT, error TEXT, mnemonic TEXT)"
    "CREATE INDEX IF NOT EXISTS runs_job_started ON runs (job, started_at)"
    "CREATE INDEX IF NOT EXISTS runs_status ON runs (status)"
]

;; Columns added to `runs` after the first release. CREATE TABLE IF NOT
;; EXISTS leaves an existing table exactly as it was, so a store built by
;; an older version needs the column added explicitly; the check is by
;; name, and adding a nullable column is instant however many rows the
;; table holds.
define _ADDED-COLUMNS #{"mnemonic": "TEXT"}


;; --- run mnemonics -------------------------------------------------

;; A mnemonic is one short line a handler may hang on its own run --
;; "DOC-1234 reindexed", "sample=58 rss=77032KiB" -- so the job history
;; can be read at a glance instead of by run id. Optional, non-unique,
;; and a property of the RUN rather than its trigger, which is why a
;; retrigger computes its own instead of inheriting one.
define MNEMONIC-MAX 200


define clean-mnemonic [value]:
    """
    Fit whatever a handler passed into one table cell: stringified,
    all whitespace collapsed to single spaces, capped. None -- or
    anything that collapses to nothing -- leaves the run unlabelled.
    """

    when (None? value):
        (return None)

    define text (.join " " (.split (str value)))
    unless text:
        (return None)
    if (> (len text) MNEMONIC-MAX):
        (+ (item-slice text stop: (- MNEMONIC-MAX 3)) "...")
    else:
        text


;; The active run's mnemonic slot. A MUTABLE cell, not a plain value: a
;; ContextVar `.set` performed inside a called function does not reach
;; the caller's context, so `mnemonic` mutates the cell that Job.run put
;; here and still holds, exactly as log capture appends to a buffer
;; rather than re-setting one.
define _current-mnemonic (ContextVar "kosrunner_mnemonic" default: None)


define mnemonic [value]:
    """
    Label the run in progress. Call this from anywhere inside a handler
    (or an on-error hook, which still runs inside the run); the last call
    wins, so a handler may set a provisional label early and refine it
    once it knows more. Outside a run it does nothing, which keeps a
    handler callable directly in a test or a REPL. Returns the cleaned
    text.
    """

    define text (clean-mnemonic value)
    define cell (_current-mnemonic.get)
    unless (None? cell):
        (set! (item cell 0) text)
    text


;; --- per-run log capture ------------------------------------------

;; A run's log output is routed to a per-run buffer selected by this
;; contextvar, so concurrent runs (overlapping webhook/kafka handlers)
;; each capture only their own lines.
define _current-run (ContextVar "kosrunner_run" default: None)
define _log-installed #[False]


define-class _RunLogHandler [logging.Handler]:
    """
    Appends each `kosrunner.*` log record to the active run's buffer. The
    `emit` override is @demand-decorated because Python's logging calls it
    synchronously -- without demand it would return an un-awaited
    coroutine and drop the record.
    """

    @demand
    define emit [self record]:
        define buf (_current-run.get)
        when (not (None? buf)):
            (buf.append (self.format record))


define install-run-logging []:
    """
    Attach the capture handler to the `kosrunner` logger once, so every
    variety's log output during a run lands in that run's output.log.
    """

    unless (item _log-installed 0):
        define lg (logging.getLogger "kosrunner")
        define handler (_RunLogHandler)
        (handler.setFormatter
            (logging.Formatter "%(asctime)s %(levelname)s %(name)s %(message)s"))
        (lg.addHandler handler)
        (set! (item _log-installed 0) True)
    None


define-class RunStore []:
    """
    Run history over a single aiosqlite connection, with per-run
    artifacts (trigger/result/log) on disk beneath <root>/runs/<job>/
    <runid>/. One writer, one connection: aiosqlite serializes every
    call on its own thread, so there is no lock to hand-roll.
    """

    define __init__ [self root config: None]:
        set! self.root (Path root)
        set! self.config config
        set! self.runs-dir (self.root.joinpath "runs")
        set! self.dbpath (str (self.root.joinpath "index.db"))
        set! self.db None


    ; --- lifecycle ---

    define open [self]:
        """
        Create the store dirs, connect (WAL), install the schema, and
        reconcile orphaned runs. Idempotent; must run inside a live loop.
        """

        when self.db:
            (return self)

        (install-run-logging)
        (self.root.mkdir parents: True exist_ok: True)
        (self.runs-dir.mkdir parents: True exist_ok: True)

        define db (aiosqlite.connect self.dbpath)
        set! db.row_factory aiosqlite.Row
        set! self.db db

        (self._exec "PRAGMA journal_mode=WAL")
        for-each [stmt _SCHEMA]:
            (self._exec stmt)
        (self.db.commit)

        (self.migrate)
        (self.reconcile)
        (logger.info "run store open: %s" self.dbpath)
        self


    define close [self]:
        when self.db:
            (self.db.close)
            set! self.db None


    define migrate [self]:
        """
        Add any column the running code expects that this store predates.
        Runs on every open and does nothing once the table is current, so
        a store carried across upgrades keeps its history rather than
        needing to be thrown away.
        """

        define have (list-each [col (self._rows "PRAGMA table_info(runs)")]
            (item col "name"))
        for-each [[name decl] (_ADDED-COLUMNS.items)]:
            unless (in? name have):
                (self._exec f"ALTER TABLE runs ADD COLUMN {name} {decl}")
                (self.db.commit)
                (logger.info "store migrated: runs.%s added" name)


    define reconcile [self]:
        """
        A pod that died mid-run leaves a `running` row forever; on open,
        flip any such orphan to `interrupted`.
        """

        (self._exec
            "UPDATE runs SET status = 'interrupted', finished_at = ? WHERE status = 'running'"
            #[(_utcnow-iso)])
        (self.db.commit)


    ; --- sqlite helpers (cursor discipline: drain + close every one) ---

    define _exec [self sql params: None]:
        define cur (self.db.execute sql (or params #[]))
        (cur.fetchall)
        (cur.close)


    define _rows [self sql params: None]:
        define cur (self.db.execute sql (or params #[]))
        define rows (cur.fetchall)
        (cur.close)
        (list (map dict rows))


    define _write-json [self path obj]:
        define data (json.dumps obj indent: 2 default: str)
        (asyncio.to_thread path.write_text data)


    define _write-text [self path text]:
        (asyncio.to_thread path.write_text text)


    ; --- recording ---

    define record-start [self job type cause args: None kwargs: None parent: None]:
        """
        Open a run: mint a sortable id, create its artifact dir, persist
        the trigger args and kwargs (so re-trigger can replay), and insert
        a `running` row. Returns the run id.
        """

        define runid (_make-runid)
        define seg (safe-segment job)
        define rundir (self.runs-dir.joinpath seg runid)
        (rundir.mkdir parents: True exist_ok: True)

        (self._write-json (rundir.joinpath "trigger.json")
            #{"job": job
              "type": type
              "cause": cause
              "parent": parent
              "args": args
              "kwargs": kwargs})

        (self._exec
            "INSERT INTO runs (run_id, job, job_dir, type, cause, parent, status, started_at) VALUES (?, ?, ?, ?, ?, ?, 'running', ?)"
            #[runid job seg type cause parent (_utcnow-iso)])
        (self.db.commit)

        (logger.info "run start: %s %s (%s)" job runid cause)
        runid


    define record-finish [
            self runid status
            result: None error: None log: None mnemonic: None]:
        """
        Close a run: write its result (and captured log) artifacts and
        stamp the row with the final status, finish time, a short error
        summary, and the mnemonic the handler set (if any). The mnemonic
        rides the UPDATE that was happening anyway, so labelling a run
        costs no extra query.
        """

        define row (self.get-run runid)
        when (None? row):
            (logger.warning "record-finish: unknown run %s" runid)
            (return)

        define rundir (self.runs-dir.joinpath (item row "job_dir") runid)
        when (not (None? log)):
            (self._write-text (rundir.joinpath "output.log") log)
        (self._write-json (rundir.joinpath "result.json")
            #{"status": status
              "result": result
              "error": error})
        (self._exec
            "UPDATE runs SET status = ?, finished_at = ?, error = ?, mnemonic = ? WHERE run_id = ?"
            #[status (_utcnow-iso) (if (None? error) None (str error))
              (clean-mnemonic mnemonic) runid])
        (self.db.commit)
        (logger.info "run finish: %s %s" runid status)
        None


    ; --- queries ---

    define get-run [self runid]:
        define rows (self._rows "SELECT * FROM runs WHERE run_id = ?" #[runid])
        (if rows (item rows 0) None)


    define list-runs [self job: None status: None limit: 50 offset: 0]:
        define clauses #[]
        define params #[]
        when job:
            (clauses.append "job = ?")
            (params.append job)
        when status:
            (clauses.append "status = ?")
            (params.append status)
        define joiner " AND "
        define where (if clauses f"WHERE {(joiner.join clauses)}" "")
        (params.append limit)
        (params.append offset)
        (self._rows
            f"SELECT * FROM runs {where} ORDER BY started_at DESC LIMIT ? OFFSET ?"
            params)


    define last-runs [self]:
        """
        The most recent run row per job, as a job-name -> row dict. One
        grouped query, so a dashboard listing every job costs one round
        trip, not one per job.
        """

        define rows (self._rows
            "SELECT r.* FROM runs r JOIN (SELECT job, MAX(started_at) AS latest FROM runs GROUP BY job) m ON r.job = m.job AND r.started_at = m.latest")
        define out #{}
        for-each [row rows]:
            (set! (item out (item row "job")) row)
        out


    define run-log-path [self runid]:
        define row (self.get-run runid)
        (if (None? row)
            None
            (self.runs-dir.joinpath (item row "job_dir") runid "output.log"))


    define _read-text-at [self base name]:
        define path (base.joinpath name)
        (if (path.exists) (asyncio.to_thread path.read_text) None)


    define _read-json-at [self base name]:
        define text (self._read-text-at base name)
        (if (None? text) None (json.loads text))


    define get-trigger [self runid]:
        """
        The persisted trigger record (job/type/cause/parent/args) for a
        run, read from its trigger.json. Re-trigger replays `args`.
        """

        define row (self.get-run runid)
        if (None? row):
            None
        else:
            define base (self.runs-dir.joinpath (item row "job_dir") runid)
            (self._read-json-at base "trigger.json")


    define run-detail [self runid]:
        """
        A run's row enriched with its on-disk artifacts: the captured
        `output` log, the `result`, and the `trigger`. None if unknown.
        """

        define row (self.get-run runid)
        when (None? row):
            (return None)
        define base (self.runs-dir.joinpath (item row "job_dir") runid)
        (set! (item row "output")  (self._read-text-at base "output.log"))
        (set! (item row "result")  (self._read-json-at base "result.json"))
        (set! (item row "trigger") (self._read-json-at base "trigger.json"))
        row


    define prune [self]:
        ;; retention (keep_runs / keep_days) is not wired yet; the method
        ;; exists so callers can start invoking it once the policy lands.
        None


;; --- variety entry syntax ------------------------------------------

;; Storage is singular per jobset, so only the unnamed `()` case is
;; supported: `config storage:` -> `(config/storage () ...)`. It binds
;; the first-wins `default/storage` slot the jobset macro reads when it
;; wires the store onto the JobSet.
define-syntax config/storage:
    syntax-rules []:
        case (config/storage () setting ...):
            (begin
                (define default/storage)
                (unless &default/storage
                    (set! default/storage (StorageConfig setting ...))))


;; The end.
