import json
import logging
import ssl

import-from dataclasses dataclass
import-from contextlib AsyncExitStack
import-from typing Any

;; stompman is the `umb` EXTRA, so it is imported where it is used, not
;; here -- this module must stay importable without it (see `require-extra`)
(use .job Config Job require-extra)


var logger (logging.getLogger "kosrunner.umb")

;; the SSL STOMP port UMB brokers listen on; a `servers` entry may
;; override it per host with the usual `host:port`
var DEFAULT-PORT 61612


def parse-servers [spec port login passcode connect-headers]:
    """
    Split a `host:port,host:port` server string into the
    ConnectionParameters list stompman connects with, trying each in turn.
    A bare host takes the config's `port`. The credentials and connect
    headers are shared by every entry -- one bus, one identity.
    """

    import-from stompman ConnectionParameters

    var out #[]
    for-each [entry (spec.split ",")]:
        var e (entry.strip)
        when e:
            var host e
            var p port
            when (in? ":" e):
                var parts (e.rsplit ":" 1)
                set! host (item parts 0)
                set! p (int (item parts 1))
            (out.append (ConnectionParameters
                host: host
                port: p
                login: login
                passcode: passcode
                connect_headers: connect-headers))
    out


def encode-body [value]:
    """
    Turn a handler's return value into the `(body, content-type)` pair a
    STOMP frame carries. Bytes ride as-is and a str is utf-8 encoded (both
    with no declared content type); anything else is JSON encoded and
    declared `application/json`.
    """

    if (instance? value bytes):
        (values value None)
    elif (instance? value str):
        (values (value.encode "utf-8") None)
    else:
        (values (.encode (json.dumps value) "utf-8") "application/json")


@dataclass
class UmbConfig [Config]:
    """
    A UMB broker connection over STOMP 1.2: the full client surface, with
    sensible defaults, declared in one place. Mirrors KafkaConfig's shape
    where the two buses agree -- `servers` is the same comma-separated
    `host:port` string, and an ssl context is built from the cert files
    automatically.
    """

    ;; required in practice; defaulted None because the base Config's
    ;; defaulted `disabled` field precedes it in the dataclass init, and
    ;; guarded at start so a serverless umb job still dies loudly
    var servers :: str None
    var port :: int DEFAULT-PORT

    ;; UMB authenticates with an x509 client cert, so the STOMP login
    ;; frame is normally empty; both are here for brokers that want one
    var login :: str ""
    var passcode :: str ""

    var ssl_context :: Any None
    var ssl_certfile :: str None
    var ssl_keyfile :: str None
    var ssl_password :: str None
    var ssl_cafile :: str None

    ;; extra headers for the CONNECT frame (e.g. `client-id`, which UMB
    ;; wants for a durable subscription) and for the SUBSCRIBE frame (e.g.
    ;; `selector`, or `activemq.subscriptionName`)
    var connect_headers :: Any None
    var subscribe_headers :: Any None

    var ack :: str "client-individual"

    ;; where a reply goes when the incoming message declares no `reply-to`
    ;; header; unset means a handler's return value is simply dropped
    var reply_to :: str None

    ;; politeness knobs -- how hard we lean on the broker. The heartbeat
    ;; pair is what we promise to send and what we ask to receive; both
    ;; default a good deal quieter than stompman's own 1s/1s, which is
    ;; chatty for a shared bus. The connect trio bounds a reconnect storm.
    var heartbeat_send_ms :: int 10000
    var heartbeat_receive_ms :: int 10000
    var connect_retry_attempts :: int 3
    var connect_retry_interval :: int 1
    var connect_timeout :: int 5

    ;; stompman's transport class -- unset takes its plain TCP one; set it
    ;; to `stompman.connection_ws.WebSocketConnection` for STOMP over a
    ;; websocket (and give the servers their `ws_uri_path`)
    var connection_class :: Any None


class UmbJob [Job]:
    """
    Subscribes to one UMB destination; dispatches each message to the
    handler, and publishes the handler's return value back as a reply.
    """

    var config-class UmbConfig

    def __init__ [self destination]:
        (Job.__init__ self)
        (require-extra "stompman" "umb")
        set! self.destination destination
        set! self._client None
        set! self._stack None
        set! self._subscription None


    ;; umb-variety sub-item setter (paired with the `on-error` macro)
    def on-error [self fn]:
        set! self.on_error_cb fn
        self


    def make-ssl-context [self]:
        """
        The ssl context the client connects with: an explicitly configured
        one wins, otherwise one is built from the cert files -- which is
        what UMB's x509 client-cert authentication needs. Returns None when
        nothing TLS-shaped is configured, leaving a plaintext connection.
        """

        var c self.config
        when c.ssl_context:
            (return c.ssl_context)
        unless (or c.ssl_certfile c.ssl_cafile):
            (return None)

        var ctx (ssl.create_default_context cafile: c.ssl_cafile)
        when c.ssl_certfile:
            (ctx.load_cert_chain c.ssl_certfile
                keyfile: c.ssl_keyfile
                password: c.ssl_password)
        ctx


    def make-client [self]:

        import-from stompman Client Heartbeat

        var c self.config

        ;; the transport defaults to a CLASS, not None, so it can only be
        ;; passed when the config actually names one
        var extra #{}
        when c.connection_class:
            (set! (item extra "connection_class") c.connection_class)

        (Client
            (parse-servers c.servers c.port c.login c.passcode
                (or c.connect_headers #{}))

            ssl: (self.make-ssl-context)

            heartbeat: (Heartbeat c.heartbeat_send_ms c.heartbeat_receive_ms)

            connect_retry_attempts: c.connect_retry_attempts
            connect_retry_interval: c.connect_retry_interval
            connect_timeout: c.connect_timeout

            on_error_frame: (demand self._on-error-frame)

            **: extra)


    def _on-error-frame [self frame]:
        (logger.error "umb error frame on %s: %s" self.destination frame.body)


    def _on-suppressed [self exc frame]:
        ;; Job.run already catches and records a failing handler, so this
        ;; only fires when the dispatch or reply path itself broke
        (logger.error "umb dispatch failed on %s" self.destination exc_info: exc)


    def send [self body destination content-type: None headers: None]:
        """
        Publish one frame on the live connection. `body` must already be
        bytes -- see `encode-body`.
        """

        unless self._client:
            raise (RuntimeError f"umb job {self.name} is not connected")
        (self._client.send body destination
            content_type: content-type
            headers: headers)


    def reply [self msg value]:
        """
        Publish a handler's return value as the reply to `msg`: to the
        message's own `reply-to` header, or the config's `reply_to` when it
        declares none, carrying the correlation id the requester will match
        on. With neither destination there is nowhere to answer, so the
        value is dropped with a warning.
        """

        var dest (or (msg.headers.get "reply-to") self.config.reply_to)
        unless dest:
            (logger.warning "no reply-to for message on %s; reply dropped"
                self.destination)
            (return)

        var [body ctype] (encode-body value)

        ;; JMS-style request/reply: echo the requester's correlation id, or
        ;; fall back to its message id, which is what a requester that sent
        ;; none will be waiting on
        var headers #{}
        var corr (or (msg.headers.get "correlation-id")
            (msg.headers.get "message-id"))
        when corr:
            (set! (item headers "correlation-id") corr)

        (self.send body dest content-type: ctype headers: headers)


    def _dispatch [self msg]:
        """
        The subscription callback: decode the frame body, fire it as a
        tracked run, and publish a non-None result back as the reply. A
        handler that fails records a failed run and dispatches to
        `on-error`, returning None -- so a failed run never answers.
        """

        var raw msg.body
        var value (if (None? raw) None (raw.decode "utf-8"))
        ;; Job.run records the run and dispatches to on-error on failure
        var result (self.run value cause: "umb")
        unless (None? result):
            (self.reply msg result)


    def start [self]:
        when self._client:
            (return)
        when (None? self.config.servers):
            raise (ValueError
                f"umb job {self.name} has no servers configured")
        set! self.running True
        (logger.info "starting umb subscription: %s" self.destination)

        ;; the client is an async context manager and start/stop straddle
        ;; two calls, so the stack holds the entered context for `stop`
        var stack (AsyncExitStack)
        set! self._stack stack
        set! self._client (stack.enter_async_context (self.make-client))
        set! self._subscription (self._client.subscribe
            self.destination
            self._dispatch
            ack: self.config.ack
            headers: self.config.subscribe_headers
            on_suppressed_exception: (demand self._on-suppressed))


    def stop [self]:
        set! self.running False
        ;; unsubscribe FIRST: closing the client waits for its subscriptions
        ;; to drain, so an active one would hold the teardown open
        when self._subscription:
            (self._subscription.unsubscribe)
            set! self._subscription None
        when self._stack:
            (self._stack.aclose)
            set! self._stack None
            set! self._client None


syntax config/umb:
    syntax-rules []:
        case (config/umb () setting ...):
            (begin
                (var -'default/umb)
                (unless &-'default/umb
                    (set! -'default/umb (UmbConfig setting ...))))

        case (config/umb nm setting ...):
            (begin
                (var nm (UmbConfig setting ...))
                (var -'default/umb)
                (unless &-'default/umb (set! -'default/umb nm)))


;; `job umb <name> <destination>:` -- trigger key is the destination.
syntax job/umb:
    syntax-rules []:
        case (job/umb name destination (subhead subrest ...) ...):
            (begin
                (var name (UmbJob destination))
                (var -'default/umb)
                (if &-'default/umb
                    (.configure name via: -'default/umb)
                    (.configure name))
                (subhead (umb name) subrest ...) ...)


;; The end.
