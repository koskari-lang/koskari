# Copy to .env and fill these in. The oauth2-proxy front-end reads them
# at start; nothing here is committed.

# --- OIDC client (the ticket you file with your IdP) ---
# The issuer's well-known base; oauth2-proxy discovers endpoints under it.
OIDC_ISSUER_URL=https://sso.example.internal/realms/main
# Must be registered as an allowed redirect URI on the client above.
OIDC_REDIRECT_URL=https://kosrunner.example.internal/oauth2/callback
OIDC_CLIENT_ID=kosrunner
OIDC_CLIENT_SECRET=change-me
# Restrict who may log in at all; leave as * and let kosrunner's access
# config do the real authz, or pin to your domain for a coarse gate.
OIDC_EMAIL_DOMAIN=*

# --- session cookie signing key ---
# 32 random bytes, base64: openssl rand -base64 32
OAUTH2_COOKIE_SECRET=change-me
