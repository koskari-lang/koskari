"""
Example demonstrating using define-syntax and extend-syntax to
produce macros.
"""


syntax tacos:
    syntax-rules []:
        match (tacos):
             print "Lonely Tacos"

extend-syntax tacos:
    syntax-rules []:
        match (tacos friend):
            print "Tacos with" friend

extend-syntax tacos:
    syntax-rules []:
        match (tacos f1 f2):
            (tacos f"{f1}, and {f2}")
        match (tacos f1 f2 f3 ...):
            (tacos f"{f1}, {f2}" f3 ...)


(tacos)
(tacos 'Zoe)
(tacos 'Zoe 'Mike)
(tacos 'Zoe 'Mike 'Lang)
(tacos 'Zoe 'Mike 'Lang 'Jane)


;; The end.
