"""
Example: Python dataclass decorator on a Koskari class
"""


import-from dataclasses dataclass
import-from itertools product


def around [i reach: 1]:
    (range (- i reach) (+ i reach 1))


@dataclass
class Point []:
    """ A point in 2D space """

    var x :: int 0
    var y :: int 0

    def neighbors [self reach: 1]:
        each [[x y] (product (around self.x reach) (around self.y reach))]:
            (Point x y)

    def move [self x: 0 y: 0]:
        (incr! self.x x)
        (incr! self.y y)

    @property
    def coord [self]:
        #(self.x self.y)

    @coord.setter
    def coord [self value]:
        var [x y] value
        (set! self.x x)
        (set! self.y y)


@entry-point
def main []:
    print "Point class:" Point
    print "Point.__doc__:" Point.__doc__
    print "Point.__annotations__:" Point.__annotations__

    var p (Point 3 5)
    print "p:" p
    print "p.x:" p.x
    print "p.y:" p.y

    print "p.neighbors:"
    for-each [n (p.neighbors)]:
        print "  " n

    print "p.coord:" p.coord

    set! p.coord #(10 20)
    print "set! p.coord #(10 20)"
    print "p.coord:" p.coord
    print "p.x:" p.x
    print "p.y:" p.y

    print "p.neighbors:"
    for-each [n (p.neighbors)]:
        print "  " n


;; The end.
