;; Example: Python dataclass decorator on a Koskari define-class


import-from dataclasses dataclass
import-from itertools product


define around [i reach: 1]:
    (range (- i reach) (+ i reach 1))


@dataclass
define-class Point []:
    """ A point in 2D space """

    define x :: int 0
    define y :: int 0

    define neighbors [self reach: 1]:
        each [[x y] (product (around self.x reach) (around self.y reach))]:
            (Point x y)


when-main:
    print "Point class:" Point
    print "Point.__doc__:" Point.__doc__
    print "Point.__annotations__:" Point.__annotations__

    define p (Point 3 5)
    print "p:" p
    print "p.x:" p.x
    print "p.y:" p.y

    print "p.neighbors:"
    for-each [n (p.neighbors)]:
        print "  " n


;; The end.
