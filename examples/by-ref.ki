"""
Example: Passing references to functions
"""


import-from types SimpleNamespace


define-syntax report:
    """
    Print the source representation of an expression, then
    the value of that expression.

    Optional second argument acts as the line-ending string
    """

    syntax-rules []:
        case (report val):
            (print 'val val)
        case (report val end):
            (print 'val val end: end)


define ref-incr! [&r by: 101]:
    """
    Increment the value within the reference
    """

    ; r was passed by reference, and that reference is now
    ; bound in this namespace. So we simply need to use the
    ; normal incr! macro, which will fetch the value, add to
    ; it, and store the result back. The namespace will
    ; dispatch the value into the ref for us.
    incr! r by


define data-val 123
define data-list #[1 2 3 4]
define data-dict #{a: 5 b: 10}
define data-obj (SimpleNamespace count: 15)


; pass a reference to a named value
report data-val " -> "
ref-incr! &data-val
report data-val

; pass a reference to an item in a list
report data-list " -> "
ref-incr! &(item data-list 2)
report data-list

; pass a reference to an item in a dictionary
report data-dict " -> "
ref-incr! &(item data-dict "a")
report data-dict

; pass a reference to an attribute in an object
report data-obj " -> "
ref-incr! &data-obj.count
report data-obj

; pass a dynamic reference
ref-incr! &(dynamic
                { ; the dynamic getter thunk
                    (define result 567)
                    (print f"dynamic ref was asked for a value {result}")
                    result }
                { ; the dynamic setter thunk
                    (print f"dynamic ref was fed a value {%1}") })


; The end.
