(import sys)
(import-from argparse ArgumentParser)
(import-from os.path basename)


def create-option-parser [name]:
  """
  Argument parser for koslife
  """

  var parser (ArgumentParser
    prog: (basename name)
    description: "Conway's Game of Life in the terminal, written in Koskari")

  (parser.add_argument "--wrap" action: "store_true" default: False
                       help: "Game board wraps at edges")

  var g (parser.add_mutually_exclusive_group)

  (g.add_argument "--digits" action: "store_const" dest: "renderer"
                  const: "digits"
                  help: "use the digits renderer")

  (g.add_argument "--dots" action: "store_const" dest: "renderer"
                  const: "dots"
                  help: "use the dots renderer")

  (g.add_argument "--color" action: "store_const" dest: "renderer"
                  const: "color"
                  help: "use the color renderer")

  (g.add_argument "--default" action: "store_const" dest: "renderer"
                  const: "default" default: "default"
                  help: "use the default renderer")

  parser


@entry-point
def main [argv: None]:
  """
  koslife CLI entry
  """

  when (None? argv):
    (set! argv sys.argv)

  (var [prog *: args] argv)

  var parser (create-option-parser prog)
  var options (parser.parse_args args)

  ;; Defer curse/life/curses until after argparse (--help exits earlier).
  (import-from .curse cli)

  try:
    (cli options)
  except [KeyboardInterrupt]:
    (print file: sys.stderr)
    130
  else:
    0


;; The end.
