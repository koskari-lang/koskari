;; examples/life/koslife/life.ki
;;
;; Conway's Game of Life board (sparse dict). Ported from python-sibilant
;; sibilant-life (LGPL-3); this koskari example under the project GPLv3.
;;
;; :author: Christopher O'Brien <obriencj@preoccupied.net>
;; :license: GNU General Public License v3


import-from itertools product
import-from random random seed


class LifeBoard []:

    def __init__ [self width height wrap: False]:
        set! self.width width
        set! self.height height
        set! self.wrap wrap

        set! self.data #{}


    def clear [self]:
        """
        Clear the board to dead; keeps keys so UIs can turn cells off
        """

        set! self.data (dict.fromkeys self.data 0)


    def all-coordinates [self]:
        product (range 0 self.width) (range 0 self.height)


    def randomize [self threshold: 0.6]:
        """
        Random fill: cell lives when (random) > threshold
        """

        (self.clear)
        (seed)

        for-each [[x y] (self.all-coordinates)]:
            when (< threshold (random)):
                self.set-cell x y 1


    def tracked [self cleanup: True]:
        """
        Yield #(coord value) for live and recently dead cells
        """

        var data self.data
        if cleanup:
            for-each [item (list (data.items))]:
                var [coord cell] item
                unless cell:
                    del! data[coord]
                yield item
        else:
            yield-from (data.items)


    def toggle [self x y]:
        var coord #(x y)
        var cell (self.data.get coord None)
        set! self.data[coord] (if cell 0 1)


    def coord-key [self x y]:
        var w self.width
        var h self.height
        unless self.wrap:
            unless (and (< -1 x w) (< -1 y h)):
                return None
        #((% x w) (% y h))


    def set-cell [self x y value]:
        var key (self.coord-key x y)
        unless (None? key):
            set! self.data[key] value


    def group-coords [self x y]:
        product #((- x 1) x (+ x 1)) #((- y 1) y (+ y 1))


    def age [self]:
        """
        Advance one generation.

        Scatter each live cell into a neighbour-count map, then decide
        every candidate's fate from its count. Cells drawn last frame
        that die are retained as 0 for one frame so the renderer can
        blank them.
        """

        var data self.data
        var counts #{}

        ;; Scatter: each live cell adds 1 to each of its eight neighbours.
        for-each [[coord value] (data.items)]:
            when value:
                var [x y] coord
                for-each [[cx cy] (self.group-coords x y)]:
                    unless (and (== cx x) (== cy y)):
                        var key (self.coord-key cx cy)
                        unless (None? key):
                            set! counts[key] (+ 1 (counts.get key 0))

        var new #{}

        ;; Survival ages the cell up; birth needs exactly three neighbours.
        for-each [[key n] (counts.items)]:
            var prev (data.get key 0)
            var survives (<= 2 n 3)
            if prev:
                set! new[key] (if survives (+ prev 1) 0)
            elif (== n 3):
                set! new[key] 1

        ;; A cell drawn last frame but not resolved above just died; keep
        ;; it (and any older marker) as 0 until a redraw clears it.
        for-each [[coord value] (data.items)]:
            unless (in coord new):
                set! new[coord] 0

        set! self.data new
        self


    def child [self]:
        var clone (LifeBoard self.width self.height self.wrap)
        set! clone.data self.data
        (clone.age)


;; The end.
