import sys
import fastapi
import uvicorn


;; Application definition


define app (fastapi.FastAPI title: "Koskari Demo")


define-syntax define-route:
    syntax-rules []:
        define-route path name args body ...:
            define name args body ...
            (app.add_api_route path (coroutine-fn name)
                methods: #["GET"])


define-route "/" home []:
    (print "-> home")
    #{ok: True
      message: "hello from Koskari"
      routes: #["/" "/healthz" "/echo/{name}"]}

define-route "/healthz" healthz []:
    (print "-> healthz")
    #{ok: True}

define-route "/echo/{name}" echo [name: "<anon>"]:
    (print "-> echo" name)
    #{ok: True
      echo: name}


;; Server management


define server None


define create-server [host: "127.0.0.1" port: 8000]:
    define config (uvicorn.Config app host: host port: port)
    (uvicorn.Server config)


define start [host: "127.0.0.1" port: 8000]:
    global server
    when (None? server):
        set! server (create-server host: host port: port)
    (server.serve)


define stop []:
    global server
    unless (None? server):
        (server.shutdown)
        set! server None


;; Client for interactive mode


define create-client []:
    import-from httpx AsyncClient

    define-global client:
        AsyncClient base_url: "http://127.0.0.1:8000/"

    define-global GET [path: ""]:
        .json (client.get path)


;; Script entry point


define main []:
    define-parameter *interactive* False

    if *interactive*:
        ;; global keeps the Task alive; the loop holds only a weak ref
        define-global server-task (create-task (defer start))
        (create-client)
        (await)

        ; now you can define additional routes, and use GET to test them, and
        ; it all happens in the same event loop

    else:
        (start)


when-main:
    (main)


;; The end.
