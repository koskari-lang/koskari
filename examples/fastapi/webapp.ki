"""
Example: a FastAPI application whose routes are declared with a macro

Install the dependencies with pip install -r requirements.txt, then
koskari webapp.ki serves on 127.0.0.1:8000. With koskari -i webapp.ki
the server runs in the background of the session: (GET "/healthz")
queries it, and a define-route form at the prompt adds a route to the
live application.
"""


import sys
import fastapi
import uvicorn


;; Application definition


var app (fastapi.FastAPI title: "Koskari Demo")


syntax define-route:
    syntax-rules []:
        define-route path name args body ...:
            def name args body ...
            (app.add_api_route path (coroutine-fn name)
                methods: #["GET"])


define-route "/" home []:
    (print "-> home")
    #{"ok": True
      "message": "hello from Koskari"
      "routes": #["/" "/healthz" "/echo/{name}"]}

define-route "/healthz" healthz []:
    (print "-> healthz")
    #{"ok": True}

define-route "/echo/{name}" echo [name: "<anon>"]:
    (print "-> echo" name)
    #{"ok": True
      "echo": name}


;; Server management


var server None


def create-server [host: "127.0.0.1" port: 8000]:
    var config (uvicorn.Config app host: host port: port)
    (uvicorn.Server config)


def start [host: "127.0.0.1" port: 8000]:
    global var server
    when (None? server):
        set! server (create-server host: host port: port)
    (server.serve)


def stop []:
    global var server
    unless (None? server):
        (server.shutdown)
        set! server None


;; Client for interactive mode


def create-client []:
    import-from httpx AsyncClient

    global var client:
        AsyncClient base_url: "http://127.0.0.1:8000/"

    global def GET [path: ""]:
        .json (client.get path)


;; Script entry point


@entry-point
def main []:
    define-parameter *interactive* False

    if *interactive*:
        ;; global keeps the Task alive; the loop holds only a weak ref
        global var server-task (create-task (defer start))
        (create-client)
        (await)

        ; now you can define additional routes, and use GET to test them, and
        ; it all happens in the same event loop

    else:
        (start)


;; The end.
