"""
Example: Pydantic model using a Koskari define-class
"""


import-from pydantic BaseModel ConfigDict
import-from itertools product
import-from koskari.lib Function


def around [i reach: 1]:
    (range (- i reach) (+ i reach 1))


def base_config [**: cfg]:
    """
    Pydantic ConfigDict for Koskari-written models.

    Injects the demand and Function types into the config's
    ignored_types setting.
    """

    var ignored (cfg.get "ignored_types" #())
    set! cfg["ignored_types"] #(demand Function *: ignored)
    (ConfigDict **: cfg)


define-class Point [BaseModel]:
    """ A point in 2D space """

    var model_config (base_config)

    var x :: int 0
    var y :: int 0

    def neighbors [self reach: 1]:
        each [[x y] (product (around self.x reach) (around self.y reach))]:
            (Point x: x y: y)


@entry-point
define main []:
    print "Point class:" Point
    print "Point.__doc__:" Point.__doc__
    print "Point.__annotations__:" Point.__annotations__

    var p (Point x: 3 y: 5)
    print "p:" p
    print "p.x:" p.x
    print "p.y:" p.y

    print "p.neighbors:"
    for-each [n (p.neighbors)]:
        print "  " n


;; The end.
