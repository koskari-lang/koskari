import-from functools [lru_cache as: memoize]


def fib-recur [n]:
    """
    Good old Fibonacci sequence, defined recursively.
    """

    if (< n 2):
        if (< n 1) 0 n
    else:
        + (fib-recur (- n 1)) (fib-recur (- n 2))


;; Note that in order for LRU cache to work, we need to
;; move it into the demand path, so it's no longer returning
;; a coroutine. If we rewrite the lru_cache in koskari, we
;; can move away from this.
@(memoize maxsize: None)
@demand
def fib-recur-decorated [n]:
    """
    Good old Fibonacci sequence, defined recursively, with a
    memoizing decorator.
    """

    if (< n 2):
        if (< n 1) 0 n
    else:
        + (fib-recur-decorated (- n 1)) (fib-recur-decorated (- n 2))


;; The @let decorator closes the function over a private cache, so the
;; memo persists across calls -- a second call reuses everything the
;; first one computed. A cache defined inside the body would be rebuilt
;; per call and only serve that call's own recursion.
@let [[cache #{}]]
def fib-recur-cached [n]:
    """
    Good old Fibonacci sequence, defined recursively with
    a cache.
    """

    if (in n cache):
        cache[n]

    elif (< n 2):
        if (< n 1) 0 n

    else:
        var result (+ (fib-recur-cached (- n 1))
                         (fib-recur-cached (- n 2)))
        set! cache[n] result
        result


def fib-tail-recur [n]:
    """
    Fibonacci sequence, defined recursively with
    tail-call optimization.
    """

    let inner [[n n] [v 0] [accu 1]]:
        if (< n 1):
            v
        else:
            inner (- n 1) accu (+ accu v)


def fib-loop [n]:
    """
    Fibonacci sequence, defined iteratively.
    """

    var tmp 0
    var v 0
    var accu 1

    while (> n 0):
        decr! n
        set! tmp accu
        incr! accu v
        set! v tmp
    v


;; The end.
