import fastapi as: fastapi
import uvicorn as: uvicorn

define app (fastapi.FastAPI title: "Koskari Demo")


define-syntax define-route:
    syntax-rules []:
        define-route path name args body...:
            define name args body...
            (app.add_api_route path (as-coroutine name)
                methods: #["GET"])


define-route "/" home []:
    (print "home")
    #{ok: True
      message: "hello from Koskari"
      routes: #["/" "/healthz" "/echo/{name}"]}

define-route "/healthz" healthz []:
    (print "healthz")
    #{ok: True}

define-route "/echo/{name}" echo [name: "<anon>"]:
    (print "echo" name)
    #{ok: True
      echo: name}


define main []:
  define config (uvicorn.Config app host: "127.0.0.1" port: 8000)
  define server (uvicorn.Server config)
  (server.serve)


when-main:
    (main)


;; The end.
