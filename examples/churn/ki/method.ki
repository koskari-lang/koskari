;; churn_method -- one bound-method call per iteration, mutating instance
;; state through self.  Exercises attribute resolution and call dispatch.

(var MASK32 0xffffffff)


class ChurnCounter []:

    def __init__ [self]:
        set! self.total 0

    def bump [self v]:
        set! self.total (& (+ self.total v) MASK32)
        self.total


def churn_method [n x: 1]:
    var c (ChurnCounter)
    var i 0
    while (< i n):
        set! x (c.bump (^ x i))
        incr! i
    c.total


;; The end.
