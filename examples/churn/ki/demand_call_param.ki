;; churn_demand_call_param -- the demand_call shape run with one parameterize
;; binding in force: Python's builtin map driving a two-argument koskari
;; function wrapped in demand, one Python-to-koskari boundary call per
;; element, each call reading the parameter.  No Python counterpart: the
;; point is the koskari demand boundary under a parameterize extent.

(import-from builtins map)

(var MASK32 0xffffffff)

(define-parameter salt 0)


def mix [a b]:
    (& (+ (* a 31) (^ b salt)) MASK32)


def churn_demand_call_param [n: 20000]:
    var acc 0
    parameterize [[salt 0x5bd1e995]]:
        for-each [v (map (demand mix) (range 0 n) (range n 0 -1))]:
            set! acc (& (+ (* acc 33) v) MASK32)
    acc


;; The end.
