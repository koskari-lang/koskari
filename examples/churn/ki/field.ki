;; churn_field -- every step is a read-modify-write of an instance attribute,
;; and the loop counter is itself an attribute, so attribute access on the
;; dict storage path dominates.

(var MASK32 0xffffffff)


class ChurnBox []:

    def __init__ [self]:
        set! self.i 0
        set! self.a 0
        set! self.b 0


def churn_field [n x: 1]:
    var box (ChurnBox)
    set! box.i 0
    set! box.a (& x MASK32)
    set! box.b 1
    while (< box.i n):
        set! box.a (+ box.a box.b)
        set! box.a (& box.a MASK32)
        set! box.b (^ box.b box.a)
        set! box.i (+ box.i 1)
    (& (^ box.a box.b) MASK32)


;; The end.
