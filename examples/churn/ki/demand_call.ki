;; churn_demand_call -- Python's builtin map driving a two-argument koskari
;; function wrapped in demand: one Python-to-koskari boundary call per
;; element, on the simple shape (plain positional formals, no defaults, no
;; bound method, no class).  No Python counterpart: the point is the koskari
;; demand boundary.

(import-from builtins map)

(var MASK32 0xffffffff)


def mix [a b]:
    (& (+ (* a 31) (^ b 0x5bd1e995)) MASK32)


def churn_demand_call [n: 20000]:
    var acc 0
    for-each [v (map (demand mix) (range 0 n) (range n 0 -1))]:
        set! acc (& (+ (* acc 33) v) MASK32)
    acc


;; The end.
