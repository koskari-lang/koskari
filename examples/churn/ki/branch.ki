;; churn_branch -- a four-arm if/elif/else per iteration with deliberately
;; light arithmetic, so branch/compare/jump dispatch dominates.

(define MASK32 0xffffffff)


define churn_branch [n x: 1]:
    define acc 0
    define v (& x MASK32)
    for-each [i (range n)]:
        set! v (& (+ v i) MASK32)
        if (== 0 (% v 3)):
            set! acc (& (+ acc (>> v 2)) MASK32)
        elif (== 0 (% v 5)):
            set! acc (& (^ acc (& (<< v 1) MASK32)) MASK32)
        elif (& v 1):
            set! acc (& (+ acc (* v 3) 1) MASK32)
        else:
            set! acc (& (+ acc (>> v 1)) MASK32)
    acc


;; The end.
