;; churn_call_kw -- a koskari loop calling a koskari function with a
;; keyword argument: one koskari-to-koskari call per element, each
;; carrying a keyword, so none takes the simple shape.  No Python
;; counterpart: the point is the koskari keyword call path.

(var MASK32 0xffffffff)


def mixkw [a b: 0]:
    (& (+ (* a 31) (^ b 0x5bd1e995)) MASK32)


def churn_call_kw [n: 20000]:
    var acc 0
    for-each [i (range 0 n)]:
        set! acc (& (+ (* acc 33) (mixkw i b: (- n i))) MASK32)
    acc


;; The end.
