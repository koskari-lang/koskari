;; churn_yieldfrom -- yield-from delegation, consumed both fully and abandoned
;; mid-delegation (break after one value), which stresses the YIELD_FROM
;; teardown path.  No Python counterpart: the point is koskari's generator
;; delegation machinery.

(define MASK32 0xffffffff)


define yield-from-items [items]:
    yield-from items


define churn_yieldfrom [n: 64]:
    define data (list (range n))
    define acc 0

    ;; full consumption
    for-each [_ (range n)]:
        for-each [v (yield-from-items data)]:
            set! acc (& (+ acc v) MASK32)

    ;; partial consumption: abandon each generator after one value
    for-each [_ (range n)]:
        define g (yield-from-items data)
        for-each [v g]:
            set! acc (& (^ acc v) MASK32)
            (break)
    (& acc MASK32)


;; The end.
