;; fannkuch -- fannkuch-redux (benchmarks-game).  Generates every permutation
;; of n elements, counting prefix-reversal flips.  Exercises integer array
;; indexing and in-place mutation (item / set-item) in tight loops.  Returns
;; #(max-flips checksum); for n=7 that is #(16 228), a known oracle.

define fannkuch [n]:
    define perm1 (list (range n))
    define count (* #[0] n)
    define max-flips 0
    define checksum 0
    define perm-count 0
    define r n

    while True:
        while (!= r 1):
            set! count[(- r 1)] r
            decr! r

        define perm (list perm1)
        define flips 0
        define k perm[0]
        while (!= k 0):
            define i 0
            define j k
            while (< i j):
                define tmp perm[i]
                set! perm[i] perm[j]
                set! perm[j] tmp
                incr! i
                decr! j

            incr! flips
            set! k perm[0]

        when (> flips max-flips):
            set! max-flips flips

        if (== 0 (% perm-count 2)):
            set! checksum (+ checksum flips)
        else:
            set! checksum (- checksum flips)

        ;; advance perm1 to the next permutation
        define advanced False
        while (not advanced):
            when (== r n):
                return max-flips checksum
            define perm0 perm1[0]
            define i2 0
            while (< i2 r):
                define j2 (+ i2 1)
                set! perm1[i2] perm1[j2]
                set! i2 j2

            set! perm1[r] perm0
            decr! count[r]
            if (> count[r] 0):
                set! advanced True
            else:
                incr! r
        incr! perm-count


;; The end.
