;; fannkuch -- fannkuch-redux (benchmarks-game).  Generates every permutation
;; of n elements, counting prefix-reversal flips.  Exercises integer array
;; indexing and in-place mutation (item / set-item) in tight loops.  Returns
;; #(max-flips checksum); for n=7 that is #(16 228), a known oracle.

def fannkuch [n]:
    var perm1 (list (range n))
    var count (* #[0] n)
    var max-flips 0
    var checksum 0
    var perm-count 0
    var r n

    while True:
        while (!= r 1):
            set! count[(- r 1)] r
            decr! r

        var perm (list perm1)
        var flips 0
        var k perm[0]
        while (!= k 0):
            var i 0
            var j k
            while (< i j):
                var tmp perm[i]
                set! perm[i] perm[j]
                set! perm[j] tmp
                incr! i
                decr! j

            incr! flips
            set! k perm[0]

        when (> flips max-flips):
            set! max-flips flips

        if (== 0 (% perm-count 2)):
            incr! checksum flips
        else:
            decr! checksum flips

        ;; advance perm1 to the next permutation
        var advanced False
        while (not advanced):
            when (== r n):
                return max-flips checksum
            var perm0 perm1[0]
            var i2 0
            while (< i2 r):
                var j2 (+ i2 1)
                set! perm1[i2] perm1[j2]
                set! i2 j2

            set! perm1[r] perm0
            decr! count[r]
            if (> count[r] 0):
                set! advanced True
            else:
                incr! r
        incr! perm-count


;; The end.
