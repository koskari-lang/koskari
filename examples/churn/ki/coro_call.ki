;; churn_coro_call -- the koskari half of the async boundary kernel: a
;; two-argument function on the simple shape (plain positional formals, no
;; defaults, no bound method, no class).  Each call from Python returns a
;; Koskari Coroutine; the driver in py/coro_call.py gathers them on asyncio.


(var MASK32 0xffffffff)


def mix [a b]:
    (& (+ (* a 31) (^ b 0x5bd1e995)) MASK32)


;; The end.
