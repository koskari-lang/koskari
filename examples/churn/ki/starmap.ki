;; churn_starmap -- koskari.itertools starmap driving a koskari method,
;; nested two deep: the lazy neighbourhood scan a grid program writes, each
;; cell read a method call made inside the running evaluator.  The Python
;; counterpart is itertools.starmap over the same methods.

(import-from itertools product)
(import-from koskari.itertools starmap)

(var MASK32 0xffffffff)


class ChurnGrid []:

    def __init__ [self w h]:
        set! self.width w
        set! self.height h
        set! self.wrap False
        set! self.data #{}

        var tmp 175

        ;; seed live cells so dict.get hits both present and absent keys
        for-each [[x y] (product (range 0 w) (range 0 h))]:
            when (== 0 (% (+ x y) 3)):
                set! (item self.data #(x y)) tmp
                set! tmp (^ tmp (& (<< tmp 5) MASK32))


    def coord-key [self x y]:
        var w self.width
        var h self.height
        unless self.wrap:
            unless (and (< -1 x w) (< -1 y h)):
                return None
        #((% x w) (% y h))


    def get-cell [self x y]:
        var key (self.coord-key x y)
        if (None? key) 0 (self.data.get key 0)


    def group-coord [self x y]:
        (product #((- x 1) x (+ x 1)) #((- y 1) y (+ y 1)))


    def get-group [self x y]:
        (starmap self.get-cell (self.group-coord x y))


    def get-all-groups [self]:
        (starmap self.get-group
          (product (range 0 self.width) (range 0 self.height)))


def churn_starmap [w: 8 h: 8]:
    var grid (ChurnGrid w h)
    var acc 0
    for-each [grp (grid.get-all-groups)]:
        for-each [v grp]:
            when v:
                set! acc (& (+ acc v) MASK32)
    acc


;; The end.
