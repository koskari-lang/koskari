;; coroutines -- await-chain recursion (pyperformance coroutines).  The
;; Python variant is an async fibonacci: one coroutine object per call,
;; awaited by its caller.  Every Koskari call already runs on the
;; async-native evaluator, so the kernel is the plain recursion and the
;; harness hosts it on an event loop for the comparison.

define fib [n]:
    if (<= n 1):
        n
    else:
        (+ (fib (- n 1)) (fib (- n 2)))


define coroutines [n]:
    (fib n)


;; The end.
