;; churn_demand_call_kw -- Python's builtin map driving functools.partial over
;; a demand-wrapped koskari function, the partial binding a keyword: one
;; Python-to-koskari boundary call per element, each carrying a keyword
;; argument, so none takes the simple shape.  No Python counterpart: the
;; point is the koskari demand boundary.

(import-from builtins map)
(import-from functools partial)

(var MASK32 0xffffffff)


def mixkw [a b: 0]:
    (& (+ (* a 31) (^ b 0x5bd1e995)) MASK32)


def churn_demand_call_kw [n: 20000]:
    var acc 0
    for-each [v (map (partial (demand mixkw) b: 7) (range 0 n))]:
        set! acc (& (+ (* acc 33) v) MASK32)
    acc


;; The end.
