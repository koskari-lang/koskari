;; pidigits -- unbounded spigot (Gibbons) for the digits of pi.  Every step is
;; arbitrary-precision integer arithmetic (multiply, add, floor-divide on
;; growing integers), so this is a direct exercise of the bignum path.  The
;; assembled integer of the first n digits is a known oracle.

def pidigits [n]:
    var q 1
    var r 0
    var t 1
    var k 1
    var m 3
    var x 3
    var decimal 0
    var count 0

    while (< count n):
        if (< (- (+ (* 4 q) r) t) (* m t)):
            ;; emit digit m; update q, r, m from the current values
            set! decimal (+ (* decimal 10) m)
            set! count (+ count 1)
            var nq (* 10 q)
            var nr (* 10 (- r (* m t)))
            var nm (- (// (* 10 (+ (* 3 q) r)) t) (* 10 m))
            set! q nq
            set! r nr
            set! m nm
        else:
            var nq (* q k)
            var nr (* (+ (* 2 q) r) x)
            var nt (* t x)
            var nk (+ k 1)
            var nm (// (+ (* q (+ (* 7 k) 2)) (* r x)) (* t x))
            var nx (+ x 2)
            set! q nq
            set! r nr
            set! t nt
            set! k nk
            set! m nm
            set! x nx
    decimal


;; The end.
