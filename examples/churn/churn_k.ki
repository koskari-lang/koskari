#! /usr/bin/env koskari

(define MASK32 0xffffffff)


define churn_loop [n x: 1]:
    (define i 0)

    while (< i n):
      (set! x (& (+ (* x 1664525) 1013904223) MASK32))
      (set! x (^ x (& (<< x 13) MASK32)))
      (set! x (^ x (>> x 17)))
      (set! x (^ x (& (<< x 5) MASK32)))
      (set! x (& (+ x (* i 1103515245)) MASK32))
      (set! i (+ i 1))
    x


define churn_tree [depth x: 1]:
    if (<= depth 0):
        (set! x (& (+ (* x 1664525) 1013904223) MASK32))
        (set! x (^ x (& (<< x 13) MASK32)))
        (set! x (^ x (>> x 17)))
        (set! x (^ x (& (<< x 5) MASK32)))
        (& x MASK32)
    else:
        (define a (churn_tree (- depth 1) (& (+ (* x 1664525) 1013904223) MASK32)))
        (define b (churn_tree (- depth 1) (& (^ x 2654435769) MASK32)))
        (& (^ (+ a (* (^ b x) 33)) (^ (& (<< a 7) MASK32) (>> b 3))) MASK32)


define churn_step [x i]:
    (set! x (& (+ (* x 1664525) 1013904223) MASK32))
    (set! x (^ x (& (<< x 13) MASK32)))
    (set! x (^ x (>> x 17)))
    (set! x (^ x (& (<< x 5) MASK32)))
    (& (+ x (* i 1103515245)) MASK32)


define churn_list_each [n x: 1]:
    (define acc 0)
    (for-each [v (list-each [i (range n)] (churn_step x i))]
      (set! acc (^ acc v)))
    (& acc MASK32)


define-syntax compile/loop:
  """
  A wholly unnecessary loop macro.
  """

  syntax-rules []:
    case (loop each: [binding expr] body ...):
      (for-each [binding expr] body ...)
    case (loop times: n body ...):
      (for-each [_ (range n)] body ...)
    case (loop until: test body ...):
      (while (not test) body ...)
    case (loop while: test body ...):
      (while test body ...)
    case (loop body ...):
      (while True body ...)


when-main:
    import sys
    import-from argparse ArgumentParser

    define parser (ArgumentParser
      description: "Run koskari churn tests for valgrind analysis")

    (parser.add_argument "-n"
        type: int default: 10  dest: "count" metavar: "N"
        help: "repetitions per test (default: 10)")
    (parser.add_argument "tests"
        nargs: "*" metavar: "TEST"
        default: #[]
        help: "loop tree list_each (default: all)")

    define options (parser.parse_args)

    define tests #{
      loop: { (churn_loop 10000 1) }
      tree: { (churn_tree 12 1) }
      list_each: { (churn_list_each 10000 1) }
    }

    define sel options.tests
    when (or (not sel) (has? sel "all")):
      set! sel (list (tests.keys))

    define n options.count
    define result 0
    for-each [test sel]:
      loop times: n:
        set! result (call (item tests test))
      print f"""{test " <10"}: {result}"""


;; The end.
