#! /usr/bin/env koskari

(import-from itertools product starmap)

(define MASK32 0xffffffff)


define churn_loop [n x: 1]:
    (define i 0)

    while (< i n):
      (set! x (& (+ (* x 1664525) 1013904223) MASK32))
      (set! x (^ x (& (<< x 13) MASK32)))
      (set! x (^ x (>> x 17)))
      (set! x (^ x (& (<< x 5) MASK32)))
      (set! x (& (+ x (* i 1103515245)) MASK32))
      (set! i (+ i 1))
    x


define churn_tree [depth x: 1]:
    if (<= depth 0):
        (set! x (& (+ (* x 1664525) 1013904223) MASK32))
        (set! x (^ x (& (<< x 13) MASK32)))
        (set! x (^ x (>> x 17)))
        (set! x (^ x (& (<< x 5) MASK32)))
        (& x MASK32)
    else:
        (define a (churn_tree (- depth 1) (& (+ (* x 1664525) 1013904223) MASK32)))
        (define b (churn_tree (- depth 1) (& (^ x 2654435769) MASK32)))
        (& (^ (+ a (* (^ b x) 33)) (^ (& (<< a 7) MASK32) (>> b 3))) MASK32)


define churn_step [x i]:
    (set! x (& (+ (* x 1664525) 1013904223) MASK32))
    (set! x (^ x (& (<< x 13) MASK32)))
    (set! x (^ x (>> x 17)))
    (set! x (^ x (& (<< x 5) MASK32)))
    (& (+ x (* i 1103515245)) MASK32)


define churn_list_each [n x: 1]:
    (define acc 0)
    (for-each [v (list-each [i (range n)] (churn_step x i))]
      (set! acc (^ acc v)))
    (& acc MASK32)


;; Exercises attribute resolution and bound-method calls: one method
;; call per iteration, mutating instance state through self.

define-class ChurnCounter []:

    define __init__ [self]:
        set! self.total 0

    define bump [self v]:
        set! self.total (& (+ self.total v) MASK32)
        self.total


define churn_method [n x: 1]:
    define c (ChurnCounter)
    for-each [i (range n)]:
        set! x (c.bump (^ x i))
    c.total


;; Exercises branch density: a four-arm if/elif/else per iteration with
;; deliberately light arithmetic so jump/compare dispatch dominates.

define churn_branch [n x: 1]:
    define acc 0
    define v (& x MASK32)
    for-each [i (range n)]:
        set! v (& (+ v i) MASK32)
        if (== 0 (% v 3)):
            set! acc (& (+ acc (>> v 2)) MASK32)
        elif (== 0 (% v 5)):
            set! acc (& (^ acc (& (<< v 1) MASK32)) MASK32)
        elif (& v 1):
            set! acc (& (+ acc (* v 3) 1) MASK32)
        else:
            set! acc (& (+ acc (>> v 1)) MASK32)
    acc


;; Exercises the demand path the way koslife does: Python's itertools
;; starmap calls a koskari method wrapped in (demand ...), and the
;; outer get-all-groups nests a second demand+starmap inside the eval
;; of the first.  This is the only meaningful demand churn in koslife.

define-class ChurnGrid []:

    define __init__ [self w h]:
        set! self.width w
        set! self.height h
        set! self.wrap False
        set! self.data #{}

        define tmp 175

        ;; seed live cells so dict.get hits both present and absent keys
        for-each [[x y] (product (range 0 w) (range 0 h))]:
            when (== 0 (% (+ x y) 3)):
                set! (item self.data #(x y)) tmp
                set! tmp (^ tmp (& (<< tmp 5) MASK32))


    define coord-key [self x y]:
        define w self.width
        define h self.height
        unless self.wrap:
            unless (and (< -1 x w) (< -1 y h)):
                return None
        #((% x w) (% y h))


    define get-cell [self x y]:
        define key (self.coord-key x y)
        if (None? key) 0 (self.data.get key 0)


    define group-coord [self x y]:
        (product #((- x 1) x (+ x 1)) #((- y 1) y (+ y 1)))


    define get-group [self x y]:
        (starmap (demand self.get-cell) (self.group-coord x y))


    define get-all-groups [self]:
        (starmap (demand self.get-group)
          (product (range 0 self.width) (range 0 self.height)))


define churn_starmap [w: 8 h: 8]:
    define grid (ChurnGrid w h)
    define acc 0
    for-each [grp (grid.get-all-groups)]:
      for-each [v grp]:
        when v:
          (set! acc (& (+ acc v) MASK32))
    acc


;; Exercises yield-from delegation, which koslife's `tracked` uses
;; (yield-from (data.items)) and which the other churn tests never
;; touch.  Builds a generator that delegates to an inner iterable and
;; consumes it both fully and partially (abandoning the generator
;; mid-delegation, which stresses the YIELD_FROM teardown path).

define yield-from-items [items]:
    yield-from items


define churn_yieldfrom [n: 64]:
    define data (list (range n))
    define acc 0

    ;; full consumption
    for-each [_ (range n)]:
        for-each [v (yield-from-items data)]:
            (set! acc (& (+ acc v) MASK32))

    ;; partial consumption: abandon each generator after one value
    for-each [_ (range n)]:
        define g (yield-from-items data)
        for-each [v g]:
            (set! acc (& (^ acc v) MASK32))
            (break)
    (& acc MASK32)


define-syntax compile/loop:
  """
  A wholly unnecessary loop macro.
  """

  syntax-rules []:
    case (loop each: [binding expr] body ...):
      (for-each [binding expr] body ...)
    case (loop times: n body ...):
      (for-each [_ (range n)] body ...)
    case (loop until: test body ...):
      (while (not test) body ...)
    case (loop while: test body ...):
      (while test body ...)
    case (loop body ...):
      (while True body ...)


when-main:
    import sys
    import-from argparse ArgumentParser

    define parser (ArgumentParser
      description: "Run koskari churn tests for valgrind analysis")

    (parser.add_argument "-n"
        type: int default: 10  dest: "count" metavar: "N"
        help: "repetitions per test (default: 10)")
    (parser.add_argument "tests"
        nargs: "*" metavar: "TEST"
        default: #[]
        help: "loop tree list_each method branch starmap yieldfrom (default: all)")

    define options (parser.parse_args)

    define tests #{
      loop: { (churn_loop 10000 1) }
      tree: { (churn_tree 12 1) }
      list_each: { (churn_list_each 10000 1) }
      method: { (churn_method 10000 1) }
      branch: { (churn_branch 10000 1) }
      starmap: { (churn_starmap 8 8) }
      yieldfrom: { (churn_yieldfrom 64) }
    }

    define sel options.tests
    when (or (not sel) (has? sel "all")):
      set! sel (list (tests.keys))

    define n options.count
    define result 0
    for-each [test sel]:
      loop times: n:
        set! result (call (item tests test))
      print f"""{test " <10"}: {result}"""


;; The end.
