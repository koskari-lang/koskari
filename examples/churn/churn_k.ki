(define MASK32 0xffffffff)


define churn_loop [n x: 1]:
    (define i 0)

    while (< i n):
      (set! x (& (+ (* x 1664525) 1013904223) MASK32))
      (set! x (^ x (& (<< x 13) MASK32)))
      (set! x (^ x (>> x 17)))
      (set! x (^ x (& (<< x 5) MASK32)))
      (set! x (& (+ x (* i 1103515245)) MASK32))
      (set! i (+ i 1))
    x


define churn_tree [depth x: 1]:
    if (<= depth 0):
        (set! x (& (+ (* x 1664525) 1013904223) MASK32))
        (set! x (^ x (& (<< x 13) MASK32)))
        (set! x (^ x (>> x 17)))
        (set! x (^ x (& (<< x 5) MASK32)))
        (& x MASK32)
    else:
        (define a (churn_tree (- depth 1) (& (+ (* x 1664525) 1013904223) MASK32)))
        (define b (churn_tree (- depth 1) (& (^ x 2654435769) MASK32)))
        (& (^ (+ a (* (^ b x) 33)) (^ (& (<< a 7) MASK32) (>> b 3))) MASK32)


define churn_step [x i]:
    (set! x (& (+ (* x 1664525) 1013904223) MASK32))
    (set! x (^ x (& (<< x 13) MASK32)))
    (set! x (^ x (>> x 17)))
    (set! x (^ x (& (<< x 5) MASK32)))
    (& (+ x (* i 1103515245)) MASK32)


define churn_list_each [n x: 1]:
    (define acc 0)
    (for-each [v (list-each [i (range n)] (churn_step x i))]
      (set! acc (^ acc v)))
    (& acc MASK32)


;; koskari's CLI rejects option-like args before they reach the script, so
;; the loop count is a positional integer: koskari churn_k.ki [N [test...]]
;; where test is one of: loop tree list_each  (default: all three)

when-main:
    import sys
    import-from argparse ArgumentParser

    define parser (ArgumentParser
        description: "Run koskari churn tests for valgrind analysis"
        epilog: "usage: koskari churn_k.ki [N [loop] [tree] [list_each]]")

    (parser.add_argument "loops"
        type: int nargs: "?" default: 10 metavar: "N"
        help: "repetitions per test (default: 10)")
    (parser.add_argument "tests"
        nargs: "*" metavar: "TEST"
        help: "loop tree list_each (default: all)")

    define options (parser.parse_args)
    define n options.loops
    define sel (set options.tests)
    define run-all (? sel)
    define result 0

    when (or run-all (has? sel "loop")):
        for-each [_ (range n)]:
          (set! result (churn_loop 10000 1))
        (print f"churn_loop      x{n}: {result}")

    when (or run-all (has? sel "tree")):
        for-each [_ (range n)]:
          (set! result (churn_tree 12 1))
        (print f"churn_tree      x{n}: {result}")

    when (or run-all (has? sel "list_each")):
        for-each [_ (range n)]:
          (set! result (churn_list_each 10000 1))
        (print f"churn_list_each x{n}: {result}")


;; The end.
