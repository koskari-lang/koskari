(define MASK32 0xffffffff)


define churn_loop [n x: 1]:
    (define i 0)

    while (< i n):
      (setq x (& (+ (* x 1664525) 1013904223) MASK32))
      (setq x (^ x (& (<< x 13) MASK32)))
      (setq x (^ x (>> x 17)))
      (setq x (^ x (& (<< x 5) MASK32)))
      (setq x (& (+ x (* i 1103515245)) MASK32))
      (setq i (+ i 1))
    x


define churn_tree [depth x: 1]:
    if (<= depth 0):
        (setq x (& (+ (* x 1664525) 1013904223) MASK32))
        (setq x (^ x (& (<< x 13) MASK32)))
        (setq x (^ x (>> x 17)))
        (setq x (^ x (& (<< x 5) MASK32)))
        (& x MASK32)
    else:
        (define a (churn_tree (- depth 1) (& (+ (* x 1664525) 1013904223) MASK32)))
        (define b (churn_tree (- depth 1) (& (^ x 2654435769) MASK32)))
        (& (^ (+ a (* (^ b x) 33)) (^ (& (<< a 7) MASK32) (>> b 3))) MASK32)


;; The end.
